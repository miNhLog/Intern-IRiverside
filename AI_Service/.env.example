# UC10 - Cau hinh chatbot RAG. Copy file nay thanh `.env` roi dien key that.
# TUYET DOI khong commit file `.env` (da nam trong .gitignore).

# --- OpenAI (uu tien neu co key) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini (du phong khi khong co OpenAI) ---
GEMINI_API_KEY=
# gemini-1.5-flash da bi shutdown (2026); dung model con phuc vu.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Embedding retrieval ---
# De trong: dung embedding ngu nghia (sentence-transformers all-MiniLM-L6-v2).
# Dat tfidf/hash/local/off: bat buoc dung fallback nhe (khong can tai model).
RAG_EMBEDDINGS=

# --- Mang ---
# Ep IPv4 khi goi LLM (tranh IPv6 cua Google bi treo/WinError 10013 tren Windows).
LLM_FORCE_IPV4=true
