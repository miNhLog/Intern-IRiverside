@model HeThongDatTiecCuoi_WEB.Models.AdminReport.RevenueBiViewModel
@{
    ViewData["Title"] = "Thống kê và báo cáo";
    Layout = "_AdminLayout";
}

<!-- Font và Bootstrap Icons dùng chung được nạp bởi _AdminLayout; Chart.js & SheetJS vẫn giữ nguyên. -->
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"></script>

<script>
    tailwind.config = {
        theme: {
            extend: {
                colors: {
                    brand: {
                        gold: '#B89758',
                        goldLight: '#E8D8B6',
                        goldHover: '#8C6D32',
                        darkNavy: '#111822',
                        sidebar: '#141E28',
                        surface: '#FFFFFF',
                        canvas: '#F8F9FA',
                        border: '#E2E8F0',
                        textMain: '#1E293B',
                        textMuted: '#64748B'
                    }
                },
                fontFamily: {
                    serif: ['"Playfair Display"', 'Georgia', 'serif'],
                    sans: ['"Plus Jakarta Sans"', '-apple-system', 'BlinkMacSystemFont', 'sans-serif']
                }
            }
        }
    }
</script>

<style>
    .bi-page-wrapper {
        font-family: 'Inter', sans-serif;
        color: var(--rp-text);
    }

        .bi-page-wrapper .font-serif {
            font-family: 'Inter', sans-serif;
        }

    .card-shadow {
        box-shadow: none;
    }

    .focus-ring:focus-visible {
        outline: 2px solid #B89758;
        outline-offset: 2px;
    }

    .custom-scrollbar::-webkit-scrollbar {
        height: 8px;
        width: 8px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: var(--rp-surface-muted);
        border-radius: 4px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: var(--rp-border-strong);
        border-radius: 4px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: var(--rp-gold-500);
        }

    /* Hiệu ứng cho ma trận */
    .matrix-table {
        border-collapse: separate;
        border-spacing: 0;
    }

        .matrix-table th,
        .matrix-table td {
            border-right: 1px solid var(--rp-border);
            border-bottom: 1px solid var(--rp-border);
        }

        .matrix-table thead th {
            border-color: var(--rp-border-strong);
        }

    .matrix-cell-booking {
        transition: background-color var(--metis-transition), border-color var(--metis-transition), box-shadow var(--metis-transition);
    }

        .matrix-cell-booking:hover {
            border-color: var(--rp-gold-500);
            box-shadow: inset 0 0 0 1px var(--rp-gold-500);
        }

    /* Hiệu ứng pulse nhẹ cho badge trạng thái */
    @@keyframes subtlePulse {
        0%, 100%

    {
        opacity: 1;
    }

    50% {
        opacity: 0.85;
    }

    }

    .status-pulse {
        animation: subtlePulse 2.5s ease-in-out infinite;
    }

    /* Custom scrollbar cho bảng ma trận */
    .matrix-scroll-container::-webkit-scrollbar {
        height: 10px;
    }

    .matrix-scroll-container::-webkit-scrollbar-track {
        background: var(--rp-surface-muted);
        border-radius: 6px;
        margin: 0 8px;
    }

    .matrix-scroll-container::-webkit-scrollbar-thumb {
        background: var(--rp-border-strong);
        border-radius: 6px;
        border: 2px solid var(--rp-surface-muted);
    }

        .matrix-scroll-container::-webkit-scrollbar-thumb:hover {
            background: var(--rp-gold-500);
        }

    /* Manager BI dashboard */
    .bi-dashboard { --bi-gold:var(--rp-gold-600);display:flex;flex-direction:column; }
    .bi-hero { order:-3;min-height:0;padding:0 0 2px!important;border:0!important;background:transparent!important;box-shadow:none!important; }
    .bi-hero h1 { max-width:760px;margin:4px 0 0;color:var(--rp-text);font-size:26px;font-weight:700;line-height:1.2;letter-spacing:0; }
    .bi-hero p { max-width:720px;color:var(--rp-text-secondary);font-size:13px;line-height:1.55; }
    .bi-filter-panel { order:-1;position:sticky;top:12px;z-index:20;padding:14px 16px!important;border-color:var(--rp-border)!important;border-radius:var(--metis-radius-lg)!important;background:var(--rp-surface)!important;box-shadow:none!important; }
    .bi-filter-panel[aria-busy="true"] { opacity:.72;pointer-events:none; }
    .bi-filter-panel[aria-busy="true"]::after { width:14px;height:14px;border:2px solid var(--rp-border-strong);border-top-color:var(--rp-gold-500);border-radius:50%;content:"";animation:biSpin .7s linear infinite; }
    @@keyframes biSpin { to { transform:rotate(360deg); } }
    .bi-filter-label { display:flex;align-items:center;gap:7px;color:var(--rp-text);font-size:11px;font-weight:700; }
    .bi-filter-label i { color:var(--bi-gold); }
    .bi-filter-control { min-height:42px!important;border-color:var(--rp-border)!important;border-radius:var(--metis-radius)!important;color:var(--rp-text);background:var(--rp-surface-muted)!important; }
    .bi-filter-control :is(label,select) { color:inherit!important; }
    .bi-filter-reset { min-height:42px;border:1px solid var(--rp-border)!important;color:var(--rp-text-secondary)!important;background:var(--rp-surface-muted)!important; }
    .bi-filter-reset:hover { color:var(--rp-text)!important;background:var(--rp-surface-hover)!important; }
    .bi-kpi-grid.manager-kpi-grid { order:-2;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px!important;margin-top:0; }
    .bi-kpi-grid .manager-kpi-card { min-width:0; }
    .bi-kpi-grid .manager-kpi-card > div { min-width:0; }
    .bi-kpi-grid .manager-kpi-card em { display:none; }
    .bi-kpi-grid .manager-kpi-card :is(small,strong) { min-width:0;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;overflow-wrap:normal;word-break:normal; }
    .bi-kpi-grid .manager-kpi-card small { display:block; }
    .bi-kpi-grid .manager-kpi-card strong { display:block;line-height:1.15; }
    .bi-kpi-unit { margin-left:3px;color:var(--rp-text-muted);font-size:10px;font-weight:500;letter-spacing:0;white-space:nowrap; }
    .bi-chart-grid,.bi-secondary-grid { gap:18px!important; }
    .bi-panel { overflow:hidden;padding:0!important;border:1px solid var(--rp-border)!important;border-radius:var(--metis-radius-lg)!important;background:var(--rp-surface);box-shadow:none; }
    .bi-panel-head { min-height:62px;padding:14px 18px!important;border-bottom:1px solid var(--rp-border)!important;background:transparent; }
    .bi-panel-head h3 { display:flex;align-items:center;gap:9px;color:var(--rp-text)!important;font-family:"Inter",sans-serif!important;font-size:15px!important;font-weight:650!important;letter-spacing:-.01em; }
    .bi-panel-head h3 i { width:30px;height:30px;display:grid;place-items:center;border-radius:var(--metis-radius-sm);color:var(--metis-badge-primary);background:color-mix(in srgb,var(--metis-badge-primary) 12%,transparent);font-size:14px; }
    .bi-panel-head p { margin-top:3px!important;color:var(--rp-text-secondary)!important;font-size:10px!important;line-height:1.5; }
    .bi-chart-body { padding:20px 20px 18px; }
    .bi-chart-canvas { min-height:280px; }
    .bi-chart-unit { display:inline-flex;align-items:center;gap:7px;padding:6px 9px;border:1px solid var(--rp-border);border-radius:var(--metis-radius-sm);color:var(--rp-text-secondary);background:var(--rp-surface-muted);font-size:9px!important;font-weight:650;white-space:nowrap; }
    .bi-chart-unit span { width:7px!important;height:7px!important;background:var(--metis-badge-primary)!important; }
    .bi-chart-summary { display:flex;align-items:center;gap:8px;margin-top:12px;padding:10px 12px;border:1px solid var(--rp-border);border-radius:var(--metis-radius-sm);color:var(--rp-text-secondary);background:var(--rp-surface-muted);font-size:9px;line-height:1.5; }
    .bi-chart-summary i { color:var(--bi-gold); }
    .bi-structure-legend { margin:0 20px 18px;padding:12px!important;border:1px solid var(--rp-border)!important;border-radius:var(--metis-radius-sm);color:var(--rp-text-secondary);background:var(--rp-surface-muted); }
    .bi-structure-legend>div { min-height:28px; }
    .bi-chart-empty { min-height:92px!important;display:flex;align-items:center;justify-content:center;gap:8px;color:var(--rp-text-secondary);font-size:11px;text-align:center; }
    .bi-chart-empty i { color:var(--rp-gold-600);font-size:16px; }
    .bi-recent-panel { padding:0!important; }
    .bi-recent-panel table { min-width:700px; }
    .bi-recent-panel thead { position:sticky;top:0;z-index:1; }
    .bi-recent-count { border:1px solid var(--rp-border);color:var(--rp-text-secondary);background:var(--rp-surface-muted); }
    .bi-recent-panel th { color:var(--rp-text-secondary);background:var(--rp-surface-muted); }
    .bi-recent-panel td { border-color:var(--rp-border);color:var(--rp-text-secondary); }
    .bi-recent-panel tbody tr:hover { background:var(--rp-surface-hover)!important; }
    .bi-recent-footer { border-color:var(--rp-border)!important;background:var(--rp-surface-muted)!important; }
    .bi-matrix-shell { border-color:var(--rp-border)!important;background:var(--rp-surface)!important; }
    .bi-matrix-header,.bi-matrix-footer { border-color:var(--rp-border)!important;background:var(--rp-surface)!important; }
    .bi-matrix-toolbar { border-color:var(--rp-border)!important;background:var(--rp-surface-muted)!important; }
    .bi-matrix-control { border-color:var(--rp-border)!important;color:var(--rp-text)!important;background:var(--rp-surface)!important; }
    .bi-matrix-body { background:var(--rp-surface-muted)!important; }
    .bi-matrix-loading { color:var(--rp-text-secondary);background:color-mix(in srgb,var(--rp-surface) 90%,transparent)!important; }
    .bi-matrix-loading>div { border-color:var(--rp-border)!important;background:var(--rp-surface)!important;box-shadow:none!important; }
    .bi-matrix-legend { border-color:var(--rp-border)!important;color:var(--rp-text-secondary)!important;background:var(--rp-surface-muted)!important; }

    html[data-admin-theme="dark"] .admin-metis-app :is(.bi-filter-panel,.bi-panel,.manager-kpi-card) { border-color:var(--rp-border)!important;background:var(--rp-surface)!important;box-shadow:none!important; }
    html[data-admin-theme="dark"] .admin-metis-app .bi-dashboard :is(.text-slate-900,.text-slate-800,.text-slate-700) { color:var(--rp-text)!important; }
    html[data-admin-theme="dark"] .admin-metis-app .bi-dashboard :is(.text-slate-600,.text-slate-500,.text-slate-400) { color:var(--rp-text-secondary)!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal :is(.text-slate-900,.text-slate-800,.text-slate-700) { color:var(--rp-text)!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal :is(.text-slate-600,.text-slate-500,.text-slate-400,.text-slate-300) { color:var(--rp-text-secondary)!important; }
    html[data-admin-theme="dark"] .admin-metis-app #matrixBodyRows { background:var(--rp-surface)!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .matrix-table td { border-color:var(--rp-border)!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .matrix-row:hover { background:transparent!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .matrix-hall-cell { border-color:var(--rp-border)!important;background:var(--rp-surface)!important;box-shadow:3px 0 8px -3px rgba(0,0,0,.45)!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .matrix-row:hover .matrix-hall-cell { background:var(--rp-surface-hover)!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .matrix-slot-empty { border-color:var(--rp-border)!important;background:color-mix(in srgb,var(--rp-surface-muted) 78%,var(--rp-surface))!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .matrix-slot-empty:hover { background:color-mix(in srgb,var(--metis-badge-success) 8%,var(--rp-surface-muted))!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .matrix-slot-empty>div { opacity:.88!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .matrix-slot-empty :is(i,span) { color:var(--rp-text-muted)!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .matrix-slot-booked { border-color:var(--rp-border)!important;background:color-mix(in srgb,var(--rp-gold-500) 7%,var(--rp-surface-muted))!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .matrix-booking-card { border-color:color-mix(in srgb,var(--rp-gold-500) 48%,var(--rp-border))!important;background:var(--rp-surface)!important;box-shadow:none!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .matrix-slot-locked { border-color:var(--rp-border)!important;background:color-mix(in srgb,#fb7185 9%,var(--rp-surface-muted))!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .matrix-lock-icon { border-color:color-mix(in srgb,#fb7185 35%,var(--rp-border))!important;background:color-mix(in srgb,#fb7185 14%,var(--rp-surface))!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .matrix-booking-status--booked { border-color:color-mix(in srgb,var(--rp-gold-500) 55%,var(--rp-border))!important;color:#fcd34d!important;background:color-mix(in srgb,var(--rp-gold-500) 14%,var(--rp-surface))!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .matrix-booking-status--completed { border-color:color-mix(in srgb,#34d399 45%,var(--rp-border))!important;color:#86efac!important;background:color-mix(in srgb,#34d399 13%,var(--rp-surface))!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .bi-matrix-current-week { border-color:var(--rp-border)!important;color:var(--rp-text)!important;background:var(--rp-surface-muted)!important;box-shadow:none!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .bi-matrix-current-week:hover { background:var(--rp-surface-hover)!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal :is(.bi-matrix-close,.bi-matrix-nav) { color:var(--rp-text-secondary)!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal :is(.bi-matrix-close,.bi-matrix-nav):hover { color:var(--rp-text)!important;background:var(--rp-surface-hover)!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .matrix-legend-booked { border-color:color-mix(in srgb,var(--rp-gold-500) 50%,var(--rp-border))!important;color:#fcd34d!important;background:color-mix(in srgb,var(--rp-gold-500) 12%,var(--rp-surface))!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .matrix-legend-locked { border-color:color-mix(in srgb,#fb7185 42%,var(--rp-border))!important;color:#fda4af!important;background:color-mix(in srgb,#fb7185 12%,var(--rp-surface))!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .matrix-legend-completed { border-color:color-mix(in srgb,#34d399 42%,var(--rp-border))!important;color:#86efac!important;background:color-mix(in srgb,#34d399 12%,var(--rp-surface))!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .bi-matrix-close-action { border:1px solid var(--rp-border)!important;color:var(--rp-text)!important;background:var(--rp-surface-muted)!important;box-shadow:none!important; }
    html[data-admin-theme="dark"] .admin-metis-app #hallMatrixModal .bi-matrix-close-action:hover { background:var(--rp-surface-hover)!important; }
    html[data-admin-theme="dark"] .admin-metis-app .bi-dashboard .manager-status.status-completed { color:#86efac!important;background:color-mix(in srgb,var(--metis-badge-success) 16%,var(--rp-surface))!important; }
    html[data-admin-theme="dark"] .admin-metis-app .bi-dashboard .manager-status.status-pending { color:#fcd34d!important;background:color-mix(in srgb,var(--metis-badge-warning) 16%,var(--rp-surface))!important; }
    html[data-admin-theme="dark"] .admin-metis-app .bi-dashboard .manager-status.status-preparing { color:#93c5fd!important;background:color-mix(in srgb,var(--metis-badge-primary) 16%,var(--rp-surface))!important; }
    @@media(max-width:1100px){.bi-kpi-grid.manager-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @@media(max-width:1024px){.bi-filter-panel{position:static}.bi-chart-canvas{min-height:260px}}
    @@media(max-width:640px){.bi-page-wrapper{padding:16px!important}.bi-hero h1{font-size:24px}.bi-panel-head{align-items:flex-start!important;flex-direction:column}.bi-chart-body{padding:14px}.bi-chart-canvas{min-height:240px}.bi-filter-panel>div{width:100%}.bi-filter-control{flex:1 1 100%;justify-content:space-between}.bi-export-btn{width:100%;justify-content:center}.bi-kpi-grid.manager-kpi-grid{grid-template-columns:1fr}}
    @@media(prefers-reduced-motion:reduce){.status-pulse,.bi-filter-panel[aria-busy="true"]::after{animation:none!important}.matrix-cell-booking{transition:none}}
</style>

<!-- CONTAINER CHÍNH -->
<div class="bi-page-wrapper bi-dashboard p-6 lg:p-8 space-y-6 w-full max-w-[1600px] mx-auto">

    <!-- ================= 1. HEADER TRANG ================= -->
    <div class="manager-section-header bi-hero flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <span class="backoffice-hero__eyebrow"><i class="bi bi-bar-chart-line" aria-hidden="true"></i> PHÂN TÍCH KINH DOANH</span>
            <h1>
                Thống kê và báo cáo
            </h1>
            <p>Tổng hợp doanh thu, cơ cấu nguồn thu và hiệu suất khai thác sảnh theo từng kỳ báo cáo.</p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
            <button type="button" onclick="exportReportExcel()" class="excel-export-button bi-export-btn focus-ring">
                <i class="bi bi-file-earmark-excel" aria-hidden="true"></i>
                <span>Xuất báo cáo Excel</span>
            </button>
        </div>
    </div>

    <!-- ================= 2. BỘ LỌC KỲ BÁO CÁO ================= -->
    <section id="biFilterPanel" aria-label="Bộ lọc kỳ báo cáo" aria-busy="false" class="bi-filter-panel bg-white rounded-xl p-4 border border-slate-200 card-shadow flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-3">
            <span class="bi-filter-label"><i class="bi bi-sliders" aria-hidden="true"></i>Bộ lọc báo cáo</span>
            <div class="backoffice-filter-control bi-filter-control flex items-center border rounded-lg px-3 py-1.5 min-h-[40px]">
                <i class="bi bi-calendar3 mr-2 text-xs" aria-hidden="true"></i>
                <label for="selectYear" class="text-xs text-slate-500 mr-1.5 font-medium">Niên độ:</label>
                <select id="selectYear" onchange="onFilterChange()" class="bg-transparent text-xs font-bold text-slate-800 focus:outline-none cursor-pointer">
                    <option value="2026" selected>Năm 2026</option>
                    <option value="2025">Năm 2025</option>
                </select>
            </div>

            <div class="backoffice-filter-control bi-filter-control flex items-center border rounded-lg px-3 py-1.5 min-h-[40px]">
                <i class="bi bi-pie-chart mr-2 text-xs" aria-hidden="true"></i>
                <label for="selectQuarter" class="text-xs text-slate-500 mr-1.5 font-medium">Kỳ thống kê:</label>
                <select id="selectQuarter" onchange="onFilterChange()" class="bg-transparent text-xs font-bold text-slate-800 focus:outline-none cursor-pointer">
                    <option value="0" selected>Toàn bộ 4 Quý (12 Tháng)</option>
                    <option value="1">Quý 1 (Tháng 1 – 3)</option>
                    <option value="2">Quý 2 (Tháng 4 – 6)</option>
                    <option value="3">Quý 3 (Tháng 7 – 9)</option>
                    <option value="4">Quý 4 (Tháng 10 – 12)</option>
                </select>
            </div>

            <button type="button" onclick="resetBiFilter()" class="bi-filter-reset px-3.5 py-2 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-colors">
                <i class="bi bi-arrow-counterclockwise text-[11px]" aria-hidden="true"></i>
                <span>Mặc định</span>
            </button>
        </div>

    </section>

    <!-- ================= 3. BỘ THẺ KPI ================= -->
    <div class="bi-kpi-grid manager-kpi-grid" aria-label="Chỉ số kinh doanh trong kỳ báo cáo">
        <article class="manager-kpi-card">
            <span class="manager-kpi-icon"><i class="bi bi-cash-stack" aria-hidden="true"></i></span>
            <div>
                <small>Doanh thu thực thu</small>
                <strong id="kpiTotalRevenue">@Model.Kpi.TotalRevenue.ToString("N0") <span class="bi-kpi-unit">VNĐ</span></strong>
                <em>Số tiền đã thanh toán trong kỳ</em>
            </div>
        </article>

        <article class="manager-kpi-card">
            <span class="manager-kpi-icon"><i class="bi bi-file-earmark-check" aria-hidden="true"></i></span>
            <div>
                <small>Tiệc đã xác nhận</small>
                <strong id="kpiConfirmedBookings">@Model.Kpi.ConfirmedBookings <span class="bi-kpi-unit">tiệc</span></strong>
                <em>Đã chốt, không tính đơn bị hủy</em>
            </div>
        </article>

        <article class="manager-kpi-card">
            <span class="manager-kpi-icon"><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i></span>
            <div>
                <small>Giá trị hợp đồng mới</small>
                <strong id="kpiNewContractValue">@Model.Kpi.TotalContractValue.ToString("N0") <span class="bi-kpi-unit">VNĐ</span></strong>
                <em>Tổng giá trị hợp đồng ký trong kỳ</em>
            </div>
        </article>

        <article class="manager-kpi-card">
            <span class="manager-kpi-icon"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></span>
            <div>
                <small>Công nợ phải thu</small>
                <strong id="kpiOutstandingReceivables">@Model.Kpi.OutstandingReceivables.ToString("N0") <span class="bi-kpi-unit">VNĐ</span></strong>
                <em>Số tiền hợp đồng chưa thanh toán</em>
            </div>
        </article>
    </div>

    <!-- ================= 4. KHU VỰC BIỂU ĐỒ TRỰC QUAN ================= -->
    <div class="bi-chart-grid grid grid-cols-1 lg:grid-cols-12 gap-6">
        <section class="bi-panel lg:col-span-12 bg-white rounded-xl border border-slate-200">
            <header class="bi-panel-head flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                <div>
                    <h3><i class="bi bi-graph-up-arrow" aria-hidden="true"></i>Xu hướng doanh thu theo tháng</h3>
                    <p>So sánh biến động doanh thu thực thu giữa các tháng trong kỳ.</p>
                </div>
                <span class="bi-chart-unit flex items-center gap-1.5 text-xs text-slate-600">
                    <span class="w-3 h-3 rounded-xs bg-[#B89758]"></span> Doanh thu (Triệu VNĐ)
                </span>
            </header>
            <div class="bi-chart-body">
                <div class="bi-chart-canvas h-64 sm:h-80 w-full relative">
                    <canvas id="monthlyRevenueChart" role="img" aria-label="Biểu đồ xu hướng doanh thu thực thu theo tháng"></canvas>
                </div>
                <p class="bi-chart-summary" id="monthlyChartSummary"><i class="bi bi-info-circle" aria-hidden="true"></i><span>Đang tổng hợp xu hướng doanh thu...</span></p>
            </div>
        </section>

        <section class="hidden" aria-hidden="true">
            <header class="bi-panel-head">
                <h3><i class="bi bi-pie-chart" aria-hidden="true"></i>Cơ cấu nguồn thu</h3>
                <p>Tỷ trọng đóng góp giữa ẩm thực, sảnh và trang trí.</p>
            </header>
            <div class="bi-chart-body">
                <div class="bi-chart-canvas h-56 sm:h-64 relative flex items-center justify-center">
                    <canvas id="revenueStructureChart" role="img" aria-label="Biểu đồ tỷ trọng cơ cấu nguồn thu"></canvas>
                </div>
            </div>
            <div id="structureLegend" class="bi-structure-legend space-y-2 pt-2 border-t border-slate-100 text-xs">
                @foreach (var s in Model.RevenueStructures)
                {
                    <div class="flex items-center justify-between">
                        <span class="flex items-center gap-2 text-slate-600">
                            <span class="w-2.5 h-2.5 rounded-full" style="background-color: @s.ColorHex;"></span>
                            <span>@s.CategoryName</span>
                        </span>
                        <span class="font-bold text-slate-800">@s.Percentage%</span>
                    </div>
                }
            </div>
        </section>
    </div>

    <!-- ================= 5. HIỆU SUẤT SẢNH & BẢNG TIỆC GẦN NHẤT ================= -->
    <div class="bi-secondary-grid grid grid-cols-1 lg:grid-cols-12 gap-6">
        <section class="bi-panel lg:col-span-12 bg-white rounded-xl border border-slate-200">
            <header class="bi-panel-head">
                <h3><i class="bi bi-bar-chart" aria-hidden="true"></i>Hiệu suất khai thác sảnh</h3>
                <p>Xếp hạng doanh thu thực thu theo từng sảnh trong kỳ.</p>
            </header>
            <div class="bi-chart-body">
                <div class="bi-chart-canvas h-80 sm:h-96 relative">
                    <canvas id="hallPerformanceChart" role="img" aria-label="Biểu đồ xếp hạng doanh thu theo sảnh"></canvas>
                </div>
                <p class="bi-chart-summary" id="hallChartSummary"><i class="bi bi-trophy" aria-hidden="true"></i><span>Đang xác định sảnh dẫn đầu...</span></p>
            </div>
        </section>

        <section class="bi-panel bi-recent-panel lg:col-span-12 bg-white rounded-xl border border-slate-200 flex flex-col justify-between overflow-hidden">
            <header class="bi-panel-head flex items-center justify-between">
                <div>
                    <h3><i class="bi bi-calendar2-check" aria-hidden="true"></i>Sự kiện tiệc cưới gần nhất</h3>
                    <p>Các booking mới nhất trong kỳ báo cáo đang chọn.</p>
                </div>
                <span class="bi-recent-count px-2.5 py-1 rounded-md text-[11px] font-semibold"><span id="recentBookingsBadgeCount">@Model.RecentBookings.Count</span> đơn đặt tiệc</span>
            </header>

            <div class="overflow-x-auto custom-scrollbar flex-1">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="border-b border-slate-200 font-semibold uppercase text-[10.5px]">
                            <th class="py-3 px-4">Mã Tiệc</th>
                            <th class="py-3 px-4">Khách Hàng / Sảnh</th>
                            <th class="py-3 px-3 text-center">Ngày Đặt</th>
                            <th class="py-3 px-4 text-right">Tổng Tiền</th>
                            <th class="py-3 px-3 text-center">Trạng Thái</th>
                        </tr>
                    </thead>
                    <tbody id="recentBookingsTbody" class="divide-y divide-slate-100">
                        @foreach (var b in Model.RecentBookings)
                        {
                            <tr class="transition-colors">
                                <td class="py-3 px-4 font-mono font-bold text-slate-800">@b.BookingCode</td>
                                <td class="py-3 px-4">
                                    <p class="font-bold text-slate-900">@b.CustomerName</p>
                                    <p class="text-[11px] text-[#8C6D32]">Sảnh @b.HallName • @b.TableCount bàn</p>
                                </td>
                                <td class="py-3 px-3 text-center">
                                    <span class="font-medium text-slate-700">@b.EventDate.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td class="py-3 px-4 text-right font-serif font-bold text-slate-900">
                                    @b.TotalAmount.ToString("N0") đ
                                </td>
                                <td class="py-3 px-3 text-center">
                                    @if (b.Status == "Hoàn tất")
                                    {
                                        <span class="manager-status status-completed">Hoàn tất</span>
                                    }
                                    else if (b.Status == "Đã cọc")
                                    {
                                        <span class="manager-status status-pending">Đã cọc</span>
                                    }
                                    else
                                    {
                                        <span class="manager-status status-preparing">@b.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="bi-recent-footer p-3 border-t text-center">
                <button type="button" onclick="openHallMatrixModal()" class="text-xs text-[#8C6D32] hover:text-[#B89758] font-bold inline-flex items-center gap-1.5 transition-colors cursor-pointer">
                    <i class="bi bi-grid-3x3-gap text-[#B89758]"></i>
                    <span>Xem ma trận lịch sảnh toàn hệ thống &rarr;</span>
                </button>
            </div>
        </section>
    </div>

</div>

<!-- ================= MODAL MA TRẬN LỊCH SẢNH TOÀN HỆ THỐNG (UI NÂNG CẤP) ================= -->
<div id="hallMatrixModal"
     class="fixed inset-0 hidden items-center justify-center bg-slate-950/80 backdrop-blur-sm p-2 sm:p-4 md:p-6 transition-all duration-300"
     role="dialog"
     aria-modal="true"
     aria-hidden="true"
     aria-labelledby="hallMatrixTitle"
     aria-describedby="hallMatrixDescription"
     tabindex="-1"
     style="z-index: 99999; font-family: 'Plus Jakarta Sans', sans-serif;">
    <div class="bi-matrix-shell bg-white w-full h-full sm:h-[95vh] sm:max-w-[1500px] sm:rounded-xl flex flex-col border overflow-hidden">

        <!-- ============ HEADER MODAL ============ -->
        <header class="bi-matrix-header shrink-0 border-b">
            <!-- Dòng tiêu đề chính -->
            <div class="px-4 sm:px-6 py-4 flex items-center justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#B89758] to-[#8C6D32] flex items-center justify-center text-white shadow-md shrink-0">
                        <i class="bi bi-grid-3x3 text-base"></i>
                    </div>
                    <div class="min-w-0">
                        <h3 id="hallMatrixTitle" class="font-serif font-bold text-base sm:text-lg text-slate-900 tracking-tight truncate">
                            Ma Trận Điều Phối Lịch Sảnh Toàn Hệ Thống
                        </h3>
                        <p id="hallMatrixDescription" class="text-[11px] text-slate-500 mt-0.5 flex items-center gap-2 flex-wrap">
                            <span class="inline-flex items-center gap-1">
                                <i class="bi bi-building text-[#B89758] text-[10px]"></i>
                                9 Đại Sảnh Hoàng Gia
                            </span>
                            <span class="text-slate-300">•</span>
                            <span class="inline-flex items-center gap-1">
                                <i class="bi bi-clock text-[#B89758] text-[10px]"></i>
                                Trưa 10:30–14:00 | Tối 17:30–21:30
                            </span>
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                    <button type="button" onclick="loadMatrixCurrentWeek()"
                            class="bi-matrix-current-week hidden sm:inline-flex items-center gap-1.5 px-3 py-2 bg-white hover:bg-[#FAF8F5] text-slate-700 rounded-lg text-xs font-semibold border border-slate-200 shadow-2xs transition-colors cursor-pointer"
                            title="Quay về tuần hiện tại">
                        <i class="bi bi-calendar2-check text-[#B89758] text-[11px]"></i>
                        <span>Tuần hiện tại</span>
                    </button>
                    <button type="button" onclick="closeHallMatrixModal()"
                            class="bi-matrix-close w-9 h-9 flex items-center justify-center text-slate-400 hover:text-slate-800 hover:bg-slate-200/70 rounded-lg transition-colors cursor-pointer"
                            aria-label="Đóng ma trận lịch sảnh"
                            title="Đóng cửa sổ">
                        <i class="bi bi-x-lg text-lg"></i>
                    </button>
                </div>
            </div>

            <!-- Thanh điều hướng tuần -->
            <div class="bi-matrix-toolbar px-4 sm:px-6 py-3 border-t flex items-center justify-between gap-3 flex-wrap">
                <div class="flex items-center gap-2">
                    <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Tuần làm việc:</span>
                    <div class="bi-matrix-control flex items-center border rounded-lg overflow-hidden">
                        <button type="button" onclick="changeMatrixWeek(-7)"
                                class="bi-matrix-nav w-9 h-9 flex items-center justify-center text-slate-600 hover:text-[#8C6D32] hover:bg-[#FAF8F5] transition-colors border-r border-slate-200"
                            aria-label="Xem tuần trước"
                                title="Tuần trước">
                            <i class="bi bi-chevron-left text-xs"></i>
                        </button>
                        <span id="matrixWeekLabel"
                              class="px-4 text-xs font-bold text-slate-800 font-mono tracking-wide text-center min-w-[180px]">
                            Đang đồng bộ...
                        </span>
                        <button type="button" onclick="changeMatrixWeek(7)"
                                class="bi-matrix-nav w-9 h-9 flex items-center justify-center text-slate-600 hover:text-[#8C6D32] hover:bg-[#FAF8F5] transition-colors border-l border-slate-200"
                            aria-label="Xem tuần sau"
                                title="Tuần sau">
                            <i class="bi bi-chevron-right text-xs"></i>
                        </button>
                    </div>
                </div>

            </div>
        </header>

        <!-- ============ BODY: BẢNG MA TRẬN ============ -->
        <div class="bi-matrix-body flex-1 overflow-auto matrix-scroll-container relative">

            <!-- Loading Overlay -->
            <div id="matrixLoading"
                 class="bi-matrix-loading absolute inset-0 backdrop-blur-sm flex items-center justify-center z-30 transition-opacity"
                 role="status"
                 aria-live="polite">
                <div class="flex flex-col items-center gap-3 p-6 rounded-2xl bg-white shadow-xl border border-[#E5D5B8]">
                    <div class="relative">
                        <div class="w-12 h-12 rounded-full border-4 border-[#FAF8F5]"></div>
                        <div class="w-12 h-12 rounded-full border-4 border-t-[#B89758] border-r-transparent border-b-transparent border-l-transparent animate-spin absolute top-0 left-0"></div>
                    </div>
                    <span class="text-xs font-semibold text-slate-700">Đang tải lịch sảnh...</span>
                    <span class="text-[10px] text-slate-400">Vui lòng chờ trong giây lát</span>
                </div>
            </div>

            <table class="matrix-table w-full text-xs">
                <caption class="sr-only">Lịch sử dụng các đại sảnh theo ngày và ca trong tuần được chọn</caption>
                <thead class="sticky top-0 z-20">
                    <tr id="matrixHeaderDays" class="bg-[#1E293B] text-white text-center shadow-md">
                        <th rowspan="2"
                            class="py-3 px-3 font-bold border border-slate-700 sticky left-0 z-30 bg-[#1E293B] min-w-[140px] sm:min-w-[180px] text-left">
                            <div class="flex items-center gap-2">
                                <i class="bi bi-building text-[#B89758] text-xs"></i>
                                <span class="text-[11px] tracking-wide uppercase">Đại Sảnh / Quy Mô</span>
                            </div>
                        </th>
                    </tr>
                    <tr id="matrixHeaderShifts" class="bg-slate-800 text-slate-300 text-[10.5px] text-center">
                    </tr>
                </thead>
                <tbody id="matrixBodyRows" class="divide-y divide-slate-200 bg-white">
                </tbody>
            </table>
        </div>

        <!-- ============ FOOTER: CHÚ THÍCH ============ -->
        <footer class="bi-matrix-footer shrink-0 border-t px-4 sm:px-6 py-4">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                <!-- Legend chips -->
                <div class="flex flex-wrap items-center gap-2">
                    <span class="text-[10.5px] font-bold text-slate-700 uppercase tracking-wider mr-1 flex items-center gap-1.5">
                        <i class="bi bi-info-circle text-[#B89758] text-[11px]"></i>
                        Chú thích trạng thái:
                    </span>

                    <div class="bi-matrix-legend inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border font-medium text-[11px]">
                        <span class="w-2.5 h-2.5 rounded-full bg-slate-200 border border-slate-300"></span>
                        <span>Trống</span>
                    </div>

                    <div class="matrix-legend-booked inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-[#B89758]/10 border border-[#B89758]/40 shadow-2xs text-[#8C6D32] font-semibold text-[11px]">
                        <i class="bi bi-calendar2-check text-[#B89758] text-[10px]"></i>
                        <span>Đã đặt tiệc</span>
                    </div>

                    <div class="matrix-legend-locked inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-rose-50 border border-rose-200 shadow-2xs text-rose-700 font-semibold text-[11px]">
                        <i class="bi bi-lock text-rose-500 text-[10px]"></i>
                        <span>Tạm khóa</span>
                    </div>

                    <div class="matrix-legend-completed inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-emerald-50 border border-emerald-300 shadow-2xs text-emerald-800 font-semibold text-[11px]">
                        <i class="bi bi-check-circle text-emerald-600 text-[10px]"></i>
                        <span>Hoàn tất</span>
                    </div>
                </div>

                <!-- Nút đóng -->
                <div class="flex items-center justify-end">
                    <button type="button"
                            onclick="closeHallMatrixModal()"
                            class="bi-matrix-close-action w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-gradient-to-r from-[#1E293B] to-[#0F172A] hover:from-[#0F172A] hover:to-black active:scale-95 text-white rounded-lg text-xs font-semibold shadow-md transition-all cursor-pointer">
                        <i class="bi bi-x-lg text-slate-400 text-xs"></i>
                        <span>Đóng cửa sổ</span>
                    </button>
                </div>
            </div>
        </footer>

    </div>
</div>

@section Scripts {
    <script>
        // Dữ liệu ban đầu nhận từ CSDL qua Razor ViewModel
        let reportData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

        let monthlyChart = null;
        let structureChart = null;
        let hallChart = null;

        const getReportChartTheme = () => {
            const styles = getComputedStyle(document.body);
            const read = name => styles.getPropertyValue(name).trim();
            const dark = document.documentElement.dataset.adminTheme === 'dark';
            const categorical = [
                read('--chart-role-1'),
                read('--chart-role-2'),
                read('--chart-role-3'),
                read('--chart-role-4'),
                read('--metis-badge-primary'),
                read('--metis-badge-purple')
            ];
            return {
                dark,
                text: read('--rp-text'),
                secondary: read('--rp-text-secondary'),
                muted: read('--rp-text-muted'),
                panel: read('--rp-surface'),
                grid: read('--rp-border'),
                accent: categorical[0],
                palette: categorical,
                tooltip: read('--chart-tooltip-bg'),
                tooltipText: read('--chart-tooltip-text')
            };
        };

        const doughnutCenterTextPlugin = {
            id: 'doughnutCenterText',
            afterDraw(chart) {
                const { ctx, chartArea } = chart;
                if (!chartArea) return;
                const total = chart.data.datasets[0].data.reduce((sum, value) => sum + Number(value || 0), 0);
                const x = (chartArea.left + chartArea.right) / 2;
                const y = (chartArea.top + chartArea.bottom) / 2;
                ctx.save();
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                const theme = getReportChartTheme();
                ctx.fillStyle = theme.text;
                ctx.font = '800 24px "Inter"';
                ctx.fillText(`${Math.round(total)}%`, x, y - 5);
                ctx.fillStyle = theme.secondary;
                ctx.font = '600 9px "Inter"';
                ctx.fillText('TỔNG TỶ TRỌNG', x, y + 17);
                ctx.restore();
            }
        };

        document.addEventListener('DOMContentLoaded', () => {
            initCharts(reportData);
        });

        window.addEventListener('admin-theme-change', () => initCharts(reportData));

        function showBiToast(title, msg) {
            const normalizedTitle = String(title || 'Thông báo').toLocaleLowerCase('vi-VN');
            const type = normalizedTitle.includes('lỗi')
                ? 'error'
                : normalizedTitle.includes('cảnh báo')
                    ? 'warning'
                    : normalizedTitle.includes('thành công')
                        ? 'success'
                        : 'info';
            window.RiversideToast?.show(type, msg, { title });
        }

        function initCharts(data) {
            if (!data) return;
            const theme = getReportChartTheme();
            Chart.defaults.font.family = '"Inter", sans-serif';
            Chart.defaults.color = theme.secondary;
            Chart.defaults.animation.duration = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 550;

            // 1. Biểu đồ cột: Doanh thu theo tháng
            const monthlyRevenues = data.monthlyRevenues || data.MonthlyRevenues || [];
            const months = monthlyRevenues.map(m => m.monthName || m.MonthName || `Tháng ${m.month || m.Month}`);
            const revenues = monthlyRevenues.map(m => (m.totalRevenue ?? m.TotalRevenue ?? 0) / 1000000);

            const ctxMonthly = document.getElementById('monthlyRevenueChart').getContext('2d');
            const monthlyGradient = ctxMonthly.createLinearGradient(0, 0, 0, 320);
            monthlyGradient.addColorStop(0, theme.dark ? 'rgba(59, 130, 246, .24)' : 'rgba(37, 99, 235, .22)');
            monthlyGradient.addColorStop(1, theme.dark ? 'rgba(59, 130, 246, .015)' : 'rgba(37, 99, 235, .015)');
            if (monthlyChart) monthlyChart.destroy();
            monthlyChart = new Chart(ctxMonthly, {
                type: 'line',
                data: {
                    labels: months,
                    datasets: [{
                        label: 'Doanh thu (Triệu VNĐ)',
                        data: revenues,
                        borderColor: theme.accent,
                        backgroundColor: monthlyGradient,
                        borderWidth: 2.5,
                        fill: true,
                        tension: .38,
                        pointRadius: 3,
                        pointHoverRadius: 6,
                        pointBackgroundColor: theme.panel,
                        pointBorderColor: theme.accent,
                        pointBorderWidth: 2,
                        pointHitRadius: 12
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            displayColors: true,
                            usePointStyle: true,
                            boxWidth: 8,
                            boxHeight: 8,
                            backgroundColor: theme.tooltip,
                            titleColor: theme.tooltipText,
                            bodyColor: theme.tooltipText,
                            borderColor: theme.grid,
                            borderWidth: 1,
                            titleFont: { weight: '700' },
                            padding: 11,
                            cornerRadius: 9,
                            callbacks: {
                                label: (ctx) => `Doanh thu: ${ctx.parsed.y.toLocaleString('vi-VN')} triệu VNĐ`
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            border: { display: false },
                            ticks: { color: theme.secondary, padding: 9, font: { size: 10 }, callback: (v) => v.toLocaleString('vi-VN') + ' tr' },
                            grid: { color: theme.grid, drawTicks: false, borderDash: [4, 5] }
                        },
                        x: { border: { display: false }, ticks: { color: theme.secondary, padding: 8, font: { size: 10, weight: '600' } }, grid: { display: false } }
                    }
                }
            });
            const monthlySummary = document.querySelector('#monthlyChartSummary span');
            if (monthlySummary) {
                if (!revenues.length || revenues.every(value => value === 0)) monthlySummary.textContent = 'Chưa có doanh thu được ghi nhận trong kỳ báo cáo này.';
                else {
                    const peak = Math.max(...revenues); const peakIndex = revenues.indexOf(peak);
                    monthlySummary.textContent = `${months[peakIndex]} có doanh thu cao nhất: ${peak.toLocaleString('vi-VN')} triệu VNĐ.`;
                }
            }

            // 2. Biểu đồ tròn: Cơ cấu doanh thu
            const revenueStructures = data.revenueStructures || data.RevenueStructures || [];
            const labelsStruct = revenueStructures.map(s => s.categoryName || s.CategoryName);
            const valuesStruct = revenueStructures.map(s => s.percentage ?? s.Percentage ?? 0);
            const colorsStruct = revenueStructures.map((_, index) => theme.palette[index % theme.palette.length]);

            const structureCanvas = document.getElementById('revenueStructureChart');
            if (structureCanvas && structureCanvas.offsetParent !== null) {
                const ctxStructure = structureCanvas.getContext('2d');
                if (structureChart) structureChart.destroy();
                structureChart = new Chart(ctxStructure, {
                type: 'doughnut',
                data: {
                    labels: labelsStruct,
                    datasets: [{
                        data: valuesStruct,
                        backgroundColor: colorsStruct,
                        borderWidth: 3,
                        borderColor: theme.panel,
                        hoverOffset: 6,
                        spacing: 2
                    }]
                },
                plugins: [doughnutCenterTextPlugin],
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '66%',
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: theme.tooltip,
                            titleColor: theme.tooltipText,
                            bodyColor: theme.tooltipText,
                            borderColor: theme.grid,
                            borderWidth: 1,
                            padding: 11,
                            cornerRadius: 9,
                            callbacks: {
                                label: (ctx) => ` ${ctx.label}: ${ctx.parsed}%`
                            }
                        }
                    }
                }
            });
                updateStructureLegend(revenueStructures);
            } else if (structureChart) {
                structureChart.destroy();
                structureChart = null;
            }

            // 2. Biểu đồ cột đứng: Hiệu suất 9 đại sảnh
            const hallPerformances = [...(data.hallPerformances || data.HallPerformances || [])].sort((a, b) =>
                Number(b.totalRevenue ?? b.TotalRevenue ?? 0) - Number(a.totalRevenue ?? a.TotalRevenue ?? 0));
            const hallNames = hallPerformances.map(h => h.hallName || h.HallName);
            const hallRevs = hallPerformances.map(h => (h.totalRevenue ?? h.TotalRevenue ?? 0) / 1000000);

            const ctxHall = document.getElementById('hallPerformanceChart').getContext('2d');
            const hallColors = hallRevs.map(() => theme.accent);
            if (hallChart) hallChart.destroy();
            hallChart = new Chart(ctxHall, {
                type: 'bar',
                data: {
                    labels: hallNames,
                    datasets: [{
                        label: 'Doanh thu (Triệu VNĐ)',
                        data: hallRevs,
                        backgroundColor: hallColors,
                        hoverBackgroundColor: hallColors,
                        borderRadius: 6,
                        borderSkipped: false,
                        maxBarThickness: 56
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            displayColors: false,
                            backgroundColor: theme.tooltip,
                            titleColor: theme.tooltipText,
                            bodyColor: theme.tooltipText,
                            borderColor: theme.grid,
                            borderWidth: 1,
                            padding: 11,
                            cornerRadius: 9,
                            callbacks: {
                                label: (ctx) => `Doanh thu: ${ctx.parsed.y.toLocaleString('vi-VN')} triệu VNĐ`
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            border: { display: false },
                            ticks: { color: theme.secondary, padding: 8, font: { size: 9 }, callback: (v) => v.toLocaleString('vi-VN') + ' tr' },
                            grid: { color: theme.grid, drawTicks: false, borderDash: [4, 5] }
                        },
                        x: { border: { display: false }, ticks: { color: theme.text, maxRotation: 0, minRotation: 0, autoSkip: false, font: { size: 10, weight: '700' } }, grid: { display: false } }
                    }
                }
            });
            const hallSummary = document.querySelector('#hallChartSummary span');
            if (hallSummary) hallSummary.textContent = hallNames.length
                ? `${hallNames[0]} đang dẫn đầu với ${hallRevs[0].toLocaleString('vi-VN')} triệu VNĐ doanh thu.`
                : 'Chưa có dữ liệu doanh thu sảnh trong kỳ báo cáo này.';
        }

        async function onFilterChange() {
            const year = document.getElementById('selectYear').value;
            const quarter = document.getElementById('selectQuarter').value;
            const filterPanel = document.getElementById('biFilterPanel');
            filterPanel?.setAttribute('aria-busy', 'true');

            try {
                const res = await fetch(`/AdminReport/GetReportData?year=${year}&quarter=${quarter}`);
                if (!res.ok) {
                    showBiToast('Lỗi máy chủ', `Lỗi HTTP ${res.status}`);
                    return;
                }

                const result = await res.json();

                if (result.success && result.data) {
                    const data = result.data;
                    reportData = data;

                    updateKpiDom(data.kpi || data.Kpi);
                    initCharts(data);
                    renderRecentTable(data.recentBookings || data.RecentBookings);
                    updateStructureLegend(data.revenueStructures || data.RevenueStructures);

                    const quarterText = quarter == 0 ? 'Toàn bộ 4 Quý' : `Quý ${quarter}`;
                    showBiToast('Thành công', `Đã cập nhật báo cáo: Năm ${year} – ${quarterText}`);
                } else {
                    showBiToast('Thông báo', result.message || 'Không có dữ liệu cho kỳ này.');
                }
            } catch (e) {
                console.error("Lỗi khi lọc báo cáo BI:", e);
                showBiToast('Lỗi', 'Không thể kết nối máy chủ để cập nhật dữ liệu.');
            } finally {
                filterPanel?.setAttribute('aria-busy', 'false');
            }
        }

        function resetBiFilter() {
            document.getElementById('selectYear').value = '2026';
            document.getElementById('selectQuarter').value = '0';
            onFilterChange();
        }

        function updateKpiDom(kpi) {
            if (!kpi) return;
            const totalRevenue = kpi.totalRevenue ?? kpi.TotalRevenue ?? 0;
            const confirmedBookings = kpi.confirmedBookings ?? kpi.ConfirmedBookings ?? 0;
            const newContractValue = kpi.totalContractValue ?? kpi.TotalContractValue ?? 0;
            const outstandingReceivables = kpi.outstandingReceivables ?? kpi.OutstandingReceivables ?? 0;

            document.getElementById('kpiTotalRevenue').innerHTML = `${Number(totalRevenue).toLocaleString('vi-VN')} <span class="bi-kpi-unit">VNĐ</span>`;
            document.getElementById('kpiConfirmedBookings').innerHTML = `${confirmedBookings} <span class="bi-kpi-unit">tiệc</span>`;
            document.getElementById('kpiNewContractValue').innerHTML = `${Number(newContractValue).toLocaleString('vi-VN')} <span class="bi-kpi-unit">VNĐ</span>`;
            document.getElementById('kpiOutstandingReceivables').innerHTML = `${Number(outstandingReceivables).toLocaleString('vi-VN')} <span class="bi-kpi-unit">VNĐ</span>`;
        }

        function renderRecentTable(bookings) {
            const tbody = document.getElementById('recentBookingsTbody');
            tbody.innerHTML = '';
            const list = bookings || [];
            const badgeCount = document.getElementById('recentBookingsBadgeCount');
            if (badgeCount) badgeCount.innerText = list.length;

            if (list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-slate-400 italic">Không có sự kiện tiệc trong kỳ này.</td></tr>`;
                return;
            }

            list.forEach(b => {
                const code = b.bookingCode || b.BookingCode || '';
                const custName = b.customerName || b.CustomerName || '';
                const hallName = b.hallName || b.HallName || '';
                const tableCount = b.tableCount ?? b.TableCount ?? 0;
                const totalAmt = b.totalAmount ?? b.TotalAmount ?? 0;
                const status = b.status || b.Status || '';
                const eventDateRaw = b.eventDate || b.EventDate;
                const dateFormatted = eventDateRaw ? new Date(eventDateRaw).toLocaleDateString('vi-VN') : '---';

                let badge = `<span class="manager-status status-preparing">${status}</span>`;
                if (status === 'Hoàn tất') {
                    badge = `<span class="manager-status status-completed">Hoàn tất</span>`;
                } else if (status === 'Đã cọc') {
                    badge = `<span class="manager-status status-pending">Đã cọc</span>`;
                }

                tbody.innerHTML += `
                    <tr class="transition-colors">
                        <td class="py-3 px-4 font-mono font-bold text-slate-800">${code}</td>
                        <td class="py-3 px-4">
                            <p class="font-bold text-slate-900">${custName}</p>
                            <p class="text-[11px] text-[#8C6D32]">Sảnh ${hallName} • ${tableCount} bàn</p>
                        </td>
                        <td class="py-3 px-3 text-center">
                            <span class="font-medium text-slate-700">${dateFormatted}</span>
                        </td>
                        <td class="py-3 px-4 text-right font-serif font-bold text-slate-900">
                            ${Number(totalAmt).toLocaleString('vi-VN')} đ
                        </td>
                        <td class="py-3 px-3 text-center">${badge}</td>
                    </tr>
                `;
            });
        }

        function updateStructureLegend(structures) {
            const legendContainer = document.getElementById('structureLegend');
            if (!legendContainer) return;
            legendContainer.innerHTML = '';
            const list = structures || [];
            const theme = getReportChartTheme();

            if (list.length === 0) {
                legendContainer.innerHTML = '<div class="bi-chart-empty"><i class="bi bi-pie-chart" aria-hidden="true"></i><span>Chưa có dữ liệu cơ cấu nguồn thu trong kỳ này.</span></div>';
                return;
            }

            list.forEach((s, index) => {
                const name = s.categoryName || s.CategoryName || '';
                const color = theme.palette[index % theme.palette.length];
                const pct = s.percentage ?? s.Percentage ?? 0;

                legendContainer.innerHTML += `
                    <div class="flex items-center justify-between">
                        <span class="flex items-center gap-2 text-slate-600">
                            <span class="w-2.5 h-2.5 rounded-full" style="background-color: ${color};"></span>
                            <span>${name}</span>
                        </span>
                        <span class="font-bold text-slate-800">${pct}%</span>
                    </div>
                `;
            });
        }

                // ================= XỬ LÝ XUẤT EXCEL NÂNG CAO (CÓ NHÚNG BIỂU ĐỒ) =================
        async function exportReportExcel() {
            if (!reportData) {
                showBiToast('Lỗi', 'Không có dữ liệu để xuất.');
                return;
            }

            if (typeof ExcelJS === 'undefined') {
                showBiToast('Lỗi', 'Thư viện ExcelJS chưa sẵn sàng. Vui lòng thử lại sau vài giây.');
                return;
            }

            showBiToast('Đang xử lý', 'Đang tạo báo cáo Excel với đầy đủ biểu đồ...');

            try {
                const wb = new ExcelJS.Workbook();
                wb.creator = 'Riverside Palace';
                wb.company = 'Riverside Palace Convention & Wedding Center';
                wb.created = new Date();

                // ============ STYLE CONSTANTS ============
                const COLOR_GOLD = 'FFB89758';
                const COLOR_GOLD_DARK = 'FF8C6D32';
                const COLOR_DARK = 'FF1E293B';
                const COLOR_LIGHT_BG = 'FFFAF8F5';
                const COLOR_GRAY = 'FF64748B';
                const COLOR_BORDER = 'FFE2E8F0';

                const headerFill = { type: 'pattern', pattern: 'solid', fgColor: { argb: COLOR_DARK } };
                const headerFont = { bold: true, color: { argb: 'FFFFFFFF' }, size: 11, name: 'Calibri' };
                const goldFill = { type: 'pattern', pattern: 'solid', fgColor: { argb: COLOR_GOLD } };

                const borderAll = {
                    top: { style: 'thin', color: { argb: COLOR_BORDER } },
                    bottom: { style: 'thin', color: { argb: COLOR_BORDER } },
                    left: { style: 'thin', color: { argb: COLOR_BORDER } },
                    right: { style: 'thin', color: { argb: COLOR_BORDER } }
                };

                const applyHeaderStyle = (row) => {
                    row.eachCell(cell => {
                        cell.fill = headerFill;
                        cell.font = headerFont;
                        cell.alignment = { horizontal: 'center', vertical: 'middle', wrapText: true };
                        cell.border = borderAll;
                    });
                    row.height = 28;
                };

                const applySectionTitle = (sheet, range, text) => {
                    sheet.mergeCells(range);
                    const cell = sheet.getCell(range.split(':')[0]);
                    cell.value = text;
                    cell.font = { bold: true, size: 13, color: { argb: COLOR_DARK }, name: 'Calibri' };
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: COLOR_LIGHT_BG } };
                    cell.alignment = { vertical: 'middle', indent: 1 };
                    sheet.getRow(parseInt(range.match(/\d+/)[0])).height = 26;
                };

                // =====================================================
                // SHEET 1: DASHBOARD VỚI KPI + 2 BIỂU ĐỒ ẢNH
                // =====================================================
                const wsDash = wb.addWorksheet('📊 Dashboard', {
                    properties: { tabColor: { argb: COLOR_GOLD } },
                    views: [{ showGridLines: false }]
                });

                wsDash.columns = [
                    { width: 22 }, { width: 22 }, { width: 6 }, { width: 22 }, { width: 22 }
                ];

                // Title
                wsDash.mergeCells('A1:E1');
                const t1 = wsDash.getCell('A1');
                t1.value = 'BÁO CÁO DOANH THU & HIỆU SUẤT KINH DOANH (BI)';
                t1.font = { bold: true, size: 18, color: { argb: COLOR_GOLD_DARK }, name: 'Calibri' };
                t1.alignment = { horizontal: 'center', vertical: 'middle' };
                wsDash.getRow(1).height = 38;

                wsDash.mergeCells('A2:E2');
                const t2 = wsDash.getCell('A2');
                t2.value = `Riverside Palace Convention & Wedding Center • Niên độ ${new Date().getFullYear()}`;
                t2.font = { size: 10, italic: true, color: { argb: COLOR_GRAY } };
                t2.alignment = { horizontal: 'center' };
                wsDash.getRow(2).height = 20;

                // KPI Section
                applySectionTitle(wsDash, 'A4:E4', '💰  CHỈ SỐ KPI TỔNG QUAN');

                const kpi = reportData.kpi || reportData.Kpi;
                const kpiRows = [
                    ['Doanh thu thực thu', (kpi.totalRevenue || kpi.TotalRevenue || 0), 'VNĐ'],
                    ['Tiệc đã xác nhận', (kpi.confirmedBookings || kpi.ConfirmedBookings || 0), 'tiệc'],
                    ['Giá trị hợp đồng mới', (kpi.totalContractValue || kpi.TotalContractValue || 0), 'VNĐ'],
                    ['Công nợ phải thu', (kpi.outstandingReceivables || kpi.OutstandingReceivables || 0), 'VNĐ']
                ];

                kpiRows.forEach((row, idx) => {
                    const r = 5 + idx;
                    wsDash.getCell(`A${r}`).value = row[0];
                    wsDash.getCell(`A${r}`).font = { bold: true, size: 11, color: { argb: 'FF475569' } };
                    wsDash.getCell(`A${r}`).alignment = { vertical: 'middle', indent: 1 };
                    wsDash.getCell(`A${r}`).fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: COLOR_LIGHT_BG } };
                    wsDash.getCell(`A${r}`).border = borderAll;

                    wsDash.mergeCells(`B${r}:E${r}`);
                    const valueCell = wsDash.getCell(`B${r}`);
                    if (row[2] === 'VNĐ' || row[2] === '%') {
                        valueCell.value = Number(row[1]);
                        valueCell.numFmt = row[2] === 'VNĐ' ? '#,##0 "VNĐ"' : '#,##0.0"%"';
                    } else {
                        valueCell.value = `${row[1]} ${row[2]}`;
                    }
                    valueCell.font = { bold: true, size: 13, color: { argb: COLOR_GOLD_DARK } };
                    valueCell.alignment = { vertical: 'middle', indent: 1 };
                    valueCell.border = borderAll;
                    wsDash.getRow(r).height = 24;
                });

                let currentRow = 5 + kpiRows.length + 2;

                // CHART 1: Monthly Revenue
                if (monthlyChart) {
                    applySectionTitle(wsDash, `A${currentRow}:E${currentRow}`, '📈  XU HƯỚNG DOANH THU THEO THÁNG');
                    currentRow++;

                    const imgBase64 = monthlyChart.toBase64Image('image/png', 1);
                    const imgId = wb.addImage({ base64: imgBase64, extension: 'png' });
                    wsDash.addImage(imgId, {
                        tl: { col: 0.1, row: currentRow - 1 },
                        ext: { width: 720, height: 340 },
                        editAs: 'oneCell'
                    });
                    currentRow += 18;
                }

                // CHART 2: Hall Performance
                if (hallChart) {
                    applySectionTitle(wsDash, `A${currentRow}:E${currentRow}`, '📊  HIỆU SUẤT KHAI THÁC SẢNH');
                    currentRow++;

                    if (hallChart) {
                        const imgBase64 = hallChart.toBase64Image('image/png', 1);
                        const imgId = wb.addImage({ base64: imgBase64, extension: 'png' });
                        wsDash.addImage(imgId, {
                            tl: { col: 0.1, row: currentRow - 1 },
                            ext: { width: 720, height: 340 },
                            editAs: 'oneCell'
                        });
                    }
                    currentRow += 18;
                }

                // Footer
                wsDash.mergeCells(`A${currentRow + 1}:E${currentRow + 1}`);
                const footerCell = wsDash.getCell(`A${currentRow + 1}`);
                footerCell.value = `© ${new Date().getFullYear()} Riverside Palace • Báo cáo xuất tự động từ hệ thống BI`;
                footerCell.font = { size: 9, italic: true, color: { argb: COLOR_GRAY } };
                footerCell.alignment = { horizontal: 'center' };

                // =====================================================
                // SHEET 2: DOANH THU THEO THÁNG
                // =====================================================
                const wsMonthly = wb.addWorksheet('📈 DoanhThu_Thang', {
                    properties: { tabColor: { argb: 'FF3B82F6' } }
                });
                wsMonthly.columns = [
                    { header: 'Tháng', key: 'month', width: 20 },
                    { header: 'Doanh thu (VNĐ)', key: 'revenue', width: 25 },
                    { header: 'Tỷ trọng (%)', key: 'percent', width: 15 }
                ];
                applyHeaderStyle(wsMonthly.getRow(1));

                const monthlyList = reportData.monthlyRevenues || reportData.MonthlyRevenues || [];
                const totalMonthly = monthlyList.reduce((s, m) => s + (m.totalRevenue || m.TotalRevenue || 0), 0);

                monthlyList.forEach(m => {
                    const rev = m.totalRevenue || m.TotalRevenue || 0;
                    const pct = totalMonthly > 0 ? (rev / totalMonthly * 100) : 0;
                    const row = wsMonthly.addRow({
                        month: m.monthName || m.MonthName,
                        revenue: rev,
                        percent: pct
                    });
                    row.getCell('month').alignment = { horizontal: 'center', vertical: 'middle' };
                    row.getCell('revenue').numFmt = '#,##0 "VNĐ"';
                    row.getCell('revenue').alignment = { horizontal: 'right', vertical: 'middle' };
                    row.getCell('percent').numFmt = '0.00"%"';
                    row.getCell('percent').alignment = { horizontal: 'center', vertical: 'middle' };
                    row.eachCell(c => c.border = borderAll);
                    row.height = 22;
                });

                // Total row
                const totalRow = wsMonthly.addRow({
                    month: 'TỔNG CỘNG',
                    revenue: totalMonthly,
                    percent: 100
                });
                totalRow.font = { bold: true, color: { argb: 'FFFFFFFF' } };
                totalRow.getCell('month').fill = goldFill;
                totalRow.getCell('revenue').fill = goldFill;
                totalRow.getCell('percent').fill = goldFill;
                totalRow.getCell('month').alignment = { horizontal: 'center', vertical: 'middle' };
                totalRow.getCell('revenue').numFmt = '#,##0 "VNĐ"';
                totalRow.getCell('revenue').alignment = { horizontal: 'right', vertical: 'middle' };
                totalRow.getCell('percent').alignment = { horizontal: 'center', vertical: 'middle' };
                totalRow.eachCell(c => c.border = borderAll);
                totalRow.height = 24;

                // =====================================================
                // SHEET 3: CƠ CẤU NGUỒN THU
                // =====================================================
                const wsStructure = wb.addWorksheet('🥧 CoCau_NguonThu', {
                    properties: { tabColor: { argb: 'FF10B981' } }
                });
                wsStructure.columns = [
                    { header: 'Hạng mục', key: 'name', width: 32 },
                    { header: 'Tỷ trọng (%)', key: 'pct', width: 20 },
                    { header: 'Màu đại diện', key: 'color', width: 18 }
                ];
                applyHeaderStyle(wsStructure.getRow(1));

                const structList = reportData.revenueStructures || reportData.RevenueStructures || [];
                structList.forEach(s => {
                    const row = wsStructure.addRow({
                        name: s.categoryName || s.CategoryName,
                        pct: s.percentage || s.Percentage || 0,
                        color: s.colorHex || s.ColorHex || ''
                    });
                    row.getCell('name').alignment = { vertical: 'middle', indent: 1 };
                    row.getCell('pct').numFmt = '0.0"%"';
                    row.getCell('pct').alignment = { horizontal: 'center', vertical: 'middle' };
                    row.getCell('color').alignment = { horizontal: 'center', vertical: 'middle' };
                    row.getCell('color').font = { color: { argb: (s.colorHex || s.ColorHex || '#000').replace('#', 'FF') }, bold: true };
                    row.eachCell(c => c.border = borderAll);
                    row.height = 22;
                });

                // =====================================================
                // SHEET 4: HIỆU SUẤT ĐẠI SẢNH
                // =====================================================
