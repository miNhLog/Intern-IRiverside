@model HeThongDatTiecCuoi_WEB.Models.AdminReport.RevenueBiViewModel
@{
    ViewData["Title"] = "Báo Cáo Doanh Thu & Thống Kê BI";
    Layout = "_AdminLayout";
}

<!-- Font dùng chung được nạp bởi _AdminLayout; FontAwesome, Chart.js & SheetJS vẫn giữ nguyên. -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"></script>

<script>
    tailwind.config = {
        theme: {
            extend: {
                colors: {
                    brand: {
                        gold: '#B89758',
                        goldLight: '#E8D8B6',
                        goldHover: '#8C6D32',
                        darkNavy: '#111822',
                        sidebar: '#141E28',
                        surface: '#FFFFFF',
                        canvas: '#F8F9FA',
                        border: '#E2E8F0',
                        textMain: '#1E293B',
                        textMuted: '#64748B'
                    }
                },
                fontFamily: {
                    serif: ['"Playfair Display"', 'Georgia', 'serif'],
                    sans: ['"Plus Jakarta Sans"', '-apple-system', 'BlinkMacSystemFont', 'sans-serif']
                }
            }
        }
    }
</script>

<style>
    .bi-page-wrapper {
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #1E293B;
    }

        .bi-page-wrapper .font-serif {
            font-family: 'Playfair Display', serif;
        }

    .card-shadow {
        box-shadow: 0 4px 20px -2px rgba(30, 41, 59, 0.05), 0 2px 6px -1px rgba(30, 41, 59, 0.02);
    }

    .focus-ring:focus-visible {
        outline: 2px solid #B89758;
        outline-offset: 2px;
    }

    .custom-scrollbar::-webkit-scrollbar {
        height: 8px;
        width: 8px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: #F1F5F9;
        border-radius: 4px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #CBD5E1;
        border-radius: 4px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #B89758;
        }

    /* Hiệu ứng cho ma trận */
    .matrix-table {
        border-collapse: separate;
        border-spacing: 0;
    }

        .matrix-table th,
        .matrix-table td {
            border-right: 1px solid rgba(226, 232, 240, 0.7);
            border-bottom: 1px solid rgba(226, 232, 240, 0.7);
        }

        .matrix-table thead th {
            border-color: rgba(51, 65, 85, 0.6);
        }

    .matrix-cell-booking {
        transition: all 0.2s ease;
    }

        .matrix-cell-booking:hover {
            transform: scale(1.02);
            box-shadow: 0 4px 12px -2px rgba(184, 151, 88, 0.25);
        }

    /* Hiệu ứng pulse nhẹ cho badge trạng thái */
    @@keyframes subtlePulse {
        0%, 100%

    {
        opacity: 1;
    }

    50% {
        opacity: 0.85;
    }

    }

    .status-pulse {
        animation: subtlePulse 2.5s ease-in-out infinite;
    }

    /* Custom scrollbar cho bảng ma trận */
    .matrix-scroll-container::-webkit-scrollbar {
        height: 10px;
    }

    .matrix-scroll-container::-webkit-scrollbar-track {
        background: #F1F5F9;
        border-radius: 6px;
        margin: 0 8px;
    }

    .matrix-scroll-container::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, #C5A880, #B89758);
        border-radius: 6px;
        border: 2px solid #F1F5F9;
    }

        .matrix-scroll-container::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(180deg, #B89758, #8C6D32);
        }
</style>

<!-- TOAST THÔNG BÁO TỰ ĐỘNG -->
<div id="biToast" class="fixed top-5 right-5 z-[100000] transform translate-x-full transition-transform duration-300 flex items-center gap-3 bg-white border border-[#E5D5B8] shadow-2xl px-4 py-3 rounded-xl">
    <div class="w-7 h-7 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs">
        <i class="fa-solid fa-circle-check"></i>
    </div>
    <div>
        <p class="text-xs font-bold text-slate-900" id="biToastTitle">Thông báo</p>
        <p class="text-[11px] text-slate-500" id="biToastMsg">Nội dung</p>
    </div>
</div>

<!-- CONTAINER CHÍNH -->
<div class="bi-page-wrapper p-6 lg:p-8 space-y-6 w-full max-w-[1600px] mx-auto">

    <!-- ================= 1. HEADER TRANG ================= -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500 mb-1">
                <span>Quản trị Nghiệp vụ</span>
                <i class="fa-solid fa-chevron-right text-[9px] text-slate-400"></i>
                <span class="text-[#B89758] font-semibold">Báo Cáo Doanh Thu &amp; BI</span>
            </nav>
            <h2 class="font-serif text-2xl font-bold text-slate-900 tracking-tight">
                Phân Tích Doanh Thu &amp; Hiệu Suất Kinh Doanh (BI)
            </h2>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
            <div class="flex items-center bg-slate-50 rounded-lg px-3 py-1.5 border border-slate-200 text-xs shadow-2xs">
                <span class="w-2 h-2 rounded-full bg-emerald-500 mr-2 animate-pulse"></span>
                <span class="text-slate-600 font-medium">CSDL thời gian thực • Niên độ @Model.Year</span>
            </div>

            <button onclick="exportReportExcel()" class="flex items-center gap-2 px-3.5 py-2 bg-slate-50 hover:bg-slate-100 text-slate-700 rounded-lg text-xs font-semibold transition-colors border border-slate-200 focus-ring min-h-[40px] shadow-2xs">
                <i class="fa-solid fa-file-excel text-emerald-600 text-sm"></i>
                <span>Xuất Báo Cáo Excel</span>
            </button>
        </div>
    </div>

    <!-- ================= 2. BỘ LỌC KỲ BÁO CÁO ================= -->
    <section class="bg-white rounded-xl p-4 border border-slate-200 card-shadow flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-3">
            <div class="flex items-center bg-[#FAF8F5] border border-slate-200 rounded-lg px-3 py-1.5 min-h-[40px]">
                <i class="fa-regular fa-calendar text-[#B89758] mr-2 text-xs"></i>
                <label for="selectYear" class="text-xs text-slate-500 mr-1.5 font-medium">Niên độ:</label>
                <select id="selectYear" onchange="onFilterChange()" class="bg-transparent text-xs font-bold text-slate-800 focus:outline-none cursor-pointer">
                    <option value="2026" selected>Năm 2026</option>
                    <option value="2025">Năm 2025</option>
                </select>
            </div>

            <div class="flex items-center bg-[#FAF8F5] border border-slate-200 rounded-lg px-3 py-1.5 min-h-[40px]">
                <i class="fa-solid fa-chart-pie text-[#B89758] mr-2 text-xs"></i>
                <label for="selectQuarter" class="text-xs text-slate-500 mr-1.5 font-medium">Kỳ thống kê:</label>
                <select id="selectQuarter" onchange="onFilterChange()" class="bg-transparent text-xs font-bold text-slate-800 focus:outline-none cursor-pointer">
                    <option value="0" selected>Toàn bộ 4 Quý (12 Tháng)</option>
                    <option value="1">Quý 1 (Tháng 1 – 3)</option>
                    <option value="2">Quý 2 (Tháng 4 – 6)</option>
                    <option value="3">Quý 3 (Tháng 7 – 9)</option>
                    <option value="4">Quý 4 (Tháng 10 – 12)</option>
                </select>
            </div>

            <button onclick="resetBiFilter()" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold border border-slate-200 flex items-center gap-1.5 min-h-[40px] transition-colors">
                <i class="fa-solid fa-arrow-rotate-left text-slate-500 text-[11px]"></i>
                <span>Mặc định</span>
            </button>
        </div>

        <div class="flex items-center gap-2 text-xs text-slate-500">
            <span class="inline-block w-2 h-2 rounded-full bg-[#B89758]"></span>
            <span>Nguồn CSDL: <strong>dbo.DatTiec</strong> &amp; <strong>dbo.SanhTiec</strong></span>
        </div>
    </section>

    <!-- ================= 3. BỘ THẺ KPI ================= -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl p-5 border border-slate-200 card-shadow relative overflow-hidden">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Tổng Doanh Thu</span>
                <div class="w-8 h-8 rounded-lg bg-[#B89758]/15 border border-[#B89758]/30 flex items-center justify-center text-[#8C6D32]">
                    <i class="fa-solid fa-coins text-sm"></i>
                </div>
            </div>
            <div class="mt-3">
                <h3 id="kpiTotalRevenue" class="font-serif text-2xl font-bold text-slate-900">
                    @Model.Kpi.TotalRevenue.ToString("N0") <span class="text-xs font-sans font-normal text-slate-500">VNĐ</span>
                </h3>
                <p class="text-[11px] text-emerald-600 font-semibold mt-1 flex items-center gap-1">
                    <i class="fa-solid fa-arrow-trend-up"></i> Tăng trưởng thực tế theo hợp đồng
                </p>
            </div>
            <div class="absolute -right-2 -bottom-2 w-16 h-16 bg-[#B89758]/5 rounded-full pointer-events-none"></div>
        </div>

        <div class="bg-white rounded-xl p-5 border border-slate-200 card-shadow relative overflow-hidden">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Sự Kiện Tiệc Cưới</span>
                <div class="w-8 h-8 rounded-lg bg-blue-50 border border-blue-200 flex items-center justify-center text-blue-600">
                    <i class="fa-solid fa-bell-concierge text-sm"></i>
                </div>
            </div>
            <div class="mt-3">
                <h3 id="kpiTotalBookings" class="font-serif text-2xl font-bold text-slate-900">
                    @Model.Kpi.TotalBookings <span class="text-xs font-sans font-normal text-slate-500">hợp đồng</span>
                </h3>
                <p class="text-[11px] text-slate-500 mt-1">
                    Tổng quy mô: <strong id="kpiTotalTables">@Model.Kpi.TotalTables</strong> bàn tiệc
                </p>
            </div>
            <div class="absolute -right-2 -bottom-2 w-16 h-16 bg-blue-50/50 rounded-full pointer-events-none"></div>
        </div>

        <div class="bg-white rounded-xl p-5 border border-slate-200 card-shadow relative overflow-hidden">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Doanh Thu / Bàn Tiệc</span>
                <div class="w-8 h-8 rounded-lg bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-600">
                    <i class="fa-solid fa-utensils text-sm"></i>
                </div>
            </div>
            <div class="mt-3">
                <h3 id="kpiAvgPerTable" class="font-serif text-2xl font-bold text-[#8C6D32]">
                    @Model.Kpi.AverageRevenuePerTable.ToString("N0") <span class="text-xs font-sans font-normal text-slate-500">VNĐ</span>
                </h3>
                <p class="text-[11px] text-slate-500 mt-1">
                    Bao gồm Món ăn, Sảnh &amp; Decor
                </p>
            </div>
            <div class="absolute -right-2 -bottom-2 w-16 h-16 bg-amber-50/50 rounded-full pointer-events-none"></div>
        </div>

        <div class="bg-white rounded-xl p-5 border border-slate-200 card-shadow relative overflow-hidden">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Công Suất Khai Thác</span>
                <div class="w-8 h-8 rounded-lg bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-600">
                    <i class="fa-solid fa-chart-line text-sm"></i>
                </div>
            </div>
            <div class="mt-3">
                <h3 id="kpiOccupancy" class="font-serif text-2xl font-bold text-emerald-600">
                    @Model.Kpi.AverageOccupancyRate% <span class="text-xs font-sans font-normal text-slate-500">lấp đầy</span>
                </h3>
                <p class="text-[11px] text-slate-500 mt-1">
                    Bình quân 9 đại sảnh (Ca trưa &amp; tối)
                </p>
            </div>
            <div class="absolute -right-2 -bottom-2 w-16 h-16 bg-emerald-50/50 rounded-full pointer-events-none"></div>
        </div>
    </div>

    <!-- ================= 4. KHU VỰC BIỂU ĐỒ TRỰC QUAN ================= -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <div class="lg:col-span-8 bg-white rounded-xl p-5 border border-slate-200 card-shadow space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-100 pb-3">
                <div>
                    <h3 class="font-serif font-bold text-base text-slate-900">Xu Hướng Doanh Thu Theo Tháng</h3>
                    <p class="text-[11px] text-slate-500">Số liệu lũy kế từ bảng DatTiec theo các tháng trong niên độ</p>
                </div>
                <span class="flex items-center gap-1.5 text-xs text-slate-600">
                    <span class="w-3 h-3 rounded-xs bg-[#B89758]"></span> Doanh thu (Triệu VNĐ)
                </span>
            </div>
            <div class="h-64 sm:h-80 w-full relative">
                <canvas id="monthlyRevenueChart"></canvas>
            </div>
        </div>

        <div class="lg:col-span-4 bg-white rounded-xl p-5 border border-slate-200 card-shadow space-y-4">
            <div class="border-b border-slate-100 pb-3">
                <h3 class="font-serif font-bold text-base text-slate-900">Cơ Cấu Nguồn Thu</h3>
                <p class="text-[11px] text-slate-500">Tỷ trọng đóng góp giữa Ẩm thực, Sảnh &amp; Decor</p>
            </div>
            <div class="h-56 sm:h-64 relative flex items-center justify-center">
                <canvas id="revenueStructureChart"></canvas>
            </div>
            <div id="structureLegend" class="space-y-2 pt-2 border-t border-slate-100 text-xs">
                @foreach (var s in Model.RevenueStructures)
                {
                    <div class="flex items-center justify-between">
                        <span class="flex items-center gap-2 text-slate-600">
                            <span class="w-2.5 h-2.5 rounded-full" style="background-color: @s.ColorHex;"></span>
                            <span>@s.CategoryName</span>
                        </span>
                        <span class="font-bold text-slate-800">@s.Percentage%</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ================= 5. HIỆU SUẤT SẢNH & BẢNG TIỆC GẦN NHẤT ================= -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <div class="lg:col-span-6 bg-white rounded-xl p-5 border border-slate-200 card-shadow space-y-4">
            <div class="border-b border-slate-100 pb-3">
                <h3 class="font-serif font-bold text-base text-slate-900">Hiệu Suất Khai Thác 9 Đại Sảnh</h3>
                <p class="text-[11px] text-slate-500">Xếp hạng doanh thu sảnh thực tế (bảng SanhTiec)</p>
            </div>
            <div class="h-72 sm:h-84 relative">
                <canvas id="hallPerformanceChart"></canvas>
            </div>
        </div>

        <div class="lg:col-span-6 bg-white rounded-xl border border-slate-200 card-shadow flex flex-col justify-between overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                <div>
                    <h3 class="font-serif font-bold text-base text-slate-900">Sự Kiện Tiệc Cưới Gần Nhất</h3>
                    <p class="text-[11px] text-slate-500">Dữ liệu thực tế từ các bản ghi đặt tiệc mới nhất</p>
                </div>
                <span class="px-2.5 py-1 bg-slate-100 text-slate-600 rounded-md text-[11px] font-semibold">@Model.RecentBookings.Count hợp đồng</span>
            </div>

            <div class="overflow-x-auto custom-scrollbar flex-1">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-[#FAF8F5] text-slate-700 border-b border-slate-200 font-semibold uppercase text-[10.5px]">
                            <th class="py-3 px-4">Mã Tiệc</th>
                            <th class="py-3 px-4">Khách Hàng / Sảnh</th>
                            <th class="py-3 px-3 text-center">Ngày Đặt</th>
                            <th class="py-3 px-4 text-right">Tổng Tiền</th>
                            <th class="py-3 px-3 text-center">Trạng Thái</th>
                        </tr>
                    </thead>
                    <tbody id="recentBookingsTbody" class="divide-y divide-slate-100">
                        @foreach (var b in Model.RecentBookings)
                        {
                            <tr class="hover:bg-[#FAF8F5] transition-colors">
                                <td class="py-3 px-4 font-mono font-bold text-slate-800">@b.BookingCode</td>
                                <td class="py-3 px-4">
                                    <p class="font-bold text-slate-900">@b.CustomerName</p>
                                    <p class="text-[11px] text-[#8C6D32]">Sảnh @b.HallName • @b.TableCount bàn</p>
                                </td>
                                <td class="py-3 px-3 text-center">
                                    <span class="font-medium text-slate-700">@b.EventDate.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td class="py-3 px-4 text-right font-serif font-bold text-slate-900">
                                    @b.TotalAmount.ToString("N0") đ
                                </td>
                                <td class="py-3 px-3 text-center">
                                    @if (b.Status == "Hoàn tất")
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10.5px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">Hoàn tất</span>
                                    }
                                    else if (b.Status == "Đã cọc")
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10.5px] font-bold bg-amber-50 text-amber-800 border border-amber-300">Đã cọc</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10.5px] font-bold bg-blue-50 text-blue-700 border border-blue-200">@b.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3 bg-[#FAF8F5] border-t border-slate-100 text-center">
                <button type="button" onclick="openHallMatrixModal()" class="text-xs text-[#8C6D32] hover:text-[#B89758] font-bold inline-flex items-center gap-1.5 transition-colors cursor-pointer">
                    <i class="fa-solid fa-table-cells text-[#B89758]"></i>
                    <span>Xem ma trận lịch sảnh toàn hệ thống &rarr;</span>
                </button>
            </div>
        </div>
    </div>

</div>

<!-- ================= MODAL MA TRẬN LỊCH SẢNH TOÀN HỆ THỐNG (UI NÂNG CẤP) ================= -->
<div id="hallMatrixModal"
     class="fixed inset-0 hidden items-center justify-center bg-slate-950/80 backdrop-blur-sm p-2 sm:p-4 md:p-6 transition-all duration-300"
     style="z-index: 99999; font-family: 'Plus Jakarta Sans', sans-serif;">
    <div class="bg-white w-full h-full sm:h-[95vh] sm:max-w-[1500px] sm:rounded-2xl shadow-2xl flex flex-col border border-[#E5D5B8] overflow-hidden">

        <!-- ============ HEADER MODAL ============ -->
        <header class="shrink-0 bg-gradient-to-r from-[#FAF8F5] via-white to-[#FAF8F5] border-b border-slate-200">
            <!-- Dòng tiêu đề chính -->
            <div class="px-4 sm:px-6 py-4 flex items-center justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#B89758] to-[#8C6D32] flex items-center justify-center text-white shadow-md shrink-0">
                        <i class="fa-solid fa-table-cells-large text-base"></i>
                    </div>
                    <div class="min-w-0">
                        <h3 class="font-serif font-bold text-base sm:text-lg text-slate-900 tracking-tight truncate">
                            Ma Trận Điều Phối Lịch Sảnh Toàn Hệ Thống
                        </h3>
                        <p class="text-[11px] text-slate-500 mt-0.5 flex items-center gap-2 flex-wrap">
                            <span class="inline-flex items-center gap-1">
                                <i class="fa-solid fa-building-columns text-[#B89758] text-[10px]"></i>
                                9 Đại Sảnh Hoàng Gia
                            </span>
                            <span class="text-slate-300">•</span>
                            <span class="inline-flex items-center gap-1">
                                <i class="fa-regular fa-clock text-[#B89758] text-[10px]"></i>
                                Trưa 10:30–14:00 | Tối 17:30–21:30
                            </span>
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                    <button type="button" onclick="loadMatrixDefaultWeek()"
                            class="hidden sm:inline-flex items-center gap-1.5 px-3 py-2 bg-white hover:bg-[#FAF8F5] text-slate-700 rounded-lg text-xs font-semibold border border-slate-200 shadow-2xs transition-colors">
                        <i class="fa-solid fa-wand-magic-sparkles text-[#B89758] text-[11px]"></i>
                        <span>Mùa cưới 2026</span>
                    </button>
                    <button type="button" onclick="closeHallMatrixModal()"
                            class="w-9 h-9 flex items-center justify-center text-slate-400 hover:text-slate-800 hover:bg-slate-200/70 rounded-lg transition-colors cursor-pointer"
                            title="Đóng cửa sổ">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>
            </div>

            <!-- Thanh điều hướng tuần -->
            <div class="px-4 sm:px-6 py-3 border-t border-slate-200/70 bg-white/60 flex items-center justify-between gap-3 flex-wrap">
                <div class="flex items-center gap-2">
                    <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Tuần làm việc:</span>
                    <div class="flex items-center bg-white border border-[#E5D5B8] rounded-lg shadow-2xs overflow-hidden">
                        <button type="button" onclick="changeMatrixWeek(-7)"
                                class="w-9 h-9 flex items-center justify-center text-slate-600 hover:text-[#8C6D32] hover:bg-[#FAF8F5] transition-colors border-r border-slate-200"
                                title="Tuần trước">
                            <i class="fa-solid fa-chevron-left text-xs"></i>
                        </button>
                        <span id="matrixWeekLabel"
                              class="px-4 text-xs font-bold text-slate-800 font-mono tracking-wide text-center min-w-[180px]">
                            Đang đồng bộ...
                        </span>
                        <button type="button" onclick="changeMatrixWeek(7)"
                                class="w-9 h-9 flex items-center justify-center text-slate-600 hover:text-[#8C6D32] hover:bg-[#FAF8F5] transition-colors border-l border-slate-200"
                                title="Tuần sau">
                            <i class="fa-solid fa-chevron-right text-xs"></i>
                        </button>
                    </div>
                </div>

                <div class="flex items-center gap-3 text-[11px]">
                    <div class="hidden md:flex items-center gap-1.5 text-slate-500">
                        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>Dữ liệu trực tiếp từ CSDL</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- ============ BODY: BẢNG MA TRẬN ============ -->
        <div class="flex-1 overflow-auto matrix-scroll-container relative bg-gradient-to-b from-slate-50 to-slate-100/50">

            <!-- Loading Overlay -->
            <div id="matrixLoading"
                 class="absolute inset-0 bg-white/85 backdrop-blur-sm flex items-center justify-center z-30 transition-opacity">
                <div class="flex flex-col items-center gap-3 p-6 rounded-2xl bg-white shadow-xl border border-[#E5D5B8]">
                    <div class="relative">
                        <div class="w-12 h-12 rounded-full border-4 border-[#FAF8F5]"></div>
                        <div class="w-12 h-12 rounded-full border-4 border-t-[#B89758] border-r-transparent border-b-transparent border-l-transparent animate-spin absolute top-0 left-0"></div>
                    </div>
                    <span class="text-xs font-semibold text-slate-700">Đang trích xuất ma trận CSDL...</span>
                    <span class="text-[10px] text-slate-400">Vui lòng chờ trong giây lát</span>
                </div>
            </div>

            <table class="matrix-table w-full text-xs">
                <thead class="sticky top-0 z-20">
                    <tr id="matrixHeaderDays" class="bg-[#1E293B] text-white text-center shadow-md">
                        <th rowspan="2"
                            class="py-3 px-3 font-bold border border-slate-700 sticky left-0 z-30 bg-[#1E293B] min-w-[140px] sm:min-w-[180px] text-left">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-building-columns text-[#B89758] text-xs"></i>
                                <span class="text-[11px] tracking-wide uppercase">Đại Sảnh / Quy Mô</span>
                            </div>
                        </th>
                    </tr>
                    <tr id="matrixHeaderShifts" class="bg-slate-800 text-slate-300 text-[10.5px] text-center">
                    </tr>
                </thead>
                <tbody id="matrixBodyRows" class="divide-y divide-slate-200 bg-white">
                </tbody>
            </table>
        </div>

        <!-- ============ FOOTER: CHÚ THÍCH ============ -->
        <footer class="shrink-0 bg-gradient-to-r from-[#FAF8F5] via-white to-[#FAF8F5] border-t border-slate-200 px-4 sm:px-6 py-4">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                <!-- Legend chips -->
                <div class="flex flex-wrap items-center gap-2">
                    <span class="text-[10.5px] font-bold text-slate-700 uppercase tracking-wider mr-1 flex items-center gap-1.5">
                        <i class="fa-solid fa-circle-info text-[#B89758] text-[11px]"></i>
                        Chú thích trạng thái:
                    </span>

                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-white border border-slate-200 shadow-2xs text-slate-600 font-medium text-[11px]">
                        <span class="w-2.5 h-2.5 rounded-full bg-slate-200 border border-slate-300"></span>
                        <span>Trống</span>
                    </div>

                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-[#B89758]/10 border border-[#B89758]/40 shadow-2xs text-[#8C6D32] font-semibold text-[11px]">
                        <i class="fa-solid fa-calendar-check text-[#B89758] text-[10px]"></i>
                        <span>Đã đặt tiệc</span>
                    </div>

                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-rose-50 border border-rose-200 shadow-2xs text-rose-700 font-semibold text-[11px]">
                        <i class="fa-solid fa-lock text-rose-500 text-[10px]"></i>
                        <span>Tạm khóa</span>
                    </div>

                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-emerald-50 border border-emerald-300 shadow-2xs text-emerald-800 font-semibold text-[11px]">
                        <i class="fa-solid fa-circle-check text-emerald-600 text-[10px]"></i>
                        <span>Hoàn tất</span>
                    </div>
                </div>

                <!-- Nút đóng -->
                <div class="flex items-center justify-end">
                    <button type="button"
                            onclick="closeHallMatrixModal()"
                            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-gradient-to-r from-[#1E293B] to-[#0F172A] hover:from-[#0F172A] hover:to-black active:scale-95 text-white rounded-lg text-xs font-semibold shadow-md transition-all cursor-pointer">
                        <i class="fa-solid fa-xmark text-slate-400 text-xs"></i>
                        <span>Đóng cửa sổ</span>
                    </button>
                </div>
            </div>
        </footer>

    </div>
</div>

@section Scripts {
    <script>
        // Dữ liệu ban đầu nhận từ CSDL qua Razor ViewModel
        let reportData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

        let monthlyChart = null;
        let structureChart = null;
        let hallChart = null;

        document.addEventListener('DOMContentLoaded', () => {
            initCharts(reportData);
        });

        function showBiToast(title, msg) {
            const toast = document.getElementById('biToast');
            document.getElementById('biToastTitle').innerText = title;
            document.getElementById('biToastMsg').innerText = msg;
            toast.classList.remove('translate-x-full');
            setTimeout(() => toast.classList.add('translate-x-full'), 3000);
        }

        function initCharts(data) {
            if (!data) return;

            // 1. Biểu đồ cột: Doanh thu theo tháng
            const monthlyRevenues = data.monthlyRevenues || data.MonthlyRevenues || [];
            const months = monthlyRevenues.map(m => m.monthName || m.MonthName || `Tháng ${m.month || m.Month}`);
            const revenues = monthlyRevenues.map(m => (m.totalRevenue ?? m.TotalRevenue ?? 0) / 1000000);

            const ctxMonthly = document.getElementById('monthlyRevenueChart').getContext('2d');
            if (monthlyChart) monthlyChart.destroy();
            monthlyChart = new Chart(ctxMonthly, {
                type: 'bar',
                data: {
                    labels: months,
                    datasets: [{
                        label: 'Doanh thu (Triệu VNĐ)',
                        data: revenues,
                        backgroundColor: '#B89758',
                        hoverBackgroundColor: '#8C6D32',
                        borderRadius: 6,
                        maxBarThickness: 40
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: (ctx) => `${ctx.parsed.y.toLocaleString('vi-VN')} Triệu VNĐ`
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { callback: (v) => v + ' tr' },
                            grid: { color: '#F1F5F9' }
                        },
                        x: { grid: { display: false } }
                    }
                }
            });

            // 2. Biểu đồ tròn: Cơ cấu doanh thu
            const revenueStructures = data.revenueStructures || data.RevenueStructures || [];
            const labelsStruct = revenueStructures.map(s => s.categoryName || s.CategoryName);
            const valuesStruct = revenueStructures.map(s => s.percentage ?? s.Percentage ?? 0);
            const colorsStruct = revenueStructures.map(s => s.colorHex || s.ColorHex || '#B89758');

            const ctxStructure = document.getElementById('revenueStructureChart').getContext('2d');
            if (structureChart) structureChart.destroy();
            structureChart = new Chart(ctxStructure, {
                type: 'doughnut',
                data: {
                    labels: labelsStruct,
                    datasets: [{
                        data: valuesStruct,
                        backgroundColor: colorsStruct,
                        borderWidth: 2,
                        borderColor: '#FFFFFF'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: (ctx) => ` ${ctx.label}: ${ctx.parsed}%`
                            }
                        }
                    }
                }
            });

            // 3. Biểu đồ ngang: Hiệu suất 9 đại sảnh
            const hallPerformances = data.hallPerformances || data.HallPerformances || [];
            const hallNames = hallPerformances.map(h => h.hallName || h.HallName);
            const hallRevs = hallPerformances.map(h => (h.totalRevenue ?? h.TotalRevenue ?? 0) / 1000000);

            const ctxHall = document.getElementById('hallPerformanceChart').getContext('2d');
            if (hallChart) hallChart.destroy();
            hallChart = new Chart(ctxHall, {
                type: 'bar',
                data: {
                    labels: hallNames,
                    datasets: [{
                        label: 'Doanh thu (Triệu VNĐ)',
                        data: hallRevs,
                        backgroundColor: '#1E293B',
                        hoverBackgroundColor: '#B89758',
                        borderRadius: 4
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: (ctx) => `${ctx.parsed.x.toLocaleString('vi-VN')} Triệu VNĐ`
                            }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: { callback: (v) => v + ' tr' },
                            grid: { color: '#F1F5F9' }
                        },
                        y: { grid: { display: false } }
                    }
                }
            });
        }

        async function onFilterChange() {
            const year = document.getElementById('selectYear').value;
            const quarter = document.getElementById('selectQuarter').value;

            try {
                const res = await fetch(`/AdminReport/GetReportData?year=${year}&quarter=${quarter}`);
                if (!res.ok) {
                    showBiToast('Lỗi máy chủ', `Lỗi HTTP ${res.status}`);
                    return;
                }

                const result = await res.json();

                if (result.success && result.data) {
                    const data = result.data;
                    reportData = data;

                    updateKpiDom(data.kpi || data.Kpi);
                    initCharts(data);
                    renderRecentTable(data.recentBookings || data.RecentBookings);
                    updateStructureLegend(data.revenueStructures || data.RevenueStructures);

                    const quarterText = quarter == 0 ? 'Toàn bộ 4 Quý' : `Quý ${quarter}`;
                    showBiToast('Thành công', `Đã đồng bộ số liệu CSDL: Năm ${year} – ${quarterText}`);
                } else {
                    showBiToast('Thông báo', result.message || 'Không có dữ liệu cho kỳ này.');
                }
            } catch (e) {
                console.error("Lỗi khi lọc báo cáo BI:", e);
                showBiToast('Lỗi', 'Không thể kết nối máy chủ để cập nhật dữ liệu.');
            }
        }

        function resetBiFilter() {
            document.getElementById('selectYear').value = '2026';
            document.getElementById('selectQuarter').value = '0';
            onFilterChange();
        }

        function updateKpiDom(kpi) {
            if (!kpi) return;
            const totalRevenue = kpi.totalRevenue ?? kpi.TotalRevenue ?? 0;
            const totalBookings = kpi.totalBookings ?? kpi.TotalBookings ?? 0;
            const totalTables = kpi.totalTables ?? kpi.TotalTables ?? 0;
            const avgPerTable = kpi.averageRevenuePerTable ?? kpi.AverageRevenuePerTable ?? 0;
            const occupancy = kpi.averageOccupancyRate ?? kpi.AverageOccupancyRate ?? 0;

            document.getElementById('kpiTotalRevenue').innerHTML = `${Number(totalRevenue).toLocaleString('vi-VN')} <span class="text-xs font-sans font-normal text-slate-500">VNĐ</span>`;
            document.getElementById('kpiTotalBookings').innerHTML = `${totalBookings} <span class="text-xs font-sans font-normal text-slate-500">hợp đồng</span>`;
            document.getElementById('kpiTotalTables').innerText = totalTables;
            document.getElementById('kpiAvgPerTable').innerHTML = `${Number(avgPerTable).toLocaleString('vi-VN')} <span class="text-xs font-sans font-normal text-slate-500">VNĐ</span>`;
            document.getElementById('kpiOccupancy').innerHTML = `${occupancy}% <span class="text-xs font-sans font-normal text-slate-500">lấp đầy</span>`;
        }

        function renderRecentTable(bookings) {
            const tbody = document.getElementById('recentBookingsTbody');
            tbody.innerHTML = '';
            const list = bookings || [];

            if (list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-slate-400 italic">Không có sự kiện tiệc trong kỳ này.</td></tr>`;
                return;
            }

            list.forEach(b => {
                const code = b.bookingCode || b.BookingCode || '';
                const custName = b.customerName || b.CustomerName || '';
                const hallName = b.hallName || b.HallName || '';
                const tableCount = b.tableCount ?? b.TableCount ?? 0;
                const totalAmt = b.totalAmount ?? b.TotalAmount ?? 0;
                const status = b.status || b.Status || '';
                const eventDateRaw = b.eventDate || b.EventDate;
                const dateFormatted = eventDateRaw ? new Date(eventDateRaw).toLocaleDateString('vi-VN') : '---';

                let badge = `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10.5px] font-bold bg-blue-50 text-blue-700 border border-blue-200">${status}</span>`;
                if (status === 'Hoàn tất') {
                    badge = `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10.5px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">Hoàn tất</span>`;
                } else if (status === 'Đã cọc') {
                    badge = `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10.5px] font-bold bg-amber-50 text-amber-800 border border-amber-300">Đã cọc</span>`;
                }

                tbody.innerHTML += `
                    <tr class="hover:bg-[#FAF8F5] transition-colors">
                        <td class="py-3 px-4 font-mono font-bold text-slate-800">${code}</td>
                        <td class="py-3 px-4">
                            <p class="font-bold text-slate-900">${custName}</p>
                            <p class="text-[11px] text-[#8C6D32]">Sảnh ${hallName} • ${tableCount} bàn</p>
                        </td>
                        <td class="py-3 px-3 text-center">
                            <span class="font-medium text-slate-700">${dateFormatted}</span>
                        </td>
                        <td class="py-3 px-4 text-right font-serif font-bold text-slate-900">
                            ${Number(totalAmt).toLocaleString('vi-VN')} đ
                        </td>
                        <td class="py-3 px-3 text-center">${badge}</td>
                    </tr>
                `;
            });
        }

        function updateStructureLegend(structures) {
            const legendContainer = document.getElementById('structureLegend');
            if (!legendContainer) return;
            legendContainer.innerHTML = '';
            const list = structures || [];

            list.forEach(s => {
                const name = s.categoryName || s.CategoryName || '';
                const color = s.colorHex || s.ColorHex || '#B89758';
                const pct = s.percentage ?? s.Percentage ?? 0;

                legendContainer.innerHTML += `
                    <div class="flex items-center justify-between">
                        <span class="flex items-center gap-2 text-slate-600">
                            <span class="w-2.5 h-2.5 rounded-full" style="background-color: ${color};"></span>
                            <span>${name}</span>
                        </span>
                        <span class="font-bold text-slate-800">${pct}%</span>
                    </div>
                `;
            });
        }

                // ================= XỬ LÝ XUẤT EXCEL NÂNG CAO (CÓ NHÚNG BIỂU ĐỒ) =================
        async function exportReportExcel() {
            if (!reportData) {
                showBiToast('Lỗi', 'Không có dữ liệu để xuất.');
                return;
            }

            if (typeof ExcelJS === 'undefined') {
                showBiToast('Lỗi', 'Thư viện ExcelJS chưa sẵn sàng. Vui lòng thử lại sau vài giây.');
                return;
            }

            showBiToast('Đang xử lý', 'Đang tạo báo cáo Excel với đầy đủ biểu đồ...');

            try {
                const wb = new ExcelJS.Workbook();
                wb.creator = 'Riverside Palace';
                wb.company = 'Riverside Palace Convention & Wedding Center';
                wb.created = new Date();

                // ============ STYLE CONSTANTS ============
                const COLOR_GOLD = 'FFB89758';
                const COLOR_GOLD_DARK = 'FF8C6D32';
                const COLOR_DARK = 'FF1E293B';
                const COLOR_LIGHT_BG = 'FFFAF8F5';
                const COLOR_GRAY = 'FF64748B';
                const COLOR_BORDER = 'FFE2E8F0';

                const headerFill = { type: 'pattern', pattern: 'solid', fgColor: { argb: COLOR_DARK } };
                const headerFont = { bold: true, color: { argb: 'FFFFFFFF' }, size: 11, name: 'Calibri' };
                const goldFill = { type: 'pattern', pattern: 'solid', fgColor: { argb: COLOR_GOLD } };

                const borderAll = {
                    top: { style: 'thin', color: { argb: COLOR_BORDER } },
                    bottom: { style: 'thin', color: { argb: COLOR_BORDER } },
                    left: { style: 'thin', color: { argb: COLOR_BORDER } },
                    right: { style: 'thin', color: { argb: COLOR_BORDER } }
                };

                const applyHeaderStyle = (row) => {
                    row.eachCell(cell => {
                        cell.fill = headerFill;
                        cell.font = headerFont;
                        cell.alignment = { horizontal: 'center', vertical: 'middle', wrapText: true };
                        cell.border = borderAll;
                    });
                    row.height = 28;
                };

                const applySectionTitle = (sheet, range, text) => {
                    sheet.mergeCells(range);
                    const cell = sheet.getCell(range.split(':')[0]);
                    cell.value = text;
                    cell.font = { bold: true, size: 13, color: { argb: COLOR_DARK }, name: 'Calibri' };
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: COLOR_LIGHT_BG } };
                    cell.alignment = { vertical: 'middle', indent: 1 };
                    sheet.getRow(parseInt(range.match(/\d+/)[0])).height = 26;
                };

                // =====================================================
                // SHEET 1: DASHBOARD VỚI KPI + 3 BIỂU ĐỒ ẢNH
                // =====================================================
                const wsDash = wb.addWorksheet('📊 Dashboard', {
                    properties: { tabColor: { argb: COLOR_GOLD } },
                    views: [{ showGridLines: false }]
                });

                wsDash.columns = [
                    { width: 22 }, { width: 22 }, { width: 6 }, { width: 22 }, { width: 22 }
                ];

                // Title
                wsDash.mergeCells('A1:E1');
                const t1 = wsDash.getCell('A1');
                t1.value = 'BÁO CÁO DOANH THU & HIỆU SUẤT KINH DOANH (BI)';
                t1.font = { bold: true, size: 18, color: { argb: COLOR_GOLD_DARK }, name: 'Calibri' };
                t1.alignment = { horizontal: 'center', vertical: 'middle' };
                wsDash.getRow(1).height = 38;

                wsDash.mergeCells('A2:E2');
                const t2 = wsDash.getCell('A2');
                t2.value = `Riverside Palace Convention & Wedding Center • Niên độ ${new Date().getFullYear()}`;
                t2.font = { size: 10, italic: true, color: { argb: COLOR_GRAY } };
                t2.alignment = { horizontal: 'center' };
                wsDash.getRow(2).height = 20;

                // KPI Section
                applySectionTitle(wsDash, 'A4:E4', '💰  CHỈ SỐ KPI TỔNG QUAN');

                const kpi = reportData.kpi || reportData.Kpi;
                const kpiRows = [
                    ['Tổng doanh thu', (kpi.totalRevenue || kpi.TotalRevenue || 0), 'VNĐ'],
                    ['Tổng số hợp đồng', (kpi.totalBookings || kpi.TotalBookings || 0), 'hợp đồng'],
                    ['Tổng số bàn tiệc', (kpi.totalTables || kpi.TotalTables || 0), 'bàn'],
                    ['Doanh thu / Bàn', (kpi.averageRevenuePerTable || kpi.AverageRevenuePerTable || 0), 'VNĐ'],
                    ['Công suất lấp đầy', (kpi.averageOccupancyRate || kpi.AverageOccupancyRate || 0), '%']
                ];

                kpiRows.forEach((row, idx) => {
                    const r = 5 + idx;
                    wsDash.getCell(`A${r}`).value = row[0];
                    wsDash.getCell(`A${r}`).font = { bold: true, size: 11, color: { argb: 'FF475569' } };
                    wsDash.getCell(`A${r}`).alignment = { vertical: 'middle', indent: 1 };
                    wsDash.getCell(`A${r}`).fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: COLOR_LIGHT_BG } };
                    wsDash.getCell(`A${r}`).border = borderAll;

                    wsDash.mergeCells(`B${r}:E${r}`);
                    const valueCell = wsDash.getCell(`B${r}`);
                    if (row[2] === 'VNĐ' || row[2] === '%') {
                        valueCell.value = Number(row[1]);
                        valueCell.numFmt = row[2] === 'VNĐ' ? '#,##0 "VNĐ"' : '#,##0.0"%"';
                    } else {
                        valueCell.value = `${row[1]} ${row[2]}`;
                    }
                    valueCell.font = { bold: true, size: 13, color: { argb: COLOR_GOLD_DARK } };
                    valueCell.alignment = { vertical: 'middle', indent: 1 };
                    valueCell.border = borderAll;
                    wsDash.getRow(r).height = 24;
                });

                let currentRow = 12;

                // CHART 1: Monthly Revenue
                if (monthlyChart) {
                    applySectionTitle(wsDash, `A${currentRow}:E${currentRow}`, '📈  XU HƯỚNG DOANH THU THEO THÁNG');
                    currentRow++;

                    const imgBase64 = monthlyChart.toBase64Image('image/png', 1);
                    const imgId = wb.addImage({ base64: imgBase64, extension: 'png' });
                    wsDash.addImage(imgId, {
                        tl: { col: 0.1, row: currentRow - 1 },
                        ext: { width: 720, height: 340 },
                        editAs: 'oneCell'
                    });
                    currentRow += 18;
                }

                // CHART 2 + 3: Structure & Hall Performance (Side by side)
                if (structureChart || hallChart) {
                    applySectionTitle(wsDash, `A${currentRow}:E${currentRow}`, '📊  CƠ CẤU NGUỒN THU & HIỆU SUẤT ĐẠI SẢNH');
                    currentRow++;

                    if (structureChart) {
                        const imgBase64 = structureChart.toBase64Image('image/png', 1);
                        const imgId = wb.addImage({ base64: imgBase64, extension: 'png' });
                        wsDash.addImage(imgId, {
                            tl: { col: 0.1, row: currentRow - 1 },
                            ext: { width: 380, height: 320 },
                            editAs: 'oneCell'
                        });
                    }

                    if (hallChart) {
                        const imgBase64 = hallChart.toBase64Image('image/png', 1);
                        const imgId = wb.addImage({ base64: imgBase64, extension: 'png' });
                        wsDash.addImage(imgId, {
                            tl: { col: 2.7, row: currentRow - 1 },
                            ext: { width: 420, height: 320 },
                            editAs: 'oneCell'
                        });
                    }
                    currentRow += 17;
                }

                // Footer
                wsDash.mergeCells(`A${currentRow + 1}:E${currentRow + 1}`);
                const footerCell = wsDash.getCell(`A${currentRow + 1}`);
                footerCell.value = `© ${new Date().getFullYear()} Riverside Palace • Báo cáo xuất tự động từ hệ thống BI`;
                footerCell.font = { size: 9, italic: true, color: { argb: COLOR_GRAY } };
                footerCell.alignment = { horizontal: 'center' };

                // =====================================================
                // SHEET 2: DOANH THU THEO THÁNG
                // =====================================================
                const wsMonthly = wb.addWorksheet('📈 DoanhThu_Thang', {
                    properties: { tabColor: { argb: 'FF3B82F6' } }
                });
                wsMonthly.columns = [
                    { header: 'Tháng', key: 'month', width: 20 },
                    { header: 'Doanh thu (VNĐ)', key: 'revenue', width: 25 },
                    { header: 'Tỷ trọng (%)', key: 'percent', width: 15 }
                ];
                applyHeaderStyle(wsMonthly.getRow(1));

                const monthlyList = reportData.monthlyRevenues || reportData.MonthlyRevenues || [];
                const totalMonthly = monthlyList.reduce((s, m) => s + (m.totalRevenue || m.TotalRevenue || 0), 0);

                monthlyList.forEach(m => {
                    const rev = m.totalRevenue || m.TotalRevenue || 0;
                    const pct = totalMonthly > 0 ? (rev / totalMonthly * 100) : 0;
                    const row = wsMonthly.addRow({
                        month: m.monthName || m.MonthName,
                        revenue: rev,
                        percent: pct
                    });
                    row.getCell('month').alignment = { horizontal: 'center', vertical: 'middle' };
                    row.getCell('revenue').numFmt = '#,##0 "VNĐ"';
                    row.getCell('revenue').alignment = { horizontal: 'right', vertical: 'middle' };
                    row.getCell('percent').numFmt = '0.00"%"';
                    row.getCell('percent').alignment = { horizontal: 'center', vertical: 'middle' };
                    row.eachCell(c => c.border = borderAll);
                    row.height = 22;
                });

                // Total row
                const totalRow = wsMonthly.addRow({
                    month: 'TỔNG CỘNG',
                    revenue: totalMonthly,
                    percent: 100
                });
                totalRow.font = { bold: true, color: { argb: 'FFFFFFFF' } };
                totalRow.getCell('month').fill = goldFill;
                totalRow.getCell('revenue').fill = goldFill;
                totalRow.getCell('percent').fill = goldFill;
                totalRow.getCell('month').alignment = { horizontal: 'center', vertical: 'middle' };
                totalRow.getCell('revenue').numFmt = '#,##0 "VNĐ"';
                totalRow.getCell('revenue').alignment = { horizontal: 'right', vertical: 'middle' };
                totalRow.getCell('percent').alignment = { horizontal: 'center', vertical: 'middle' };
                totalRow.eachCell(c => c.border = borderAll);
                totalRow.height = 24;

                // =====================================================
                // SHEET 3: CƠ CẤU NGUỒN THU
                // =====================================================
                const wsStructure = wb.addWorksheet('🥧 CoCau_NguonThu', {
                    properties: { tabColor: { argb: 'FF10B981' } }
                });
                wsStructure.columns = [
                    { header: 'Hạng mục', key: 'name', width: 32 },
                    { header: 'Tỷ trọng (%)', key: 'pct', width: 20 },
                    { header: 'Màu đại diện', key: 'color', width: 18 }
                ];
                applyHeaderStyle(wsStructure.getRow(1));

                const structList = reportData.revenueStructures || reportData.RevenueStructures || [];
                structList.forEach(s => {
                    const row = wsStructure.addRow({
                        name: s.categoryName || s.CategoryName,
                        pct: s.percentage || s.Percentage || 0,
                        color: s.colorHex || s.ColorHex || ''
                    });
                    row.getCell('name').alignment = { vertical: 'middle', indent: 1 };
                    row.getCell('pct').numFmt = '0.0"%"';
                    row.getCell('pct').alignment = { horizontal: 'center', vertical: 'middle' };
                    row.getCell('color').alignment = { horizontal: 'center', vertical: 'middle' };
                    row.getCell('color').font = { color: { argb: (s.colorHex || s.ColorHex || '#000').replace('#', 'FF') }, bold: true };
                    row.eachCell(c => c.border = borderAll);
                    row.height = 22;
                });

                // =====================================================
                // SHEET 4: HIỆU SUẤT ĐẠI SẢNH
                // =====================================================
                const wsHall = wb.addWorksheet('🏛 HieuSuat_Sanh', {
                    properties: { tabColor: { argb: 'FF8B5CF6' } }
                });
                wsHall.columns = [
                    { header: 'STT', key: 'stt', width: 8 },
                    { header: 'Đại sảnh', key: 'name', width: 28 },
                    { header: 'Doanh thu (VNĐ)', key: 'revenue', width: 25 },
                    { header: 'Xếp hạng', key: 'rank', width: 14 }
                ];
                applyHeaderStyle(wsHall.getRow(1));

                const hallList = (reportData.hallPerformances || reportData.HallPerformances || [])
                    .slice()
                    .sort((a, b) => (b.totalRevenue || b.TotalRevenue || 0) - (a.totalRevenue || a.TotalRevenue || 0));

                hallList.forEach((h, i) => {
                    const row = wsHall.addRow({
                        stt: i + 1,
                        name: h.hallName || h.HallName,
                        revenue: h.totalRevenue || h.TotalRevenue || 0,
                        rank: i === 0 ? '🥇 Top 1' : (i === 1 ? '🥈 Top 2' : (i === 2 ? '🥉 Top 3' : ''))
                    });
                    row.getCell('stt').alignment = { horizontal: 'center', vertical: 'middle' };
                    row.getCell('name').alignment = { vertical: 'middle', indent: 1 };
                    row.getCell('name').font = { bold: true, color: { argb: COLOR_GOLD_DARK } };
                    row.getCell('revenue').numFmt = '#,##0 "VNĐ"';
                    row.getCell('revenue').alignment = { horizontal: 'right', vertical: 'middle' };
                    row.getCell('rank').alignment = { horizontal: 'center', vertical: 'middle' };
                    if (i === 0) row.getCell('rank').fill = goldFill;
                    row.eachCell(c => c.border = borderAll);
                    row.height = 22;
                });

                // =====================================================
                // SHEET 5: TIỆC GẦN NHẤT
                // =====================================================
                const wsRecent = wb.addWorksheet('📅 Tiec_GanNhat', {
                    properties: { tabColor: { argb: 'FFF59E0B' } }
                });
                wsRecent.columns = [
                    { header: 'Mã tiệc', key: 'code', width: 18 },
                    { header: 'Khách hàng', key: 'customer', width: 28 },
                    { header: 'Sảnh', key: 'hall', width: 18 },
                    { header: 'Số bàn', key: 'tables', width: 12 },
                    { header: 'Ngày đặt', key: 'date', width: 16 },
                    { header: 'Tổng tiền (VNĐ)', key: 'total', width: 22 },
                    { header: 'Trạng thái', key: 'status', width: 16 }
                ];
                applyHeaderStyle(wsRecent.getRow(1));

                const recentList = reportData.recentBookings || reportData.RecentBookings || [];
                recentList.forEach(b => {
                    const eventDateRaw = b.eventDate || b.EventDate;
                    const dateFormatted = eventDateRaw ? new Date(eventDateRaw).toLocaleDateString('vi-VN') : '';
                    const row = wsRecent.addRow({
                        code: b.bookingCode || b.BookingCode,
                        customer: b.customerName || b.CustomerName,
                        hall: b.hallName || b.HallName,
                        tables: b.tableCount || b.TableCount || 0,
                        date: dateFormatted,
                        total: b.totalAmount || b.TotalAmount || 0,
                        status: b.status || b.Status
                    });
                    row.getCell('code').font = { bold: true, color: { argb: COLOR_GOLD_DARK } };
                    row.getCell('code').alignment = { horizontal: 'center', vertical: 'middle' };
                    row.getCell('customer').alignment = { vertical: 'middle', indent: 1 };
                    row.getCell('hall').alignment = { horizontal: 'center', vertical: 'middle' };
                    row.getCell('tables').alignment = { horizontal: 'center', vertical: 'middle' };
                    row.getCell('date').alignment = { horizontal: 'center', vertical: 'middle' };
                    row.getCell('total').numFmt = '#,##0 "đ"';
                    row.getCell('total').alignment = { horizontal: 'right', vertical: 'middle' };
                    row.getCell('status').alignment = { horizontal: 'center', vertical: 'middle' };

                    // Status color
                    const status = b.status || b.Status;
                    if (status === 'Hoàn tất') {
                        row.getCell('status').fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD1FAE5' } };
                        row.getCell('status').font = { bold: true, color: { argb: 'FF047857' } };
                    } else if (status === 'Đã cọc') {
                        row.getCell('status').fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFEF3C7' } };
                        row.getCell('status').font = { bold: true, color: { argb: 'FF92400E' } };
                    } else {
                        row.getCell('status').fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFDBEAFE' } };
                        row.getCell('status').font = { bold: true, color: { argb: 'FF1E40AF' } };
                    }
                    row.eachCell(c => c.border = borderAll);
                    row.height = 24;
                });

                // =====================================================
                // XUẤT FILE
                // =====================================================
                const buffer = await wb.xlsx.writeBuffer();
                const blob = new Blob([buffer], {
                    type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `Riverside_BaoCao_BI_${new Date().getFullYear()}_Full.xlsx`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);

                showBiToast('Thành công', 'Đã xuất báo cáo Excel với đầy đủ biểu đồ và dữ liệu!');
            } catch (err) {
                console.error('Lỗi xuất Excel:', err);
                showBiToast('Lỗi', 'Không thể xuất file Excel: ' + err.message);
            }
        }

        // ================= XỬ LÝ MA TRẬN LỊCH SẢNH (THOÁT STACKING CONTEXT & CHUẨN HÓA DỮ LIỆU) =================
        let currentMatrixStartDate = new Date(2026, 0, 12); // Thứ Hai, 12/01/2026

        function openHallMatrixModal() {
            const modal = document.getElementById('hallMatrixModal');

            // ĐƯA MODAL RA TRỰC TIẾP THẺ BODY ĐỂ THOÁT KHỎI BỊ SIDEBAR CHE KHUẤT
            if (modal.parentElement !== document.body) {
                document.body.appendChild(modal);
            }

            modal.classList.remove('hidden');
            modal.classList.add('flex'); // Đảm bảo flexbox hoạt động
            document.body.style.overflow = 'hidden'; // Khóa cuộn trang nền khi mở modal
            loadHallMatrixData(currentMatrixStartDate);
        }

        function closeHallMatrixModal() {
            const modal = document.getElementById('hallMatrixModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = ''; // Trả lại thanh cuộn cho trang
        }

        function changeMatrixWeek(offsetDays) {
            currentMatrixStartDate.setDate(currentMatrixStartDate.getDate() + offsetDays);
            loadHallMatrixData(currentMatrixStartDate);
        }

        function loadMatrixDefaultWeek() {
            currentMatrixStartDate = new Date(2026, 0, 12);
            loadHallMatrixData(currentMatrixStartDate);
        }

        // Format ngày chuẩn YYYY-MM-DD theo giờ địa phương, không bị lệch múi giờ
        function formatDateToYMD(d) {
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        async function loadHallMatrixData(targetDate) {
            const loading = document.getElementById('matrixLoading');
            if (loading) loading.classList.remove('hidden');

            const dateStr = formatDateToYMD(targetDate);
            try {
                const res = await fetch(`/AdminReport/GetHallMatrix?startDate=${dateStr}`);
                const result = await res.json();

                if (result.success && result.data) {
                    renderHallMatrixTable(result.data);
                } else {
                    showBiToast('Thông báo', result.message || 'Chưa có lịch sảnh cho tuần này.');
                }
            } catch (err) {
                console.error("Lỗi render ma trận:", err);
                showBiToast('Lỗi', 'Không thể kết nối máy chủ để lấy dữ liệu.');
            } finally {
                if (loading) loading.classList.add('hidden');
            }
        }

        function renderHallMatrixTable(matrixData) {
            // HỖ TRỢ AN TOÀN CẢ camelCase LẪN PascalCase TỪ API
            const startDateRaw = matrixData.startDate || matrixData.StartDate;
            const endDateRaw = matrixData.endDate || matrixData.EndDate;
            const days = matrixData.days || matrixData.Days || [];
            const halls = matrixData.halls || matrixData.Halls || [];

            // 1. Hiển thị nhãn tuần
            if (startDateRaw && endDateRaw) {
                const startFormatted = new Date(startDateRaw).toLocaleDateString('vi-VN');
                const endFormatted = new Date(endDateRaw).toLocaleDateString('vi-VN');
                document.getElementById('matrixWeekLabel').innerText = `${startFormatted} – ${endFormatted}`;
            }

            // 2. Render Header 7 Ngày
            const headerDays = document.getElementById('matrixHeaderDays');
            headerDays.innerHTML = `
                <th rowspan="2" class="py-3 px-3 font-bold border border-slate-700 sticky left-0 z-30 bg-[#1E293B] min-w-[140px] sm:min-w-[180px] text-left">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-building-columns text-[#B89758] text-xs"></i>
                        <span class="text-[11px] tracking-wide uppercase">Đại Sảnh / Quy Mô</span>
                    </div>
                </th>
            `;

            const headerShifts = document.getElementById('matrixHeaderShifts');
            headerShifts.innerHTML = '';

            days.forEach(d => {
                const dayName = d.dayOfWeekName || d.DayOfWeekName || '';
                const fDate = d.formattedDate || d.FormattedDate || '';
                const isWeekend = d.isWeekend ?? d.IsWeekend ?? false;
                const weekendClass = isWeekend ? 'bg-gradient-to-b from-[#2A374A] to-[#1E293B] text-amber-300' : '';

                headerDays.innerHTML += `
                    <th colspan="2" class="py-2.5 px-3 border border-slate-700 font-bold ${weekendClass} relative">
                        <div class="flex flex-col items-center gap-0.5">
                            <span class="text-[12px] tracking-wide">${dayName}</span>
                            <span class="text-[10px] font-normal opacity-75 tracking-wider">${fDate}</span>
                        </div>
                    </th>
                `;

                headerShifts.innerHTML += `
                    <th class="py-2 px-2 border border-slate-700 min-w-[90px] sm:min-w-[100px] text-[10.5px] tracking-wider">
                        <i class="fa-regular fa-sun text-amber-400 mr-1 text-[10px]"></i>Trưa
                    </th>
                    <th class="py-2 px-2 border border-slate-700 min-w-[90px] sm:min-w-[100px] text-[10.5px] tracking-wider">
                        <i class="fa-regular fa-moon text-indigo-300 mr-1 text-[10px]"></i>Tối
                    </th>
                `;
            });

            // 3. Render từng hàng 9 Đại Sảnh
            const tbody = document.getElementById('matrixBodyRows');
            tbody.innerHTML = '';

            if (halls.length === 0) {
                tbody.innerHTML = `<tr><td colspan="${1 + days.length * 2}" class="py-8 text-center text-slate-400 italic">Không tìm thấy dữ liệu đại sảnh.</td></tr>`;
                return;
            }

            halls.forEach(hall => {
                const hallName = hall.hallName || hall.HallName || '';
                const hallCode = hall.hallCode || hall.HallCode || '';
                const capacity = hall.capacity ?? hall.Capacity ?? 0;
                const slots = hall.slots || hall.Slots || [];

                let rowHtml = `
                    <tr class="hover:bg-[#FAF8F5]/70 transition-colors group">
                        <td class="py-3 px-3 sm:px-4 font-semibold text-slate-900 border border-slate-200 sticky left-0 z-10 bg-white shadow-[3px_0_8px_-3px_rgba(0,0,0,0.08)] group-hover:bg-[#FAF8F5] transition-colors">
                            <div class="flex items-center gap-2">
                                <div class="w-7 h-7 rounded-md bg-gradient-to-br from-[#B89758]/20 to-[#8C6D32]/10 border border-[#B89758]/30 flex items-center justify-center shrink-0">
                                    <i class="fa-solid fa-hotel text-[#B89758] text-[10px]"></i>
                                </div>
                                <div class="min-w-0">
                                    <div class="font-bold text-[13px] text-[#8C6D32] truncate">${hallName}</div>
                                    <div class="text-[10px] text-slate-500 font-normal flex items-center gap-1">
                                        <span class="font-mono">${hallCode}</span>
                                        <span class="text-slate-300">•</span>
                                        <span>Max ${capacity} bàn</span>
                                    </div>
                                </div>
                            </div>
                        </td>
                `;

                slots.forEach(slot => {
                    const statusId = slot.statusId ?? slot.StatusId ?? 401;
                    const bookingCode = slot.bookingCode || slot.BookingCode;
                    const customerName = slot.customerName || slot.CustomerName || '';
                    const tableCount = slot.tableCount ?? slot.TableCount ?? 0;
                    const bookingStatus = slot.bookingStatus || slot.BookingStatus || '';

                    if (statusId === 402 && bookingCode) {
                        const isCompleted = bookingStatus === 'Hoàn tất';
                        const accentColor = isCompleted ? 'emerald' : 'amber';
                        const badgeBg = isCompleted
                            ? 'bg-emerald-50 text-emerald-700 border-emerald-300'
                            : 'bg-amber-50 text-amber-800 border-amber-300';
                        const dotClass = isCompleted ? 'bg-emerald-500' : 'bg-amber-500';

                        rowHtml += `
                            <td class="p-1.5 border border-slate-200 text-center bg-${accentColor}-50/20 align-middle">
                                <div class="matrix-cell-booking p-2 rounded-lg bg-white border border-[#B89758]/40 shadow-2xs cursor-default">
                                    <div class="flex items-center justify-center gap-1 mb-0.5">
                                        <span class="w-1.5 h-1.5 rounded-full ${dotClass}"></span>
                                        <span class="font-mono font-bold text-[10.5px] text-[#8C6D32] tracking-tight">${bookingCode}</span>
                                    </div>
                                    <span class="text-[10.5px] text-slate-800 font-semibold block truncate max-w-[90px] sm:max-w-[110px] mx-auto" title="${customerName}">${customerName}</span>
                                    <div class="flex items-center justify-center gap-1 mt-1">
                                        <span class="inline-flex items-center gap-0.5 text-[9px] text-slate-500">
                                            <i class="fa-solid fa-chair text-[8px]"></i>
                                            ${tableCount} bàn
                                        </span>
                                        <span class="inline-block px-1.5 py-0.5 rounded text-[8.5px] font-bold border ${badgeBg}">${bookingStatus}</span>
                                    </div>
                                </div>
                            </td>
                        `;
                    } else if (statusId === 403) {
                        rowHtml += `
                            <td class="p-1.5 border border-slate-200 text-center bg-rose-50/40 align-middle">
                                <div class="flex flex-col items-center justify-center gap-1 py-2">
                                    <div class="w-7 h-7 rounded-full bg-rose-100 border border-rose-200 flex items-center justify-center">
                                        <i class="fa-solid fa-lock text-rose-500 text-[11px]"></i>
                                    </div>
                                    <span class="text-[9.5px] text-rose-600 font-bold italic tracking-wide">Tạm khóa</span>
                                </div>
                            </td>
                        `;
                    } else {
                        rowHtml += `
                            <td class="p-1.5 border border-slate-200 text-center bg-slate-50/40 hover:bg-emerald-50/30 transition-colors align-middle group/cell cursor-default">
                                <div class="flex flex-col items-center justify-center gap-1 py-2 opacity-60 group-hover/cell:opacity-100 transition-opacity">
                                    <i class="fa-regular fa-circle text-slate-300 text-[13px] group-hover/cell:text-emerald-400 transition-colors"></i>
                                    <span class="text-[9.5px] text-slate-400 font-medium tracking-wide">Trống</span>
                                </div>
                            </td>
                        `;
                    }
                });

                rowHtml += `</tr>`;
                tbody.innerHTML += rowHtml;
            });
        }
    </script>
}
