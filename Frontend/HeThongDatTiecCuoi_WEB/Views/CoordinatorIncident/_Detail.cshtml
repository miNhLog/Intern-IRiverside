@model HeThongDatTiecCuoi_WEB.Models.Incident.IncidentDetailViewModel
@{ string statusClass = Model.StatusCode == "RESOLVED" ? "resolved" : Model.StatusCode == "PROCESSING" ? "processing" : "pending"; string severityClass = Model.Severity == "Nghiêm trọng" ? "critical" : Model.Severity == "Thấp" ? "low" : "normal"; }
<article class="incident-detail" data-booking-id="@Model.BookingId" data-type="@Model.IncidentType" data-severity="@Model.Severity" data-occurred="@Model.OccurredAt.ToString("yyyy-MM-ddTHH:mm")" data-description="@Model.Description">
    <header><div><span class="modal-icon"><i class="fa-solid fa-triangle-exclamation"></i></span><div><small>SỰ CỐ #@Model.IncidentId</small><h2>@Model.IncidentType</h2></div></div><button type="button" class="modal-close" data-close-detail aria-label="Đóng chi tiết sự cố"><i class="fa-solid fa-xmark"></i></button></header>
    <div class="detail-status-line"><span class="status-badge @statusClass">@Model.StatusName</span><span class="severity-badge @severityClass"><i></i>@Model.Severity</span></div>
    <section class="detail-summary"><div><small>Mã tiệc</small><strong>@Model.BookingCode</strong></div><div><small>Sảnh</small><strong>@Model.HallName</strong></div><div><small>Ngày / ca</small><strong>@Model.EventDate.ToString("dd/MM/yyyy") · @Model.Shift</strong></div><div><small>Phát sinh</small><strong>@Model.OccurredAt.ToString("dd/MM/yyyy HH:mm")</strong></div></section>
    <section class="detail-section"><h3><i class="fa-regular fa-file-lines"></i>Nội dung báo cáo</h3><p>@Model.Description</p><div class="reporter"><span><i class="fa-regular fa-user"></i></span><div><small>Người báo cáo</small><strong>@Model.ReporterName</strong><em>@Model.ReporterCode</em></div></div></section>
    <section class="detail-section resolution"><h3><i class="fa-solid fa-screwdriver-wrench"></i>Hướng giải quyết</h3>@if(string.IsNullOrWhiteSpace(Model.Resolution)){<div class="resolution-empty"><i class="fa-regular fa-clock"></i><p>Chưa có hướng giải quyết</p><span>Bộ phận quản lý sẽ cập nhật khi tiếp nhận sự cố.</span></div>}else{<p>@Model.Resolution</p>@if(Model.ResolvedAt.HasValue){<small class="resolved-time"><i class="fa-solid fa-circle-check"></i> Hoàn tất lúc @Model.ResolvedAt.Value.ToString("dd/MM/yyyy HH:mm")</small>}}</section>
    <footer><button type="button" class="modal-secondary" data-close-detail>Đóng</button>@if(Model.CanEdit){<button type="button" class="incident-primary js-edit-from-detail" data-id="@Model.IncidentId"><i class="fa-regular fa-pen-to-square"></i><span>Chỉnh sửa báo cáo</span></button>}</footer>
</article>
