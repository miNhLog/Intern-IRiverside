@model HeThongDatTiecCuoi_WEB.Models.AdminAccount.AuditLogPageViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Nhật ký hệ thống";
    var actions = new Dictionary<string, string>
    {
        ["CREATE_ACCOUNT"] = "Cấp tài khoản",
        ["UPDATE_ACCOUNT"] = "Cập nhật tài khoản",
        ["LOCK_ACCOUNT"] = "Khóa tài khoản",
        ["UNLOCK_ACCOUNT"] = "Mở khóa tài khoản",
        ["CHANGE_ROLE"] = "Thay đổi vai trò",
        ["RESET_PASSWORD"] = "Đặt lại mật khẩu",
        ["ROLE_CHANGE_REQUESTED"] = "Gửi yêu cầu thay đổi vai trò",
        ["ROLE_CHANGE_APPROVED"] = "Duyệt thay đổi vai trò",
        ["ROLE_CHANGE_REJECTED"] = "Từ chối thay đổi vai trò",
        ["FIRST_PASSWORD_CHANGED"] = "Hoàn tất đổi mật khẩu lần đầu",
        ["ADMIN_PASSWORD_CHANGED"] = "Đổi mật khẩu quản trị viên"
    };
    string Label(string action) => actions.GetValueOrDefault(action, action);
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Keyword)
        || !string.IsNullOrWhiteSpace(Model.Action)
        || Model.FromDate.HasValue
        || Model.ToDate.HasValue;
    var firstItem = Model.TotalItems == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
    var lastItem = Math.Min(Model.Page * Model.PageSize, Model.TotalItems);
}

<link rel="stylesheet" href="~/css/admin-audit-log.css" asp-append-version="true" />

<section class="audit-page">
    <header class="audit-page-header">
        <div class="breadcrumb">Quản trị hệ thống <span>›</span> <strong>Nhật ký hệ thống</strong></div>
        <h1>Nhật ký hệ thống</h1>
        <p>Theo dõi các thao tác quản trị tài khoản, phân quyền và bảo mật hệ thống.</p>
    </header>

    <form method="get" class="audit-toolbar" id="auditFilterForm">
        <label class="audit-field audit-search">
            <span class="audit-field-label">Tìm kiếm</span>
            <span class="audit-input-wrap">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input type="search" name="keyword" value="@Model.Keyword" maxlength="200" placeholder="Người thực hiện, tài khoản, nội dung..." />
            </span>
        </label>

        <label class="audit-field">
            <span class="audit-field-label">Thao tác</span>
            <select name="auditAction">
                <option value="">Tất cả thao tác</option>
                @foreach (var item in actions)
                {
                    <option value="@item.Key" selected="@(Model.Action == item.Key)">@item.Value</option>
                }
            </select>
        </label>

        <label class="audit-field audit-date-field">
            <span class="audit-field-label">Từ ngày</span>
            <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
        </label>

        <label class="audit-field audit-date-field">
            <span class="audit-field-label">Đến ngày</span>
            <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
        </label>

        <label class="audit-field audit-page-size-field">
            <span class="audit-field-label">Hiển thị</span>
            <select name="pageSize">
                <option value="10" selected="@(Model.PageSize == 10)">10 dòng</option>
                <option value="20" selected="@(Model.PageSize == 20)">20 dòng</option>
                <option value="50" selected="@(Model.PageSize == 50)">50 dòng</option>
            </select>
        </label>

        <div class="audit-toolbar-actions">
            <button type="submit" class="audit-filter-button"><i class="fa-solid fa-filter" aria-hidden="true"></i>Lọc</button>
            @if (hasFilters)
            {
                <a asp-action="Index" asp-route-pageSize="@Model.PageSize" class="audit-reset-button"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i>Đặt lại</a>
            }
        </div>
    </form>

    <div class="audit-filter-error" id="auditFilterError" role="alert" hidden></div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="audit-error" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><span>@Model.ErrorMessage</span></div>
    }

    <section class="audit-card" aria-labelledby="auditTableTitle">
        <div class="audit-card-heading">
            <div><h2 id="auditTableTitle">Lịch sử thao tác</h2><span>@Model.TotalItems nhật ký được tìm thấy</span></div>
            @if (Model.TotalItems > 0)
            {
                <span>Hiển thị @firstItem–@lastItem / @Model.TotalItems</span>
            }
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="audit-empty">
                <span class="audit-empty-icon"><i class="fa-regular fa-clock" aria-hidden="true"></i></span>
                <strong>@(hasFilters ? "Không tìm thấy nhật ký phù hợp" : "Chưa có nhật ký hệ thống")</strong>
                <span>@(hasFilters ? "Hãy thay đổi điều kiện lọc để xem kết quả khác." : "Các thao tác quản trị tài khoản và phân quyền sẽ được hiển thị tại đây.")</span>
            </div>
        }
        else
        {
            <div class="audit-table-wrap">
                <table class="audit-table">
                    <thead><tr><th scope="col">Thời gian</th><th scope="col">Người thực hiện</th><th scope="col">Thao tác</th><th scope="col">Đối tượng</th><th scope="col">Nội dung</th></tr></thead>
                    <tbody>
                    @foreach (var log in Model.Items)
                    {
                        <tr>
                            <td class="audit-time"><strong>@log.Timestamp.ToString("dd/MM/yyyy")</strong><small>@log.Timestamp.ToString("HH:mm:ss")</small></td>
                            <td class="audit-actor"><i class="fa-regular fa-user" aria-hidden="true"></i><span><strong>@log.ActorName</strong>@if (!string.IsNullOrWhiteSpace(log.ActorEmail)){<small>@log.ActorEmail</small>}</span></td>
                            <td><span class="audit-action action-@log.Action.ToLowerInvariant()">@Label(log.Action)</span></td>
                            <td class="audit-target"><strong>@log.Target</strong></td>
                            <td class="audit-detail">
                                <span>@(log.Notes ?? "Không có ghi chú")</span>
                                @if (!string.IsNullOrWhiteSpace(log.OldData) || !string.IsNullOrWhiteSpace(log.NewData))
                                {
                                    <button type="button" class="audit-detail-button" data-old="@log.OldData" data-new="@log.NewData" data-title="@Label(log.Action) – @log.Target" data-time="@log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")" data-actor="@log.Actor" data-target="@log.Target" data-entity="@log.EntityName #@log.EntityId" data-notes="@log.Notes">Xem chi tiết<i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <nav class="audit-pagination" aria-label="Phân trang nhật ký">
                <a class="audit-page-link @(Model.Page <= 1 ? "disabled" : null)" aria-label="Trang trước" aria-disabled="@(Model.Page <= 1 ? "true" : null)" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-auditAction="@Model.Action" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-keyword="@Model.Keyword"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></a>
                @for (var number = Math.Max(1, Model.Page - 2); number <= Math.Min(Model.TotalPages, Model.Page + 2); number++)
                {
                    <a class="audit-page-link @(number == Model.Page ? "active" : null)" aria-current="@(number == Model.Page ? "page" : null)" asp-action="Index" asp-route-page="@number" asp-route-pageSize="@Model.PageSize" asp-route-auditAction="@Model.Action" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-keyword="@Model.Keyword">@number</a>
                }
                <a class="audit-page-link @(Model.Page >= Model.TotalPages ? "disabled" : null)" aria-label="Trang sau" aria-disabled="@(Model.Page >= Model.TotalPages ? "true" : null)" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-auditAction="@Model.Action" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-keyword="@Model.Keyword"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
            </nav>
        }
    </section>
</section>

<dialog class="audit-dialog" id="auditDetailDialog" aria-labelledby="auditDialogTitle">
    <div class="audit-dialog-header">
        <div><span>Chi tiết nhật ký</span><h2 id="auditDialogTitle">Chi tiết thay đổi</h2></div>
        <button type="button" data-close aria-label="Đóng"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </div>
    <div class="audit-change-grid">
        <section class="audit-meta"><h3><i class="fa-solid fa-circle-info"></i>Thông tin</h3><dl id="auditMeta"></dl></section>
        <section><h3><i class="fa-solid fa-arrow-rotate-left" aria-hidden="true"></i>Dữ liệu trước</h3><dl id="auditOldData"></dl></section>
        <section><h3><i class="fa-solid fa-arrow-right" aria-hidden="true"></i>Dữ liệu sau</h3><dl id="auditNewData"></dl></section>
    </div>
</dialog>

@section Scripts {
<script>
(() => {
    const form = document.getElementById('auditFilterForm');
    const filterError = document.getElementById('auditFilterError');
    const dialog = document.getElementById('auditDetailDialog');
    const oldData = document.getElementById('auditOldData');
    const newData = document.getElementById('auditNewData');
    const dialogTitle = document.getElementById('auditDialogTitle');
    const meta = document.getElementById('auditMeta');
    const labels = { email:'Email', employeeCode:'Mã nhân viên', employeeCodeBefore:'Mã nhân viên trước', employeeCodeAfter:'Mã nhân viên sau', fullName:'Họ tên', phoneNumber:'Số điện thoại', dataStatus:'Trạng thái dữ liệu', role:'Vai trò', roleName:'Vai trò', currentRoleName:'Vai trò hiện tại', requestedRoleName:'Vai trò đề xuất', status:'Trạng thái', mustChangePassword:'Yêu cầu đổi mật khẩu', rejectionReason:'Lý do từ chối', reason:'Lý do', passwordChanged:'Đã đổi mật khẩu', userId:'Mã tài khoản', employeeId:'Mã định danh nhân viên' };
    const values = { ACTIVE:'Hoạt động', LOCKED:'Bị khóa', EXISTING:'Đang sử dụng', DELETED:'Đã xóa', PENDING:'Chờ duyệt', APPROVED:'Đã duyệt', REJECTED:'Từ chối', Manager:'Quản lý', HallManager:'Quản lý sảnh', Coordinator:'Nhân viên điều phối', Admin:'Quản trị viên', true:'Có', false:'Không' };
    const sensitive = ['password','matkhau','token','otp','securitycode','authorization','salt'];

    form?.addEventListener('submit', event => {
        const fromDate = form.elements.fromDate.value;
        const toDate = form.elements.toDate.value;
        filterError.hidden = true;
        filterError.textContent = '';
        if (fromDate && toDate && toDate < fromDate) {
            event.preventDefault();
            filterError.textContent = 'Ngày kết thúc phải lớn hơn hoặc bằng ngày bắt đầu.';
            filterError.hidden = false;
        }
    });

    const renderEmpty = element => {
        const empty = document.createElement('span');
        empty.className = 'audit-change-empty';
        empty.textContent = 'Không có dữ liệu';
        element.append(empty);
    };
    const formatValue = value => {
        if (value === null || value === undefined || value === '') return '—';
        const key = String(value);
        return values[key] || key;
    };
    const fill = (element, value) => {
        element.replaceChildren();
        let data = {};
        try { data = value ? JSON.parse(value) : {}; } catch { const dd=document.createElement('dd');dd.textContent=value||'Không có dữ liệu';element.append(dd);return; }
        const entries = Object.entries(data);
        if (!entries.length) { renderEmpty(element); return; }
        entries.forEach(([key, value]) => {
            const dt = document.createElement('dt');
            const dd = document.createElement('dd');
            const normalized=key.replace(/[^a-z0-9]/gi,'').toLowerCase();
            dt.textContent = labels[key] || labels[key.charAt(0).toLowerCase()+key.slice(1)] || key;
            dd.textContent = sensitive.some(item=>normalized.includes(item)) ? '[Đã ẩn]' : formatValue(value);
            element.append(dt, dd);
        });
    };

    document.querySelectorAll('.audit-detail-button').forEach(button => {
        button.addEventListener('click', () => {
            dialogTitle.textContent = button.dataset.title || 'Chi tiết thay đổi';
            meta.replaceChildren();
            [['Thời gian',button.dataset.time],['Người thực hiện',button.dataset.actor],['Đối tượng',button.dataset.target],['Entity',button.dataset.entity],['Nội dung',button.dataset.notes]].forEach(([key,value])=>{const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=key;dd.textContent=value||'—';meta.append(dt,dd);});
            fill(oldData, button.dataset.old);
            fill(newData, button.dataset.new);
            dialog.showModal();
        });
    });
    dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
})();
</script>
}
