@model HeThongDatTiecCuoi_WEB.Models.ManagerHr.ManagerHrPageViewModel
@using HeThongDatTiecCuoi_WEB.Constants
@using HeThongDatTiecCuoi_WEB.Constants.StatusCodes
@{
 Layout="_AdminLayout"; ViewData["Title"]="Quản lý nhân sự";
 string Initials(string name){var p=name.Split(' ',StringSplitOptions.RemoveEmptyEntries);return string.Concat(p.TakeLast(Math.Min(2,p.Length)).Select(x=>x[0])).ToUpperInvariant();}
 string RequestLabel(string s)=>s switch{"APPROVED"=>"Đã duyệt","REJECTED"=>"Từ chối",_=>"Chờ duyệt"};
}
@section Styles { <link rel="stylesheet" href="~/css/manager-hr.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/manager-hr-fixes.css" asp-append-version="true" /> }
<main class="hr-page">
 <header class="hr-header"><div><nav>Nhân sự <i class="fa-solid fa-chevron-right"></i> <strong>Quản lý nhân sự</strong></nav><h1><i class="fa-solid fa-users-gear"></i> Quản lý nhân sự</h1><p>Quản lý đội ngũ nhân sự, phân công phụ trách sảnh và gửi yêu cầu thay đổi vai trò.</p></div></header>
 @Html.AntiForgeryToken()
 @if(!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<div class="hr-alert error">@Model.ErrorMessage</div>}
 <div id="hrToast" class="hr-toast" hidden></div>
 <section class="hr-kpis">
  <article><span><i class="fa-solid fa-users"></i></span><div><small>Tổng nhân sự</small><strong>@Model.TotalEmployees</strong></div></article>
  <article><span><i class="fa-solid fa-people-roof"></i></span><div><small>Quản lý sảnh</small><strong>@Model.HallManagerCount</strong></div></article>
  <article><span><i class="fa-solid fa-people-group"></i></span><div><small>Nhân viên điều phối</small><strong>@Model.CoordinatorCount</strong></div></article>
  <article><span class="warn"><i class="fa-regular fa-clock"></i></span><div><small>Yêu cầu đang chờ duyệt</small><strong>@Model.PendingRequestCount</strong></div></article>
 </section>
 <section class="hr-workspace">
  <div class="hr-tabs" role="tablist"><button class="active" data-tab="employees"><i class="fa-solid fa-users"></i> Danh sách nhân sự (@Model.TotalEmployees)</button><button data-tab="requests"><i class="fa-solid fa-clock-rotate-left"></i> Yêu cầu thay đổi vai trò (@Model.PendingRequestCount)</button><button data-tab="history"><i class="fa-regular fa-clipboard"></i> Lịch sử bổ nhiệm</button></div>
  <div class="hr-tab-panel active" id="employeesPanel">
   <form method="get" class="hr-filters"><label class="search"><i class="fa-solid fa-magnifying-glass"></i><input name="search" value="@Model.Search" placeholder="Tìm theo tên, mã nhân viên, email, số điện thoại..." /></label><select name="role"><option value="">Tất cả vai trò</option><option selected="@(Model.Role==RoleNames.HallManager)" value="@RoleNames.HallManager">Quản lý sảnh</option><option selected="@(Model.Role==RoleNames.Coordinator)" value="@RoleNames.Coordinator">Điều phối viên</option></select><select name="status"><option value="">Tất cả trạng thái</option><option selected="@(Model.Status=="ACTIVE")" value="ACTIVE">Hoạt động</option><option selected="@(Model.Status=="LOCKED")" value="LOCKED">Đã khóa</option></select><select name="assignmentStatus"><option value="">Tất cả tình trạng phân công</option><option selected="@(Model.AssignmentStatus=="ASSIGNED")" value="ASSIGNED">Đang phụ trách sảnh</option><option selected="@(Model.AssignmentStatus=="UNASSIGNED")" value="UNASSIGNED">Chưa phụ trách sảnh</option></select><button><i class="fa-solid fa-filter"></i> Lọc</button><a asp-action="Index"><i class="fa-solid fa-rotate"></i></a></form>
   <div class="hr-table-scroll"><table class="hr-table"><thead><tr><th>Nhân viên</th><th>Mã nhân viên</th><th>Vai trò hiện tại</th><th>Liên hệ</th><th>Sảnh đang phụ trách</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
   @if(Model.Employees.Count==0){<tr><td colspan="7" class="hr-empty"><i class="fa-solid fa-user-slash"></i><strong>@(string.IsNullOrWhiteSpace(Model.Search)&&string.IsNullOrWhiteSpace(Model.Role)&&string.IsNullOrWhiteSpace(Model.Status)&&string.IsNullOrWhiteSpace(Model.AssignmentStatus)?"Chưa có nhân sự phù hợp.":"Không tìm thấy nhân sự phù hợp với bộ lọc.")</strong></td></tr>}
   @foreach(var e in Model.Employees)
   {
    var hall=e.RoleName==RoleNames.HallManager?string.Join(", ",e.ActiveAssignments.Take(2).Select(x=>x.HallName)):"—";
    <tr>
     <td><button class="employee-link open-detail" data-id="@e.EmployeeId"><span class="avatar">@Initials(e.FullName)</span><strong>@e.FullName</strong></button></td>
     <td>@e.EmployeeCode</td>
     <td><span class="role-pill @(e.RoleName==RoleNames.HallManager?"manager":"coordinator")">@(e.RoleName==RoleNames.Coordinator?"Điều phối viên":e.RoleName)</span>@if(e.HasPendingRoleRequest){<small class="pending-note">Đang chờ duyệt vai trò</small>}</td>
     <td><strong>@(string.IsNullOrWhiteSpace(e.PhoneNumber)?"—":e.PhoneNumber)</strong><small>@(string.IsNullOrWhiteSpace(e.Email)?"—":e.Email)</small></td>
     <td>
      @if(e.RoleName==RoleNames.Coordinator){<span>—</span>}
      else if(e.ActiveAssignments.Count==0){<em>Chưa phụ trách sảnh</em>}
      else {<span>@hall</span>@if(e.ActiveAssignments.Count>2){<b class="more-halls">+@(e.ActiveAssignments.Count-2)</b>}}
     </td>
     <td><span class="account-pill @e.AccountStatusCode.ToLowerInvariant()"><i></i>@e.AccountStatusName</span></td>
     <td><button class="row-actions open-actions" data-id="@e.EmployeeId" aria-label="Thao tác với @e.FullName"><i class="fa-solid fa-ellipsis"></i></button></td>
    </tr>
   }
   </tbody></table></div>
   @if(Model.TotalPages>1){<nav class="hr-pagination">@for(var p=1;p<=Model.TotalPages;p++){<a class="@(p==Model.Page?"active":"")" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-role="@Model.Role" asp-route-status="@Model.Status" asp-route-assignmentStatus="@Model.AssignmentStatus">@p</a>}</nav>}
  </div>
  <div class="hr-tab-panel" id="requestsPanel"><div class="hr-table-scroll"><table class="hr-table"><thead><tr><th>Nhân viên</th><th>Mã nhân viên</th><th>Vai trò hiện tại</th><th>Vai trò đề xuất</th><th>Lý do</th><th>Ngày gửi</th><th>Trạng thái / Kết quả</th></tr></thead><tbody>@if(Model.RoleRequests.Count==0){<tr><td colspan="7" class="hr-empty">Chưa có yêu cầu thay đổi vai trò.</td></tr>}@foreach(var r in Model.RoleRequests){<tr><td><strong>@r.FullName</strong></td><td>@r.EmployeeCode</td><td>@r.CurrentRoleName</td><td>@r.RequestedRoleName</td><td>@(r.Reason??"—")</td><td>@r.RequestedAt.ToString("dd/MM/yyyy HH:mm")</td><td><span class="request-pill @r.Status.ToLowerInvariant()">@RequestLabel(r.Status)</span>@if(!string.IsNullOrWhiteSpace(r.RejectionReason)){<small>@r.RejectionReason</small>}</td></tr>}</tbody></table></div></div>
  <div class="hr-tab-panel" id="historyPanel"><div class="hr-table-scroll"><table class="hr-table"><thead><tr><th>Quản lý sảnh</th><th>Mã nhân viên</th><th>Sảnh</th><th>Từ ngày</th><th>Đến ngày</th><th>Trạng thái</th></tr></thead><tbody>@if(Model.AssignmentHistory.Count==0){<tr><td colspan="6" class="hr-empty">Chưa có lịch sử bổ nhiệm Quản lý sảnh.</td></tr>}@foreach(var h in Model.AssignmentHistory){<tr><td><strong>@h.EmployeeName</strong></td><td>@h.EmployeeCode</td><td>@h.HallName</td><td>@h.FromDate.ToString("dd/MM/yyyy")</td><td>@(h.ToDate?.ToString("dd/MM/yyyy")??"—")</td><td><span class="assignment-pill @(h.ToDate is null?"active":"ended")">@(h.ToDate is null?"Đang phụ trách":"Đã kết thúc")</span></td></tr>}</tbody></table></div></div>
 </section>
</main>

<div class="hr-overlay" id="drawerOverlay" hidden></div><aside class="employee-drawer" id="employeeDrawer" aria-hidden="true"><button class="drawer-close"><i class="fa-solid fa-xmark"></i></button><div id="drawerContent"></div></aside>
<div class="hr-modal-wrap" id="roleModal" hidden><div class="hr-modal"><button class="modal-close"><i class="fa-solid fa-xmark"></i></button><h2 id="roleModalTitle"></h2><p>Yêu cầu sẽ được chuyển đến Quản trị viên để phê duyệt.</p><dl class="modal-employee"></dl><form id="roleForm"><input type="hidden" name="EmployeeId"/><label>Lý do<textarea name="Reason" maxlength="500" rows="4" placeholder="Nhập lý do đề xuất"></textarea></label><div class="modal-actions"><button type="button" class="modal-cancel">Hủy</button><button class="primary"><i class="fa-solid fa-paper-plane"></i> Gửi yêu cầu</button></div></form></div></div>
<div class="hr-modal-wrap" id="assignModal" hidden>
 <div class="hr-modal wide assignment-modal">
  <button class="modal-close" aria-label="Đóng"><i class="fa-solid fa-xmark"></i></button>
  <div class="assignment-modal-heading"><span><i class="fa-solid fa-building-user"></i></span><div><h2 id="assignTitle"></h2><p>Chọn một hoặc nhiều sảnh để nhân viên phụ trách.</p></div></div>
  <div class="assignment-guidance"><i class="fa-solid fa-circle-info"></i><span>Phân công hiện tại sẽ được kết thúc và lưu vào lịch sử nếu bạn chọn thay thế Quản lý sảnh.</span></div>
  <form id="assignForm">
   <div class="hall-list-header"><span>Chọn</span><span>Thông tin sảnh</span><span>Tình trạng</span></div>
   <div class="hall-select-list">
    @foreach(var h in Model.Halls)
    {
     <label><input type="checkbox" name="HallIds" value="@h.HallId" data-current-id="@h.CurrentEmployeeId"/><span><strong>@h.HallName</strong><small>@(h.CurrentEmployeeId.HasValue?$"Đang phụ trách: {h.CurrentEmployeeCode} - {h.CurrentManagerName}":"Chưa có Quản lý sảnh")</small></span><em class="@(h.CurrentEmployeeId.HasValue?"busy":"available")">@(h.CurrentEmployeeId.HasValue?"Cần thay thế":"Sẵn sàng")</em></label>
    }
   </div>
   <div id="replaceWarning" class="replace-warning" hidden><i class="fa-solid fa-triangle-exclamation"></i><span>Sảnh đã có Quản lý sảnh sẽ được thay thế sau khi bạn xác nhận.</span></div>
   <div class="assignment-modal-footer"><span id="assignSelectionCount"><strong>0</strong> sảnh mới được chọn</span><div class="modal-actions"><button type="button" class="modal-cancel">Hủy</button><button class="primary"><i class="fa-solid fa-user-check"></i> Xác nhận bổ nhiệm</button></div></div>
  </form>
 </div>
</div>
<div class="hr-modal-wrap" id="confirmModal" hidden><div class="hr-modal"><h2 id="confirmTitle">Xác nhận thao tác</h2><p id="confirmMessage"></p><div class="modal-actions"><button type="button" id="confirmCancel">Hủy</button><button type="button" class="primary" id="confirmAccept">Xác nhận</button></div></div></div>

@section Scripts { <script src="~/js/manager-hr.js" asp-append-version="true"></script><script>window.hrData={employees:@Json.Serialize(Model.Employees)};</script> }
