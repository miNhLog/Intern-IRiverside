@section Scripts {

    <script>

        // =====================================================
        // MODAL
        // =====================================================

        function openFoodModal(id) {

            const modal =
                document.getElementById(id);

            if (modal) {
                modal.classList.add("show");
            }

        }


        function closeFoodModal(modal) {

            if (modal) {
                modal.classList.remove("show");
            }

        }


        document
            .querySelectorAll("[data-open-modal]")
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        openFoodModal(
                            button.dataset.openModal
                        );

                    }
                );

            });


        document
            .querySelectorAll("[data-close-modal]")
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        closeFoodModal(
                            button.closest(".food-modal")
                        );

                    }
                );

            });


        document
            .querySelectorAll(".food-modal")
            .forEach(function (modal) {

                modal.addEventListener(
                    "click",
                    function (event) {

                        if (event.target === modal) {

                            closeFoodModal(modal);

                        }

                    }
                );

            });


        document.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Escape") {

                    document
                        .querySelectorAll(
                            ".food-modal.show"
                        )
                        .forEach(
                            function (modal) {

                                closeFoodModal(modal);

                            }
                        );

                }

            }
        );


        // =====================================================
        // EDIT MENU
        // =====================================================

        document
            .querySelectorAll(
                ".edit-menu-button"
            )
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        document.getElementById(
                            "editMenuId"
                        ).value =
                            button.dataset.id;


                        document.getElementById(
                            "editMenuName"
                        ).value =
                            button.dataset.name ?? "";


                        document.getElementById(
                            "editMenuDescription"
                        ).value =
                            button.dataset.description ?? "";


                        document.getElementById(
                            "editMenuPrice"
                        ).value =
                            button.dataset.price ?? "0";


                        openFoodModal(
                            "editMenuModal"
                        );

                    }
                );

            });


        // =====================================================
        // EDIT DISH
        // =====================================================

        function openDishEditor(row) {

                        document.getElementById(
                            "editDishId"
                        ).value =
                            row.dataset.id;


                        document.getElementById(
                            "editDishName"
                        ).value =
                            row.dataset.name ?? "";


                        document.getElementById(
                            "editDishGroup"
                        ).value =
                            row.dataset.category
                            ?? "Món chính";


                        document.getElementById(
                            "deleteDishImage"
                        ).checked =
                            false;


                        document.getElementById(
                            "deleteImageWrapper"
                        ).style.display =
                            row.dataset.image
                                ? "flex"
                                : "none";

                        const isServing =
                            row.dataset.status === "@DishStatusCodes.Active";

                        document.getElementById(
                            "editDishStatusId"
                        ).value = row.dataset.id;

                        document.getElementById(
                            "editDishStatusValue"
                        ).value = isServing
                            ? "@DishStatusCodes.Inactive"
                            : "@DishStatusCodes.Active";

                        const currentStatus = document.getElementById(
                            "editDishCurrentStatus"
                        );
                        currentStatus.textContent =
                            row.dataset.statusName ?? "";
                        currentStatus.className = isServing
                            ? "serving"
                            : "stopped";

                        const statusButton = document.getElementById(
                            "editDishStatusButton"
                        );
                        statusButton.querySelector("i").className = isServing
                            ? "fa-solid fa-eye-slash"
                            : "fa-solid fa-eye";
                        statusButton.querySelector("span").textContent = isServing
                            ? "Ngừng phục vụ"
                            : "Phục vụ trở lại";


                        openFoodModal(
                            "editDishModal"
                        );

        }

        document
            .querySelectorAll(".edit-dish-row")
            .forEach(function (row) {

                row.addEventListener("click", function () {
                    openDishEditor(row);
                });

                row.addEventListener("keydown", function (event) {
                    if (event.key !== "Enter" && event.key !== " ") {
                        return;
                    }

                    event.preventDefault();
                    openDishEditor(row);
                });

            });


        // =====================================================
        // DISH PAGINATION
        // =====================================================

        const dishRows = Array.from(
            document.querySelectorAll(".edit-dish-row")
        );
        const dishesPerPage = 10;
        const visibleDishPageCount = 5;
        const dishPageCount = Math.ceil(
            dishRows.length / dishesPerPage
        );
        const dishPagination = document.getElementById(
            "dishPagination"
        );
        const dishPageNumbers = document.getElementById(
            "dishPageNumbers"
        );
        const dishPreviousPage = document.getElementById(
            "dishPreviousPage"
        );
        const dishNextPage = document.getElementById(
            "dishNextPage"
        );
        let currentDishPage = 1;

        function renderDishPage(page) {
            currentDishPage = Math.min(
                Math.max(page, 1),
                Math.max(dishPageCount, 1)
            );

            const firstDishIndex =
                (currentDishPage - 1) * dishesPerPage;
            const lastDishIndex =
                firstDishIndex + dishesPerPage;

            dishRows.forEach(function (row, index) {
                row.hidden =
                    index < firstDishIndex || index >= lastDishIndex;
            });

            dishPageNumbers.replaceChildren();

            const firstVisiblePage =
                Math.floor(
                    (currentDishPage - 1) / visibleDishPageCount
                ) * visibleDishPageCount + 1;
            const lastVisiblePage = Math.min(
                firstVisiblePage + visibleDishPageCount - 1,
                dishPageCount
            );

            for (let pageNumber = firstVisiblePage;
                pageNumber <= lastVisiblePage;
                pageNumber++) {
                const pageButton = document.createElement("button");
                pageButton.type = "button";
                pageButton.className = "food-page-button";
                pageButton.textContent = pageNumber;
                pageButton.setAttribute(
                    "aria-label",
                    `Chuyển đến trang ${pageNumber}`
                );

                if (pageNumber === currentDishPage) {
                    pageButton.classList.add("active");
                    pageButton.setAttribute("aria-current", "page");
                }

                pageButton.addEventListener("click", function () {
                    renderDishPage(pageNumber);
                });

                dishPageNumbers.appendChild(pageButton);
            }

            dishPreviousPage.disabled = currentDishPage === 1;
            dishNextPage.disabled =
                currentDishPage === dishPageCount;
        }

        if (dishPageCount > 1) {
            dishPagination.hidden = false;
            dishPreviousPage.addEventListener("click", function () {
                renderDishPage(currentDishPage - 1);
            });
            dishNextPage.addEventListener("click", function () {
                renderDishPage(currentDishPage + 1);
            });
        }

        if (dishPageCount > 0) {
            renderDishPage(1);
        }


        // =====================================================
        // REORDER DISH
        // =====================================================

        function getCompositionIds() {

            return Array.from(
                document.querySelectorAll(
                    "#compositionList .food-composition-item"
                )
            ).map(
                function (row) {

                    return Number(
                        row.dataset.dishId
                    );

                }
            );

        }


        document
            .querySelectorAll(".move-dish")
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        const ids =
                            getCompositionIds();


                        const index =
                            Number(
                                button.dataset.index
                            );


                        const targetIndex =
                            button.dataset.direction
                            === "up"
                                ? index - 1
                                : index + 1;


                        if (
                            targetIndex < 0 ||
                            targetIndex >= ids.length
                        ) {
                            return;
                        }


                        const temp =
                            ids[index];


                        ids[index] =
                            ids[targetIndex];


                        ids[targetIndex] =
                            temp;


                        document.getElementById(
                            "reorderIds"
                        ).value =
                            ids.join(",");


                        document.getElementById(
                            "reorderForm"
                        ).submit();

                    }
                );

            });

                    // =====================================================
        // GIỮ NGUYÊN VỊ TRÍ CUỘN SAU KHI THAO TÁC
        // =====================================================

        const foodScrollKey = "adminMenuScrollPosition";


        function saveFoodScrollPosition() {

            sessionStorage.setItem(
                foodScrollKey,
                window.scrollY.toString()
            );

        }


        // Lưu vị trí khi submit các form trong trang thực đơn
        document
            .querySelectorAll(
                ".food-page form, .food-modal form"
            )
            .forEach(function (form) {

                form.addEventListener(
                    "submit",
                    saveFoodScrollPosition
                );

            });


        // Lưu vị trí khi click các link lọc / xem chi tiết
        document
            .querySelectorAll(
                ".food-page a[href]"
            )
            .forEach(function (link) {

                link.addEventListener(
                    "click",
                    saveFoodScrollPosition
                );

            });


        // Sau khi trang load lại,
        // đưa màn hình về đúng vị trí trước đó
        window.addEventListener(
            "pageshow",
            function () {

                const savedPosition =
                    sessionStorage.getItem(
                        foodScrollKey
                    );

                if (savedPosition === null) {
                    return;
                }

                setTimeout(
                    function () {

                        window.scrollTo({
                            top: Number(savedPosition),
                            left: 0,
                            behavior: "auto"
                        });

                        sessionStorage.removeItem(
                            foodScrollKey
                        );

                    },
                    50
                );

            }
        );

    </script>

}
