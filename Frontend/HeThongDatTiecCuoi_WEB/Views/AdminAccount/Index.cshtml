@model HeThongDatTiecCuoi_WEB.Models.AdminAccount.AccountManagementViewModel

@{
    Layout = "_AdminLayout";

    ViewData["Title"] = "Quản lý tài khoản & phân quyền";
    ViewData["ActiveMenu"] = "Account";

    var adminAccounts = Model.Accounts
        .Where(x => x.RoleName == RoleNames.Admin)
        .ToList();

    var employeeAccounts = Model.Accounts
        .Where(x =>
            x.RoleName == RoleNames.Manager ||
            x.RoleName == RoleNames.HallManager ||
            x.RoleName == RoleNames.Coordinator)
        .ToList();

    var managerAccounts = employeeAccounts.Where(x => x.RoleName == RoleNames.Manager).ToList();
    var hallManagerAccounts = employeeAccounts.Where(x => x.RoleName == RoleNames.HallManager).ToList();
    var coordinatorAccounts = employeeAccounts.Where(x => x.RoleName == RoleNames.Coordinator).ToList();
}

<link rel="stylesheet"
      href="~/css/admin-account.css"
      asp-append-version="true" />


<header class="top-header">

    <div>
        <div class="breadcrumb">
            Quản trị nghiệp vụ
            <span>›</span>
            <strong>Quản lý tài khoản</strong>
        </div>
        <h2>
            Quản lý tài khoản
        </h2>
        <p class="account-page-subtitle">Quản lý nhân sự và trạng thái tài khoản trong hệ thống</p>
    </div>

</header>


<section class="content account-content">

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="error-box">
            <i class="fa-solid fa-circle-exclamation"></i>
            @Model.ErrorMessage
        </div>
    }


    <!-- THỐNG KÊ -->
    <div class="account-summary">

        <div class="summary-card">
            <div class="summary-icon">
                <i class="fa-solid fa-users"></i>
            </div>

            <div>
                <span>Tổng tài khoản</span>
                <strong>@Model.Accounts.Count</strong>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-icon active-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div>
                <span>Đang hoạt động</span>

                <strong>
                    @Model.Accounts.Count(
                    x => x.Status == AccountStatusCodes.Active
                                        )
                </strong>
            </div>
        </div>


        <div class="summary-card">
            <div class="summary-icon locked-icon">
                <i class="fa-solid fa-lock"></i>
            </div>

            <div>
                <span>Bị khóa</span>

                <strong>
                    @Model.Accounts.Count(
                    x => x.Status == AccountStatusCodes.Locked
                                        )
                </strong>
            </div>
        </div>

    </div>


    <!-- FILTER -->
    <div class="account-toolbar">

        <form method="get"
              action="/admin/quan-ly-tai-khoan"
              class="account-filter-form">


            <!-- SEARCH -->
            <div class="account-search">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input type="text"
                       name="keyword"
                       value="@Model.Keyword"
                       placeholder="Tên, email, mã nhân viên..." />

            </div>


            <!-- ROLE -->
            <select name="roleId"
                    class="account-select">

                <option value="">
                    Tất cả vai trò
                </option>

                @foreach (var role in Model.Roles)
                {
                    if (Model.RoleId == role.RoleId)
                    {
                        <option value="@role.RoleId"
                                selected>
                            @role.RoleName
                        </option>
                    }
                    else
                    {
                        <option value="@role.RoleId">
                            @role.RoleName
                        </option>
                    }
                }

            </select>


            <!-- STATUS -->
            <select name="status"
                    class="account-select">

                <option value="">
                    Tất cả trạng thái
                </option>

                @if (Model.Status == AccountStatusCodes.Active)
                {
                    <option value="@AccountStatusCodes.Active" selected>
                        Hoạt động
                    </option>
                }
                else
                {
                    <option value="@AccountStatusCodes.Active">
                        Hoạt động
                    </option>
                }


                @if (Model.Status == AccountStatusCodes.Locked)
                {
                    <option value="@AccountStatusCodes.Locked" selected>
                        Bị khóa
                    </option>
                }
                else
                {
                    <option value="@AccountStatusCodes.Locked">
                        Bị khóa
                    </option>
                }

            </select>


            <button type="submit"
                    class="btn-account-filter">

                <i class="fa-solid fa-filter"></i>
                Lọc

            </button>


            <a href="/admin/quan-ly-tai-khoan"
               class="btn-account-reset">

                <i class="fa-solid fa-rotate-left"></i>
                Đặt lại

            </a>

        </form>


        <button type="button"
                class="btn-add-account"
                id="openAddAccountModal">

            <i class="fa-solid fa-user-plus"></i>
            Thêm tài khoản nội bộ

        </button>

    </div>


    <!-- =====================================================
     TÀI KHOẢN QUẢN TRỊ VIÊN
     ===================================================== -->
    @if (adminAccounts.Count > 0)
    {
        <div class="account-section account-panel admin-role-panel">

            <div class="account-section-title">
                <div>
                    <h3>
                        <i class="fa-solid fa-user-shield"></i>
                        Quản trị viên hệ thống
                    </h3>

                    <p>
                        Quản trị và vận hành hệ thống
                    </p>
                </div>

                <span>
                    @adminAccounts.Count tài khoản
                </span>
            </div>


            <div class="admin-account-grid">

                @foreach (var account in adminAccounts)
                {
                    var statusClass =
                    account.Status == AccountStatusCodes.Active
                    ? "account-status-active"
                    : account.Status == AccountStatusCodes.Locked
                    ? "account-status-locked"
                    : "account-status-inactive";

                    <div class="admin-account-card">

                        <div class="admin-account-avatar">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>

                        <div class="admin-account-info">

                            <strong>
                                Quản trị viên hệ thống
                            </strong>

                            <span>
                                @account.Email
                            </span>

                            <small>
                                ID tài khoản: @account.UserId
                            </small>

                        </div>


                        <div class="admin-account-meta">

                            <span class="role-badge">
                                @account.RoleName
                            </span>

                            <span class="account-status @statusClass">
                                <i class="fa-solid fa-circle"></i>
                                @(string.IsNullOrWhiteSpace(account.StatusName) ? StatusDisplayNames.GetAccountStatusName(account.Status) : account.StatusName)
                            </span>

                            <span class="created-date">
                                <i class="fa-regular fa-calendar"></i>
                                @account.CreatedAt.ToString("dd/MM/yyyy")
                            </span>

                        </div>

                    </div>
                }

            </div>

        </div>
    }



    <!-- =====================================================
         TÀI KHOẢN NHÂN VIÊN
         ===================================================== -->

    @foreach (var roleSection in new[] {
            new { Title = "Quản lý", Subtitle = "Điều hành hoạt động kinh doanh và giám sát nghiệp vụ", Icon = "fa-briefcase", Accounts = managerAccounts },
            new { Title = "Quản lý sảnh", Subtitle = "Quản lý sảnh, lịch sảnh và tình trạng sử dụng", Icon = "fa-building", Accounts = hallManagerAccounts },
            new { Title = "Nhân viên điều phối", Subtitle = "Theo dõi và điều phối quá trình tổ chức tiệc", Icon = "fa-calendar-check", Accounts = coordinatorAccounts }
    })
    {
        <div class="account-panel account-role-panel">
                <div class="account-panel-header"><div><h3><i class="fa-solid @roleSection.Icon"></i> @roleSection.Title</h3><p>@roleSection.Subtitle</p></div><span>@roleSection.Accounts.Count nhân viên</span></div>
                @if (roleSection.Accounts.Count == 0)
                {
                    <div class="account-empty compact-empty"><span>Chưa có tài khoản</span></div>
                }
                else
                {
                    <div class="account-table-wrapper"><table class="account-table employee-table"><thead><tr><th>Nhân viên</th><th>Mã NV</th><th>Liên hệ</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
                    @foreach (var account in roleSection.Accounts)
                    {
                        var statusClass = account.Status == AccountStatusCodes.Active ? "account-status-active" : "account-status-locked";
                        <tr><td><div class="account-user"><div class="account-avatar"><i class="fa-solid fa-user-tie"></i></div><div><strong>@account.FullName</strong><span>@account.Email</span></div></div></td><td><strong class="employee-code">@account.EmployeeCode</strong></td><td><span>@account.Email</span><small class="contact-phone"><i class="fa-solid fa-phone"></i> @(account.PhoneNumber ?? "—")</small></td><td><select class="account-status inline-status-select @statusClass" aria-label="Trạng thái tài khoản" data-user-id="@account.UserId" data-previous-status="@account.Status"><option value="@AccountStatusCodes.Active" selected="@(account.Status == AccountStatusCodes.Active)">Hoạt động</option><option value="@AccountStatusCodes.Locked" selected="@(account.Status == AccountStatusCodes.Locked)">Bị khóa</option></select></td><td><div class="account-actions"><button type="button" class="account-action-button edit-account" title="Chỉnh sửa" data-user-id="@account.UserId" data-employee-code="@account.EmployeeCode" data-full-name="@account.FullName" data-email="@account.Email" data-phone-number="@account.PhoneNumber" data-role-id="@account.RoleId"><i class="fa-regular fa-pen-to-square"></i></button><button type="button" class="account-action-button password-account" title="Đặt lại mật khẩu" data-user-id="@account.UserId" data-email="@account.Email"><i class="fa-solid fa-key"></i></button></div></td></tr>
                    }
                    </tbody></table></div>
                }
        </div>
    }



    @* CUSTOMER_ACCOUNTS_REMOVED
    <!-- =====================================================
         TÀI KHOẢN KHÁCH HÀNG
         ===================================================== -->

    <div class="account-panel account-section">

        <div class="account-panel-header">

            <div>
                <h3>
                    <i class="fa-solid fa-users"></i>
                    Tài Khoản Khách Hàng
                </h3>

                <p>
                    Danh sách khách hàng đã đăng ký tài khoản trên hệ thống
                </p>
            </div>

            <span>
                @customerAccounts.Count khách hàng
            </span>

        </div>


        @if (customerAccounts.Count == 0)
        {
