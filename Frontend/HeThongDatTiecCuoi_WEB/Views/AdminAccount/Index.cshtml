@model HeThongDatTiecCuoi_WEB.Models.AdminAccount.AccountManagementViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý tài khoản";

    var employeeAccounts = Model.Accounts
        .Where(account => account.RoleName == RoleNames.Admin
            || account.RoleName == RoleNames.Manager
            || account.RoleName == RoleNames.HallManager
            || account.RoleName == RoleNames.Coordinator)
        .ToList();
    var internalRoles = Model.Roles
        .Where(role => role.RoleName == RoleNames.Admin
            || role.RoleName == RoleNames.Manager
            || role.RoleName == RoleNames.HallManager
            || role.RoleName == RoleNames.Coordinator)
        .ToList();
    var allAccounts = Model.AllAccounts.Count > 0 ? Model.AllAccounts : employeeAccounts;
    var totalAccounts = allAccounts.Count;
    var activeAccounts = allAccounts.Count(account => account.Status == AccountStatusCodes.Active);
    var lockedAccounts = allAccounts.Count(account => account.Status == AccountStatusCodes.Locked);
    var mustChangePasswordAccounts = allAccounts.Count(account => account.MustChangePassword);
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Keyword)
        || Model.RoleId.HasValue
        || !string.IsNullOrWhiteSpace(Model.Status)
        || Model.MustChangePassword.HasValue;

    string RoleClass(string roleName) => roleName switch
    {
        RoleNames.Admin => "is-admin",
        RoleNames.Manager => "is-manager",
        RoleNames.HallManager => "is-hall-manager",
        RoleNames.Coordinator => "is-coordinator",
        _ => string.Empty
    };

    string RoleIcon(string roleName) => roleName switch
    {
        RoleNames.Admin => "bi-person-badge",
        RoleNames.Manager => "bi-briefcase",
        RoleNames.HallManager => "bi-building",
        RoleNames.Coordinator => "bi-people",
        _ => "bi-person"
    };
}

<link rel="stylesheet" href="~/css/admin-account.css" asp-append-version="true" />

<section class="account-management-page">
    <header class="account-management-header">
        <div>
            <span class="backoffice-hero__eyebrow"><i class="bi bi-shield-check" aria-hidden="true"></i> QUẢN TRỊ HỆ THỐNG</span>
            <h1>Quản lý tài khoản</h1>
            <p>Quản lý tài khoản nội bộ và trạng thái truy cập hệ thống</p>
        </div>
        <button type="button" class="account-create-button admin-create-button" id="openAddAccountModal">
            <i class="bi bi-person-plus" aria-hidden="true"></i>
            Cấp tài khoản
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="error-box account-page-error" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@Model.ErrorMessage</div>
    }

    <section class="account-stat-grid" aria-label="Thống kê tài khoản">
        <article class="account-stat-card"><span class="account-stat-icon"><i class="bi bi-people" aria-hidden="true"></i></span><div><small>Tổng tài khoản</small><strong>@totalAccounts</strong><p>Tất cả tài khoản nội bộ</p></div></article>
        <article class="account-stat-card"><span class="account-stat-icon is-active"><i class="bi bi-person-check" aria-hidden="true"></i></span><div><small>Đang hoạt động</small><strong>@activeAccounts</strong><p>@(totalAccounts == 0 ? 0 : Math.Round(activeAccounts * 100m / totalAccounts, 0))% tổng tài khoản</p></div></article>
        <article class="account-stat-card"><span class="account-stat-icon is-locked"><i class="bi bi-lock" aria-hidden="true"></i></span><div><small>Bị khóa</small><strong>@lockedAccounts</strong><p>@(totalAccounts == 0 ? 0 : Math.Round(lockedAccounts * 100m / totalAccounts, 0))% tổng tài khoản</p></div></article>
        <article class="account-stat-card"><span class="account-stat-icon is-password"><i class="bi bi-key" aria-hidden="true"></i></span><div><small>Chờ đổi mật khẩu</small><strong>@mustChangePasswordAccounts</strong><p>Cần đổi mật khẩu lần đầu</p></div></article>
    </section>

    <section class="employee-account-panel" aria-labelledby="employeeAccountTitle">
        <header class="account-directory-header">
            <div><h2 id="employeeAccountTitle">Danh mục tài khoản</h2><p>Quản lý vai trò và trạng thái truy cập.</p></div>
            <form method="get" asp-action="Index" class="employee-account-toolbar" id="accountFilterForm">
            <div class="employee-search">
                <button type="submit" title="Tìm kiếm" aria-label="Tìm kiếm">
                    <i class="bi bi-search" aria-hidden="true"></i>
                </button>
                <input type="search" id="accountSearchInput" name="keyword" value="@Model.Keyword" placeholder="Tìm theo tên, email hoặc mã tài khoản" autocomplete="off" />
            </div>
            <label class="employee-filter">
                <select name="roleId" aria-label="Lọc theo vai trò">
                    <option value="">Tất cả vai trò</option>
                    @foreach (var role in internalRoles)
                    {
                        <option value="@role.RoleId" selected="@(Model.RoleId == role.RoleId)">@role.RoleName</option>
                    }
                </select>
            </label>
            <label class="employee-filter">
                <select name="status" aria-label="Lọc theo trạng thái">
                    <option value="">Tất cả trạng thái</option>
                    <option value="@AccountStatusCodes.Active" selected="@(Model.Status == AccountStatusCodes.Active)">Hoạt động</option>
                    <option value="@AccountStatusCodes.Locked" selected="@(Model.Status == AccountStatusCodes.Locked)">Bị khóa</option>
                </select>
            </label>
            <button type="submit" class="visually-hidden">Lọc tài khoản</button>
            @if (hasFilters)
            {
                <a asp-action="Index" class="account-filter-clear" title="Xóa bộ lọc" aria-label="Xóa bộ lọc"><i class="bi bi-x-lg" aria-hidden="true"></i></a>
            }
            </form>
        </header>
        @if (employeeAccounts.Count == 0)
        {
            <div class="employee-account-empty">
                <span><i class="bi bi-person" aria-hidden="true"></i></span>
                <strong>Chưa có tài khoản</strong>
                <p>Hiện chưa có tài khoản nào phù hợp với bộ lọc.</p>
                @if (!hasFilters)
                {
                    <button type="button" class="account-create-button admin-create-button" data-open-create><i class="bi bi-person-plus" aria-hidden="true"></i>Cấp tài khoản</button>
                }
            </div>
        }
        else
        {
            <div class="employee-account-table-wrap">
                <table class="employee-account-table">
                    <thead><tr><th scope="col">Tài khoản</th><th scope="col">Vai trò</th><th scope="col">Liên hệ</th><th scope="col">Ngày tạo</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead>
                    <tbody>
                    @foreach (var account in employeeAccounts)
                    {
                        var isAdministrator = account.RoleName == RoleNames.Admin;
                        var isActive = account.Status == AccountStatusCodes.Active;
                        var statusClass = isActive ? "is-active" : "is-locked";
                        var statusText = string.IsNullOrWhiteSpace(account.StatusName) ? StatusDisplayNames.GetAccountStatusName(account.Status) : account.StatusName;
                        var nextStatus = isActive ? AccountStatusCodes.Locked : AccountStatusCodes.Active;
                        var nextStatusText = isActive ? "Khóa tài khoản" : "Mở khóa tài khoản";
                        <tr>
                            <td><div class="employee-identity"><span class="employee-avatar" aria-hidden="true"><i class="bi bi-person"></i></span><div><strong>@(string.IsNullOrWhiteSpace(account.FullName) ? account.Email : account.FullName)</strong><span class="employee-code">#@account.UserId.ToString("D4")</span></div></div></td>
                            <td><span class="employee-role-badge @RoleClass(account.RoleName)"><i class="bi @RoleIcon(account.RoleName)" aria-hidden="true"></i>@account.RoleName</span></td>
                            <td><div class="employee-contact"><span><i class="bi bi-envelope" aria-hidden="true"></i>@account.Email</span>@if (!string.IsNullOrWhiteSpace(account.PhoneNumber)) { <span><i class="bi bi-telephone" aria-hidden="true"></i>@account.PhoneNumber</span> }</div></td>
                            <td><time datetime="@account.CreatedAt.ToString("yyyy-MM-dd")">@account.CreatedAt.ToString("dd/MM/yyyy")</time></td>
                            <td>
                                <div class="employee-status-stack">
                                    <span class="employee-status-badge @statusClass"><i class="bi bi-circle-fill" aria-hidden="true"></i>@statusText</span>
                                    @if (account.MustChangePassword)
                                    {
                                        <span class="password-waiting-badge"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>Chờ đổi mật khẩu</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (isAdministrator)
                                {
                                    <span class="self-account-label" title="Không thể tự khóa tài khoản đang đăng nhập"><i class="bi bi-shield-lock" aria-hidden="true"></i>Hiện tại</span>
                                }
                                else
                                {
                                    <details class="employee-action-menu">
                                        <summary aria-label="Mở menu thao tác" title="Thao tác">
                                            <i class="bi bi-three-dots" aria-hidden="true"></i>
                                            <i class="bi bi-chevron-down action-menu-chevron" aria-hidden="true"></i>
                                        </summary>
                                        <div class="employee-action-menu-panel">
                                            <button type="button" class="employee-action-button edit-account" title="Sửa tài khoản" data-user-id="@account.UserId" data-account-code="#@account.UserId.ToString("D4")" data-full-name="@account.FullName" data-email="@account.Email" data-phone-number="@account.PhoneNumber" data-role-name="@account.RoleName"><i class="bi bi-pencil-square" aria-hidden="true"></i><span>Sửa tài khoản</span></button>
                                            <button type="button" class="employee-action-button reset-password-account" title="Đặt lại mật khẩu" data-user-id="@account.UserId" data-employee-code="@account.EmployeeCode" data-full-name="@account.FullName" data-email="@account.Email" data-role-name="@account.RoleName" data-is-locked="@((!isActive).ToString().ToLowerInvariant())"><i class="bi bi-key" aria-hidden="true"></i><span>Đặt lại mật khẩu</span></button>
                                            <button type="button" class="employee-action-button toggle-account-status" title="@nextStatusText" data-user-id="@account.UserId" data-status="@nextStatus" data-account-name="@(string.IsNullOrWhiteSpace(account.FullName) ? account.Email : account.FullName)"><i class="bi @(isActive ? "bi-lock" : "bi-unlock")" aria-hidden="true"></i><span>@nextStatusText</span></button>
                                        </div>
                                    </details>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <footer class="employee-account-footer">Hiển thị 1 - @employeeAccounts.Count của @employeeAccounts.Count tài khoản</footer>
        }
    </section>
</section>

<div id="addAccountModal" class="account-modal-overlay" aria-hidden="true">
    <div class="account-modal" role="dialog" aria-modal="true" aria-labelledby="addAccountTitle">
        <div class="account-modal-header"><div><h3 id="addAccountTitle">Cấp tài khoản nội bộ</h3><p>Thiết lập thông tin tài khoản cho nhân viên</p></div><button type="button" class="account-modal-close" data-close-modal aria-label="Đóng"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
        <form id="addAccountForm" autocomplete="off">
            @Html.AntiForgeryToken()
            <div class="account-form-grid">
                <div class="account-form-group"><label>Họ tên <span>*</span></label><input type="text" name="FullName" maxlength="150" required /></div>
                <div class="account-form-group"><label>Email <span>*</span></label><input type="email" name="Email" maxlength="255" data-validated-email required /></div>
                <div class="account-form-group"><label>Số điện thoại <span>*</span></label><input type="tel" name="PhoneNumber" maxlength="20" required /></div>
                <div class="account-form-group"><label>Vai trò <span>*</span></label><select name="RoleId" required><option value="">Chọn vai trò</option>@foreach (var role in internalRoles) { <option value="@role.RoleId">@role.RoleName</option> }</select></div>
            </div>
            <p class="account-form-note"><i class="bi bi-info-circle" aria-hidden="true"></i><span>Mật khẩu ban đầu: <strong>StaffRiverside@123</strong>. Nhân viên phải thay đổi mật khẩu khi đăng nhập lần đầu.</span></p>
            <div id="addAccountError" class="account-form-error" role="alert"></div>
            <div class="account-modal-actions"><button type="button" class="btn-modal-cancel" data-close-modal>Hủy</button><button type="submit" class="btn-modal-save" id="saveAccountButton"><i class="bi bi-person-plus" aria-hidden="true"></i>Cấp tài khoản</button></div>
        </form>
    </div>
</div>

<div id="resetPasswordModal" class="account-modal-overlay" aria-hidden="true">
    <div class="account-modal reset-password-modal" role="dialog" aria-modal="true" aria-labelledby="resetPasswordTitle">
        <div class="account-modal-header"><div class="reset-password-heading"><span><i class="bi bi-key" aria-hidden="true"></i></span><div><h3 id="resetPasswordTitle">Đặt lại mật khẩu</h3><p>Gửi liên kết bảo mật qua email cho nhân viên</p></div></div><button type="button" class="account-modal-close" data-close-modal aria-label="Đóng"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
        <div class="reset-password-content">
            <section class="reset-password-user" aria-label="Tài khoản nhận liên kết đặt lại mật khẩu">
                <span class="reset-password-avatar" aria-hidden="true"><i class="bi bi-person"></i></span>
                <div><strong id="resetFullName"></strong><span id="resetEmail"></span></div>
                <span id="resetAccountStatus" class="reset-account-status"></span>
            </section>
            <dl class="reset-password-summary"><div><dt><i class="bi bi-person-badge" aria-hidden="true"></i>Mã nhân viên</dt><dd id="resetEmployeeCode"></dd></div><div><dt><i class="bi bi-person-gear" aria-hidden="true"></i>Vai trò</dt><dd id="resetRoleName"></dd></div></dl>
            <div class="reset-password-notice"><i class="bi bi-info-circle" aria-hidden="true"></i><div><strong>Quy trình đặt lại mật khẩu</strong><span>Hệ thống sẽ gửi một liên kết bảo mật đến email của nhân viên. Mật khẩu hiện tại chỉ thay đổi sau khi nhân viên hoàn tất thao tác qua liên kết.</span></div></div>
            <div id="resetLockedNotice" class="reset-password-locked" hidden><i class="bi bi-lock" aria-hidden="true"></i><div><strong>Tài khoản đang bị khóa</strong><span>Đặt lại mật khẩu không tự động mở khóa tài khoản.</span></div></div>
            <div id="resetPasswordError" class="account-form-error" role="alert"></div>
            <div id="resetPasswordSuccess" class="account-form-success" role="status"></div>
        </div>
        <form id="resetPasswordForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="resetUserId" />
            <div class="account-modal-actions"><button type="button" class="btn-modal-cancel" data-close-modal>Hủy</button><button type="submit" class="btn-modal-save" id="sendResetPasswordButton"><i class="bi bi-envelope" aria-hidden="true"></i>Gửi email đặt lại mật khẩu</button></div>
        </form>
    </div>
</div>

<div id="editAccountModal" class="account-modal-overlay" aria-hidden="true">
    <div class="account-modal" role="dialog" aria-modal="true" aria-labelledby="editAccountTitle">
        <div class="account-modal-header"><div><h3 id="editAccountTitle">Sửa tài khoản nhân viên</h3><p>Cập nhật thông tin tài khoản nội bộ</p></div><button type="button" class="account-modal-close" data-close-modal aria-label="Đóng"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
        <form id="editAccountForm" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editUserId" />
            <div class="account-form-grid">
                <div class="account-form-group"><label>Mã tài khoản</label><input type="text" id="editAccountCode" readonly /></div>
                <div class="account-form-group"><label>Họ tên <span>*</span></label><input type="text" id="editFullName" name="FullName" maxlength="150" required /></div>
                <div class="account-form-group"><label>Email <span>*</span></label><input type="email" id="editEmail" name="Email" maxlength="255" data-validated-email required /></div>
                <div class="account-form-group"><label>Số điện thoại <span>*</span></label><input type="tel" id="editPhoneNumber" name="PhoneNumber" maxlength="20" required /></div>
                <div class="account-form-group"><label>Vai trò hiện tại</label><input type="text" id="editRoleName" readonly /></div>
            </div>
            <div id="editAccountError" class="account-form-error" role="alert"></div>
            <div class="account-modal-actions"><button type="button" class="btn-modal-cancel" data-close-modal>Hủy</button><button type="submit" class="btn-modal-save" id="saveEditAccountButton"><i class="bi bi-floppy" aria-hidden="true"></i>Lưu thay đổi</button></div>
        </form>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const commonEmailDomainTypos = { 'gmaiil.com':'gmail.com', 'gmaill.com':'gmail.com', 'gmial.com':'gmail.com', 'gmal.com':'gmail.com', 'gmail.co':'gmail.com', 'gmail.con':'gmail.com', 'gmail.cm':'gmail.com', 'hotmaiil.com':'hotmail.com', 'hotmal.com':'hotmail.com', 'outlok.com':'outlook.com', 'yahooo.com':'yahoo.com' };
    const validateEmail = input => {
        const domain = input.value.trim().toLowerCase().split('@@')[1] || '';
        const suggestion = commonEmailDomainTypos[domain];
        input.setCustomValidity(suggestion ? `Tên miền "${domain}" có thể đã nhập sai. Bạn có muốn dùng "${suggestion}"?` : '');
    };
    document.querySelectorAll('[data-validated-email]').forEach(input => {
        input.addEventListener('input', () => validateEmail(input));
        input.addEventListener('change', () => validateEmail(input));
    });

    const openModal = modal => { modal.classList.add('show'); modal.setAttribute('aria-hidden', 'false'); };
    const closeModal = modal => { modal.classList.remove('show'); modal.setAttribute('aria-hidden', 'true'); };
    document.querySelectorAll('.account-modal-overlay').forEach(modal => {
        modal.querySelectorAll('[data-close-modal]').forEach(button => button.addEventListener('click', () => closeModal(modal)));
        modal.addEventListener('click', event => { if (event.target === modal) closeModal(modal); });
    });

    const addModal = document.getElementById('addAccountModal');
    const addForm = document.getElementById('addAccountForm');
    const addError = document.getElementById('addAccountError');
    document.getElementById('openAddAccountModal')?.addEventListener('click', () => openModal(addModal));
    document.querySelectorAll('[data-open-create]').forEach(button => button.addEventListener('click', () => openModal(addModal)));
    addForm?.addEventListener('submit', async event => {
        event.preventDefault();
        await submitForm(addForm, '/admin/quan-ly-tai-khoan/them-nhan-vien', document.getElementById('saveAccountButton'), addError, 'Đang cấp...');
    });

    const editModal = document.getElementById('editAccountModal');
    const editForm = document.getElementById('editAccountForm');
    const editError = document.getElementById('editAccountError');
    document.querySelectorAll('.edit-account').forEach(button => button.addEventListener('click', () => {
        document.getElementById('editUserId').value = button.dataset.userId;
        document.getElementById('editAccountCode').value = button.dataset.accountCode || '';
        document.getElementById('editFullName').value = button.dataset.fullName || '';
        document.getElementById('editEmail').value = button.dataset.email || '';
        document.getElementById('editPhoneNumber').value = button.dataset.phoneNumber || '';
        document.getElementById('editRoleName').value = button.dataset.roleName || '';
        editError.textContent = '';
        openModal(editModal);
    }));
    editForm?.addEventListener('submit', async event => {
        event.preventDefault();
        const userId = document.getElementById('editUserId').value;
        await submitForm(editForm, `/admin/quan-ly-tai-khoan/sua-nhan-vien/${userId}`, document.getElementById('saveEditAccountButton'), editError, 'Đang lưu...');
    });

    const resetModal = document.getElementById('resetPasswordModal');
    const resetForm = document.getElementById('resetPasswordForm');
    const resetError = document.getElementById('resetPasswordError');
    const resetSuccess = document.getElementById('resetPasswordSuccess');
    document.querySelectorAll('.reset-password-account').forEach(button => button.addEventListener('click', () => {
        const isLocked = button.dataset.isLocked === 'true';
        document.getElementById('resetUserId').value = button.dataset.userId;
        document.getElementById('resetFullName').textContent = button.dataset.fullName || '—';
        document.getElementById('resetEmployeeCode').textContent = button.dataset.employeeCode || '—';
        document.getElementById('resetEmail').textContent = button.dataset.email || '—';
        document.getElementById('resetRoleName').textContent = button.dataset.roleName || '—';
        const status = document.getElementById('resetAccountStatus');
        status.textContent = isLocked ? 'Đang bị khóa' : 'Đang hoạt động';
        status.classList.toggle('is-locked', isLocked);
        document.getElementById('resetLockedNotice').hidden = !isLocked;
        resetError.textContent = '';
        resetSuccess.textContent = '';
        openModal(resetModal);
    }));
    resetForm?.addEventListener('submit', async event => {
        event.preventDefault();
        const userId = document.getElementById('resetUserId').value;
        const button = document.getElementById('sendResetPasswordButton');
        const original = button.innerHTML;
        resetError.textContent = '';
        resetSuccess.textContent = '';
        button.disabled = true;
        button.innerHTML = '<i class="bi bi-arrow-repeat admin-icon-spin"></i>Đang gửi...';
        try {
            const result = await postForm(resetForm, `/admin/quan-ly-tai-khoan/gui-lien-ket-dat-lai-mat-khau/${userId}`);
            if (!result.success) { resetError.textContent = result.message || 'Không thể gửi email đặt lại mật khẩu. Vui lòng thử lại.'; return; }
            resetSuccess.textContent = result.message || 'Đã gửi liên kết đặt lại mật khẩu đến email của nhân viên.';
        } catch {
            resetError.textContent = 'Không thể kết nối đến hệ thống.';
        } finally {
            button.disabled = false;
            button.innerHTML = original;
        }
    });

    async function postForm(form, url) {
        const response = await fetch(url, { method: 'POST', body: new FormData(form) });
        return response.json();
    }

    async function submitForm(form, url, button, errorElement, loadingText) {
        errorElement.textContent = '';
        const original = button.innerHTML;
        button.disabled = true;
        button.innerHTML = `<i class="bi bi-arrow-repeat admin-icon-spin"></i>${loadingText}`;
        try {
            const response = await fetch(url, { method: 'POST', body: new FormData(form) });
            const result = await response.json();
            if (!result.success) { errorElement.textContent = result.message || 'Không thể thực hiện yêu cầu.'; return; }
            window.location.reload();
        } catch {
            errorElement.textContent = 'Không thể kết nối đến hệ thống.';
        } finally {
            button.disabled = false;
            button.innerHTML = original;
        }
    }

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    async function updateAccountStatus(userId, status) {
        const formData = new FormData();
        formData.append('status', status);
        if (token) formData.append('__RequestVerificationToken', token);
        const response = await fetch(`/admin/quan-ly-tai-khoan/trang-thai/${userId}`, { method: 'POST', body: formData });
        const result = await response.json();
        if (!result.success) throw new Error(result.message || 'Không thể cập nhật trạng thái.');
        window.location.reload();
    }

    document.querySelectorAll('.toggle-account-status').forEach(button => button.addEventListener('click', async () => {
        if (!window.confirm(`${button.title} “${button.dataset.accountName}”?`)) return;
        button.disabled = true;
        try { await updateAccountStatus(button.dataset.userId, button.dataset.status); }
        catch (error) { alert(error.message); button.disabled = false; }
    }));

    const actionMenus = document.querySelectorAll('.employee-action-menu');
    const closeActionMenus = except => actionMenus.forEach(menu => {
        if (menu !== except) menu.removeAttribute('open');
    });
    actionMenus.forEach(menu => menu.addEventListener('toggle', () => {
        if (!menu.open) return;
        closeActionMenus(menu);
        const summary = menu.querySelector('summary');
        const panel = menu.querySelector('.employee-action-menu-panel');
        const bounds = summary.getBoundingClientRect();
        const panelWidth = 206;
        const panelHeight = 138;
        panel.style.left = `${Math.max(12, Math.min(window.innerWidth - panelWidth - 12, bounds.right - panelWidth))}px`;
        panel.style.top = `${bounds.bottom + panelHeight > window.innerHeight - 12 ? bounds.top - panelHeight - 6 : bounds.bottom + 6}px`;
    }));
    actionMenus.forEach(menu => menu.querySelectorAll('.employee-action-button').forEach(button => {
        button.addEventListener('click', () => menu.removeAttribute('open'));
    }));
    document.addEventListener('click', event => {
        if (!event.target.closest('.employee-action-menu')) closeActionMenus();
    });
    window.addEventListener('scroll', () => closeActionMenus(), true);

    document.querySelectorAll('#accountFilterForm select').forEach(select => select.addEventListener('change', () => document.getElementById('accountFilterForm').submit()));
    let searchDebounceTimer;
    const accountSearchInput = document.getElementById('accountSearchInput');
    accountSearchInput?.addEventListener('input', () => {
        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(() => {
            document.getElementById('accountFilterForm').submit();
        }, 500);
    });
    document.addEventListener('keydown', event => {
        if (event.key === 'Escape') document.querySelectorAll('.account-modal-overlay.show').forEach(closeModal);
    });
})();
</script>
}
