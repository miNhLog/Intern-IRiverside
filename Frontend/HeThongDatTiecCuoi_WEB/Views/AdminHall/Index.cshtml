@model HeThongDatTiecCuoi_WEB.Models.AdminHall.HallManagementViewModel

@{
    Layout = "_AdminLayout";

    ViewData["Title"] = "Quản lý Sảnh & Lịch";
    ViewData["ActiveMenu"] = "Hall";

    var endDate = Model.StartDate.AddDays(6);
}

<!-- HEADER -->
<header class="top-header">

    <div>

        <div class="breadcrumb">
            Quản trị Master Data
            <span>›</span>
            <strong>Quản lý Sảnh & Lịch Sảnh</strong>
        </div>

        <h2>
            Quản Trị Sảnh Tiệc & Lịch Phân Bổ Theo Ca
        </h2>

    </div>

    <div class="system-status">
        <span></span>
        Dữ liệu đang kết nối
    </div>

</header>


<section class="content">

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="error-box">
            <i class="fa-solid fa-circle-exclamation"></i>
            @Model.ErrorMessage
        </div>
    }


    <!-- FILTER -->
    <div class="filter-bar">

        <form method="get"
              action="/admin/quan-ly-sanh"
              class="filter-form">

            <div class="filter-item">

                <i class="fa-regular fa-calendar"></i>

                <label>Tuần:</label>

                <input type="date"
                       name="date"
                       value="@Model.StartDate.ToString("yyyy-MM-dd")" />

            </div>


            <div class="filter-item">

                <i class="fa-solid fa-building"></i>

                <label>Sảnh:</label>

                <select name="hallId">

                    <option value="">
                        Tất cả sảnh
                    </option>

                    @foreach (var hall in Model.Halls)
                    {
                        if (Model.HallId == hall.HallId)
                        {
                            <option value="@hall.HallId"
                                    selected>
                                @hall.HallName
                            </option>
                        }
                        else
                        {
                            <option value="@hall.HallId">
                                @hall.HallName
                            </option>
                        }
                    }

                </select>

            </div>


            <button type="submit"
                    class="btn-filter">

                <i class="fa-solid fa-filter"></i>

                Lọc dữ liệu

            </button>

        </form>


        <button type="button"
                class="btn-add"
                id="openAddHallModal">

            <i class="fa-solid fa-plus"></i>

            Thêm sảnh tiệc mới

        </button>

    </div>


    <!-- HALL HEADER -->
    <div class="section-header">

        <div>
            <h3>
                Thông Tin & Bảng Giá Danh Mục Sảnh Tiệc
            </h3>

            <p>
                Hiển thị dữ liệu trực tiếp từ hệ thống
            </p>
        </div>

        <span>
            @Model.Halls.Count sảnh
        </span>

    </div>


    <!-- HALL CARDS -->
    <div class="hall-grid"
         id="hallGrid">

        @{
            var index = 0;
        }

        @foreach (var hall in Model.Halls)
        {
            var extraClass = index >= 3 ? "extra-hall hidden" : "";

            <div class="hall-card @extraClass">

                <div class="hall-card-header">

                    <div>

                        <div class="hall-title">

                            <h4>
                                @hall.HallName
                            </h4>

                            <span class="status-badge
                                    @(hall.Status == HallStatusCodes.Active
                                                                                                                ? "status-active"
                                                                                                                : hall.Status == HallStatusCodes.Maintenance
                                                                                                                    ? "status-maintenance"
                                                                                                                    : "status-inactive")">

                            @if (hall.Status == HallStatusCodes.Active)
                                {
                                    <i class="fa-solid fa-circle-check"></i>
                                }
                                else if (hall.Status == HallStatusCodes.Maintenance)
                                {
                                    <i class="fa-solid fa-screwdriver-wrench"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-circle-xmark"></i>
                                }

                                @(string.IsNullOrWhiteSpace(hall.StatusName) ? StatusDisplayNames.GetHallStatusName(hall.Status) : hall.StatusName)

                            </span>

                        </div>

                        <div class="hall-code">
                            Mã sảnh: @hall.HallCode
                        </div>

                    </div>

                    <div class="hall-icon">
                        <i class="fa-solid fa-crown"></i>
                    </div>

                </div>


                <div class="hall-info">

                    <div class="info-row">

                        <span>
                            Sức chứa tối thiểu:
                        </span>

                        <strong>
                            @(hall.MinimumCapacity?.ToString() ?? "Chưa xác định") khách
                        </strong>

                    </div>


                    <div class="info-row">

                        <span>
                            Sức chứa tối đa:
                        </span>

                        <strong>
                            @hall.MaximumCapacity khách
                        </strong>

                    </div>


                    <div class="info-row">

                        <span>
                            Giá thuê:
                        </span>

                        <strong class="price">
                            @hall.RentalPrice.ToString("N0") VNĐ
                        </strong>

                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(hall.Description))
                {
                    <div class="hall-description">
                        @hall.Description
                    </div>
                }


            <div class="hall-actions">

                <button type="button"
                        class="btn-edit"
                        data-hall-id="@hall.HallId"
                        data-code="@hall.HallCode"
                        data-name="@hall.HallName"
                        data-minimum-capacity="@hall.MinimumCapacity"
                        data-maximum-capacity="@hall.MaximumCapacity"
                        data-rental-price="@hall.RentalPrice"
                        data-image-url="@hall.ImageUrl"
                        data-description="@hall.Description"
                        data-status="@hall.Status">

                    <i class="fa-regular fa-pen-to-square"></i>

                    Chỉnh sửa
                </button>


                <button type="button"
                        class="btn-status
                                @(hall.Status == HallStatusCodes.Active
                                                            ? "btn-status-active"
                                                            : hall.Status == HallStatusCodes.Maintenance
                                                                ? "btn-status-maintenance"
                                                                : "btn-status-inactive")"
                        data-hall-id="@hall.HallId"
                        data-name="@hall.HallName"
                        data-status="@hall.Status">

                    @if (hall.Status == HallStatusCodes.Active)
                        {
                            <i class="fa-solid fa-circle-check"></i>
                        }
                        else if (hall.Status == HallStatusCodes.Maintenance)
                        {
                            <i class="fa-solid fa-screwdriver-wrench"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-circle-xmark"></i>
                        }

                        @(string.IsNullOrWhiteSpace(hall.StatusName) ? StatusDisplayNames.GetHallStatusName(hall.Status) : hall.StatusName)
                    </button>

                    <button type="button"
                            class="btn-delete"
                            data-hall-id="@hall.HallId"
                            data-name="@hall.HallName"
                            data-status="@hall.Status">

                        <i class="fa-regular fa-trash-can"></i>

                        Xóa
                    </button>

                </div>

            </div>

            index++;
        }

    </div>


    @if (Model.Halls.Count > 3)
    {
        <div class="show-more-wrapper">

            <button type="button"
                    id="toggleHallButton"
                    class="btn-show-more">

                <span id="toggleHallText">
                    Xem tất cả sảnh
                </span>

                <i id="toggleHallIcon"
                   class="fa-solid fa-chevron-down"></i>

            </button>

        </div>
    }


    <!-- LỊCH SẢNH THEO TUẦN -->
    <div class="schedule-section">

        <div class="schedule-header">

            <div>
                <h3>
                    <i class="fa-regular fa-calendar-days"></i>
                    Ma Trận Lịch Sảnh Theo Ngày & Ca Tổ Chức
                </h3>

                <p>
                    @Model.StartDate.ToString("dd/MM/yyyy")
                    -
                    @endDate.ToString("dd/MM/yyyy")
                </p>
            </div>

            <div class="week-navigation">

                <a class="week-button current-button"
                   href="@Url.Action(
                                              "Index",
                                              "AdminHall",
                                              new
                                              {
                                                  date = DateTime.Today.ToString("yyyy-MM-dd"),
                                                  hallId = Model.HallId
                                              })">

                    <i class="fa-solid fa-calendar-day"></i>
                    Tuần hiện tại
                </a>

                <a class="week-button"
                   href="@Url.Action(
                                                          "Index",
                                                          "AdminHall",
                                                          new
                                                          {
                                                              date = Model.StartDate.AddDays(-7).ToString("yyyy-MM-dd"),
                                                              hallId = Model.HallId
                                                          })">

                    <i class="fa-solid fa-chevron-left"></i>
                    Tuần trước
                </a>


                <span class="current-week">
                    @Model.StartDate.ToString("dd/MM")
                    -
                    @endDate.ToString("dd/MM/yyyy")
                </span>


                <a class="week-button"
                   href="@Url.Action(
                                                          "Index",
                                                          "AdminHall",
                                                          new
                                                          {
                                                              date = Model.StartDate.AddDays(7).ToString("yyyy-MM-dd"),
                                                              hallId = Model.HallId
                                                          })">

                    Tuần sau
                    <i class="fa-solid fa-chevron-right"></i>
                </a>

            </div>

        </div>



        @if (Model.WeeklySchedule == null ||
                Model.WeeklySchedule.Halls.Count == 0)
        {
            <div class="schedule-empty">
                Không có dữ liệu lịch sảnh.
            </div>
        }
        else
        {
            <div class="schedule-table-wrapper">

                <table class="schedule-table">

                    <thead>

                        <tr>

                            <th class="hall-column">
                                Sảnh Tiệc
                            </th>

                            @for (var i = 0; i < 7; i++)
                            {
                                var date = Model.StartDate.AddDays(i);

                                var dayName = date.DayOfWeek switch
                                {
                                    DayOfWeek.Monday => "Thứ Hai",
                                    DayOfWeek.Tuesday => "Thứ Ba",
                                    DayOfWeek.Wednesday => "Thứ Tư",
                                    DayOfWeek.Thursday => "Thứ Năm",
                                    DayOfWeek.Friday => "Thứ Sáu",
                                    DayOfWeek.Saturday => "Thứ Bảy",
                                    DayOfWeek.Sunday => "Chủ Nhật",
                                    _ => ""
                                };

                                <th>
                                    <strong>@dayName</strong>
                                    <span>@date.ToString("dd/MM/yyyy")</span>
                                </th>
                            }

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var hall in Model.WeeklySchedule.Halls)
                        {
                            <tr>

                                <!-- TÊN SẢNH -->
                                <td class="hall-column">

                                    <strong>
                                        @hall.HallName
                                    </strong>

                                    <span>
                                        @hall.HallCode
                                    </span>

                                    @if (hall.HallStatus != HallStatusCodes.Active)
                                    {
                                        <small>
                                            @(string.IsNullOrWhiteSpace(hall.HallStatusName) ? StatusDisplayNames.GetHallStatusName(hall.HallStatus) : hall.HallStatusName)
                                        </small>
                                    }

                                </td>


                                <!-- 7 NGÀY -->
                                @for (var i = 0; i < 7; i++)
                                {
                                    var date = Model.StartDate.AddDays(i);

                                    var lunchShift = hall.Schedule.FirstOrDefault(x =>
                                    x.Date.Date == date.Date &&
                                    x.Shift == "Ca trưa");

                                    var dinnerShift = hall.Schedule.FirstOrDefault(x =>
                                    x.Date.Date == date.Date &&
                                    x.Shift == "Ca tối");

                                    <td class="schedule-cell">

                                        @if (lunchShift != null)
                                        {
                                            var classStatus =
                                            lunchShift.Status == HallScheduleStatusCodes.Booked
                                            ? "slot-booked"
                                            : lunchShift.Status == HallScheduleStatusCodes.Locked
                                            ? "slot-locked"
                                            : "slot-empty";

                                            <div class="schedule-slot @classStatus
                                                                        @(lunchShift.Status != HallScheduleStatusCodes.Booked ? "editable-slot" : "")"
                                                 data-hall-schedule-id="@lunchShift.HallScheduleId"
                                                 data-status="@lunchShift.Status">

                                                <span class="slot-time">
                                                    Trưa
                                                </span>

                                                @if (lunchShift.Status == HallScheduleStatusCodes.Booked &&
                                                                                lunchShift.Booking != null)
                                                {
                                                    <strong>
                                                        <i class="fa-solid fa-calendar-check"></i>
                                                        @lunchShift.Booking.BookingCode
                                                    </strong>

                                                    <span class="booking-customer">
                                                        @lunchShift.Booking.CustomerName
                                                    </span>

                                                    @if (lunchShift.Booking.TableCount.HasValue)
                                                    {
                                                        <span class="booking-tables">
                                                            @lunchShift.Booking.TableCount bàn
                                                        </span>
                                                    }

                                                    <div class="booking-tooltip">

                                                        <strong>
                                                            @lunchShift.Booking.BookingCode
                                                        </strong>

                                                        <p>
                                                            Khách hàng:
                                                            @lunchShift.Booking.CustomerName
                                                        </p>

                                                        <p>
                                                            Số bàn:
                                                            @(lunchShift.Booking.TableCount?.ToString() ?? "Chưa xác định")
                                                        </p>

                                                        <p>
                                                            Số khách:
                                                            @(lunchShift.Booking.GuestCount?.ToString() ?? "Chưa xác định")
                                                        </p>

                                                        <p>
                                                            Trạng thái:
                                                            @lunchShift.Booking.BookingStatus
                                                        </p>

                                                    </div>
                                                }
                                                else
                                                {
                                                    <strong>
                                                        @if (lunchShift.Status == HallScheduleStatusCodes.Available)
                                                        {
                                                            <i class="fa-solid fa-circle-check"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fa-solid fa-lock"></i>
                                                        }

                                                        @(string.IsNullOrWhiteSpace(lunchShift.StatusName) ? StatusDisplayNames.GetHallScheduleStatusName(lunchShift.Status) : lunchShift.StatusName)
                                                    </strong>
                                                }

                                            </div>
                                        }


                                        @if (dinnerShift != null)
                                        {
                                            var classStatus =
                                            dinnerShift.Status == HallScheduleStatusCodes.Booked
                                            ? "slot-booked"
                                            : dinnerShift.Status == HallScheduleStatusCodes.Locked
                                            ? "slot-locked"
                                            : "slot-empty";

                                            <div class="schedule-slot @classStatus
                                                                        @(dinnerShift.Status != HallScheduleStatusCodes.Booked ? "editable-slot" : "")"
                                                 data-hall-schedule-id="@dinnerShift.HallScheduleId"
                                                 data-status="@dinnerShift.Status">

                                                <span class="slot-time">
                                                    Tối
                                                </span>

                                                @if (dinnerShift.Status == HallScheduleStatusCodes.Booked &&
                                                                                dinnerShift.Booking != null)
                                                {
                                                    <strong>
                                                        <i class="fa-solid fa-calendar-check"></i>
                                                        @dinnerShift.Booking.BookingCode
                                                    </strong>

                                                    <span class="booking-customer">
                                                        @dinnerShift.Booking.CustomerName
                                                    </span>

                                                    @if (dinnerShift.Booking.TableCount.HasValue)
                                                    {
                                                        <span class="booking-tables">
                                                            @dinnerShift.Booking.TableCount bàn
                                                        </span>
                                                    }

                                                    <div class="booking-tooltip">

                                                        <strong>
                                                            @dinnerShift.Booking.BookingCode
                                                        </strong>

                                                        <p>
                                                            Khách hàng:
                                                            @dinnerShift.Booking.CustomerName
                                                        </p>

                                                        <p>
                                                            Số bàn:
                                                            @(dinnerShift.Booking.TableCount?.ToString() ?? "Chưa xác định")
                                                        </p>

                                                        <p>
                                                            Số khách:
                                                            @(dinnerShift.Booking.GuestCount?.ToString() ?? "Chưa xác định")
                                                        </p>

                                                        <p>
                                                            Trạng thái:
                                                            @dinnerShift.Booking.BookingStatus
                                                        </p>

                                                    </div>
                                                }
                                                else
                                                {
                                                    <strong>
                                                        @if (dinnerShift.Status == HallScheduleStatusCodes.Available)
                                                        {
                                                            <i class="fa-solid fa-circle-check"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fa-solid fa-lock"></i>
                                                        }

                                                        @(string.IsNullOrWhiteSpace(dinnerShift.StatusName) ? StatusDisplayNames.GetHallScheduleStatusName(dinnerShift.Status) : dinnerShift.StatusName)
                                                    </strong>
                                                }

                                            </div>
                                        }

                                    </td>
                                }

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
    @{
        var totalShifts = 0;
        var bookedCount = 0;
        var availableCount = 0;
        var lockedCount = 0;

        if (Model.WeeklySchedule != null)
        {
            totalShifts = Model.WeeklySchedule.Halls
            .Sum(s => s.Schedule.Count);

            bookedCount = Model.WeeklySchedule.Halls
            .Sum(s => s.Schedule.Count(x => x.Status == HallScheduleStatusCodes.Booked));

            availableCount = Model.WeeklySchedule.Halls
            .Sum(s => s.Schedule.Count(x => x.Status == HallScheduleStatusCodes.Available));

            lockedCount = Model.WeeklySchedule.Halls
            .Sum(s => s.Schedule.Count(x => x.Status == HallScheduleStatusCodes.Locked));
        }

        var bookedPercentage = totalShifts > 0
        ? (double)bookedCount / totalShifts * 100
        : 0;

        var availablePercentage = totalShifts > 0
        ? (double)availableCount / totalShifts * 100
        : 0;

        var lockedPercentage = totalShifts > 0
        ? (double)lockedCount / totalShifts * 100
        : 0;
    }
    <div class="schedule-summary">

        <div class="summary-numbers">

            <span>
                <strong>Tổng số slot ca trong tuần:</strong>
                @totalShifts ca
                (@(Model.WeeklySchedule?.Halls.Count ?? 0) sảnh × 7 ngày × 2 ca)
            </span>

            <span class="summary-booked">
                <i class="fa-solid fa-calendar-check"></i>
                Đã đặt:
                <strong>@bookedCount ca (@bookedPercentage.ToString("0.0")%)</strong>
            </span>

            <span class="summary-empty">
                <i class="fa-solid fa-circle-check"></i>
                Còn trống:
                <strong>@availableCount ca (@availablePercentage.ToString("0.0")%)</strong>
            </span>

            @if (lockedCount > 0)
            {
                <span class="summary-locked">
                    <i class="fa-solid fa-lock"></i>
                    Tạm khóa:
                    <strong>@lockedCount ca (@lockedPercentage.ToString("0.0")%)</strong>
                </span>
            }

        </div>


        <div class="summary-actions">

            <button type="button"
                    class="summary-button"
                    onclick="window.location.reload()">

                <i class="fa-solid fa-rotate"></i>
                Tải lại lịch sảnh

            </button>


            <button type="button"
                    class="summary-button print-button"
                    onclick="window.print()">

                <i class="fa-solid fa-print"></i>
                In lịch điều phối tuần

            </button>

        </div>

    </div>

</section>
<footer class="admin-footer">

    <div>
        © @DateTime.Now.Year IRevirsidePlace.
        Quản Trị Hệ Thống Master Data
    </div>

    <div class="footer-right">

        <span>
            <i class="fa-solid fa-lock"></i>
            Phân quyền: Quản trị viên
        </span>

        <span class="footer-dot">•</span>

        <span>
            Hệ thống quản lý đặt tiệc cưới IRevirsidePlace
        </span>

    </div>

</footer>

<!-- MODAL THÊM SẢNH -->
<div id="addHallModal" class="modal-overlay">

    <div class="modal-box">

        <div class="modal-header">
            <div>
                <h3>Thêm Sảnh Tiệc Mới</h3>
                <p>Nhập thông tin sảnh tiệc vào hệ thống</p>
            </div>

            <button type="button"
                    class="modal-close"
                    id="closeAddHallModal">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>


        <form id="addHallForm">

            @Html.AntiForgeryToken()

            <div class="form-grid">

                <div class="form-group">
                    <label>Mã sảnh <span>*</span></label>

                    <input type="text"
                           name="HallCode"
                           placeholder="Ví dụ: S010"
                           required />
                </div>


                <div class="form-group">
                    <label>Tên sảnh <span>*</span></label>

                    <input type="text"
                           name="HallName"
                           placeholder="Tên sảnh"
                           required />
                </div>


                <div class="form-group">
                    <label>Sức chứa tối thiểu</label>

                    <input type="number"
                           name="MinimumCapacity"
                           min="0"
                           placeholder="Ví dụ: 200" />
                </div>


                <div class="form-group">
                    <label>Sức chứa tối đa <span>*</span></label>

                    <input type="number"
                           name="MaximumCapacity"
                           min="1"
                           placeholder="Ví dụ: 500"
                           required />
                </div>


                <div class="form-group form-full">
                    <label>Giá thuê sảnh <span>*</span></label>

                    <input type="number"
                           name="RentalPrice"
                           min="0"
                           step="1000"
                           placeholder="Ví dụ: 30000000"
                           required />
                </div>


                <div class="form-group form-full">
                    <label>Hình ảnh</label>

                    <input type="text"
                           name="ImageUrl"
                           placeholder="Đường dẫn hoặc URL hình ảnh" />
                </div>


                <div class="form-group form-full">
                    <label>Mô tả</label>

                    <textarea name="Description"
                              rows="4"
                              placeholder="Mô tả ngắn về sảnh"></textarea>
                </div>

            </div>


            <div id="addHallError" class="form-error"></div>


            <div class="modal-footer">

                <button type="button"
                        class="btn-cancel"
                        id="cancelAddHall">
                    Hủy
                </button>

                <button type="submit"
                        class="btn-save"
                        id="saveHallButton">

                    <i class="fa-solid fa-floppy-disk"></i>

                    Lưu sảnh tiệc

                </button>

            </div>

        </form>

    </div>

</div>

<!-- MODAL SỬA SẢNH -->
<div id="editHallModal" class="modal-overlay">

    <div class="modal-box">

        <div class="modal-header">

            <div>
                <h3>Chỉnh Sửa Sảnh Tiệc</h3>
                <p>Cập nhật thông tin sảnh tiệc</p>
            </div>

            <button type="button"
                    class="modal-close"
                    id="closeEditHallModal">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>


        <form id="editHallForm">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="editHallId" />

            <input type="hidden"
                   name="Status"
                   id="editStatus" />


            <div class="form-grid">

                <div class="form-group">

                    <label>
                        Mã sảnh <span>*</span>
                    </label>

                    <input type="text"
                           name="HallCode"
                           id="editHallCode"
                           required />

                </div>


                <div class="form-group">

                    <label>
                        Tên sảnh <span>*</span>
                    </label>

                    <input type="text"
                           name="HallName"
                           id="editHallName"
                           required />

                </div>


                <div class="form-group">

                    <label>Sức chứa tối thiểu</label>

                    <input type="number"
                           name="MinimumCapacity"
                           id="editMinimumCapacity"
                           min="0" />

                </div>


                <div class="form-group">

                    <label>
                        Sức chứa tối đa <span>*</span>
                    </label>

                    <input type="number"
                           name="MaximumCapacity"
                           id="editMaximumCapacity"
                           min="1"
                           required />

                </div>


                <div class="form-group form-full">

                    <label>
                        Giá thuê sảnh <span>*</span>
                    </label>

                    <input type="number"
                           name="RentalPrice"
                           id="editRentalPrice"
                           min="0"
                           step="1000"
                           required />

                </div>


                <div class="form-group form-full">

                    <label>Hình ảnh</label>

                    <input type="text"
                           name="ImageUrl"
                           id="editImageUrl" />

                </div>


                <div class="form-group form-full">

                    <label>Mô tả</label>

                    <textarea name="Description"
                              id="editDescription"
                              rows="4"></textarea>

                </div>

            </div>


            <div id="editHallError"
                 class="form-error"></div>


            <div class="modal-footer">

                <button type="button"
                        class="btn-cancel"
                        id="cancelEditHall">

                    Hủy

                </button>

                <button type="submit"
                        class="btn-save"
                        id="saveEditHallButton">

                    <i class="fa-solid fa-floppy-disk"></i>

                    Lưu thay đổi

                </button>

            </div>

        </form>

    </div>

</div>

<!-- MODAL TRẠNG THÁI SẢNH -->
<div id="statusHallModal" class="modal-overlay">

    <div class="modal-box small-modal">

        <div class="modal-header">

            <div>
                <h3>Trạng Thái Sảnh</h3>

                <p id="statusHallName">
                    Cập nhật trạng thái sảnh
                </p>
            </div>

            <button type="button"
                    class="modal-close"
                    id="closeStatusHallModal">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>


        <form id="statusHallForm">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="statusHallId" />


            <div class="form-group">

                <label>Trạng thái sảnh</label>

                <select id="statusHallSelect"
                        name="status">

                    <option value="@HallStatusCodes.Active">
                        Hoạt động
                    </option>

                    <option value="@HallStatusCodes.Maintenance">
                        Bảo trì
                    </option>

                    <option value="@HallStatusCodes.Inactive">
                        Ngừng hoạt động
                    </option>

                </select>

            </div>


            <div class="status-note">

                <i class="fa-solid fa-circle-info"></i>

                <span>
                    Đây là trạng thái chung của sảnh, không phải trạng thái của từng ca tổ chức.
                </span>

            </div>


            <div id="statusHallError"
                 class="form-error"></div>


            <div class="modal-footer">

                <button type="button"
                        class="btn-cancel"
                        id="cancelStatusHall">

                    Hủy

                </button>

                <button type="submit"
                        class="btn-save"
                        id="saveStatusHallButton">

                    <i class="fa-solid fa-floppy-disk"></i>

                    Lưu trạng thái

                </button>

            </div>

        </form>

    </div>

</div>

<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts
{
    <script>

            const toggleButton =
                document.getElementById("toggleHallButton");

            if (toggleButton) {

                let expanded = false;

                toggleButton.addEventListener("click", function () {

                    expanded = !expanded;

                    const extraHalls =
                        document.querySelectorAll(".extra-hall");

                    extraHalls.forEach(function (item) {

                        if (expanded) {
                            item.classList.remove("hidden");
                        }
                        else {
                            item.classList.add("hidden");
                        }

                    });

                    const text =
                        document.getElementById("toggleHallText");

                    const icon =
                        document.getElementById("toggleHallIcon");

                    if (expanded) {

                        text.textContent = "Thu gọn";

                        icon.classList.remove("fa-chevron-down");
                        icon.classList.add("fa-chevron-up");

                    }
                    else {

                        text.textContent = "Xem tất cả sảnh";

                        icon.classList.remove("fa-chevron-up");
                        icon.classList.add("fa-chevron-down");

                    }

                });

            }

                    const editableSlots =
                document.querySelectorAll(".editable-slot");

            editableSlots.forEach(function (slot) {

                slot.addEventListener("click", async function () {

                    const hallScheduleId = slot.dataset.hallScheduleId;
                    const currentStatus = slot.dataset.status;

                    const newStatus =
                        currentStatus === "@HallScheduleStatusCodes.Available"
                            ? "@HallScheduleStatusCodes.Locked"
                            : "@HallScheduleStatusCodes.Available";

                    const message =
                        newStatus === "@HallScheduleStatusCodes.Locked"
                            ? "Bạn có muốn tạm khóa ca này không?"
                            : "Bạn có muốn mở lại ca này không?";

                    if (!confirm(message)) {
                        return;
                    }

                    const token =
                        document.querySelector(
                            '#antiForgeryForm input[name="__RequestVerificationToken"]'
                        ).value;

                    const formData = new FormData();

                    formData.append("status", newStatus);
                    formData.append("__RequestVerificationToken", token);

                    try {

                        const response = await fetch(
                            `/admin/quan-ly-sanh/lich/${hallScheduleId}/status`,
                            {
                                method: "POST",
                                body: formData
                            }
                        );

                        const result = await response.json();

                        if (!result.success) {
                            alert(result.message);
                            return;
                        }

                        // Reload để lấy dữ liệu mới nhất từ Backend
                        window.location.reload();

                    }
                    catch (error) {

                        alert("Không thể kết nối đến hệ thống.");

                    }

                });

            });
            const addHallModal =
        document.getElementById("addHallModal");

        const openAddHallModal =
        document.getElementById("openAddHallModal");

        const closeAddHallModal =
        document.getElementById("closeAddHallModal");

        const cancelAddHall =
        document.getElementById("cancelAddHall");

        const addHallForm =
        document.getElementById("addHallForm");

        const addHallError =
        document.getElementById("addHallError");


        function openHallModal() {
        addHallModal.classList.add("show");
        }


        function closeHallModal() {
        addHallModal.classList.remove("show");

        addHallForm.reset();

        addHallError.textContent = "";
        }


        openAddHallModal.addEventListener("click", function () {
        openHallModal();
        });


        closeAddHallModal.addEventListener("click", function () {
        closeHallModal();
        });


        cancelAddHall.addEventListener("click", function () {
        closeHallModal();
        });


        addHallModal.addEventListener("click", function (event) {

        if (event.target === addHallModal) {
            closeHallModal();
        }

        });


        addHallForm.addEventListener("submit", async function (event) {

        event.preventDefault();

        addHallError.textContent = "";

        const formData =
            new FormData(addHallForm);

        const saveButton =
            document.getElementById("saveHallButton");

        saveButton.disabled = true;

        saveButton.innerHTML =
            '<i class="fa-solid fa-spinner fa-spin"></i> Đang lưu...';

        try {

            const response = await fetch(
                "/admin/quan-ly-sanh/them",
                {
                    method: "POST",
                    body: formData
                }
            );

            const result = await response.json();

            if (!result.success) {

                addHallError.textContent =
                    result.message;

                return;
            }

            window.location.reload();

        }
        catch (error) {

            addHallError.textContent =
                "Không thể kết nối đến hệ thống.";

        }
        finally {

            saveButton.disabled = false;

            saveButton.innerHTML =
                '<i class="fa-solid fa-floppy-disk"></i> Lưu sảnh tiệc';

        }

        });

                const editHallModal =
                document.getElementById("editHallModal");

            const editHallForm =
                document.getElementById("editHallForm");

            const editHallButtons =
                document.querySelectorAll(".btn-edit");

            const closeEditHallModal =
                document.getElementById("closeEditHallModal");

            const cancelEditHall =
                document.getElementById("cancelEditHall");

            const editHallError =
                document.getElementById("editHallError");


            function closeEditModal() {

                editHallModal.classList.remove("show");

                editHallError.textContent = "";

            }


            editHallButtons.forEach(function (button) {

                button.addEventListener("click", function () {

                    document.getElementById("editHallId").value =
                        button.dataset.hallId;

                    document.getElementById("editHallCode").value =
                        button.dataset.code ?? "";

                    document.getElementById("editHallName").value =
                        button.dataset.name ?? "";

                    document.getElementById("editMinimumCapacity").value =
                        button.dataset.minimumCapacity ?? "";

                    document.getElementById("editMaximumCapacity").value =
                        button.dataset.maximumCapacity ?? "";

                    document.getElementById("editRentalPrice").value =
                        button.dataset.rentalPrice ?? "";

                    document.getElementById("editImageUrl").value =
                        button.dataset.imageUrl ?? "";

                    document.getElementById("editDescription").value =
                        button.dataset.description ?? "";

                    document.getElementById("editStatus").value =
                        button.dataset.status ?? "";

                    editHallError.textContent = "";

                    editHallModal.classList.add("show");

                });

            });


            closeEditHallModal.addEventListener("click", function () {
                closeEditModal();
            });


            cancelEditHall.addEventListener("click", function () {
                closeEditModal();
            });


            editHallModal.addEventListener("click", function (event) {

                if (event.target === editHallModal) {
                    closeEditModal();
                }

            });

                    editHallForm.addEventListener("submit", async function (event) {

                event.preventDefault();

                editHallError.textContent = "";

                const hallId =
                    document.getElementById("editHallId").value;

                const formData =
                    new FormData(editHallForm);

                const saveButton =
                    document.getElementById("saveEditHallButton");

                saveButton.disabled = true;

                saveButton.innerHTML =
                    '<i class="fa-solid fa-spinner fa-spin"></i> Đang lưu...';

                try {

                    const response = await fetch(
                        `/admin/quan-ly-sanh/sua/${hallId}`,
                        {
                            method: "POST",
                            body: formData
                        }
                    );

                    const result = await response.json();

                    if (!result.success) {

                        editHallError.textContent =
                            result.message;

                        return;
                    }

                    window.location.reload();

                }
                catch (error) {

                    editHallError.textContent =
                        "Không thể kết nối đến hệ thống.";

                }
                finally {

                    saveButton.disabled = false;

                    saveButton.innerHTML =
                        '<i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi';

                }

            });

                    const statusHallModal =
                document.getElementById("statusHallModal");

            const statusHallForm =
                document.getElementById("statusHallForm");

            const statusHallButtons =
                document.querySelectorAll(".btn-status");

            const closeStatusHallModal =
                document.getElementById("closeStatusHallModal");

            const cancelStatusHall =
                document.getElementById("cancelStatusHall");

            const statusHallError =
                document.getElementById("statusHallError");


            function closeStatusModal() {

                statusHallModal.classList.remove("show");

                statusHallError.textContent = "";

            }


            statusHallButtons.forEach(function (button) {

                button.addEventListener("click", function () {

                    document.getElementById("statusHallId").value =
                        button.dataset.hallId;

                    document.getElementById("statusHallSelect").value =
                        button.dataset.status;

                    document.getElementById("statusHallName").textContent =
                        button.dataset.name;

                    statusHallError.textContent = "";

                    statusHallModal.classList.add("show");

                });

            });


            closeStatusHallModal.addEventListener("click", function () {
                closeStatusModal();
            });


            cancelStatusHall.addEventListener("click", function () {
                closeStatusModal();
            });


            statusHallModal.addEventListener("click", function (event) {

                if (event.target === statusHallModal) {
                    closeStatusModal();
                }

            });

                    statusHallForm.addEventListener("submit", async function (event) {

                event.preventDefault();

                statusHallError.textContent = "";

                const hallId =
                    document.getElementById("statusHallId").value;

                const formData =
                    new FormData(statusHallForm);

                const saveButton =
                    document.getElementById("saveStatusHallButton");

                saveButton.disabled = true;

                saveButton.innerHTML =
                    '<i class="fa-solid fa-spinner fa-spin"></i> Đang lưu...';

                try {

                    const response = await fetch(
                        `/admin/quan-ly-sanh/status/${hallId}`,
                        {
                            method: "POST",
                            body: formData
                        }
                    );

                    const result = await response.json();

                    if (!result.success) {

                        statusHallError.textContent =
                            result.message;

                        return;
                    }

                    window.location.reload();

                }
                catch (error) {

                    statusHallError.textContent =
                        "Không thể kết nối đến hệ thống.";

                }
                finally {

                    saveButton.disabled = false;

                    saveButton.innerHTML =
                        '<i class="fa-solid fa-floppy-disk"></i> Lưu trạng thái';

                }

            });

                    const deleteHallButtons =
                document.querySelectorAll(".btn-delete");

            deleteHallButtons.forEach(function (button) {

                button.addEventListener("click", async function () {

                    const hallId = button.dataset.hallId;
                    const hallName = button.dataset.name;
                    const status = button.dataset.status;

                    // Prevent deletion immediately in the UI.
                    if (status === "@HallStatusCodes.Active") {

                        alert(
                            `Không thể xóa "${hallName}" vì sảnh đang ở trạng thái Hoạt động.\n\n` +
                            `Hãy chuyển sảnh sang Bảo trì hoặc Ngừng hoạt động trước.`
                        );

                        return;
                    }

                    const confirmed = confirm(
                        `Bạn có chắc muốn xóa sảnh "${hallName}" không?\n\n` +
                        `Nếu sảnh đã từng có booking, hệ thống sẽ không cho phép xóa.`
                    );

                    if (!confirmed) {
                        return;
                    }

                    const token =
                        document.querySelector(
                            '#antiForgeryForm input[name="__RequestVerificationToken"]'
                        ).value;

                    const formData = new FormData();

                    formData.append(
                        "__RequestVerificationToken",
                        token
                    );

                    try {

                        const response = await fetch(
                            `/admin/quan-ly-sanh/xoa/${hallId}`,
                            {
                                method: "POST",
                                body: formData
                            }
                        );

                        const result = await response.json();

                        if (!result.success) {

                            alert(result.message);

                            return;
                        }

                        alert(result.message);

                        window.location.reload();

                    }
                    catch (error) {

                        alert("Không thể kết nối đến hệ thống.");

                    }

                });

            });

    </script>
}
