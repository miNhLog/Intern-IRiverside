@using System.Globalization
@model HeThongDatTiecCuoi_WEB.Models.ManagerDish.ManagerDishPageViewModel
@{ Layout="_AdminLayout"; ViewData["Title"]="Quản lý món ăn"; var vi=CultureInfo.GetCultureInfo("vi-VN"); string CatClass(string value)=>value switch { "Món khai vị"=>"starter", "Món súp"=>"soup", "Món chính"=>"main", _=>"dessert" }; }
@section Styles { <link rel="stylesheet" href="~/css/manager-dish.css" asp-append-version="true" /> }

<section class="md-page" data-detail-base="/quan-ly/mon-an">
 @Html.AntiForgeryToken()
 <header class="md-header manager-section-header"><div><div class="md-breadcrumb breadcrumb">Quản trị hệ thống <i class="fa-solid fa-chevron-right"></i> <strong>Món ăn</strong></div><h1>Quản lý món ăn</h1><p>Quản lý danh sách món ăn, hình ảnh và thông tin sử dụng trong thực đơn.</p></div><button class="md-btn gold admin-create-button" type="button" data-open="createDishModal"><i class="fa-solid fa-plus"></i> Thêm món ăn</button></header>
 @if(TempData["Success"] is string success){<div class="md-alert success">@success</div>} @if(TempData["Error"] is string error){<div class="md-alert error">@error</div>} @if(!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<div class="md-alert error">@Model.ErrorMessage</div>}
 <div class="md-kpis"><article><i class="fa-solid fa-bowl-food gold"></i><span><small>Tổng món ăn</small><b>@Model.TotalDishes</b></span></article><article><i class="fa-regular fa-circle-check green"></i><span><small>Đang phục vụ</small><b>@Model.ActiveDishes</b></span></article><article><i class="fa-regular fa-circle-pause orange"></i><span><small>Tạm ngưng</small><b>@Model.InactiveDishes</b></span></article><article><i class="fa-solid fa-layer-group purple"></i><span><small>Danh mục món</small><b>@Model.CategoryCount</b></span></article></div>
 <form method="get" class="md-filters"><label><i class="fa-solid fa-magnifying-glass"></i><input name="keyword" value="@Model.Keyword" placeholder="Tìm mã hoặc tên món ăn..." /></label><select name="category" onchange="this.form.submit()"><option value="">Tất cả danh mục</option>@foreach(var cat in new[]{"Món khai vị","Món súp","Món chính","Món tráng miệng"}){<option selected="@(Model.Category==cat ? "selected" : null)">@cat</option>}</select><select name="status" onchange="this.form.submit()"><option value="">Tất cả trạng thái</option><option value="ACTIVE" selected="@(Model.Status=="ACTIVE" ? "selected" : null)">Đang phục vụ</option><option value="INACTIVE" selected="@(Model.Status=="INACTIVE" ? "selected" : null)">Tạm ngưng</option></select><button class="md-btn navy">Tìm kiếm</button></form>
 <div class="md-workspace @(Model.Items.Count==0 ? "empty" : "")"><div class="md-left">
 @if(Model.Items.Count==0){<div class="md-empty"><i class="fa-solid fa-bowl-food"></i><h2>@(string.IsNullOrWhiteSpace(Model.Keyword)&&string.IsNullOrWhiteSpace(Model.Category)&&string.IsNullOrWhiteSpace(Model.Status)?"Chưa có món ăn.":"Không tìm thấy món ăn phù hợp.")</h2><button class="md-btn gold admin-create-button" type="button" data-open="createDishModal">Thêm món ăn</button></div>}
 else {<div class="md-grid">@foreach(var dish in Model.Items){<article class="md-card" tabindex="0" data-dish-id="@dish.DishId" data-code="@dish.DishCode" data-name="@dish.DishName" data-category="@dish.Category" data-price="@dish.Price" data-image="@dish.ImageUrl" data-status="@dish.Status" data-usage="@dish.MenuUsageCount"><div class="md-image">@if(!string.IsNullOrWhiteSpace(dish.ImageUrl)){<img src="@dish.ImageUrl" alt="@dish.DishName" onerror="this.hidden=true;this.nextElementSibling.hidden=false"/><span class="md-placeholder" hidden><i class="fa-solid fa-bowl-food"></i></span>}else{<span class="md-placeholder"><i class="fa-solid fa-bowl-food"></i></span>}<span class="md-status @(dish.Status=="ACTIVE"?"active":"inactive")">@(dish.Status=="ACTIVE"?"Đang phục vụ":"Tạm ngưng")</span></div><div class="md-card-body"><div class="md-card-top"><span class="md-code">@dish.DishCode</span><details><summary><i class="fa-solid fa-ellipsis"></i></summary><div><button type="button" data-edit>Chỉnh sửa</button><button type="button" data-status>@(dish.Status=="ACTIVE"?"Chuyển sang Tạm ngưng":"Áp dụng lại")</button></div></details></div><h2>@dish.DishName</h2><span class="md-category @CatClass(dish.Category)">@dish.Category</span><footer><strong>@dish.Price.ToString("N0",vi) đ</strong><small>@dish.MenuUsageCount thực đơn</small></footer></div></article>}</div>}
 @if(Model.TotalItems>0){var first=(Model.Page-1)*Model.PageSize+1;var last=Math.Min(Model.Page*Model.PageSize,Model.TotalItems);<footer class="md-pagination"><span>Hiển thị @first - @last trong tổng số @Model.TotalItems món ăn</span><nav><a class="@(Model.Page<=1?"disabled":"")" href="@Url.Action("Index",new{keyword=Model.Keyword,category=Model.Category,status=Model.Status,page=Model.Page-1})">‹</a>@for(var p=Math.Max(1,Model.Page-2);p<=Math.Min(Model.TotalPages,Model.Page+2);p++){<a class="@(p==Model.Page?"current":"")" href="@Url.Action("Index",new{keyword=Model.Keyword,category=Model.Category,status=Model.Status,page=p})">@p</a>}<a class="@(Model.Page>=Model.TotalPages?"disabled":"")" href="@Url.Action("Index",new{keyword=Model.Keyword,category=Model.Category,status=Model.Status,page=Model.Page+1})">›</a></nav></footer>}
 </div><aside class="md-detail" id="dishDetail"><div class="md-detail-empty"><i class="fa-regular fa-hand-pointer"></i><h2>Chọn một món ăn</h2><p>Thông tin chi tiết và các thực đơn đang sử dụng sẽ hiển thị tại đây.</p></div></aside></div>
</section>

<div class="md-modal" id="createDishModal" hidden><form method="post" action="@Url.Action("Create")" enctype="multipart/form-data" class="md-modal-box">@Html.AntiForgeryToken()<header><h2>Thêm món ăn</h2><button type="button" data-close>×</button></header><div class="md-form-grid"><label class="md-upload"><span class="md-preview"><i class="fa-solid fa-image"></i></span><b>Hình ảnh món ăn</b><small>Không chọn ảnh, hệ thống sẽ sử dụng ảnh mặc định.</small><input type="file" name="Image" accept="image/jpeg,image/png,image/webp" data-preview /></label><div><label>Tên món ăn *<input name="DishName" maxlength="200" required /></label><label>Danh mục *<select name="Category" required><option value="">Chọn danh mục</option><option>Món khai vị</option><option>Món súp</option><option>Món chính</option><option>Món tráng miệng</option></select></label><label>Giá bán *<input name="Price" type="number" min="0" step="1" required /></label></div></div><footer><button class="md-btn light" type="button" data-close>Hủy</button><button class="md-btn gold">Thêm món ăn</button></footer></form></div>
<div class="md-modal" id="editDishModal" hidden><form method="post" action="@Url.Action("Update")" enctype="multipart/form-data" class="md-modal-box">@Html.AntiForgeryToken()<input type="hidden" name="DishId"/><header><h2>Chỉnh sửa món ăn</h2><button type="button" data-close>×</button></header><div class="md-form-grid"><label class="md-upload"><span class="md-preview"><i class="fa-solid fa-image"></i></span><b>Hình ảnh món ăn</b><input type="file" name="NewImage" accept="image/jpeg,image/png,image/webp" data-preview/><span class="md-delete-image"><input type="checkbox" name="DeleteImage" value="true"/> Xóa ảnh hiện tại</span></label><div><label>Mã món<input name="DishCode" disabled /></label><label>Tên món ăn *<input name="DishName" maxlength="200" required /></label><label>Danh mục *<select name="Category" required><option>Món khai vị</option><option>Món súp</option><option>Món chính</option><option>Món tráng miệng</option></select></label><label>Giá bán *<input name="Price" type="number" min="0" required /></label></div></div><footer><button class="md-btn light" type="button" data-close>Hủy</button><button class="md-btn gold">Lưu thay đổi</button></footer></form></div>
<div class="md-modal" id="statusModal" hidden><form id="statusForm" class="md-confirm">@Html.AntiForgeryToken()<header><h2 id="statusTitle">Xác nhận</h2><button type="button" data-close>×</button></header><p id="statusMessage"></p><footer><button type="button" class="md-btn light" data-close>Hủy</button><button class="md-btn gold" id="statusConfirm">Xác nhận</button></footer></form></div>
@section Scripts { <script src="~/js/manager-dish.js" asp-append-version="true"></script> }
