@model HeThongDatTiecCuoi_WEB.Models.Recommendation.RecommendationRequestViewModel
@{
    ViewData["Title"] = "Gợi ý gói tiệc cưới Top 3 tối ưu - Riverside Palace";
    ViewData["PublicActivePage"] = "recommendation";
    var hallPlaceholder = Url.Content("~/images/home/hall-placeholder.jpg");
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;family=Plus+Jakarta+Sans:wght@300..800&amp;family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recommendation.css" asp-append-version="true" />
    <style>
        .recom-budget-badge{display:inline-block;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:700;}
        .recom-budget-badge--success{color:#047857;background:#D1FAE5;border:1px solid #6EE7B7;}
        .recom-budget-badge--warning{color:#92400E;background:#FEF3C7;border:1px solid #FCD34D;}
        .recom-analysis--sub{color:#64748B;font-size:12px;}
        .recom-explain-list{margin:10px 0 0 0;padding-left:18px;font-size:12.5px;color:#334155;display:grid;gap:4px;}
    </style>
}

<div class="home-page">
    <partial name="_PublicHeader" />

    <main class="recom-main-wrapper">
        <section class="hero recom-hero" aria-labelledby="recom-hero-title">
            <div class="hero-image" aria-hidden="true"></div>
            <div class="home-container hero-inner recom-hero-inner">
                <div class="hero-copy">
                    <span class="eyebrow hero-eyebrow"><span class="material-symbols-outlined" aria-hidden="true">auto_awesome</span> Gợi ý thông minh &bull; Riverside Palace</span>
                    <h1 id="recom-hero-title">Thiết Kế Đám Cưới Trong Mơ</h1>
                    <p>Nhập kế hoạch dự toán ngân sách và ý tưởng của hai bạn. Hệ thống đề xuất <strong class="recom-hero-accent">Top 3 Gói Tiệc Tối Ưu Nhất</strong> theo ngân sách, sức chứa và phong cách.</p>
                    <div class="hero-actions">
                        <a class="button button-gold" href="#clientRecomForm">Bắt đầu gợi ý trong 1 phút <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
                        <button class="button button-glass" type="button" onclick="openShowtimeModal()"><span class="material-symbols-outlined" aria-hidden="true">calendar_month</span> Xem lịch &amp; ca trống thực tế</button>
                    </div>
                </div>
                <div class="recom-hero-stats" aria-label="Điểm nổi bật gợi ý">
                    <span class="recom-hero-stat"><span class="material-symbols-outlined" aria-hidden="true">apartment</span> 9 sảnh ven sông Sài Gòn</span>
                    <span class="recom-hero-stat"><span class="material-symbols-outlined" aria-hidden="true">restaurant_menu</span> 24 set thực đơn chuẩn 10 khách/bàn</span>
                    <span class="recom-hero-stat"><span class="material-symbols-outlined" aria-hidden="true">workspace_premium</span> Scoring Top 3 minh bạch theo ngân sách</span>
                </div>
            </div>
        </section>

        <div class="recom-box-limit">
            <form id="clientRecomForm" onsubmit="handleAnalyzeCombos(event)" class="recom-card recom-form">
                <div>
                    <div class="recom-section-head">
                        <h3 class="recom-section-title">
                            <span class="recom-step-badge">1</span>
                            <span>Thông Tin Cặp Đôi</span>
                        </h3>
                        <span class="recom-hint-inline">Có thể chỉnh sửa trực tiếp thông tin liên hệ</span>
                    </div>
                    <div class="recom-grid-3">
                        <div>
                            <label class="recom-label" for="coupleName">Họ tên Cô dâu &amp; Chú rể *</label>
                            <input type="text" id="coupleName" required value="@Model.CoupleName" placeholder="VD: Trần Hoàng &amp; Mai Phương" class="recom-form-control">
                        </div>
                        <div>
                            <label class="recom-label" for="phoneNumber">Số điện thoại liên hệ *</label>
                            <input type="tel" id="phoneNumber" required value="@Model.PhoneNumber" placeholder="09xxxxxxxx" class="recom-form-control">
                        </div>
                        <div>
                            <label class="recom-label" for="email">Email nhận bảng dự toán *</label>
                            <input type="email" id="email" required value="@Model.Email" placeholder="wedding@gmail.com" class="recom-form-control">
                        </div>
                    </div>
                </div>

                <hr class="recom-divider">

                <div>
                    <div class="recom-section-head">
                        <h3 class="recom-section-title">
                            <span class="recom-step-badge">2</span>
                            <span>Thời Gian Tổ Chức &amp; Quy Mô Bàn Tiệc</span>
                        </h3>
                        <button type="button" onclick="openShowtimeModal()" class="recom-btn-ghost">
                            <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
                            <span>Xem Lịch &amp; Ca Trống Thực Tế</span>
                        </button>
                    </div>

                    <div class="recom-search-grid">
                        <div>
                            <label class="recom-label" for="eventDate">
                                <span>Ngày tổ chức dự kiến *</span>
                                <span class="recom-help-wrap">
                                    <button type="button" id="dateHelpBtn" class="recom-help-btn" aria-label="Xem quy định thời gian đặt tiệc" aria-expanded="false" aria-controls="dateHelpPopover" onclick="toggleDateHelp(event)" title="Quy định thời gian đặt tiệc?">?</button>
                                    <span id="dateHelpPopover" class="recom-popover" hidden>
                                        <strong>Riverside Palace nhận đặt tiệc trước từ 30 ngày đến tối đa 1 năm (365 ngày).</strong><br />
                                        Quy định này giúp nhà hàng có đủ thời gian chuẩn bị sảnh, thực đơn và dịch vụ chu đáo nhất cho hai bạn.<br />
                                        Hai bạn vui lòng chọn ngày trong khoảng cho phép; để xem sảnh còn trống thực tế, bấm nút <em>“Xem Lịch &amp; Ca Trống Thực Tế”</em> ở phía trên nhé!
                                    </span>
                                </span>
                            </label>
                            <input type="date" id="eventDate" required onchange="handleDateChanged()" class="recom-form-control">
                        </div>
                        <div>
                            <label class="recom-label" for="shift">Buổi tiệc mong muốn *</label>
                            <select id="shift" class="recom-form-control">
                                <option value="Ca tối" selected>Buổi tối (17:30 – 21:30)</option>
                                <option value="Ca trưa">Buổi trưa (10:30 – 14:00)</option>
                            </select>
                        </div>
                        <div>
                            <label class="recom-label-row" for="guestCount">
                                <span>Số lượng khách dự kiến *</span>
                                <span class="recom-label-accent">150 – 1400 khách</span>
                            </label>
                            <input type="number" id="guestCount" required min="150" max="1400" step="10" value="@Model.GuestCount" placeholder="Ví dụ: 300 (150 – 1400 khách, 10 khách/bàn)" oninput="syncGuestToTables()" class="recom-form-control recom-form-control--strong">
                            <input type="hidden" id="officialTableCount" value="30">
                        </div>
                        <div>
                            <label class="recom-label-row" for="spareTableCount">
                                <span>Bàn dự phòng</span>
                                <span class="recom-label-accent">0 – 10 bàn</span>
                            </label>
                            <input type="number" id="spareTableCount" min="0" max="10" value="@Model.SpareTableCount" placeholder="Ví dụ: 2 (để trống = 0 bàn)" oninput="syncGuestToTables()" onchange="validateTableCounts()" class="recom-form-control">
                        </div>
                    </div>
                    <div id="tableConvertHint" class="recom-convert-hint">Nhập số khách để tự động quy đổi số bàn (quy chuẩn 10 khách/bàn) + số bàn dự phòng.</div>

                    <div class="recom-grid-2">
                        <div>
                            <label class="recom-label" for="expectedBudget">
                                <span>Tổng ngân sách dự trù (VNĐ) *</span>
                                <span class="recom-help-wrap">
                                    <button type="button" id="budgetHelpBtn" class="recom-help-btn" aria-label="Xem khoảng ngân sách hợp lệ" aria-expanded="false" aria-controls="budgetHelpPopover" onclick="toggleBudgetHelp(event)" title="Khoảng ngân sách hợp lệ?">?</button>
                                    <span id="budgetHelpPopover" class="recom-popover" hidden>
                                        <strong>Nhập ngân sách trong khoảng 100 triệu – 3 tỷ VNĐ.</strong><br />
                                        Cách ước lượng theo catalog thật Riverside Palace:
                                        <ul>
                                            <li>Sảnh: <strong>20 – 80 triệu</strong> (Elbe 20tr &rarr; Grand Ballroom 80tr)</li>
                                            <li>Menu: <strong>4,35 – 5,9 triệu/bàn</strong> (10 khách/bàn)</li>
                                            <li>Decor: <strong>18 – 28 triệu</strong> + dịch vụ thêm 0 – 6 triệu</li>
                                        </ul>
                                        Công thức tối thiểu theo số bàn thực tế:<br />
                                        <strong>Min &asymp; 38tr (sảnh rẻ nhất 20tr + decor rẻ nhất 18tr) + tổng số bàn &times; 4,35tr</strong><br />
                                        Vd 15 bàn (150 khách): tối thiểu &asymp; <strong>103,3 triệu</strong> (20 + 15&times;4,35 + 18, chưa gồm dịch vụ).<br />
                                        Vd 30 bàn: tối thiểu &asymp; <strong>168,5 triệu</strong> (20 + 30&times;4,35 + 18), tối đa &asymp; <strong>285 triệu</strong> (80 + 30&times;5,9 + 28, chưa gồm dịch vụ).<br />
                                        Hệ thống chỉ gợi ý combo <strong>trong ngân sách hoặc vượt tối đa 5 – 10 triệu</strong>. Nếu ngân sách thấp hơn mức tối thiểu, hãy <em>tăng ngân sách</em> hoặc <em>giảm số khách</em>.
                                    </span>
                                </span>
                            </label>
                            <input type="text" inputmode="numeric" id="expectedBudget" required value="@Model.ExpectedBudget" placeholder="Ví dụ: 200.000.000 (tối thiểu 100 triệu – 3 tỷ VNĐ)" class="recom-form-control recom-form-control--strong" oninput="formatBudgetInput(this); updateBudgetMinHint()">
                            <small id="budgetMinHint" class="recom-small-note">Ngân sách tối thiểu 100 triệu; với quy mô hiện tại cần khoảng -- để không vượt quá 10 triệu.</small>
                        </div>
                        <div>
                            <label class="recom-label" for="budgetPriority">Ưu tiên cân đối</label>
                            <select id="budgetPriority" class="recom-form-control">
                                <option value="BALANCED" selected>Cân đối toàn diện (Ẩm thực ngon &amp; Không gian lộng lẫy)</option>
                                <option value="PRIORITIZE_FOOD">Ưu tiên Ẩm thực (Nâng cấp thực đơn hải sản cao cấp)</option>
                                <option value="PRIORITIZE_DECOR">Ưu tiên Không gian (Sảnh tiệc hoành tráng &amp; decor hoa tươi)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <hr class="recom-divider">

                <div>
                    <h3 class="recom-section-title">
                        <span class="recom-step-badge">3</span>
                        <span>Gu Thẩm Mỹ &amp; Dịch Vụ Cưới Trọn Gói</span>
                    </h3>
                    <div class="recom-grid-3" style="margin-top:16px;">
                        <div>
                            <label class="recom-label" for="preferredSpaceType">Không gian yêu thích</label>
                            <select id="preferredSpaceType" class="recom-form-control">
                                <option value="">-- Tùy chọn linh hoạt --</option>
                                <option value="INDOOR_PILLARLESS">Đại sảnh vòm trần cao không cột (Grand Ballroom, Seine)</option>
                                <option value="OUTDOOR_RIVER">Sân vườn ven sông thoáng đãng (Green Riverside)</option>
                                <option value="COZY_INTIMATE">Ấm cúng, thanh lịch (Elbe, Danube, Amur)</option>
                            </select>
                        </div>
                        <div>
                            <label class="recom-label" for="desiredStyle">Concept Decor Hot Trend</label>
                            <select id="desiredStyle" class="recom-form-control">
                                <option value="Hiện đại / lãng mạn" selected>Midnight Celestial Blue (Đêm Huyền Bí Sắc Xanh)</option>
                                <option value="Hoàng gia">Royal Versailles Gold (Hoàng Gia Versailles)</option>
                                <option value="Sân vườn / lãng mạn">Botanical Garden Muse (Vườn Cổ Tích Rustic)</option>
                                <option value="Cổ tích / lãng mạn">Fairy Princesscore (Công Chúa Ngọt Ngào)</option>
                                <option value="Nhẹ nhàng">Pure Minimalism (Trắng Pha Lê Tinh Giản)</option>
                            </select>
                        </div>
                        <div>
                            <label class="recom-label" for="foodPreference">Phong vị ẩm thực chủ đạo</label>
                            <select id="foodPreference" class="recom-form-control">
                                <option value="EUROPEAN_FUSION" selected>Á - Âu Đương đại (Bò Mỹ, Cá hồi, Mì vịt quay)</option>
                                <option value="SEAFOOD_PREMIUM">Đặc sản Hải sản Cao cấp (Cua, Tôm càng, Cá tầm)</option>
                                <option value="ASIAN_TRADITIONAL">Á Đông Tinh Hoa (Hương vị truyền thống)</option>
                            </select>
                        </div>
                    </div>

                    <div class="recom-services">
                        <span class="recom-services-title">Dịch vụ trọn gói đề xuất:</span>
                        <div class="recom-services-list">
                            <label>
                                <input type="checkbox" name="services" value="DV001" checked>
                                <span>Thức uống trọn gói (+200.000 đ)</span>
                            </label>
                            <label>
                                <input type="checkbox" name="services" value="DV002" checked>
                                <span>Đón khách tại tiền sảnh (+2.000.000 đ)</span>
                            </label>
                            <label>
                                <input type="checkbox" name="services" value="DV003">
                                <span>Lễ khai tiệc (+1.000.000 đ)</span>
                            </label>
                            <label>
                                <input type="checkbox" name="services" value="DV004">
                                <span>Chương trình giải trí (+800.000 đ)</span>
                            </label>
                            <label>
                                <input type="checkbox" name="services" value="DV005">
                                <span>Dịch vụ tiệc cưới khác (+2.000.000 đ)</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="recom-form-actions">
                    <button type="submit" id="btnSubmitRecom" class="recom-btn-gold">
                        <span class="material-symbols-outlined" aria-hidden="true">bolt</span>
                        <span>Tính Toán &amp; Trích Xuất Top 3 Combo</span>
                    </button>
                </div>
            </form>

            <div id="loadingState" class="recom-loading" role="status" aria-live="polite">
                <div class="recom-spinner" aria-hidden="true"></div>
                <p class="recom-loading-title">Scoring Engine đang chấm điểm ma trận phương án...</p>
                <p class="recom-loading-sub">Đang đối soát lịch trống tại 9 sảnh, so khớp 24 set thực đơn và các đánh giá mới nhất.</p>
            </div>

            <div id="resultsSection" class="recom-results">
                <div class="recom-card recom-results-head">
                    <div>
                        <h2 class="recom-results-title">Gợi Ý Gói Tiệc Cưới Dành Riêng Cho Hai Bạn</h2>
                        <p class="recom-results-sub" id="resNotice">Đã phân tích hàng trăm phương án để chọn ra 3 lựa chọn xuất sắc nhất.</p>
                    </div>
                    <button type="button" onclick="window.scrollTo({top: 150, behavior: 'smooth'})" class="recom-btn-light">
                        <span class="material-symbols-outlined" aria-hidden="true" style="font-size:16px;vertical-align:-3px;">tune</span> Đổi tiêu chí
                    </button>
                </div>

                <div id="combosCardsContainer" class="recom-combo-grid"></div>

                <div id="smartSuggestBox" class="recom-card" style="display:none;margin-top:16px;border:1px solid #F59E0B;background:#FFFBEB;border-radius:12px;padding:20px;" role="status" aria-live="polite">
                    <h3 style="margin:0 0 8px 0;font-size:16px;">💡 Gợi ý thông minh từ Riverside Palace</h3>
                    <p id="smartSuggestReason" class="recom-results-sub" style="margin:0 0 12px 0;"></p>
                    <p id="smartSuggestBudget" style="margin:0 0 12px 0;font-weight:600;"></p>
                    <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:12px;">
                        <button type="button" id="smartSuggestApplyBtn" class="recom-btn-gold" onclick="applySuggestedBudget()">Tự động điều chỉnh ngân sách</button>
                    </div>
                    <div id="smartSuggestDates" style="display:flex;flex-wrap:wrap;gap:8px;"></div>
                </div>
            </div>

        </div>
    </main>

    <partial name="_PublicFooter" />
</div>

<div id="itemDetailModal" class="recom-custom-modal">
    <div class="recom-dialog recom-dialog--sm recom-dialog--pop" role="dialog" aria-modal="true" aria-labelledby="modalTitle" tabindex="-1">
        <button type="button" onclick="closeDetailModal()" class="recom-dialog-close" aria-label="Đóng chi tiết">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
        <div class="recom-modal-head">
            <div id="modalIconBox" class="recom-modal-icon">
                <span class="material-symbols-outlined" aria-hidden="true">info</span>
            </div>
            <div>
                <span id="modalSubTitle" class="recom-modal-kicker">Hạng Mục Tiệc Cưới</span>
                <h3 id="modalTitle" class="recom-modal-title">Chi Tiết Hạng Mục</h3>
            </div>
        </div>
        <div class="recom-price-bar">
            <span>Đơn giá niêm yết:</span>
            <span id="modalPriceVal"><strong>-- đ</strong></span>
        </div>
        <div class="recom-modal-body">
            <div>
                <strong>Mô tả:</strong>
                <p id="modalDescription" class="recom-desc-box">Nội dung chi tiết...</p>
            </div>
            <div id="modalDishesContainer" hidden>
                <strong>Chi tiết thực đơn:</strong>
                <div id="modalDishesText" class="recom-desc-box"></div>
            </div>
            <div class="recom-note-box">
                <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
                <span id="modalNote">Thông tin được cập nhật từ hệ thống Riverside Palace.</span>
            </div>
        </div>
        <button id="modalMenuCustomBtn" type="button" onclick="openMenuCustomizerFromDetail()" class="recom-btn-gold recom-btn-block" hidden>
            <span class="material-symbols-outlined" aria-hidden="true">restaurant_menu</span> Xem thực đơn tiệc (tên món + giá, tùy chỉnh món)
        </button>
        <button type="button" onclick="closeDetailModal()" class="recom-btn-dark recom-btn-block">
            Đã Hiểu &amp; Đóng Lại
        </button>
    </div>
</div>

<div id="showtimeModal" class="recom-custom-modal">
    <div class="recom-dialog recom-dialog--lg recom-dialog--pop" role="dialog" aria-modal="true" aria-labelledby="showtimeTitle" tabindex="-1">
        <button type="button" onclick="closeShowtimeModal()" class="recom-dialog-close" aria-label="Đóng lịch sảnh">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
        <div class="recom-showtime-head">
            <div>
                <span class="recom-modal-kicker">Lịch sảnh trực tiếp</span>
                <h3 id="showtimeTitle" class="recom-modal-title" style="font-size:22px;">Tình Trạng Lịch Sảnh &amp; Ca Tổ Chức</h3>
                <p class="recom-results-sub">Hệ thống kiểm tra trực tiếp bảng LichSanh vào ngày hai bạn chọn.</p>
            </div>
            <div class="recom-date-filter">
                <label for="modalDatePicker">Xem ngày khác:</label>
                <input type="date" id="modalDatePicker" onchange="loadHallAvailability(this.value)" class="recom-mini-input">
                <small class="recom-filter-note">(Riverside Palace nhận đặt tiệc trước từ 30 ngày đến tối đa 1 năm)</small>
            </div>
        </div>

        <div class="recom-suggest-box">
            <div class="recom-suggest-head">
                <strong><span class="material-symbols-outlined" aria-hidden="true">lightbulb</span>Gợi ý các ngày gần nhất còn sảnh trống</strong>
                <div class="recom-suggest-filters">
                    <select id="availMonthFilter" onchange="onAvailFilterChanged()" class="recom-mini-select" aria-label="Lọc tháng"></select>
                    <select id="availYearFilter" onchange="onAvailFilterChanged()" class="recom-mini-select" aria-label="Lọc năm"></select>
                    <select id="availShiftFilter" onchange="onAvailFilterChanged()" class="recom-mini-select" aria-label="Lọc ca">
                        <option value="">Tất cả ca</option>
                        <option value="Ca trưa">Ca trưa</option>
                        <option value="Ca tối">Ca tối</option>
                    </select>
                    <button type="button" onclick="shiftAvailWeek(-7)" title="Tuần trước" class="recom-btn-light">‹ Tuần trước</button>
                    <button type="button" onclick="shiftAvailWeek(7)" title="Tuần sau" class="recom-btn-light">Tuần sau ›</button>
                </div>
            </div>
            <div id="availableDatesBadges" class="recom-date-badges"></div>
        </div>

        <div id="showtimeMatrixContainer" class="recom-matrix"></div>

        <div class="recom-legend">
            <div class="recom-legend-keys">
                <span><span class="recom-dot recom-dot--free"></span> Ca còn trống (Bấm để chọn)</span>
                <span><span class="recom-dot recom-dot--locked"></span> Ca đã kín lịch</span>
            </div>
            <button type="button" onclick="closeShowtimeModal()" class="recom-btn-light">Đóng</button>
