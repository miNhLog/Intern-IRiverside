        function closeDetailModal() { closeRecomModal('itemDetailModal'); }

        let availAllDates = [];
        let availWindowStart = null;

        function initAvailFilters(baseDateStr) {
            const monthSel = document.getElementById('availMonthFilter');
            const yearSel = document.getElementById('availYearFilter');
            if (!monthSel || !yearSel) return;
            if (monthSel.options.length === 0) {
                for (let m = 1; m <= 12; m++) {
                    const opt = document.createElement('option');
                    opt.value = m;
                    opt.text = 'Tháng ' + m;
                    monthSel.appendChild(opt);
                }
            }
            if (yearSel.options.length === 0) {
                const curY = new Date().getFullYear();
                for (let y = curY; y <= curY + 2; y++) {
                    const opt = document.createElement('option');
                    opt.value = y;
                    opt.text = 'Năm ' + y;
                    yearSel.appendChild(opt);
                }
            }
            let base = baseDateStr ? new Date(baseDateStr) : new Date();
            if (isNaN(base.getTime())) base = new Date();
            monthSel.value = base.getMonth() + 1;
            yearSel.value = base.getFullYear();
        }

        function onAvailFilterChanged() {
            const monthSel = document.getElementById('availMonthFilter');
            const yearSel = document.getElementById('availYearFilter');
            if (!monthSel || !yearSel) return;
            const m = parseInt(monthSel.value) || (new Date().getMonth() + 1);
            const y = parseInt(yearSel.value) || new Date().getFullYear();
            const first = new Date(y, m - 1, 1);
            availWindowStart = first;
            const fromStr = toLocalDateStr(first);
            const last = new Date(y, m, 0);
            const toStr = toLocalDateStr(last);
            loadAvailableDates(fromStr, toStr);
        }

        function shiftAvailWeek(deltaDays) {
            if (!availWindowStart || isNaN(availWindowStart.getTime())) availWindowStart = new Date();
            availWindowStart = new Date(availWindowStart.getTime() + (deltaDays || 0) * 86400000);
            const fromStr = toLocalDateStr(availWindowStart);
            const toDate = new Date(availWindowStart.getTime() + 60 * 86400000);
            const toStr = toLocalDateStr(toDate);
            initAvailFilters(fromStr);
            loadAvailableDates(fromStr, toStr);
        }

        async function openShowtimeModal() {
            const currentDateEl = document.getElementById('eventDate');
            const currentDate = currentDateEl ? currentDateEl.value : '';
            const picker = document.getElementById('modalDatePicker');
            if (picker) picker.value = currentDate || '';
            openRecomModal('showtimeModal');
            initAvailFilters(currentDate);
            availWindowStart = currentDate ? new Date(currentDate) : new Date();
            if (availWindowStart && isNaN(availWindowStart.getTime())) availWindowStart = new Date();
            const fromD = availWindowStart || new Date();
            const toD = new Date(fromD.getTime() + 60 * 86400000);
            await loadAvailableDates(toLocalDateStr(fromD), toLocalDateStr(toD));
            await loadHallAvailability(currentDate);
        }

        async function loadAvailableDates(fromStr, toStr) {
            const badgeBox = document.getElementById('availableDatesBadges');
            const shiftSel = document.getElementById('availShiftFilter');
            const shiftVal = shiftSel ? (shiftSel.value || '') : '';
            if (badgeBox) badgeBox.innerHTML = '<span class="recom-results-sub">Đang gợi ý ngày trống...</span>';
            try {
                let url = '/Recommendation/GetAvailableDates?';
                const params = [];
                if (fromStr) params.push('from=' + encodeURIComponent(fromStr));
                if (toStr) params.push('to=' + encodeURIComponent(toStr));
                if (shiftVal) params.push('shift=' + encodeURIComponent(shiftVal));
                url += params.join('&');
                const res = await fetch(url);
                if (!res || !res.ok) {
                    availAllDates = [];
                    renderAvailableDateBadges();
                    return;
                }
                const json = await res.json();
                const list = json ? (json.data || json.Data || []) : [];
                availAllDates = Array.isArray(list) ? list : [];
                renderAvailableDateBadges();
            } catch (e) {
                availAllDates = [];
                renderAvailableDateBadges();
            }
        }

        function renderAvailableDateBadges() {
            const badgeBox = document.getElementById('availableDatesBadges');
            if (!badgeBox) return;
            badgeBox.innerHTML = '';
            if (!availAllDates || availAllDates.length === 0) {
                badgeBox.innerHTML = '<div class="recom-empty-note">Không tìm thấy ngày trống trong khoảng đã chọn. Vui lòng chọn tháng/năm khác hoặc bấm Tuần trước/Tuần sau.</div>';
                return;
            }
            const monthSel = document.getElementById('availMonthFilter');
            const yearSel = document.getElementById('availYearFilter');
            const m = monthSel ? parseInt(monthSel.value) : NaN;
            const y = yearSel ? parseInt(yearSel.value) : NaN;
            const filtered = availAllDates.filter(item => {
                if (!item) return false;
                const d = item.date || item.Date || '';
                if (!d) return false;
                if (!isNaN(m) && !isNaN(y)) {
                    const parts = d.split('-');
                    if (parts.length === 3 && (parseInt(parts[1]) !== m || parseInt(parts[0]) !== y)) return false;
                }
                return true;
            });
            if (filtered.length === 0) {
                badgeBox.innerHTML = '<div class="recom-empty-note">Không tìm thấy ngày trống trong tháng đã chọn. Vui lòng chọn tháng/năm khác hoặc bấm Tuần trước/Tuần sau.</div>';
                return;
            }
            filtered.slice(0, 30).forEach(item => {
                if (!item) return;
                const d = item.date || item.Date || '';
                const s = item.shift || item.Shift || '';
                const c = item.availableHallCount ?? item.AvailableHallCount ?? 0;
                if (!d) return;
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'recom-date-badge';
                btn.title = 'Bấm để xem chi tiết sảnh ngày ' + d + (s ? ' (' + s + ')' : '');
                btn.textContent = d + (s ? ' • ' + s : '') + ' (' + c + ' sảnh)';
                btn.onclick = function () {
                    const picker = document.getElementById('modalDatePicker');
                    if (picker) picker.value = d;
                    loadHallAvailability(d);
                };
                badgeBox.appendChild(btn);
            });
        }

        async function loadHallAvailability(dateStr) {
            const container = document.getElementById('showtimeMatrixContainer');
            if (!container) return;
            if (!dateStr) {
                container.innerHTML = '<div class="recom-empty-note">Vui lòng chọn ngày để xem chi tiết sảnh trống.</div>';
                return;
            }
            // Validate ràng buộc 30–365 ngày (định dạng YYYY-MM-DD so sánh chuỗi an toàn).
            const today0 = new Date(); today0.setHours(0, 0, 0, 0);
            const minD = new Date(today0); minD.setDate(minD.getDate() + 30);
            const maxD = new Date(today0); maxD.setDate(maxD.getDate() + 365);
            const toStr = d => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
            const minStr = toStr(minD);
            const maxStr = toStr(maxD);
            if (dateStr < minStr) {
                container.innerHTML = '<div class="recom-empty-note">Ngày tổ chức tiệc cưới phải cách ngày hiện tại tối thiểu 30 ngày. Vui lòng chọn ngày xa hơn để Riverside Palace có thời gian chuẩn bị tốt nhất.</div>';
                return;
            }
            if (dateStr > maxStr) {
                container.innerHTML = '<div class="recom-empty-note">Hệ thống chỉ nhận đăng ký giữ chỗ trước tối đa 365 ngày (1 năm). Vui lòng chọn ngày gần hơn.</div>';
                return;
            }
            container.innerHTML = '<div class="recom-results-sub" style="padding:24px;text-align:center;">Đang kiểm tra lịch sảnh...</div>';

            try {
                const res = await fetch(`/Recommendation/GetHallAvailability?date=${encodeURIComponent(dateStr)}`);
                if (!res || !res.ok) {
                    const code = res ? res.status : '???';
                    container.innerHTML = `<div class="recom-empty-note">Lỗi máy chủ (${code}). Vui lòng kiểm tra lại.</div>`;
                    return;
                }
                const json = await res.json();
                const halls = json && json.data ? (json.data.halls || json.data.Halls || json.data) : null;
                if (json && json.success && Array.isArray(halls)) {
                    renderRealShowtimeMatrix(halls, dateStr);
                } else if (json && json.success && json.data && Array.isArray(json.data)) {
                    renderRealShowtimeMatrix(json.data, dateStr);
                } else {
                    const msg = (json && json.message) || 'Không thể tải dữ liệu lịch sảnh.';
                    container.innerHTML = `<div class="recom-empty-note">${msg}</div>`;
                }
            } catch (e) {
                container.innerHTML = `<div class="recom-empty-note">Lỗi kết nối máy chủ.</div>`;
            }
        }

        function renderRealShowtimeMatrix(halls, dateStr) {
            const container = document.getElementById('showtimeMatrixContainer');
            if (!container) return;
            container.innerHTML = '';
            if (!halls || halls.length === 0) {
                container.innerHTML = '<div class="recom-empty-note">Ngày này chưa có lịch sảnh trống. Vui lòng bấm badge ngày gợi ý phía trên hoặc chọn khoảng khác.</div>';
                return;
            }

            (halls || []).forEach(h => {
                if (!h) return;
                const hallName = h.hallName || h.HallName || 'Sảnh tiệc';
                // Chuẩn hóa khách vs bàn (1 bàn = 10 khách): capacity lưu SỐ KHÁCH.
                const capGuests = Number(h.capacity_max_guests ?? h.capacityMaxGuests ?? h.CapacityMaxGuests ?? h.capacity ?? h.Capacity ?? 0) || 0;
                const capMinGuests = Number(h.capacity_min_guests ?? h.capacityMinGuests ?? h.CapacityMinGuests ?? 0) || 0;
                const capMaxTables = Number(h.capacity_max_tables ?? h.capacityMaxTables ?? h.CapacityMaxTables ?? 0) || Math.floor(capGuests / 10);
                const capMinTables = Number(h.capacity_min_tables ?? h.capacityMinTables ?? h.CapacityMinTables ?? 0) || Math.floor(capMinGuests / 10);
                const capLabel = capMinTables > 0 ? `${capMinTables} - ${capMaxTables} bàn (${capGuests} khách)` : `${capMaxTables} bàn (${capGuests} khách)`;
                const price = Number(h.rentalPrice ?? h.RentalPrice ?? 0);
                const priceStr = isNaN(price) ? '0' : price.toLocaleString('vi-VN');
                const noonFree = h.isNoonAvailable ?? h.IsNoonAvailable ?? false;
                const eveFree = h.isEveningAvailable ?? h.IsEveningAvailable ?? false;
                const safeDate = (dateStr || '').replace(/'/g, '');
                const noonBtn = noonFree
                    ? `<button type="button" onclick="selectShowtimeSlot('${safeDate}', 'Ca trưa')" class="recom-slot-free"><span class="recom-slot-title">Ca Trưa (10:30 – 14:00)</span><span class="recom-slot-sub"><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Còn trống (Bấm để chọn)</span></button>`
                    : `<button type="button" disabled class="recom-slot-locked"><span class="recom-slot-title">Ca Trưa (10:30 – 14:00)</span><span class="recom-slot-sub"><span class="material-symbols-outlined" aria-hidden="true">cancel</span> Đã kín lịch</span></button>`;

                const eveBtn = eveFree
                    ? `<button type="button" onclick="selectShowtimeSlot('${safeDate}', 'Ca tối')" class="recom-slot-free"><span class="recom-slot-title">Ca Tối (17:30 – 21:30)</span><span class="recom-slot-sub"><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> Còn trống (Bấm để chọn)</span></button>`
                    : `<button type="button" disabled class="recom-slot-locked"><span class="recom-slot-title">Ca Tối (17:30 – 21:30)</span><span class="recom-slot-sub"><span class="material-symbols-outlined" aria-hidden="true">cancel</span> Đã kín lịch</span></button>`;

                const card = document.createElement('div');
                card.className = 'recom-matrix-card';
                card.innerHTML = `
                        <div class="recom-matrix-head">
                            <strong><span class="material-symbols-outlined" aria-hidden="true">apartment</span> Sảnh ${hallName}</strong>
                            <span>Sức chứa: ${capLabel} • Giá: ${priceStr} đ</span>
                        </div>
                        <div class="recom-matrix-slots">${noonBtn}${eveBtn}</div>`;
                container.appendChild(card);
            });
        }

        function selectShowtimeSlot(dateStr, shift) {
            if (!dateStr || !shift) return;
            const dateInput = document.getElementById('eventDate');
            const shiftInput = document.getElementById('shift');
            const picker = document.getElementById('modalDatePicker');
            if (dateInput) dateInput.value = dateStr;
            if (shiftInput) shiftInput.value = shift;
            if (picker) picker.value = dateStr;
            if (typeof handleDateChanged === 'function') { try { handleDateChanged(); } catch (e) { } }
            closeShowtimeModal();
            showRecomAlert(`Đã chọn sảnh trống vào ngày ${dateStr} (${shift})! Hai bạn hãy nhấn nút "Tính Toán & Trích Xuất Top 3 Combo" để cập nhật phương án nhé!`, 'Đã chọn ngày & ca trống', 'success');
        }

        function closeShowtimeModal() { closeRecomModal('showtimeModal'); }

        function fmtVN(dateStr) {
            if (!dateStr) return '';
            const s = String(dateStr).trim().slice(0, 10);
            const m = s.match(/^(\d{4})-(\d{2})-(\d{2})$/);
            if (m) return `${m[3]}/${m[2]}/${m[1]}`;
            return s;
        }

        function openBookingConfirmModal(comboIndex) {
            const s = topCombosState[comboIndex];
            if (!s || !currentPayload) {
                showRecomAlert('Chưa có gói tiệc để giữ chỗ. Hai bạn hãy nhấn "Tính Toán & Trích Xuất Top 3 Combo" trước nhé!', 'Chưa có gói tiệc', 'info');
                return;
            }
            const d = getComboDisplay(s);
            const totalCostStr = d.totalCost.toLocaleString('vi-VN');
            selectedComboToBook = {
                comboIndex,
                hallScheduleId: s.hallScheduleId,
                hallId: s.hallId,
                hallName: s.hallName,
                menuId: s.menuId,
                decorId: s.decorId,
                totalCostStr,
                customMenu: s.customMenu ? JSON.parse(JSON.stringify(s.customMenu)) : null
            };

            document.getElementById('bkCoupleName').innerText = currentPayload.coupleName;
            document.getElementById('bkPhone').innerText = currentPayload.phoneNumber;
            document.getElementById('bkHall').innerText = s.hallName;
            document.getElementById('bkDateShift').innerText = `${fmtVN(currentPayload.eventDate)} · ${currentPayload.shift}`;
            document.getElementById('bkTables').innerText = `${currentPayload.officialTableCount + currentPayload.spareTableCount} bàn (${currentPayload.officialTableCount} chính + ${currentPayload.spareTableCount} sơ cua)${s.customMenu ? ' • ' + s.customMenu.customName : ''}`;
            document.getElementById('bkTotal').innerText = `${totalCostStr} đ`;

            openRecomModal('bookingConfirmModal');
        }

        function closeBookingModal() { closeRecomModal('bookingConfirmModal'); }

        // Chuẩn hóa ca về "Ca trưa"/"Ca tối" gọn gàng trước khi gửi Backend.
        function normalizeShift(raw) {
            const s = String(raw || '').trim();
            if (/trưa|trua/i.test(s)) return 'Ca trưa';
            if (/tối|toi/i.test(s)) return 'Ca tối';
            return s;
        }

        async function submitActualBooking() {
            // Guard null để nút không kẹt disabled khi state mất (double-click/modal đóng sớm).
            if (!currentPayload || !selectedComboToBook) {
                showRecomAlert('Phiên giữ chỗ đã hết. Hai bạn vui lòng chọn lại gói tiệc và nhấn "Giữ chỗ" nhé!', 'Phiên giữ chỗ hết hạn', 'warning');
                try { closeBookingModal(); } catch (e) { }
                return;
            }
            const btn = document.getElementById('btnSubmitBooking');
            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined" aria-hidden="true">progress_activity</span> Đang kiểm tra & lưu đơn tiệc...';

            // Đảm bảo GuestCount không bao giờ 0: lấy từ form, fallback TableCount*10.
            const totalT = (currentPayload.tableCount || (currentPayload.officialTableCount + currentPayload.spareTableCount)) || 0;
            let gCount = currentPayload.guestCount || 0;
            if (gCount <= 0 && totalT > 0) gCount = totalT * 10;
            if (gCount <= 0) gCount = 300;
            // eventDate chuẩn YYYY-MM-DD (cắt phần giờ nếu có); shift chuẩn hóa gọn;
            // hallScheduleId giữ 0 khi chưa có lịch để Backend auto-init, không gửi nhầm hallId.
            const eventDateStr = String(currentPayload.eventDate || '').trim().slice(0, 10);
            const shiftStr = normalizeShift(currentPayload.shift);
            const scheduleIdNum = parseInt(selectedComboToBook.hallScheduleId, 10) || 0;
            const hallIdNum = parseInt(selectedComboToBook.hallId, 10) || 0;
            const custom = selectedComboToBook.customMenu || null;
            let specialReq = `Đăng ký từ AI Recommendation: Ngân sách dự kiến ${currentPayload.expectedBudget.toLocaleString('vi-VN')} đ`;
            if (custom) {
                const itemsText = (custom.items || []).map(x => `${x.dishName} (${Number(x.price || 0).toLocaleString('vi-VN')} đ)`).join('; ');
                specialReq += `; [${custom.customName}: ${Number(custom.customPricePerTable || 0).toLocaleString('vi-VN')} đ/bàn | ${itemsText}] (tùy chỉnh từ ${custom.originalName})`;
            }
            const bookingPayload = {
                customerName: currentPayload.coupleName,
                phoneNumber: currentPayload.phoneNumber,
                email: currentPayload.email,
                eventDate: eventDateStr,
                shift: shiftStr,
                hallScheduleId: scheduleIdNum,
                hallId: hallIdNum,
                menuId: selectedComboToBook.menuId,
                decorationPackageId: selectedComboToBook.decorId,
                guestCount: gCount,
                tableCount: totalT,
                spareTableCount: currentPayload.spareTableCount || 0,
                expectedBudget: currentPayload.expectedBudget,
                desiredStyle: currentPayload.desiredStyle,
                specialRequests: specialReq,
                customMenuName: custom ? custom.customName : null,
                customMenuPricePerTable: custom ? custom.customPricePerTable : null,
                customMenuItems: custom ? (custom.items || []).map(x => `${x.dishName} (${Number(x.price || 0).toLocaleString('vi-VN')} đ)`) : null,
                serviceCodes: Array.isArray(currentPayload.selectedServiceCodes) ? currentPayload.selectedServiceCodes : []
            };

            try {
                const res = await fetch('/Recommendation/RegisterBooking', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(bookingPayload)
                });
                const result = await res.json();

                btn.disabled = false;
                btn.innerHTML = '<span class="material-symbols-outlined" aria-hidden="true">check</span> Gửi Thông Tin Đăng Ký Giữ Chỗ';
                closeBookingModal();

                if (result.success) {
                    // Điền thông tin vào Popup thành công
                    document.getElementById('succBookingCode').innerText = result.bookingCode || 'DT-ONLINE';
                    document.getElementById('succCouple').innerText = currentPayload.coupleName;
                    document.getElementById('succHall').innerText = selectedComboToBook.hallName;
                    document.getElementById('succDateTime').innerText = `${fmtVN(currentPayload.eventDate)} · ${currentPayload.shift}`;
                    document.getElementById('succPhone').innerText = currentPayload.phoneNumber;

                    openRecomModal('bookingSuccessModal');
                } else {
                    // Nếu khách hàng đã có đơn tiệc đang hoạt động
                    if (result.message && (result.message.includes("đã có đơn tiệc") || result.message.includes("giữ chỗ 01 phương án"))) {
                        document.getElementById('duplicateNoticeMsg').innerText = result.message;
                        openRecomModal('duplicateBookingModal');
                    } else {
                        showRecomAlert(result.message || 'Chưa thể lưu đơn đặt tiệc lúc này. Hai bạn vui lòng thử lại sau ít phút nhé!', 'Chưa lưu được đơn tiệc', 'error');
                    }
                }
            } catch (e) {
                btn.disabled = false;
                btn.innerHTML = '<span class="material-symbols-outlined" aria-hidden="true">check</span> Gửi Thông Tin Đăng Ký Giữ Chỗ';
                closeBookingModal();
                showRecomAlert('Kết nối gửi giữ chỗ đang gián đoạn. Hai bạn vui lòng kiểm tra mạng và thử lại nhé!', 'Lỗi kết nối', 'error');
            }
        }

        // ============ TÙY CHỈNH THỰC ĐƠN TRONG TOP 3 ============
        async function openMenuCustomizer(comboIndex) {
            const s = topCombosState[comboIndex];
            if (!s) return;
            menuCustomCategory = '';
            const searchInput = document.getElementById('menuCustomSearch');
            if (searchInput) searchInput.value = '';
            document.querySelectorAll('#menuCustomCategoryFilter .recom-cat-btn').forEach(b => {
                b.classList.toggle('is-active', (b.getAttribute('data-cat') || '') === '');
            });
            openRecomModal('menuCustomModal');
            document.getElementById('menuCustomLoading').style.display = 'block';
            document.getElementById('menuCustomBody').hidden = true;
            document.getElementById('menuCustomTitle').innerText = s.customMenu ? s.customMenu.customName : s.menuName;
            document.getElementById('menuCustomSubtitle').innerText = `Combo Top ${s.rank} • ${s.hallName} • ${s.totalTables} bàn (chuẩn 10 khách/bàn). Loại bỏ món chưa ưng ý, thêm món yêu thích — tổng tiền cập nhật trực tiếp.`;

            try {
                const [menuRes, dishRes] = await Promise.all([
                    fetch(`/Recommendation/GetMenuDetail?menuId=${s.menuId}`).then(r => r.json()),
                    fetch('/Recommendation/GetPublicDishes').then(r => r.json())
                ]);
                const menuData = menuRes && menuRes.success ? menuRes.data : null;
                const allDishesRaw = dishRes && dishRes.success ? (dishRes.data || []) : [];
                const currentDishes = menuData
                    ? (menuData.dishes || menuData.Dishes || []).map(d => ({
                        dishId: d.dishId ?? d.DishId ?? 0,
                        dishName: d.dishName || d.DishName || 'Món ăn',
                        category: d.category || d.Category || 'Món khác',
                        price: Number(d.price ?? d.Price ?? 0)
                    }))
                    : [];
                const allDishes = (allDishesRaw || []).map(d => ({
                    dishId: d.dishId ?? d.DishId ?? 0,
                    dishCode: d.dishCode || d.DishCode || '',
                    dishName: d.dishName || d.DishName || 'Món ăn',
                    category: d.category || d.Category || 'Món khác',
                    price: Number(d.price ?? d.Price ?? 0)
                }));
                // Nếu đã custom trước đó thì giữ lựa chọn cũ, ngược lại dùng món gốc.
                const initialItems = s.customMenu
                    ? JSON.parse(JSON.stringify(s.customMenu.items))
                    : JSON.parse(JSON.stringify(currentDishes));
                const originalItems = JSON.parse(JSON.stringify(currentDishes.length > 0 ? currentDishes : initialItems));
                menuCustomState = {
                    comboIndex,
                    originalName: s.menuName,
                    originalPricePerTable: s.menuPriceNum,
                    originalItems,
                    items: initialItems,
                    allDishes
                };
                document.getElementById('menuCustomLoading').style.display = 'none';
                document.getElementById('menuCustomBody').hidden = false;
                renderMenuCustomLists();
            } catch (e) {
                document.getElementById('menuCustomLoading').innerHTML = '<span style="color:#DC2626;">Không tải được món ăn. Vui lòng đóng lại và thử lại.</span>';
            }
        }

        function closeMenuCustomModal() {
            closeRecomModal('menuCustomModal');
            menuCustomState = null;
        }

        function setMenuCustomCategory(cat) {
            menuCustomCategory = cat || '';
            document.querySelectorAll('#menuCustomCategoryFilter .recom-cat-btn').forEach(b => {
                const active = (b.getAttribute('data-cat') || '') === menuCustomCategory;
                b.classList.toggle('is-active', active);
            });
            renderMenuCustomAllList();
        }

        function calcCustomPricePerTable() {
            if (!menuCustomState) return 0;
            return menuCustomState.items.reduce((sum, x) => sum + (Number(x.price) || 0), 0);
        }

        // Chuẩn thay món (1 đổi 1): số món tùy chỉnh không vượt quá số món gốc.
        // Fallback khi originalItems rỗng: dùng items hiện tại hoặc mặc định 10.
        function getMenuCustomMaxDishes() {
            if (!menuCustomState) return 10;
            const origLen = Array.isArray(menuCustomState.originalItems) ? menuCustomState.originalItems.length : 0;
            if (origLen > 0) return origLen;
            const curLen = Array.isArray(menuCustomState.items) ? menuCustomState.items.length : 0;
            return curLen > 0 ? curLen : 10;
        }

        function escHtmlJs(x) {
            return String(x || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        function renderMenuCustomLists() {
            if (!menuCustomState) return;
            const s = topCombosState[menuCustomState.comboIndex];
            const customPrice = calcCustomPricePerTable();
            const maxDishes = getMenuCustomMaxDishes();
            // Trái: món hiện tại.
            const curBox = document.getElementById('menuCustomCurrentList');
            document.getElementById('menuCustomCurrentCount').innerText = `${menuCustomState.items.length} / ${maxDishes} món`;
            document.getElementById('menuCustomOrigPrice').innerText = `${Number(menuCustomState.originalPricePerTable || 0).toLocaleString('vi-VN')} đ`;
            document.getElementById('menuCustomNewPrice').innerText = `${customPrice.toLocaleString('vi-VN')} đ`;
            const tipEl = document.getElementById('menuCustomTip');
            if (tipEl) tipEl.innerText = `Mẹo: thực đơn chuẩn ${maxDishes} món/bàn — hai bạn hãy thay món (xóa 1 + thêm 1) thay vì cộng dồn nhé! Tổng mới = ${customPrice.toLocaleString('vi-VN')} đ/bàn.`;
            const subEl = document.getElementById('menuCustomSubtitle');
            if (subEl && s) subEl.innerText = `Combo Top ${s.rank} • ${s.hallName} • ${s.totalTables} bàn (chuẩn 10 khách/bàn). Chuẩn ${maxDishes} món/bàn — hãy thay món (xóa 1 + thêm 1) thay vì cộng dồn. Tổng tiền cập nhật trực tiếp.`;
            if (menuCustomState.items.length === 0) {
                curBox.innerHTML = '<div class="recom-empty-note" style="text-align:center;">Chưa có món nào. Hãy thêm món từ danh sách bên phải.</div>';
            } else {
                curBox.innerHTML = menuCustomState.items.map((d, i) => `
                    <div class="recom-dish-row recom-dish-row--current">
                        <div style="min-width:0;">
                            <div class="recom-dish-name">${i + 1}. ${escHtmlJs(d.dishName)}</div>
                            <div class="recom-dish-meta">${escHtmlJs(d.category || '')} • ${Number(d.price || 0).toLocaleString('vi-VN')} đ</div>
                        </div>
                        <button type="button" onclick="removeMenuCustomDish(${i})" title="Loại bỏ món này" class="recom-dish-remove"><span class="material-symbols-outlined" aria-hidden="true">delete</span></button>
                    </div>
                `).join('');
            }
            renderMenuCustomAllList();
            // Tổng dự toán mới.
            if (s) {
                const grand = s.hallPriceNum + customPrice * s.totalTables + s.decorPriceNum + (s.servicesTotalNum || 0);
                document.getElementById('menuCustomGrandTotal').innerText = `${grand.toLocaleString('vi-VN')} đ`;
                document.getElementById('menuCustomFormulaDetail').innerText =
                    `${s.hallPriceNum.toLocaleString('vi-VN')} + ${customPrice.toLocaleString('vi-VN')} × ${s.totalTables} bàn + ${s.decorPriceNum.toLocaleString('vi-VN')} + ${(s.servicesTotalNum || 0).toLocaleString('vi-VN')} (dịch vụ)`;
            }
        }

        function renderMenuCustomAllList() {
            if (!menuCustomState) return;
            const box = document.getElementById('menuCustomAllList');
            const kw = (document.getElementById('menuCustomSearch').value || '').trim().toLowerCase();
            const selectedIds = new Set(menuCustomState.items.map(x => x.dishId));
            const maxDishes = getMenuCustomMaxDishes();
            const isFull = menuCustomState.items.length >= maxDishes;
            const fullTitle = `Đã đủ ${maxDishes} món chuẩn — hãy xóa bớt 1 món để thêm món khác`;
            const filtered = menuCustomState.allDishes.filter(d => {
                if (menuCustomCategory && (d.category || '') !== menuCustomCategory) return false;
                if (kw && !(d.dishName || '').toLowerCase().includes(kw)) return false;
                return true;
            });
            if (filtered.length === 0) {
                box.innerHTML = '<div class="recom-empty-note" style="text-align:center;">Không tìm thấy món phù hợp. Thử từ khóa hoặc nhóm món khác.</div>';
                return;
            }
            box.innerHTML = filtered.slice(0, 120).map(d => {
                const added = selectedIds.has(d.dishId);
                const disabledAdd = !added && isFull;
                return `
                    <div class="recom-dish-row recom-dish-row--all">
                        <div style="min-width:0;">
                            <div class="recom-dish-name">${escHtmlJs(d.dishName)}</div>
                            <div class="recom-dish-meta--muted">${escHtmlJs(d.category || '')} • <strong style="color:#0F172A;">${Number(d.price || 0).toLocaleString('vi-VN')} đ</strong></div>
                        </div>
                        ${added
                            ? '<span class="recom-dish-added">Đã chọn</span>'
                            : disabledAdd
                            ? `<button type="button" class="recom-dish-add" disabled title="${fullTitle}"><span class="material-symbols-outlined" aria-hidden="true" style="font-size:14px;">add</span> Thêm</button>`
                            : `<button type="button" onclick="addMenuCustomDish(${d.dishId})" class="recom-dish-add"><span class="material-symbols-outlined" aria-hidden="true" style="font-size:14px;">add</span> Thêm</button>`}
                    </div>
                `;
            }).join('');
        }

        function addMenuCustomDish(dishId) {
            if (!menuCustomState) return;
            if (menuCustomState.items.some(x => x.dishId === dishId)) return;
            const maxDishes = getMenuCustomMaxDishes();
            if (menuCustomState.items.length >= maxDishes) {
                showRecomAlert(`Thực đơn chuẩn của Riverside Palace chỉ gồm ${maxDishes} món/bàn (đúng chuẩn tiệc cưới, không cộng dồn). Hai bạn vui lòng loại bỏ 1 món trước khi thêm món mới nhé!`, 'Đã đủ số món chuẩn', 'warning');
                return;
            }
            const found = menuCustomState.allDishes.find(x => x.dishId === dishId);
            if (!found) return;
            menuCustomState.items.push(JSON.parse(JSON.stringify(found)));
            renderMenuCustomLists();
        }

        function removeMenuCustomDish(index) {
            if (!menuCustomState) return;
            menuCustomState.items.splice(index, 1);
            renderMenuCustomLists();
        }

        function resetMenuCustom() {
            if (!menuCustomState) return;
            menuCustomState.items = JSON.parse(JSON.stringify(menuCustomState.originalItems));
            renderMenuCustomLists();
        }

        function confirmMenuCustom() {
            if (!menuCustomState) return;
            const s = topCombosState[menuCustomState.comboIndex];
            if (!s) return;
            if (menuCustomState.items.length === 0) {
                showRecomAlert('Thực đơn tùy chỉnh cần ít nhất 1 món. Hai bạn vui lòng thêm món từ danh sách nhà hàng nhé!', 'Chưa có món nào', 'warning');
                return;
            }
            const maxDishes = getMenuCustomMaxDishes();
            if (menuCustomState.items.length > maxDishes) {
                showRecomAlert(`Thực đơn chuẩn của Riverside Palace chỉ gồm ${maxDishes} món/bàn. Hai bạn vui lòng loại bỏ ${menuCustomState.items.length - maxDishes} món để giữ đúng chuẩn tiệc cưới nhé!`, 'Đã vượt số món chuẩn', 'warning');
                return;
            }
            const customPrice = calcCustomPricePerTable();
            const isSameAsOriginal = menuCustomState.items.length === menuCustomState.originalItems.length
                && menuCustomState.items.every((x, i) => x.dishId === (menuCustomState.originalItems[i] || {}).dishId);
            if (isSameAsOriginal) {
                s.customMenu = null;
            } else {
                s.customMenu = {
                    customName: `Thực đơn tùy chỉnh ${s.rank}`,
                    originalName: menuCustomState.originalName,
                    customPricePerTable: customPrice,
                    items: JSON.parse(JSON.stringify(menuCustomState.items)),
                    note: `Tùy chỉnh từ ${menuCustomState.originalName} (${menuCustomState.originalItems.length} món → ${menuCustomState.items.length} món)`
                };
            }
            closeMenuCustomModal();
            renderComboCards();
            document.getElementById('resultsSection').scrollIntoView({ behavior: 'smooth', block: 'start' });
            if (s.customMenu) {
                const d = getComboDisplay(s);
                showRecomAlert(`Đã cập nhật "${s.customMenu.customName}" với ${s.customMenu.items.length} món (${customPrice.toLocaleString('vi-VN')} đ/bàn).\nTổng dự toán mới: ${d.totalCost.toLocaleString('vi-VN')} đ.\nThông tin đã hiển thị khớp ngoài card Top ${s.rank} và sẽ gửi kèm khi Đăng ký giữ chỗ.`, 'Tùy chỉnh thực đơn thành công', 'success');
            } else {
                showRecomAlert('Đã khôi phục thực đơn gốc cho combo này.', 'Đã khôi phục gốc', 'info');
            }
        }

        function closeDuplicateModal() { closeRecomModal('duplicateBookingModal'); }
    </script>
}
