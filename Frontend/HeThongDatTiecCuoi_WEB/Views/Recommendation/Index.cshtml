                    : `Sức chứa tối đa: ${maxT} bàn (${maxG} khách). Giá thuê sảnh là chi phí cố định cho ca tổ chức.`;
            } else if (type === 'MENU') {
                document.getElementById('modalSubTitle').innerText = 'Ẩm Thực Tiệc Cưới';
                if (iconBox) iconBox.innerHTML = '<span class="material-symbols-outlined" aria-hidden="true">restaurant_menu</span>';
                if (dishesBox) dishesBox.hidden = false;
                document.getElementById('modalDishesText').innerText = desc;
                document.getElementById('modalNote').innerText = `Đơn giá áp dụng cho mâm tròn 10 khách. Đã tính cho ${extra} bàn tiệc. Nhấn "Xem thực đơn tiệc" để xem từng món + giá và tùy chỉnh theo sở thích.`;
