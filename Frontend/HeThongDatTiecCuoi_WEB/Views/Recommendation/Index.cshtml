        // P0 fallback 0 combo: Smart Suggestion Box — lý do + 1-click điều chỉnh ngân sách + 3 badge ngày.
        let smartSuggestState = null;
        function renderSmartSuggestBox(suggestedNext, req) {
            const reasonEl = document.getElementById('smartSuggestReason');
            const budgetEl = document.getElementById('smartSuggestBudget');
            const datesBox = document.getElementById('smartSuggestDates');
            const applyBtn = document.getElementById('smartSuggestApplyBtn');
            smartSuggestState = suggestedNext || null;
            const minBudget = Number((suggestedNext && (suggestedNext.minRequiredBudget ?? suggestedNext.MinRequiredBudget)) || 0);
            const reason = (suggestedNext && (suggestedNext.reason || suggestedNext.Reason)) || 'Ngân sách thấp hơn tối thiểu hoặc ngày đã kín sảnh phù hợp.';
            const dates = (suggestedNext && (suggestedNext.suggestedDates || suggestedNext.SuggestedDates)) || [];
            if (reasonEl) reasonEl.innerText = reason;
            if (budgetEl) budgetEl.innerText = minBudget > 0 ? `Ngân sách tối thiểu gợi ý: ${minBudget.toLocaleString('vi-VN')} đ` : '';
            if (applyBtn) {
                applyBtn.innerText = minBudget > 0 ? `Tự động điều chỉnh ngân sách lên ${minBudget.toLocaleString('vi-VN')} đ` : 'Tự động điều chỉnh ngân sách';
                applyBtn.disabled = !(minBudget > 0);
                applyBtn.style.opacity = minBudget > 0 ? '1' : '0.6';
            }
            if (datesBox) {
                datesBox.innerHTML = '';
                (Array.isArray(dates) ? dates.slice(0, 3) : []).forEach(item => {
                    const dd = item.date || item.Date || '';
                    const sh = item.shift || item.Shift || '';
                    const halls = item.availableHalls || item.AvailableHalls || [];
                    if (!dd) return;
                    const b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'recom-date-badge';
                    b.title = (Array.isArray(halls) && halls.length ? 'Sảnh trống: ' + halls.join(', ') : 'Bấm để đổi ngày và tìm lại');
                    b.textContent = `${dd}${sh ? ' • ' + sh : ''}`;
                    b.onclick = function () { applySuggestedDate(dd, sh); };
                    datesBox.appendChild(b);
                });
                if (datesBox.children.length === 0) {
                    datesBox.innerHTML = '<span class="recom-results-sub">Chưa tìm được ngày thay thế trong 60 ngày tới — hai bạn thử đổi ca hoặc giảm số bàn nhé!</span>';
                }
            }
        }

        function applySuggestedBudget() {
            if (!smartSuggestState) return;
            const minBudget = Number(smartSuggestState.minRequiredBudget ?? smartSuggestState.MinRequiredBudget ?? 0);
            if (!(minBudget > 0)) return;
            const budgetInput = document.getElementById('expectedBudget');
            if (budgetInput) { budgetInput.value = Math.ceil(minBudget); formatBudgetInput(budgetInput); try { updateBudgetMinHint(); } catch (e) { } }
            handleAnalyzeCombos(new Event('submit'));
        }

        function applySuggestedDate(dateStr, shift) {
            if (!dateStr) return;
            const dateInput = document.getElementById('eventDate');
            const shiftInput = document.getElementById('shift');
            if (dateInput) dateInput.value = String(dateStr).slice(0, 10);
            if (shift && shiftInput) {
                if (/trưa|trua/i.test(shift)) shiftInput.value = 'Ca trưa';
                else if (/tối|toi/i.test(shift)) shiftInput.value = 'Ca tối';
            }
            if (typeof handleDateChanged === 'function') { try { handleDateChanged(); } catch (e) { } }
            if (typeof loadHallAvailability === 'function') { try { loadHallAvailability(dateInput ? dateInput.value : dateStr); } catch (e) { } }
            handleAnalyzeCombos(new Event('submit'));
        }

