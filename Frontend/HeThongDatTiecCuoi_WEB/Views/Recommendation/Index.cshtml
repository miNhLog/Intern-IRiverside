@section Scripts {
    <script>
        let currentPayload = null;
        let selectedComboToBook = null;
        // State Top 3 + thực đơn tùy chỉnh (giữ trong JS, gửi kèm khi Đăng ký giữ chỗ).
        let topCombosState = [];
        let menuCustomState = null;
        let menuCustomCategory = '';
        const RECOM_HALL_PLACEHOLDER = '@hallPlaceholder';

        // ---- A11y modal helpers: lock scroll + focus + class .open (giữ API display cũ) ----
        function lockRecomScroll() { document.body.classList.add('recom-modal-open'); }
        function unlockRecomScroll() {
            if (!document.querySelector('.recom-custom-modal.open')) document.body.classList.remove('recom-modal-open');
        }
        function openRecomModal(id) {
            const m = document.getElementById(id);
            if (!m) return;
            m.classList.add('open');
            m.style.display = 'flex';
            m.setAttribute('aria-hidden', 'false');
            lockRecomScroll();
            const dlg = m.querySelector('[role="dialog"]');
            if (dlg) { try { dlg.focus({ preventScroll: true }); } catch (e) { try { dlg.focus(); } catch (ex) { } } }
        }
        function closeRecomModal(id) {
            const m = document.getElementById(id);
            if (!m) return;
            m.classList.remove('open');
            m.style.display = 'none';
            m.setAttribute('aria-hidden', 'true');
            unlockRecomScroll();
        }
        function isRecomModalOpen(id) {
            const m = document.getElementById(id);
            return !!m && m.classList.contains('open');
        }

        // Popup thông báo chuyên nghiệp thay thế alert() native.
        function showRecomAlert(message, title, type) {
            const modal = document.getElementById('recomAlertModal');
            if (!modal) return;
            const msgEl = document.getElementById('recomAlertMessage');
            const titleEl = document.getElementById('recomAlertTitle');
            const badgeEl = document.getElementById('recomAlertBadge');
            const iconBox = document.getElementById('recomAlertIcon');
            const iconFa = document.getElementById('recomAlertIconFa');
            const kind = (type || 'warning').toLowerCase();
            const cfg = {
                warning: { t: 'Hai bạn lưu ý nhé!', b: 'Lưu ý nhỏ từ Riverside Palace', icon: 'warning', cls: 'recom-alert-icon--warning', bc: '#92400E', bb: '#FEF3C7' },
                error: { t: 'Rất tiếc, chưa hoàn tất!', b: 'Thông báo từ Riverside Palace', icon: 'error', cls: 'recom-alert-icon--error', bc: '#DC2626', bb: '#FEE2E2' },
                success: { t: 'Tuyệt vời, hai bạn ơi!', b: 'Tin vui từ Riverside Palace', icon: 'check_circle', cls: 'recom-alert-icon--success', bc: '#059669', bb: '#D1FAE5' },
                info: { t: 'Riverside Palace xin chia sẻ', b: 'Thông tin hữu ích', icon: 'info', cls: 'recom-alert-icon--info', bc: '#2563EB', bb: '#DBEAFE' }
            }[kind] || { t: 'Thông báo', b: 'Thông báo từ Riverside Palace', icon: 'notifications', cls: 'recom-alert-icon--warning', bc: '#92400E', bb: '#FEF3C7' };
            if (msgEl) msgEl.innerText = message || '';
            if (titleEl) titleEl.innerText = title || cfg.t;
            if (badgeEl) { badgeEl.innerText = cfg.b; badgeEl.style.color = cfg.bc; badgeEl.style.background = cfg.bb; }
            if (iconBox) iconBox.className = 'recom-alert-icon ' + cfg.cls;
            if (iconFa) iconFa.textContent = cfg.icon;
            openRecomModal('recomAlertModal');
        }

        function closeRecomAlert() { closeRecomModal('recomAlertModal'); }

        function closeSuccessModal() { closeRecomModal('bookingSuccessModal'); }

        // Format YYYY-MM-DD theo giờ địa phương (tránh lệch ngày khi dùng toISOString UTC).
        function toLocalDateStr(d) {
            return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const ev = document.getElementById('eventDate');
            const pk = document.getElementById('modalDatePicker');
            // Ràng buộc Riverside Palace: nhận đặt tiệc trước từ 30 ngày đến tối đa 365 ngày.
            const today = new Date();
            const minD = new Date(today); minD.setDate(minD.getDate() + 30);
            const maxD = new Date(today); maxD.setDate(maxD.getDate() + 365);
            const minStr = toLocalDateStr(minD);
            const maxStr = toLocalDateStr(maxD);
            if (ev) { ev.min = minStr; ev.max = maxStr; }
            if (pk) { pk.min = minStr; pk.max = maxStr; }
            const d = new Date();
            d.setDate(d.getDate() + 60);
            const dateStr = toLocalDateStr(d);
            if (ev && !ev.value) ev.value = dateStr;
            if (ev && (ev.value < minStr || ev.value > maxStr)) ev.value = dateStr;
            if (pk) pk.value = ev ? ev.value : dateStr;
            syncGuestToTables();
            formatBudgetInput(document.getElementById('expectedBudget'));
            try { updateBudgetMinHint(); } catch (e) { }
        });

        function handleDateChanged() {
            const ev = document.getElementById('eventDate');
            const pk = document.getElementById('modalDatePicker');
            if (ev && pk) pk.value = ev.value || '';
            if (!ev || !ev.value) return;
            const today = new Date(); today.setHours(0, 0, 0, 0);
            const minD = new Date(today); minD.setDate(minD.getDate() + 30);
            const maxD = new Date(today); maxD.setDate(maxD.getDate() + 365);
            const val = new Date(ev.value + 'T00:00:00');
            if (val < minD) {
                showRecomAlert('Ngày tổ chức tiệc cưới cần cách hôm nay tối thiểu 30 ngày để Riverside Palace chuẩn bị chu đáo nhất. Hai bạn vui lòng chọn ngày xa hơn nhé!', 'Cần chọn ngày xa hơn một chút', 'warning');
                ev.value = toLocalDateStr(minD);
                if (pk) pk.value = ev.value;
            } else if (val > maxD) {
                showRecomAlert('Riverside Palace chỉ nhận giữ chỗ trước tối đa 365 ngày (1 năm). Hai bạn vui lòng chọn ngày gần hơn nhé!', 'Ngày chọn đang quá xa', 'warning');
                ev.value = toLocalDateStr(maxD);
                if (pk) pk.value = ev.value;
            }
        }

        // Ràng buộc ngân sách: min tuyệt đối 100tr (chi phí tối thiểu ~103,3tr cho 150 khách:
        // sảnh rẻ nhất Elbe 20tr + menu rẻ nhất 4,35tr/bàn × 15 bàn + decor rẻ nhất 18tr).
        // Min động theo số bàn: 38tr (20tr sảnh + 18tr decor) + tổng bàn × 4,35tr (chưa gồm dịch vụ).
        const MIN_BUDGET_ABSOLUTE = 100000000;
        const MAX_BUDGET_ABSOLUTE = 3000000000;
        const CHEAPEST_HALL_PRICE = 20000000;
        const CHEAPEST_DECOR_PRICE = 18000000;
        const CHEAPEST_MENU_PER_TABLE = 4350000;
        const OVER_BUDGET_TOLERANCE_VND = 10000000;

        function estimateMinBudget(totalTables) {
            const t = Math.max(0, parseInt(totalTables) || 0);
            return (CHEAPEST_HALL_PRICE + CHEAPEST_DECOR_PRICE) + t * CHEAPEST_MENU_PER_TABLE;
        }

        function fmtVnd(n) {
            return Number(n || 0).toLocaleString('vi-VN') + ' đ';
        }

        function parseBudget(value) {
            return Number(String(value || '').replace(/\D/g, '')) || 0;
        }

        function formatBudgetInput(input) {
            if (!input) return;
            const digits = String(input.value || '').replace(/\D/g, '');
            input.value = digits ? Number(digits).toLocaleString('vi-VN') : '';
        }

        function updateBudgetMinHint() {
            const hint = document.getElementById('budgetMinHint');
            if (!hint) return;
            const calc = syncGuestToTablesSilent();
            const minForTables = estimateMinBudget(calc.total);
            if (calc.total > 0) {
                hint.innerText = `Với ${calc.total} bàn (${calc.guests} khách), chi phí tối thiểu khoảng ${fmtVnd(minForTables)} (chưa gồm dịch vụ). Gợi ý chỉ vượt tối đa 10 triệu — hãy nhập ngân sách ≥ ${fmtVnd(Math.max(MIN_BUDGET_ABSOLUTE, minForTables))}.`;
            } else {
                hint.innerText = 'Ngân sách tối thiểu 100 triệu; với quy mô hiện tại cần khoảng -- để không vượt quá 10 triệu.';
            }
        }

        // Bản silent (không chạm DOM hint) để updateBudgetMinHint tránh đệ quy.
        function syncGuestToTablesSilent() {
            const gInput = document.getElementById('guestCount');
            const spareInput = document.getElementById('spareTableCount');
            const rawGuest = gInput ? String(gInput.value || '').trim() : '';
            const rawSpare = spareInput ? String(spareInput.value || '').trim() : '';
            let spare = parseInt(rawSpare === '' ? '0' : rawSpare) || 0;
            if (spare < 0) spare = 0;
            if (spare > 10) spare = 10;
            if (rawGuest === '') return { guests: 0, official: 0, spare, total: spare };
            let guests = parseInt(rawGuest) || 0;
            if (guests > 1400) guests = 1400;
            if (guests === 0) return { guests: 0, official: 0, spare, total: spare };
            const official = Math.ceil(guests / 10);
            return { guests, official, spare, total: official + spare };
        }

        // Quy đổi chuẩn 10 khách/bàn: OfficialTableCount = ceil(GuestCount/10), realtime hint.
        function syncGuestToTables() {
            const gInput = document.getElementById('guestCount');
            const offInput = document.getElementById('officialTableCount');
            const spareInput = document.getElementById('spareTableCount');
            const hint = document.getElementById('tableConvertHint');
            const rawGuest = gInput ? String(gInput.value || '').trim() : '';
            const rawSpare = spareInput ? String(spareInput.value || '').trim() : '';
            let spare = parseInt(rawSpare === '' ? '0' : rawSpare) || 0;
            if (spare < 0) spare = 0;
            if (spare > 10) { spare = 10; if (spareInput) spareInput.value = 10; }
            if (rawGuest === '') {
                if (offInput) offInput.value = 0;
                if (hint) hint.innerText = 'Nhập số khách để tự động quy đổi số bàn (quy chuẩn 10 khách/bàn) + số bàn dự phòng.';
                return { guests: 0, official: 0, spare, total: spare };
            }
            let guests = parseInt(rawGuest) || 0;
            if (guests === 0) {
                if (offInput) offInput.value = 0;
                if (hint) hint.innerText = 'Nhập số khách để tự động quy đổi số bàn (quy chuẩn 10 khách/bàn) + số bàn dự phòng.';
                return { guests: 0, official: 0, spare, total: spare };
            }
            if (guests > 1400) { guests = 1400; if (gInput) gInput.value = 1400; }
            let official = Math.ceil(guests / 10);
            if (offInput) offInput.value = official;
            const total = official + spare;
            if (hint) hint.innerText = `Quy đổi: ${official} bàn chính thức + ${spare} bàn dự phòng = Tổng ${total} bàn`;
            try {
                const bHint = document.getElementById('budgetMinHint');
                if (bHint) {
                    const minForTables = estimateMinBudget(total);
                    bHint.innerText = `Với ${total} bàn (${guests} khách), chi phí tối thiểu khoảng ${fmtVnd(minForTables)} (chưa gồm dịch vụ). Gợi ý chỉ vượt tối đa 10 triệu — hãy nhập ngân sách ≥ ${fmtVnd(Math.max(MIN_BUDGET_ABSOLUTE, minForTables))}.`;
                }
            } catch (e) { }
            return { guests, official, spare, total };
        }

        // Tooltip "?" ngân sách: click/hover để xem khoảng hợp lệ theo catalog thật.
        function toggleBudgetHelp(e) {
            if (e) e.stopPropagation();
            closeHelpPopover('dateHelpPopover', 'dateHelpBtn');
            toggleHelpPopover('budgetHelpPopover', 'budgetHelpBtn');
        }

        // Tooltip "?" ngày tổ chức: cùng hành vi với tooltip ngân sách.
        function toggleDateHelp(e) {
            if (e) e.stopPropagation();
            closeHelpPopover('budgetHelpPopover', 'budgetHelpBtn');
            toggleHelpPopover('dateHelpPopover', 'dateHelpBtn');
        }

        // Tooltip "?" giải thích 2 dòng giá trong modal tùy chỉnh thực đơn (gộp 1 popover).
        function toggleMenuPriceHelp(e) {
            if (e) e.stopPropagation();
            closeHelpPopover('budgetHelpPopover', 'budgetHelpBtn');
            closeHelpPopover('dateHelpPopover', 'dateHelpBtn');
            toggleHelpPopover('menuPriceHelpPopover', 'menuPriceHelpBtn');
        }

        function toggleHelpPopover(popId, btnId) {
            const pop = document.getElementById(popId);
            const btn = document.getElementById(btnId);
            if (!pop) return;
            const isHidden = pop.hasAttribute('hidden');
            if (isHidden) {
                pop.removeAttribute('hidden');
                if (btn) btn.setAttribute('aria-expanded', 'true');
            } else {
                pop.setAttribute('hidden', '');
                if (btn) btn.setAttribute('aria-expanded', 'false');
            }
        }

        function closeHelpPopover(popId, btnId) {
            const pop = document.getElementById(popId);
            const btn = document.getElementById(btnId);
            if (pop && !pop.hasAttribute('hidden')) {
                pop.setAttribute('hidden', '');
                if (btn) btn.setAttribute('aria-expanded', 'false');
            }
        }

        function isHelpEventInside(ev, popId, btnId) {
            const pop = document.getElementById(popId);
            const btn = document.getElementById(btnId);
            if (pop && pop.contains(ev.target)) return true;
            if (btn && btn.contains(ev.target)) return true;
            return false;
        }

        document.addEventListener('click', (ev) => {
            if (isHelpEventInside(ev, 'budgetHelpPopover', 'budgetHelpBtn')) return;
            if (isHelpEventInside(ev, 'dateHelpPopover', 'dateHelpBtn')) return;
            if (isHelpEventInside(ev, 'menuPriceHelpPopover', 'menuPriceHelpBtn')) return;
            closeHelpPopover('budgetHelpPopover', 'budgetHelpBtn');
            closeHelpPopover('dateHelpPopover', 'dateHelpBtn');
            closeHelpPopover('menuPriceHelpPopover', 'menuPriceHelpBtn');
        });

        document.addEventListener('keydown', (ev) => {
            if (ev.key !== 'Escape') return;
            const budgetPop = document.getElementById('budgetHelpPopover');
            const datePop = document.getElementById('dateHelpPopover');
            const menuPricePop = document.getElementById('menuPriceHelpPopover');
            let closed = false;
            if (budgetPop && !budgetPop.hasAttribute('hidden')) {
                closeHelpPopover('budgetHelpPopover', 'budgetHelpBtn');
                closed = true;
            }
            if (datePop && !datePop.hasAttribute('hidden')) {
                closeHelpPopover('dateHelpPopover', 'dateHelpBtn');
                closed = true;
            }
            if (menuPricePop && !menuPricePop.hasAttribute('hidden')) {
                closeHelpPopover('menuPriceHelpPopover', 'menuPriceHelpBtn');
                closed = true;
            }
            if (closed) return;
            // Esc đóng modal đang mở (ưu tiên modal mở sau cùng).
            const ids = ['menuCustomModal', 'bookingConfirmModal', 'bookingSuccessModal', 'duplicateBookingModal', 'recomAlertModal', 'itemDetailModal', 'showtimeModal'];
            for (const id of ids) {
                if (isRecomModalOpen(id)) {
                    closeRecomModal(id);
                    if (id === 'menuCustomModal') menuCustomState = null;
                    break;
                }
            }
        });

        // Đóng modal khi bấm backdrop.
        ['itemDetailModal', 'showtimeModal', 'bookingConfirmModal', 'bookingSuccessModal', 'duplicateBookingModal', 'recomAlertModal', 'menuCustomModal'].forEach(id => {
            document.addEventListener('click', (ev) => {
                const m = document.getElementById(id);
                if (m && m.classList.contains('open') && ev.target === m) {
                    closeRecomModal(id);
                    if (id === 'menuCustomModal') menuCustomState = null;
                }
            });
        });

        function validateTableCounts() {
            syncGuestToTables();
        }

        async function handleAnalyzeCombos(e) {
            e.preventDefault();
            validateTableCounts();

            // Validate ràng buộc 30–365 ngày trước khi gọi Backend.
            const dateVal = document.getElementById('eventDate').value;
            if (!dateVal) { showRecomAlert('Hai bạn vui lòng chọn ngày tổ chức dự kiến để Riverside Palace kiểm tra sảnh trống nhé!', 'Chưa chọn ngày tổ chức', 'info'); return; }
            const today0 = new Date(); today0.setHours(0, 0, 0, 0);
            const minD = new Date(today0); minD.setDate(minD.getDate() + 30);
            const maxD = new Date(today0); maxD.setDate(maxD.getDate() + 365);
            const minStr = toLocalDateStr(minD);
            const maxStr = toLocalDateStr(maxD);
            if (dateVal < minStr) { showRecomAlert('Ngày tổ chức cần cách hôm nay tối thiểu 30 ngày để Riverside Palace chuẩn bị chu đáo nhất. Hai bạn vui lòng chọn ngày xa hơn nhé!', 'Cần chọn ngày xa hơn một chút', 'warning'); return; }
            if (dateVal > maxStr) { showRecomAlert('Riverside Palace chỉ nhận giữ chỗ trước tối đa 365 ngày (1 năm). Hai bạn vui lòng chọn ngày gần hơn nhé!', 'Ngày chọn đang quá xa', 'warning'); return; }
            // Validate thông tin liên hệ (tên/SĐT/email) trước khi gọi Backend để khỏi nhận
            // lỗi ModelState chung chung "Dữ liệu khảo sát chưa hợp lệ".
            const coupleVal = String(document.getElementById('coupleName').value || '').trim();
            const phoneVal = String(document.getElementById('phoneNumber').value || '').trim();
            const emailVal = String(document.getElementById('email').value || '').trim();
            if (coupleVal.length < 2) { showRecomAlert('Hai bạn vui lòng nhập họ tên cô dâu & chú rể (hoặc người đại diện) để chuyên viên tiện xưng hô nhé!', 'Chưa nhập tên cặp đôi', 'info'); return; }
            if (!/^0\d{9}$/.test(phoneVal)) { showRecomAlert('Số điện thoại liên hệ gồm 10 chữ số, bắt đầu bằng số 0 (VD: 0912345678) để chuyên viên gọi xác nhận giữ chỗ nhé!', 'Số điện thoại chưa đúng', 'warning'); return; }
            if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/.test(emailVal)) { showRecomAlert('Hai bạn vui lòng nhập email hợp lệ để nhận bảng dự toán và xác nhận giữ chỗ nhé!', 'Email chưa hợp lệ', 'warning'); return; }
            const calc = syncGuestToTables();
            const guestRaw = String(document.getElementById('guestCount').value || '').trim();
            if (!guestRaw) { showRecomAlert('Hai bạn vui lòng nhập số lượng khách dự kiến (150 – 1400 khách, chuẩn 10 khách/bàn) nhé!', 'Chưa nhập số khách', 'info'); return; }
            const guestCount = parseInt(guestRaw) || calc.guests;
            if (guestCount < 150 || guestCount > 1400) { showRecomAlert('Số lượng khách phù hợp từ 150 đến 1400 khách (chuẩn 10 khách/bàn). Hai bạn vui lòng điều chỉnh lại nhé!', 'Số khách chưa phù hợp', 'warning'); return; }
            // P0: chặn quy đổi vượt Grand Ballroom (~140 bàn) trước submit.
            if ((calc.total || 0) > 140) { showRecomAlert('Quy mô ' + calc.total + ' bàn đã vượt quá sức chứa sảnh lớn nhất Grand Ballroom (tối đa 140 bàn / 1400 khách). Hai bạn vui lòng giảm số khách hoặc liên hệ Riverside Palace để tách ca tổ chức nhé!', 'Vượt sức chứa sảnh lớn nhất', 'warning'); return; }
            const budgetRaw = String(document.getElementById('expectedBudget').value || '').trim();
            if (!budgetRaw) { showRecomAlert('Hai bạn vui lòng nhập tổng ngân sách dự trù (tối thiểu 100 triệu – 3 tỷ VNĐ). Nhấn icon "?" cạnh ô ngân sách để xem khoảng hợp lệ nhé!', 'Chưa nhập ngân sách', 'info'); return; }
            const budgetVal = parseBudget(budgetRaw);
            if (isNaN(budgetVal)) { showRecomAlert('Ngân sách hai bạn nhập chưa hợp lệ. Vui lòng nhập số tiền bằng số (VNĐ) nhé!', 'Ngân sách chưa hợp lệ', 'warning'); return; }
            if (budgetVal < MIN_BUDGET_ABSOLUTE || budgetVal > MAX_BUDGET_ABSOLUTE) { showRecomAlert('Ngân sách phù hợp từ 100 triệu (tối thiểu ~103,3 triệu cho 150 khách) đến 3 tỷ VNĐ. Nhấn icon "?" cạnh ô ngân sách để xem cách ước lượng (sảnh 20–80tr + menu 4,35–5,9tr/bàn + decor 18–28tr) nhé!', 'Ngân sách ngoài khoảng cho phép', 'warning'); return; }
            // Ràng buộc động theo số bàn thực tế: Min = 38tr + tổng bàn × 4,35tr (chưa gồm dịch vụ).
            const minForTables = estimateMinBudget(calc.total);
            if (budgetVal < minForTables) {
                showRecomAlert(`Với ${calc.total} bàn (${guestCount} khách), chi phí tối thiểu khoảng ${fmtVnd(minForTables)} (20tr sảnh Elbe + ${calc.total}×4,35tr menu + 18tr decor, chưa gồm dịch vụ).\nNgân sách ${fmtVnd(budgetVal)} sẽ khiến gợi ý vượt quá 10 triệu.\nHai bạn vui lòng tăng ngân sách lên tối thiểu ${fmtVnd(Math.max(MIN_BUDGET_ABSOLUTE, minForTables))} hoặc giảm số khách nhé!`, 'Ngân sách hơi thấp so với quy mô', 'warning');
                try { updateBudgetMinHint(); } catch (e) { }
                return;
            }

            const btn = document.getElementById('btnSubmitRecom');
            const loading = document.getElementById('loadingState');
            const results = document.getElementById('resultsSection');

            btn.disabled = true;
            btn.style.opacity = '0.6';
            loading.style.display = 'block';
            results.style.display = 'none';
            results.classList.remove('open');

            const selectedServices = [];
            document.querySelectorAll('input[name="services"]:checked').forEach(cb => selectedServices.push(cb.value));

            const rawShiftVal = document.getElementById('shift').value;
            currentPayload = {
                coupleName: document.getElementById('coupleName').value.trim(),
                phoneNumber: document.getElementById('phoneNumber').value.trim(),
                email: document.getElementById('email').value.trim(),
                eventDate: String(document.getElementById('eventDate').value || '').trim().slice(0, 10),
                shift: (/trưa|trua/i.test(rawShiftVal || '') ? 'Ca trưa' : (/tối|toi/i.test(rawShiftVal || '') ? 'Ca tối' : String(rawShiftVal || '').trim())),
                guestCount: guestCount,
                officialTableCount: calc.official,
                spareTableCount: calc.spare,
                tableCount: calc.total,
                expectedBudget: budgetVal,
                budgetPriority: document.getElementById('budgetPriority').value,
                preferredSpaceType: document.getElementById('preferredSpaceType').value || null,
                desiredStyle: document.getElementById('desiredStyle').value || null,
                foodPreference: document.getElementById('foodPreference').value || null,
                selectedServiceCodes: selectedServices
            };

            try {
                const res = await fetch('/Recommendation/AnalyzeTop3', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(currentPayload)
                });
                const result = await res.json();

                btn.disabled = false;
                btn.style.opacity = '1';
                loading.style.display = 'none';

                if (result.success && result.data) {
                    renderCombosResult(result.data, currentPayload);
                    results.style.display = 'flex';
                    results.scrollIntoView({ behavior: 'smooth', block: 'start' });
                } else {
                    showRecomAlert(result.message || 'Chưa tìm thấy gói tiệc khả dụng trong ngày và ca này. Hai bạn hãy nhấn "Xem Lịch & Ca Trống" để chọn thời điểm phù hợp hơn nhé!', 'Chưa có gói phù hợp', 'info');
                }
            } catch (err) {
                btn.disabled = false;
                btn.style.opacity = '1';
                loading.style.display = 'none';
                showRecomAlert('Kết nối phân tích gói tiệc đang gián đoạn. Hai bạn vui lòng thử lại sau ít phút nhé!', 'Lỗi kết nối', 'error');
            }
        }

        function renderCombosResult(data, req) {
            document.getElementById('resNotice').innerText = data.algorithmNotice || data.AlgorithmNotice;
            const combos = data.topCombos || data.TopCombos || data.top_3 || data.data || data.Data || [];
            const count = data.count ?? data.Count ?? (Array.isArray(combos) ? combos.length : 0);
            const suggestedNext = data.suggestedNext || data.SuggestedNext || null;
            const box = document.getElementById('smartSuggestBox');
            const cardsBox = document.getElementById('combosCardsContainer');
            // P0 fallback 0 combo: ẩn card, hiện Smart Suggestion Box.
            if (!combos || combos.length === 0 || count === 0) {
                if (cardsBox) cardsBox.innerHTML = '';
                renderSmartSuggestBox(suggestedNext, req);
                if (box) box.style.display = 'block';
                document.getElementById('resNotice').innerText = (data.algorithmNotice || data.AlgorithmNotice || 'Không có combo phù hợp trong ngân sách +10tr hoặc ngày đã kín sảnh.');
                return;
            }
            if (box) box.style.display = 'none';
            const totalTables = req.tableCount || ((req.officialTableCount || 0) + (req.spareTableCount || 0)) || Math.ceil((req.guestCount || 300) / 10);
            // Lưu state Top 3 để tùy chỉnh thực đơn + giữ chỗ (customMenu giữ trong JS).
            topCombosState = combos.map((c, idx) => {
                const rank = c.rank ?? c.Rank ?? (idx + 1);
                const fallbackTitles = ['Combo Hoàn Hảo (Top 1)', 'Combo Tiêu Chuẩn (Top 2)', 'Combo Sang Trọng (Top 3)'];
                const fallbackBadges = ['LỰA CHỌN TỐI ƯU', 'CÂN BẰNG CHI PHÍ', 'TRẢI NGHIỆM ĐẲNG CẤP'];
                const fallbackTypes = ['BALANCED', 'STANDARD', 'LUXURY'];
                return {
                    comboIndex: idx,
                    rank,
                    title: c.comboTitle || c.ComboTitle || c.comboName || c.ComboName || c.packageName || c.PackageName || c.combo_name || fallbackTitles[idx] || fallbackTitles[0],
                    badge: c.comboBadge || c.ComboBadge || fallbackBadges[idx] || fallbackBadges[0],
                    comboType: c.comboType || c.ComboType || c.combo_type || fallbackTypes[idx] || 'BALANCED',
                    matchScore: c.overallMatchScore ?? c.OverallMatchScore ?? c.matchingScore ?? c.matching_score ?? 90,
                    budgetScore: c.budgetMatchScore ?? c.BudgetMatchScore ?? 0,
                    spaceScore: c.spaceFitScore ?? c.SpaceFitScore ?? 0,
                    styleScore: c.styleThemeScore ?? c.StyleThemeScore ?? 0,
                    ratingScore: c.ratingCredibilityScore ?? c.RatingCredibilityScore ?? 0,
                    analysisText: c.budgetAnalysisText || c.BudgetAnalysisText || '',
                    hallScheduleId: c.hallScheduleId ?? c.HallScheduleId ?? c.hall_schedule_id ?? 0,
                    hallId: c.hallId ?? c.HallId ?? c.hall_id ?? 0,
                    hallCode: c.hallCode || c.HallCode || '',
                    hallName: c.hallName || c.HallName || c.hall_name || 'Sảnh Riverside',
                    hallPriceNum: Number(c.hallRentalPrice ?? c.HallRentalPrice ?? c.hall_price ?? 0),
                    hallDesc: c.hallDescription || c.HallDescription || '',
                    hallMaxGuests: Number(c.capacity_max_guests ?? c.capacityMaxGuests ?? c.CapacityMaxGuests ?? c.hallCapacity ?? c.HallCapacity ?? 0) || 0,
                    hallMinGuests: Number(c.capacity_min_guests ?? c.capacityMinGuests ?? c.CapacityMinGuests ?? 0) || 0,
                    hallMaxTables: Number(c.capacity_max_tables ?? c.capacityMaxTables ?? c.CapacityMaxTables ?? 0) || 0,
                    hallMinTables: Number(c.capacity_min_tables ?? c.capacityMinTables ?? c.CapacityMinTables ?? 0) || 0,
                    hallImageUrl: c.hallImageUrl || c.HallImageUrl || c.hall_image_url || c.hallImage || c.HallImage || '',
                    menuId: c.menuId ?? c.MenuId ?? c.menu_id ?? 0,
                    menuName: c.menuName || c.MenuName || c.menu_name || 'Thực đơn Riverside',
                    menuPriceNum: Number(c.menuPricePerTable ?? c.MenuPricePerTable ?? c.price_per_table ?? 0),
                    menuDesc: c.menuDescription || c.MenuDescription || '',
                    decorId: c.decorationPackageId ?? c.DecorationPackageId ?? c.decor_id ?? 0,
                    decorName: c.decorationPackageName || c.DecorationPackageName || c.decor_name || 'Decor Riverside',
                    decorPriceNum: Number(c.decorationPrice ?? c.DecorationPrice ?? c.decor_price ?? 0),
                    decorStyle: c.decorationStyle || c.DecorationStyle || c.decor_style || '',
                    decorDesc: c.decorationDescription || c.DecorationDescription || '',
                    services: c.includedServices || c.IncludedServices || [],
                    servicesTotalNum: Number(c.servicesTotalPrice ?? c.ServicesTotalPrice ?? 0),
                    totalCostNum: Number(c.totalEstimatedCost ?? c.TotalEstimatedCost ?? c.total_estimated_cost ?? 0),
                    budgetDiffNum: Number(c.budgetDifference ?? c.BudgetDifference ?? 0),
                    explanations: c.explanations || c.Explanations || c.explanation_arguments || c.RecommendationReasons || c.recommendationReasons || [],
                    totalTables,
                    customMenu: null
                };
            });
            // Chuẩn hóa sức chứa còn thiếu (fallback quy đổi 1 bàn = 10 khách).
            topCombosState.forEach(s => {
                if (!s.hallMaxTables && s.hallMaxGuests) s.hallMaxTables = Math.floor(s.hallMaxGuests / 10);
                if (!s.hallMinTables && s.hallMinGuests) s.hallMinTables = Math.floor(s.hallMinGuests / 10);
            });
            renderComboCards(req);
        }

        function getComboDisplay(s) {
            const menuName = s.customMenu ? s.customMenu.customName : s.menuName;
            const menuPriceNum = s.customMenu ? s.customMenu.customPricePerTable : s.menuPriceNum;
            const menuTotal = menuPriceNum * s.totalTables;
            const totalCost = s.hallPriceNum + menuTotal + s.decorPriceNum + (s.servicesTotalNum || 0);
            return { menuName, menuPriceNum, menuTotal, totalCost };
        }

        // Chuẩn hóa đường dẫn ảnh sảnh Backend trả về (relative "images/..." hoặc
        // "/images/...") thành URL tuyệt đối dùng được trong <img>.
        function resolveHallImg(raw) {
            const s = String(raw || '').trim();
            if (s === '') return RECOM_HALL_PLACEHOLDER;
            if (/^https?:\/\//i.test(s) || s.startsWith('data:')) return s;
            return s.startsWith('/') ? s : '/' + s;
        }

        // Phương án C — Card minimal kiểu hall-card Home + Progressive disclosure.
        // Chỉ hiện: ảnh sảnh 280px + capacity-badge + title + tổng tiền + 2 CTA.
        // Chi tiết sảnh/menu/decor/điểm số giấu trong <details> Chi tiết (Xem breakdown).
        function renderComboCards(req) {
            const container = document.getElementById('combosCardsContainer');
            if (!container) return;
            container.innerHTML = '';
            const r = req || currentPayload || {};
            const officialT = r.officialTableCount ?? 0;
            const spareT = r.spareTableCount ?? 0;
            const esc = (x) => String(x ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/'/g, "\\'").replace(/"/g, '&quot;');
            const escHtml = (x) => String(x ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

            topCombosState.forEach((s, idx) => {
                const isBest = s.comboType === 'BALANCED' || s.rank === 1;
                const d = getComboDisplay(s);
                const totalCost = d.totalCost.toLocaleString('vi-VN');
                // P0 NFR04: nhãn ngân sách đúng — không hiển thị "Trong ngân sách" xanh khi vượt budget.
                const expected = Number((r && r.expectedBudget) || (currentPayload && currentPayload.expectedBudget) || 0);
                const diffVal = expected - d.totalCost;
                const diffStr = Math.abs(diffVal).toLocaleString('vi-VN');
                const budgetBadge = diffVal >= 0
                    ? `<span class="recom-budget-badge recom-budget-badge--success">✓ Trong ngân sách (Tiết kiệm ${diffStr} đ)</span>`
