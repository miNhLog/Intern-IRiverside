<footer class="home-footer">
    <div class="home-container">
        <div class="footer-grid">
            <div class="footer-brand">
                <a class="brand" asp-controller="Home" asp-action="Index" asp-route-publicSite="true">
                    <span class="brand-mark" aria-hidden="true">✧</span><span class="brand-name">Riverside Palace</span>
                </a>
                <p>Khám phá không gian tiệc và thực đơn công khai của Riverside Palace.</p>
            </div>
            <div>
                <h2>Khám phá</h2>
                <ul class="footer-links">
                    <li><a asp-controller="Home" asp-action="Index" asp-route-publicSite="true" asp-fragment="introduction">Giới thiệu</a></li>
                    <li><a asp-controller="Halls" asp-action="Index">Sảnh tiệc</a></li>
                    <li><a asp-controller="Menus" asp-action="Index">Thực đơn</a></li>
                </ul>
            </div>
            <div id="contact">
                <h2>Liên hệ</h2>
                <p>Thông tin liên hệ chính thức chưa được xác minh để hiển thị tại đây.</p>
            </div>
            <div>
                <h2>Dành cho nhân viên</h2>
                <ul class="footer-links"><li><a asp-controller="Auth" asp-action="Login">Đăng nhập nhân viên</a></li></ul>
            </div>
        </div>
        <div class="footer-bottom"><span>© @DateTime.Now.Year Riverside Palace</span></div>
    </div>
</footer>
