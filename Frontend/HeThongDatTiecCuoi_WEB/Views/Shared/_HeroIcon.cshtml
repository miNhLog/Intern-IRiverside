@model dynamic

@{
    var name = (string)Model.Name;
    var className = Model.Class is string customClass && !string.IsNullOrWhiteSpace(customClass)
        ? customClass
        : "heroicon";
}

<svg class="@className" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (name)
    {
        case "x-mark":
            <path d="M6 6l12 12M18 6L6 18" />
            break;
        case "check":
            <path d="m5 12.5 4.2 4.2L19 7" />
            break;
        case "cloud-arrow-up":
            <path d="M7.5 18.5h9a4 4 0 0 0 .6-7.96A5.5 5.5 0 0 0 6.4 9.2 3.75 3.75 0 0 0 7.5 18.5Z" />
            <path d="M12 15V8m0 0-2.5 2.5M12 8l2.5 2.5" />
            break;
        case "magnifying-glass":
            <circle cx="10.8" cy="10.8" r="6.3" />
            <path d="m16 16 4.5 4.5" />
            break;
        case "pencil-square":
            <path d="M4.5 19.5h4l9.8-9.8a2.1 2.1 0 0 0-3-3l-9.8 9.8v3Z" />
            <path d="m13.8 8.2 3 3M14 4.5h5.5v5.5" />
            break;
        case "lock-closed":
            <rect x="5" y="10" width="14" height="10" rx="2" />
            <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14.5v2" />
            break;
        case "lock-open":
            <rect x="5" y="10" width="14" height="10" rx="2" />
            <path d="M8 10V7a4 4 0 0 1 7.2-2.4M12 14.5v2" />
            break;
        case "eye":
            <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
            <circle cx="12" cy="12" r="2.5" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "arrow-path":
            <path d="M20 11a8 8 0 0 0-13.7-5.7L4 7.6M4 4v3.6h3.6M4 13a8 8 0 0 0 13.7 5.7l2.3-2.3m0 3.6v-3.6h-3.6" />
            break;
        case "chevron-right":
            <path d="m9 5 7 7-7 7" />
            break;
        case "bell":
            <path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4" />
            break;
        case "arrow-down-tray":
            <path d="M12 3v11m0 0 4-4m-4 4-4-4M5 19h14" />
            break;
        case "sparkles":
            <path d="m12 3 1.1 4.2L17 8.5l-3.9 1.3L12 14l-1.1-4.2L7 8.5l3.9-1.3L12 3ZM19 13l.6 2.4L22 16l-2.4.6L19 19l-.6-2.4L16 16l2.4-.6L19 13ZM5 15l.5 2L7.5 18l-2 .5L5 20.5l-.5-2-2-.5 2-.5L5 15Z" />
            break;
        case "funnel":
            <path d="M4 5h16l-6.2 7.1v5.3l-3.6 1.6v-6.9L4 5Z" />
            break;
        case "circle-alert":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 8v5m0 3h.01" />
            break;
        case "photo":
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <circle cx="8" cy="9" r="1.2" />
            <path d="m4 17 4.5-4 3 2.5 2.5-2 6 5.5" />
            break;
        case "layer":
            <path d="m12 3 8.5 4.5L12 12 3.5 7.5 12 3Z" />
            <path d="m3.5 12.5 8.5 4.5 8.5-4.5M3.5 17l8.5 4 8.5-4" />
            break;
        case "tune":
            <path d="M4 6h16M4 12h16M4 18h16" />
            <circle cx="9" cy="6" r="2" fill="currentColor" stroke="none" />
            <circle cx="15" cy="12" r="2" fill="currentColor" stroke="none" />
            <circle cx="11" cy="18" r="2" fill="currentColor" stroke="none" />
            break;
        case "archive-box":
            <path d="M4 7h16M5 7l1 13h12l1-13M9 11h6M3 4h18v3H3V4Z" />
            break;
        case "shield-check":
            <path d="M12 3 5 6v5c0 4.5 2.8 8 7 10 4.2-2 7-5.5 7-10V6l-7-3Z" />
            <path d="m8.5 12 2.2 2.2 4.8-5" />
            break;
        case "bars-3":
            <path d="M4 6h16M4 12h16M4 18h16" />
            break;
        case "hotel":
            <path d="M4 20V5h16v15M4 9h16M8 6v3m4-3v3m4-3v3M7 13h2m3 0h2m3 0h2M7 17h2m3 0h2m3 0h2" />
            break;
        case "utensils":
            <path d="M7 3v7m-2-7v4a2 2 0 0 0 4 0V3M7 10v11M17 3v18m0-18c-2 2-3 4-3 6h3" />
            break;
        case "tag":
            <path d="M4 5v6l9 9 7-7-9-9H4Z" />
            <circle cx="8" cy="8" r="1" />
            break;
        case "chart":
            <path d="M4 19V5m0 14h16M8 16v-4m4 4V8m4 8v-7" />
            break;
        case "user-shield":
            <circle cx="9" cy="8" r="3" />
            <path d="M3 20a6 6 0 0 1 12 0M17 13l4 1.7v2.8c0 2.1-1.6 3.9-4 4.5-2.4-.6-4-2.4-4-4.5v-2.8l4-1.7Z" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
            break;
        case "arrow-right-start":
            <path d="M13 5h6v14h-6M10 8l4 4-4 4M14 12H3" />
            break;
        default:
            <circle cx="12" cy="12" r="8" />
            break;
    }
</svg>
