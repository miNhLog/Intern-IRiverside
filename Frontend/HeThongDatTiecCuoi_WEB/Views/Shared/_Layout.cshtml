@{
    var isInternalAuth = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Auth", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Riverside Palace</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&amp;family=Jost:wght@400;500&amp;family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&amp;family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-format.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ai-chat.css" asp-append-version="true" />
    @if (isInternalAuth)
    {
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;subset=vietnamese&amp;display=swap" rel="stylesheet" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
        <script>
            try {
                const storedAuthTheme = localStorage.getItem("adminColorMode");
                const preferredAuthTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
                document.documentElement.dataset.authTheme = storedAuthTheme || preferredAuthTheme;
            } catch (error) {
                document.documentElement.dataset.authTheme = "light";
            }
        </script>
    }
    @await RenderSectionAsync("Styles", required: false)
    @if (isInternalAuth)
    {
        <link rel="stylesheet" href="~/css/backoffice-auth.css" asp-append-version="true" />
    }
</head>
<body class="@(isInternalAuth ? "auth-app" : string.Empty)">
    @if (isInternalAuth)
    {
        <button type="button" class="auth-theme-toggle" id="authThemeToggle" aria-label="Chuyển sang giao diện tối" title="Giao diện tối">
            <i class="bi bi-moon-stars" aria-hidden="true"></i>
        </button>
    }
    @RenderBody()
    <partial name="_AiChatWidget" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script src="~/js/ui-format.js" asp-append-version="true"></script>
    <script src="~/js/ai-chat.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
