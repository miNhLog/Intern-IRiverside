@using System.Globalization
@model HeThongDatTiecCuoi_WEB.Models.Menus.MenuDetailViewModel
@{
    var hasMenu = !Model.IsNotFound && string.IsNullOrWhiteSpace(Model.ErrorMessage);
    ViewData["Title"] = hasMenu ? Model.MenuName : Model.IsNotFound ? "Không tìm thấy thực đơn" : "Thông tin thực đơn tạm thời không khả dụng";
    ViewData["PublicActivePage"] = "menus";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var placeholderImage = Url.Content("~/images/menus/menu-banquet.png");
    var description = string.IsNullOrWhiteSpace(Model.Description)
        ? "Mô tả thực đơn chưa được cung cấp."
        : Model.Description;
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;family=Plus+Jakarta+Sans:wght@300..800&amp;family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/menu-detail.css" asp-append-version="true" />
}

<div class="home-page menu-detail-page">
    <partial name="_PublicHeader" />
    <main id="main-content" tabindex="-1">
        @if (!hasMenu)
        {
            <section class="menu-detail-feedback">
                <div class="home-container">
                    <div class="menu-detail-feedback-card" role="@(Model.IsNotFound ? null : "alert")">
                        <span class="material-symbols-outlined" aria-hidden="true">@(Model.IsNotFound ? "search_off" : "error")</span>
                        <span class="menu-detail-label">RIVERSIDE PALACE</span>
                        <h1>@(Model.IsNotFound ? "Không tìm thấy thực đơn." : "Không thể tải thông tin thực đơn")</h1>
                        <p>@(Model.IsNotFound ? "Thực đơn bạn đang tìm không tồn tại hoặc hiện không được công khai." : Model.ErrorMessage)</p>
                        <a asp-controller="Menus" asp-action="Index"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span> Quay lại danh sách thực đơn</a>
                    </div>
                </div>
            </section>
        }
        else
        {
            <section class="menu-detail-hero" aria-labelledby="menu-detail-title">
                <img class="menu-detail-hero-image" src="@placeholderImage" alt="" aria-hidden="true" />
                <div class="menu-detail-hero-shade" aria-hidden="true"></div>
                <div class="home-container menu-detail-hero-content">
                    <span>THỰC ĐƠN</span>
                    <h1 id="menu-detail-title">@Model.MenuName</h1>
                    <p>@description</p>
                </div>
            </section>

            <nav class="menu-detail-breadcrumb" aria-label="Đường dẫn trang">
                <div class="home-container">
                    <a asp-controller="Home" asp-action="Index" asp-route-publicSite="true"><span class="material-symbols-outlined" aria-hidden="true">home</span> Trang chủ</a>
                    <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                    <a asp-controller="Menus" asp-action="Index">Thực đơn</a>
                    <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                    <span aria-current="page">@Model.MenuName</span>
                </div>
            </nav>

            <section class="menu-detail-main" aria-label="Chi tiết thực đơn @Model.MenuName">
                <div class="home-container">
                    <div class="menu-detail-overview">
                        <figure class="menu-detail-photo">
                            <img src="@placeholderImage" alt="@Model.MenuName" />
                        </figure>
                        <div class="menu-detail-summary">
                            <span class="menu-detail-label">@Model.MenuCode</span>
                            <h2>@Model.MenuName</h2>
                            <p class="menu-detail-intro">@description</p>
                            <div class="menu-detail-meta">
                                <div><span class="material-symbols-outlined" aria-hidden="true">restaurant</span><strong>@Model.DishCount món</strong></div>
                                <div><span class="material-symbols-outlined" aria-hidden="true">payments</span><strong>@Model.PricePerTable.ToString("N0", vi) VNĐ</strong><small>/ bàn</small></div>
                            </div>
                            <a class="menu-detail-primary" asp-controller="Menus" asp-action="Index"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span> Quay lại danh sách thực đơn</a>
                        </div>
                    </div>

                    <section class="menu-dishes" aria-labelledby="menu-dishes-title">
                        <div class="menu-section-heading">
                            <span class="menu-detail-label">ẨM THỰC RIVERSIDE PALACE</span>
                            <h2 id="menu-dishes-title">Danh sách món</h2>
                        </div>
                        @if (Model.Dishes.Count == 0)
                        {
                            <div class="menu-dishes-empty">
                                <span class="material-symbols-outlined" aria-hidden="true">restaurant_menu</span>
                                <p>Thực đơn hiện chưa có món ăn được công khai.</p>
                            </div>
                        }
                        else
                        {
                            <div class="menu-dish-groups">
                                @foreach (var group in Model.DishGroups)
                                {
                                    <article class="menu-dish-group">
                                        <header>
                                            <span class="material-symbols-outlined" aria-hidden="true">@group.Icon</span>
                                            <h3>@group.Name</h3>
                                            <span>(@group.Dishes.Count món)</span>
                                        </header>
                                        <div class="menu-dish-list">
                                            @foreach (var dish in group.Dishes)
                                            {
                                                var dishImage = string.IsNullOrWhiteSpace(dish.ImageUrl) ? placeholderImage : dish.ImageUrl;
                                                <div class="menu-dish-item">
                                                    <img src="@dishImage" alt="@dish.DishName" loading="lazy" data-fallback="@placeholderImage" />
                                                    <div>
                                                        <strong>@dish.DishName</strong>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </section>

                    <div class="menu-detail-cta"><a asp-controller="Halls" asp-action="Index">Khám phá sảnh tiệc <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a></div>
                </div>
            </section>
        }
    </main>
    <partial name="_PublicFooter" />
    <div class="home-toast" role="status" aria-live="polite" hidden></div>
</div>

@section Scripts {
    <script src="~/js/public-site.js" asp-append-version="true"></script>
    <script src="~/js/hall-list.js" asp-append-version="true"></script>
}
