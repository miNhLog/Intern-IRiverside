@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tiệc được phân công";
}

<header class="top-header">
    <div>
        <div class="breadcrumb">Công việc của tôi <span>›</span> <strong>Tiệc được phân công</strong></div>
        <h2>Tiệc được phân công</h2>
    </div>
</header>

<section class="content coordinator-page">
    <div class="assignment-hero">
        <div>
            <span class="eyebrow">ĐIỀU PHỐI TIỆC</span>
            <h1>Danh sách tiệc của tôi</h1>
            <p>Chỉ hiển thị các tiệc mà bạn là Điều phối viên chính. Bạn không thể xem hoặc thao tác tiệc ngoài phạm vi được giao.</p>
        </div>
    </div>

    <div class="section-header"><div><h3>Tiệc được phân công</h3><p>Thông tin chi tiết phục vụ vận hành sẽ được hiển thị khi API phân công điều phối được kết nối.</p></div></div>
    <div class="hall-schedule-table-wrap">
        <table class="hall-schedule-table assigned-party-table">
            <thead><tr><th>Mã booking</th><th>Khách hàng</th><th>Ngày</th><th>Ca</th><th>Sảnh</th><th>Số bàn</th><th>Thực đơn</th><th>Decor</th><th>Dịch vụ</th><th>Yêu cầu đặc biệt</th><th>Trạng thái</th></tr></thead>
            <tbody><tr><td colspan="11" class="table-empty-state"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> Chưa có dữ liệu. Cần API chỉ trả về tiệc được giao cho Điều phối viên đang đăng nhập.</td></tr></tbody>
        </table>
    </div>
</section>
