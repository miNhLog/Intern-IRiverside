@using System.Globalization
@using HeThongDatTiecCuoi_WEB.Models.AdminHall
@model HeThongDatTiecCuoi_WEB.Models.Home.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
    ViewData["PublicActivePage"] = "home";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var defaultHeroImage = "https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=2400&q=85";
    var placeholderImage = Url.Content("~/images/home/hall-placeholder.jpg");
    var bannerHalls = Model.FeaturedHalls
        .Where(h => !string.IsNullOrWhiteSpace(h.ImageUrl))
        .ToList();
    if (bannerHalls.Count == 0)
    {
        bannerHalls.Add(new HallDto { ImageUrl = defaultHeroImage, HallName = "Riverside Palace" });
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="home-page">
    <partial name="_PublicHeader" />
    <main>
        <!-- CINEMATIC LUXURY HERO BANNER (8K EDITORIAL EXPERIENCE) -->
        <section class="cinema-hero" aria-label="Trung tâm Hội nghị Tiệc cưới Riverside Palace">
            <div class="cinema-scenes" id="cinemaHeroScenes">
                @for (var i = 0; i < Model.Banners.Count; i++)
                {
                    var banner = Model.Banners[i];
                    <div class="cinema-scene @(i == 0 ? "is-active" : null)" data-scene="@i">
                        <img src="@banner.ImageUrl" alt="@banner.ImageAlt" class="cinema-img"
                             fetchpriority="@(i == 0 ? "high" : null)" loading="@(i == 0 ? null : "lazy")" />
                    </div>
                }
            </div>

            <!-- Gradient & Vignette Overlay to ensure text readability & luxury glow -->
            <div class="cinema-overlay" aria-hidden="true"></div>

            <!-- Foreground Content: Editorial Copy, Badges, CTAs -->
            <div class="home-container cinema-content-wrap">
                <div class="cinema-stories" id="cinemaHeroStories">
                    @for (var i = 0; i < Model.Banners.Count; i++)
                    {
                        var banner = Model.Banners[i];
                        <article class="cinema-story @(i == 0 ? "is-active" : null)" data-story="@i">
                            @if (i == 0)
                            { <h1 class="cinema-title">@banner.Title<br /><em>@banner.Subtitle</em></h1> }
                            else
                            { <h2 class="cinema-title">@banner.Title<br /><em>@banner.Subtitle</em></h2> }
                            <p class="cinema-desc">@banner.Description</p>
                            <div class="cinema-actions">
                                @foreach (var action in new[] { (banner.PrimaryActionType, banner.PrimaryButtonLabel, banner.PrimaryLink, "cinema-btn--gold"), (banner.SecondaryActionType, banner.SecondaryButtonLabel, banner.SecondaryLink, "cinema-btn--glass") })
                                {
                                    if (action.Item1 == "AI" && !string.IsNullOrWhiteSpace(action.Item2))
                                    { <button class="cinema-btn @action.Item4" type="button" data-open-ai-new><span class="material-symbols-outlined" aria-hidden="true">smart_toy</span>@action.Item2</button> }
                                    else if ((action.Item1 == "INTERNAL" || action.Item1 == "SECTION") && !string.IsNullOrWhiteSpace(action.Item2) && !string.IsNullOrWhiteSpace(action.Item3))
                                    { <a class="cinema-btn @action.Item4" href="@action.Item3">@action.Item2<span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a> }
                                }
                            </div>
                        </article>
                    }
                </div>

                <!-- Interactive Story Tabs with Real-time Progress Bar -->
                @if (Model.Banners.Count > 1)
                {
                    <div class="cinema-nav" role="tablist" aria-label="Bộ chọn chủ đề trải nghiệm">
                        @for (var i = 0; i < Model.Banners.Count; i++)
                        {
                            <button class="cinema-nav-tab @(i == 0 ? "is-active" : null)" type="button" role="tab" data-nav-target="@i" aria-selected="@(i == 0 ? "true" : "false")">
                                <span class="cinema-tab-num">@((i + 1).ToString("00"))</span><span class="cinema-tab-info"><strong class="cinema-tab-label">@Model.Banners[i].NavigationLabel</strong></span><span class="cinema-tab-progress"><span class="cinema-progress-fill"></span></span>
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- Floating Key Metrics Bar (Bottom Ticker) -->
            <div class="cinema-metrics-bar">
                <div class="home-container cinema-metrics-inner">
                    <div class="cinema-metric-item">
                        <span class="material-symbols-outlined">domain</span>
                        <div><strong>09</strong><span>Đại Sảnh Châu Âu</span></div>
                    </div>
                    <div class="cinema-metric-divider"></div>
                    <div class="cinema-metric-item">
                        <span class="material-symbols-outlined">groups</span>
                        <div><strong>200 - 1.400</strong><span>Khách / Đại Tiệc</span></div>
                    </div>
                    <div class="cinema-metric-divider"></div>
                    <div class="cinema-metric-item">
                        <span class="material-symbols-outlined">water</span>
                        <div><strong>Ven Sông</strong><span>Bến Vân Đồn, Q.4</span></div>
                    </div>
                    <div class="cinema-metric-divider"></div>
                    <div class="cinema-metric-item">
                        <span class="material-symbols-outlined">workspace_premium</span>
                        <div><strong>5 Sao</strong><span>Tiêu Chuẩn Quốc Tế</span></div>
                    </div>
                </div>
            </div>
        </section>

        <section class="innovation-section" aria-labelledby="innovation-title">
            <div class="home-container">
                <div class="innovation-intro" data-reveal><span class="eyebrow">Đột Phá Kỷ Nguyên Số</span><h2 id="innovation-title">Trải Nghiệm Công Nghệ<br />Tiệc Cưới <em>Đỉnh Cao</em></h2><p>Tiên phong ứng dụng công nghệ vào tổ chức và quản lý sự kiện hạnh phúc, hướng tới trải nghiệm thuận tiện và chuẩn mực thượng lưu.</p></div>
                <div class="feature-list">
                    <article class="feature-row" data-reveal data-reveal-delay="1"><span class="feature-index" aria-hidden="true">01</span><div><span class="eyebrow">Tự Động Hóa 24/7</span><h3>Trợ lý AI tư vấn 24/7</h3><p>Giao diện tư vấn giúp quý khách hình dung cách lựa chọn sảnh, thực đơn và ngân sách cho ngày trọng đại.</p></div><button class="feature-action" type="button" data-open-ai-new>Khám phá tính năng <span class="material-symbols-outlined" aria-hidden="true">north_east</span></button></article>
                    <article class="feature-row" data-reveal data-reveal-delay="2"><span class="feature-index" aria-hidden="true">02</span><div><span class="eyebrow">Tối Ưu Ngân Sách</span><h3>Hệ thống gợi ý Top 3 combo tối ưu</h3><p>Khám phá ý tưởng kết hợp sảnh tiệc, thực đơn và trang trí theo phong cách riêng của từng cặp đôi.</p></div><button class="feature-action" type="button" data-coming-soon>Xem 3 gói đề xuất <span class="material-symbols-outlined" aria-hidden="true">north_east</span></button></article>
                    <article class="feature-row" data-reveal data-reveal-delay="3"><span class="feature-index" aria-hidden="true">03</span><div><span class="eyebrow">An Tâm Tuyệt Đối</span><h3>Minh bạch tiến độ &amp; Hợp đồng</h3><p>Theo dõi thông tin tiệc cưới và các giai đoạn chuẩn bị trong một không gian quản lý thuận tiện.</p></div><button class="feature-action" type="button" data-coming-soon>Tìm hiểu quy trình <span class="material-symbols-outlined" aria-hidden="true">north_east</span></button></article>
                </div>
                <div class="ai-preview" data-reveal="scale"><div><h3>Sẵn sàng nhận kịch bản tiệc cưới chỉ sau 3 câu hỏi?</h3><p>Khám phá giao diện tư vấn tiệc cưới của Riverside Palace. Trợ lý ảo trực tuyến 24/7, sẵn sàng giải đáp về sảnh, thực đơn và ngân sách.</p></div><button class="button button-outline" type="button" data-open-ai-new>Khởi động AI Concierge <span class="material-symbols-outlined" aria-hidden="true">north_east</span></button></div>
            </div>
        </section>

        <section class="halls-section" id="danh-sach-sanh" aria-labelledby="halls-title">
            <div class="home-container halls-layout">
                <div class="halls-copy" data-reveal="left"><span class="eyebrow">Không Gian Tiệc Đẳng Cấp</span><h2 id="halls-title">Kiệt Tác Sảnh Tiệc Hoàng Gia</h2><p>Lấy cảm hứng từ những dòng sông huyền thoại của châu Âu, mỗi đại sảnh tại Riverside Palace là một tuyệt tác kiến trúc nguy nga, tráng lệ.</p><a class="editorial-link" asp-controller="Halls" asp-action="Index">Xem tất cả sảnh <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>@if (Model.FeaturedHalls.Count > 1) { <div class="deck-instruction"><span class="material-symbols-outlined" aria-hidden="true">swipe</span><span>Kéo thẻ sang hai phía<br />hoặc dùng phím mũi tên</span></div> }</div>
                <div class="hall-deck-column" data-reveal="right">
                    @if (Model.FeaturedHalls.Count == 0)
                    {
                        <div class="empty-halls">Hiện chưa có thông tin sảnh nổi bật.</div>
                    }
                    else
                    {
                        <div class="hall-deck" id="featuredHallDeck" tabindex="0" aria-label="Danh sách sảnh nổi bật. Dùng phím mũi tên trái hoặc phải để chuyển sảnh.">
                            @for (var index = 0; index < Model.FeaturedHalls.Count; index++)
                            {
                                var hall = Model.FeaturedHalls[index];
                                var capacity = hall.MinimumCapacity.HasValue && hall.MinimumCapacity.Value > 0 ? hall.MinimumCapacity.Value == hall.MaximumCapacity ? $"{hall.MaximumCapacity.ToString("N0", vi)} khách" : $"{hall.MinimumCapacity.Value.ToString("N0", vi)} - {hall.MaximumCapacity.ToString("N0", vi)} khách" : $"Tối đa {hall.MaximumCapacity.ToString("N0", vi)} khách";
                                var image = string.IsNullOrWhiteSpace(hall.ImageUrl) ? placeholderImage : hall.ImageUrl;
                                <article class="hall-card" data-hall-card data-hall-index="@index" aria-hidden="@(index == 0 ? "false" : "true")">
                                    <a class="hall-image-wrap" asp-controller="Halls" asp-action="Details" asp-route-hallId="@hall.HallId" aria-label="Xem chi tiết sảnh @hall.HallName"><img src="@image" alt="Không gian @hall.HallName" loading="lazy" data-fallback="@placeholderImage" /><span class="hall-status">@hall.StatusName</span></a>
                                    <div class="hall-content"><div class="hall-title-row"><h3>@hall.HallName</h3><span class="capacity-badge">@capacity</span></div><p class="hall-description">@(string.IsNullOrWhiteSpace(hall.Description) ? "Không gian tiệc cưới sang trọng tại Riverside Palace." : hall.Description)</p><div class="hall-bottom"><div><span class="price-label">Giá thuê sảnh</span><strong>@hall.RentalPrice.ToString("N0", vi) VNĐ</strong></div><a class="hall-detail" asp-controller="Halls" asp-action="Details" asp-route-hallId="@hall.HallId">Xem chi tiết <span class="material-symbols-outlined" aria-hidden="true">north_east</span></a></div></div>
                                </article>
                            }
                        </div>
                        <div class="deck-controls" aria-label="Điều hướng sảnh"><button type="button" aria-label="Xem sảnh trước" data-hall-prev><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span></button><span class="deck-progress"><strong data-deck-current>01</strong><i></i><span>@Model.FeaturedHalls.Count.ToString("00")</span></span><button type="button" aria-label="Xem sảnh kế" data-hall-next><span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></button></div>
                    }
                </div>
            </div>
        </section>
        <partial name="_HomeFaq" />
    </main>
    <partial name="_PublicFooter" />
    <div class="home-toast" role="status" aria-live="polite" hidden></div>
</div>

@section Scripts { <script src="~/js/home.js" asp-append-version="true"></script> }
