@using System.Globalization
@model HeThongDatTiecCuoi_WEB.Models.Home.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
    ViewData["PublicActivePage"] = "home";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var placeholderImage = Url.Content("~/images/home/hall-placeholder.jpg");
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;family=Plus+Jakarta+Sans:wght@300..800&amp;family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="home-page">
    <partial name="_PublicHeader" />
    <main id="main-content" tabindex="-1">
        <section class="hero" aria-labelledby="hero-title">
            <div class="hero-image" aria-hidden="true"></div>
            <div class="home-container hero-inner">
                <div class="hero-copy">
                    <span class="eyebrow hero-eyebrow">Riverside Palace</span>
                    <h1 id="hero-title">Một khởi đầu đẹp cho <em>ngày trọng đại</em></h1>
                    <p>Khám phá không gian sảnh tiệc và thực đơn công khai để tìm hiểu những lựa chọn tại Riverside Palace.</p>
                    <div class="hero-actions">
                        <a class="button button-gold" asp-controller="Halls" asp-action="Index">Khám phá sảnh tiệc <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
                        <a class="button button-glass" asp-controller="Menus" asp-action="Index">Khám phá thực đơn <span class="material-symbols-outlined" aria-hidden="true">restaurant_menu</span></a>
                    </div>
                </div>
                <a class="hero-scroll-link" href="#introduction"><span aria-hidden="true">↓</span> Khám phá Riverside Palace</a>
            </div>
        </section>

        <section class="introduction-section" id="introduction" aria-labelledby="introduction-title">
            <div class="home-container introduction-layout">
                <div class="introduction-mark" aria-hidden="true">R<span>·</span>P</div>
                <div class="introduction-copy">
                    <span class="eyebrow">Riverside Palace</span>
                    <h2 id="introduction-title">Không gian để bắt đầu hành trình khám phá</h2>
                    <p>Tìm hiểu các sảnh tiệc và thực đơn đang được giới thiệu công khai. Mỗi danh mục mở ra thông tin thực tế để bạn tham khảo theo nhu cầu của mình.</p>
                    <a class="text-link" asp-controller="Halls" asp-action="Index">Xem các sảnh tiệc <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
                </div>
            </div>
        </section>

        <section class="halls-section" id="danh-sach-sanh" aria-labelledby="halls-title">
            <div class="home-container">
                <div class="halls-heading">
                    <div class="section-heading">
                        <span class="eyebrow">Không gian tiệc</span>
                        <h2 id="halls-title">Khám phá sảnh tiệc</h2>
                        <span class="gold-rule" aria-hidden="true"></span>
                        <p>Tìm hiểu thông tin sức chứa, giá thuê và mô tả của các sảnh đang được giới thiệu.</p>
                    </div>
                    <a class="text-link all-halls-link" asp-controller="Halls" asp-action="Index">Tất cả sảnh <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
                </div>
                @if (Model.FeaturedHallsUnavailable)
                {
                    <div class="home-feedback" role="alert">
                        <span class="material-symbols-outlined" aria-hidden="true">error</span>
                        <div><h3>Chưa thể tải thông tin sảnh</h3><p>Vui lòng thử lại sau hoặc xem danh sách sảnh.</p></div>
                        <a class="button button-navy" asp-controller="Halls" asp-action="Index">Mở danh sách sảnh</a>
                    </div>
                }
                else if (Model.FeaturedHalls.Count == 0)
                {
                    <div class="empty-halls">Hiện chưa có sảnh nổi bật để hiển thị. Bạn có thể xem danh sách sảnh.</div>
                }
                else
                {
                    <div class="hall-grid" id="featuredHallGrid">
                        @foreach (var hall in Model.FeaturedHalls.Take(3))
                        {
                            var capacity = hall.MinimumCapacity.HasValue && hall.MinimumCapacity.Value > 0
                                ? hall.MinimumCapacity.Value == hall.MaximumCapacity ? $"{hall.MaximumCapacity.ToString("N0", vi)} khách" : $"{hall.MinimumCapacity.Value.ToString("N0", vi)} - {hall.MaximumCapacity.ToString("N0", vi)} khách"
                                : $"Tối đa {hall.MaximumCapacity.ToString("N0", vi)} khách";
                            var image = string.IsNullOrWhiteSpace(hall.ImageUrl) ? placeholderImage : hall.ImageUrl;
                            <article class="hall-card">
                                <a class="hall-image-wrap" asp-controller="Halls" asp-action="Details" asp-route-hallId="@hall.HallId" aria-label="Xem chi tiết sảnh @hall.HallName">
                                    <img src="@image" alt="Không gian @hall.HallName" loading="lazy" data-fallback="@placeholderImage" />
                                    <span class="capacity-badge"><span class="material-symbols-outlined" aria-hidden="true">groups</span> @capacity</span>
                                </a>
                                <div class="hall-content">
                                    <h3>@hall.HallName</h3>
                                    <p class="hall-description">@(string.IsNullOrWhiteSpace(hall.Description) ? "Xem thông tin chi tiết của sảnh tại Riverside Palace." : hall.Description)</p>
                                    <div class="hall-bottom">
                                        <div><span class="price-label">Giá thuê sảnh</span><strong>@hall.RentalPrice.ToString("N0", vi) VNĐ</strong></div>
                                        <a class="button hall-detail" asp-controller="Halls" asp-action="Details" asp-route-hallId="@hall.HallId">Chi tiết <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></a>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
                <div class="section-end-link"><a class="button button-outline" asp-controller="Halls" asp-action="Index">Xem tất cả sảnh tiệc</a></div>
            </div>
        </section>

        <section class="cuisine-section" aria-labelledby="cuisine-title">
            <div class="home-container cuisine-layout">
                <div class="cuisine-image-wrap"><img src="~/images/menus/menu-banquet.png" alt="Minh họa thực đơn tiệc" loading="lazy" /></div>
                <div class="cuisine-copy">
                    <span class="eyebrow">Ẩm thực</span>
                    <h2 id="cuisine-title">Tìm hiểu các thực đơn</h2>
                    <p>Xem danh mục thực đơn và thông tin món ăn, số lượng món cùng mức giá được công khai.</p>
                    <a class="button button-navy" asp-controller="Menus" asp-action="Index">Mở danh mục thực đơn <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
                </div>
            </div>
        </section>

        <section class="journey-section" id="journey" aria-labelledby="journey-title">
            <div class="home-container">
                <div class="section-heading centered">
                    <span class="eyebrow">Khám phá theo cách của bạn</span>
                    <h2 id="journey-title">Bắt đầu từ điều bạn muốn biết</h2>
                    <span class="gold-rule" aria-hidden="true"></span>
                </div>
                <div class="journey-grid">
                    <a href="#introduction"><span>01</span><h3>Tìm hiểu</h3><p>Khám phá thông tin Riverside Palace.</p></a>
                    <a asp-controller="Halls" asp-action="Index"><span>02</span><h3>Sảnh tiệc</h3><p>Xem sức chứa, giá và mô tả sảnh.</p></a>
                    <a asp-controller="Menus" asp-action="Index"><span>03</span><h3>Thực đơn</h3><p>Khám phá danh mục món ăn.</p></a>
                </div>
            </div>
        </section>
    </main>
    <partial name="_PublicFooter" />
</div>

@section Scripts {
    <script src="~/js/public-site.js" asp-append-version="true"></script>
}
