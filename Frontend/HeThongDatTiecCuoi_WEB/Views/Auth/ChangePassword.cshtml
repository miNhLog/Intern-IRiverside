@model HeThongDatTiecCuoi_WEB.Models.Auth.ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu lần đầu"; }

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,300..600,0..1,-50..200&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<main class="first-password-page">
    <div class="first-password-content">
        <header class="first-password-brand" aria-label="Riverside Palace">
            <strong>RIVERSIDE PALACE</strong>
            <span>HỆ THỐNG QUẢN LÝ NỘI BỘ</span>
        </header>

        <section class="first-password-card" aria-labelledby="change-password-title">
            <div class="first-password-heading">
                <div class="crest"><span class="material-symbols-outlined" aria-hidden="true">lock</span></div>
                <h1 id="change-password-title">Đổi mật khẩu lần đầu</h1>
            </div>
            <p class="first-password-subtitle">Tài khoản của bạn vừa được cấp. Vui lòng thiết lập mật khẩu mới trước khi tiếp tục sử dụng hệ thống.</p>

            <form asp-action="ChangePassword" asp-controller="Auth" method="post" class="first-password-form" data-password-form>
                <div asp-validation-summary="ModelOnly" class="alert-error" role="alert"></div>

                <div class="field">
                    <label asp-for="CurrentPassword">MẬT KHẨU HIỆN TẠI</label>
                    <div class="input-wrap"><span class="material-symbols-outlined" aria-hidden="true">lock</span><input asp-for="CurrentPassword" placeholder="Nhập mật khẩu hiện tại" autocomplete="current-password" /><button class="toggle-password" type="button" aria-label="Hiện mật khẩu"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></button></div>
                    <span asp-validation-for="CurrentPassword" class="field-error"></span>
                    <small class="field-helper">Sử dụng mật khẩu tạm thời do quản trị viên cung cấp.</small>
                </div>
                <div class="field">
                    <label asp-for="NewPassword">MẬT KHẨU MỚI</label>
                    <div class="input-wrap"><span class="material-symbols-outlined" aria-hidden="true">lock</span><input asp-for="NewPassword" placeholder="Nhập mật khẩu mới" autocomplete="new-password" /><button class="toggle-password" type="button" aria-label="Hiện mật khẩu"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></button></div>
                    <span asp-validation-for="NewPassword" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="ConfirmPassword">XÁC NHẬN MẬT KHẨU MỚI</label>
                    <div class="input-wrap"><span class="material-symbols-outlined" aria-hidden="true">lock</span><input asp-for="ConfirmPassword" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" /><button class="toggle-password" type="button" aria-label="Hiện mật khẩu"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></button></div>
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span><span class="field-error client-confirm-error" aria-live="polite"></span>
                </div>

                <aside class="password-requirements" aria-label="Yêu cầu mật khẩu">
                    <div><span class="material-symbols-outlined" aria-hidden="true">security</span><strong>Yêu cầu mật khẩu</strong></div>
                    <ul><li data-rule="length">Ít nhất 8 ký tự</li><li data-rule="uppercase">Có ít nhất 1 chữ hoa (A - Z)</li><li data-rule="lowercase">Có ít nhất 1 chữ thường (a - z)</li><li data-rule="number">Có ít nhất 1 chữ số (0 - 9)</li><li data-rule="special">Có ít nhất 1 ký tự đặc biệt</li></ul>
                </aside>
                <button class="primary-button first-password-submit" type="submit">Cập nhật mật khẩu</button>
            </form>
            <div class="first-password-divider"></div>
            <form asp-action="Logout" asp-controller="Auth" method="post" class="logout-form"><button type="submit" class="logout-link"><span class="material-symbols-outlined" aria-hidden="true">logout</span>Đăng xuất</button></form>
        </section>
    </div>
</main>
