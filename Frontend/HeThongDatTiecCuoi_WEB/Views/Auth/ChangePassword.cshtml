@model HeThongDatTiecCuoi_WEB.Models.Auth.ChangePasswordViewModel
@{
    var requiresOtp = bool.TryParse(User.FindFirst("must_change_password")?.Value, out var mustChangePassword) && mustChangePassword;
    ViewData["Title"] = requiresOtp ? "Đổi mật khẩu lần đầu" : "Đổi mật khẩu";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,300..600,0..1,-50..200&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<main class="auth-shell auth-password-page">
    <section class="auth-story" aria-label="Bảo mật tài khoản Riverside Palace">
        <partial name="_AuthBrand" />
        <div class="story-content">
            <span class="auth-story-kicker">BẢO MẬT TÀI KHOẢN</span>
            <h1>@(requiresOtp ? "Bước đầu an toàn." : "Chủ động bảo vệ.")<br /><em>@(requiresOtp ? "Khởi đầu vững chắc." : "An tâm vận hành.")</em></h1>
            <p>@(requiresOtp ? "Xác minh email và thay mật khẩu tạm thời trước khi truy cập hệ thống." : "Cập nhật mật khẩu định kỳ giúp bảo vệ dữ liệu vận hành và khách hàng.")</p>
            <ul>
                <li><b><i class="bi bi-key" aria-hidden="true"></i></b><span>Mật khẩu tối thiểu 8 ký tự và đủ bốn nhóm ký tự</span></li>
                <li><b><i class="bi bi-envelope-check" aria-hidden="true"></i></b><span>Xác minh email bằng OTP cho lần truy cập đầu tiên</span></li>
                <li><b><i class="bi bi-shield-lock" aria-hidden="true"></i></b><span>Không chia sẻ mật khẩu hoặc mã xác minh với người khác</span></li>
            </ul>
        </div>
        <small>Riverside Palace · Bảo mật là một phần của tiêu chuẩn dịch vụ.</small>
    </section>
    <section class="auth-form-side">
        <div class="first-password-content">
        <section class="first-password-card" aria-labelledby="change-password-title">
            <div class="first-password-heading">
                <div class="crest"><i class="bi bi-shield-lock" aria-hidden="true"></i></div>
                <div><span class="auth-card-kicker">TRUNG TÂM BẢO MẬT</span><h1 id="change-password-title">@(requiresOtp ? "Đổi mật khẩu lần đầu" : "Đổi mật khẩu")</h1></div>
            </div>
            <p class="first-password-subtitle">@(requiresOtp ? "Tài khoản của bạn vừa được cấp. Vui lòng xác nhận email và thiết lập mật khẩu mới trước khi tiếp tục sử dụng hệ thống." : "Nhập mật khẩu hiện tại và thiết lập mật khẩu mới cho tài khoản.")</p>

            <form asp-action="ChangePassword" asp-controller="Auth" method="post" class="first-password-form" data-password-form>
                <div asp-validation-summary="ModelOnly" class="alert-error" role="alert"></div>

                @if (requiresOtp)
                {
                    <section class="first-password-otp" aria-labelledby="otp-title">
                        <div class="otp-heading"><i class="bi bi-envelope-check" aria-hidden="true"></i><div><strong id="otp-title">Xác nhận email</strong><small>Nhận mã gồm 6 chữ số qua email tài khoản</small></div></div>
                        <div class="otp-control"><div class="input-wrap"><i class="bi bi-key" aria-hidden="true"></i><input asp-for="OtpCode" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" placeholder="Nhập mã OTP" /></div><button type="button" class="otp-send-button" id="sendFirstPasswordOtp"><i class="bi bi-send" aria-hidden="true"></i><span data-otp-button-text>Gửi mã OTP</span></button></div>
                        <span asp-validation-for="OtpCode" class="field-error"></span>
                        <p class="otp-feedback" id="otpFeedback" role="status" aria-live="polite"></p>
                    </section>
                }

                <div class="field">
                    <label asp-for="CurrentPassword">Mật khẩu hiện tại</label>
                    <div class="input-wrap"><i class="bi bi-lock" aria-hidden="true"></i><input asp-for="CurrentPassword" placeholder="Nhập mật khẩu hiện tại" autocomplete="current-password" /><button class="toggle-password" type="button" aria-label="Hiện mật khẩu"><i class="bi bi-eye" aria-hidden="true"></i></button></div>
                    <span asp-validation-for="CurrentPassword" class="field-error"></span>
                    <small class="field-helper">Sử dụng mật khẩu tạm thời do quản trị viên cung cấp.</small>
                </div>
                <div class="field">
                    <label asp-for="NewPassword">Mật khẩu mới</label>
                    <div class="input-wrap"><i class="bi bi-lock" aria-hidden="true"></i><input asp-for="NewPassword" placeholder="Nhập mật khẩu mới" autocomplete="new-password" /><button class="toggle-password" type="button" aria-label="Hiện mật khẩu"><i class="bi bi-eye" aria-hidden="true"></i></button></div>
                    <span asp-validation-for="NewPassword" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                    <div class="input-wrap"><i class="bi bi-lock" aria-hidden="true"></i><input asp-for="ConfirmPassword" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" /><button class="toggle-password" type="button" aria-label="Hiện mật khẩu"><i class="bi bi-eye" aria-hidden="true"></i></button></div>
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span><span class="field-error client-confirm-error" aria-live="polite"></span>
                </div>

                <aside class="password-requirements" aria-label="Yêu cầu mật khẩu">
                    <div><i class="bi bi-shield-check" aria-hidden="true"></i><strong>Yêu cầu mật khẩu</strong></div>
                    <ul><li data-rule="length">Ít nhất 8 ký tự</li><li data-rule="uppercase">Có ít nhất 1 chữ hoa (A - Z)</li><li data-rule="lowercase">Có ít nhất 1 chữ thường (a - z)</li><li data-rule="number">Có ít nhất 1 chữ số (0 - 9)</li><li data-rule="special">Có ít nhất 1 ký tự đặc biệt</li></ul>
                </aside>
                <button class="primary-button first-password-submit" type="submit"><span>Cập nhật mật khẩu</span><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
            </form>
            <div class="first-password-divider"></div>
            <form asp-action="Logout" asp-controller="Auth" method="post" class="logout-form"><button type="submit" class="logout-link"><i class="bi bi-box-arrow-right" aria-hidden="true"></i>Đăng xuất</button></form>
        </section>
        </div>
    </section>
</main>
