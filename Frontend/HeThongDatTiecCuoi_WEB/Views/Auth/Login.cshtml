@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,300..600,0..1,-50..200&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<main class="auth-shell login-page">
    <section class="auth-story" aria-label="Giới thiệu Riverside Palace">
        <div class="brand-pill"><span></span> RIVERSIDE PALACE STAFF PORTAL</div>
        <div class="story-content">
        
            <h1>Chào Mừng Trở Lại<br /><em>Riverside Palace</em></h1>
            <p>Cổng truy cập dành cho Admin và nhân viên vận hành Riverside Palace.</p>
            <ul>
                <li><b><span class="material-symbols-outlined" aria-hidden="true">verified_user</span></b><span>Bảo mật thông tin hợp đồng &amp; thanh toán chuẩn quốc tế</span></li>
                <li><b><span class="material-symbols-outlined" aria-hidden="true">smart_toy</span></b><span>Trợ lý AI tư vấn và theo dõi tiến độ sự kiện 24/7</span></li>
                <li><b><span class="material-symbols-outlined" aria-hidden="true">admin_panel_settings</span></b><span>Phân quyền truy cập theo vai trò công việc</span></li>
            </ul>
        </div>
        <small>© 2026 Riverside Palace. All rights reserved. Tiêu chuẩn dịch vụ hội nghị &amp; yến tiệc 5 sao.</small>
    </section>

    <section class="auth-form-side">
        <div class="auth-card">
            <div class="crest"><span class="material-symbols-outlined" aria-hidden="true">login</span></div>
            <h2>Đăng Nhập</h2>
            <p class="subtitle">Đăng nhập để truy cập khu vực quản trị và vận hành</p>

            @if (TempData["Success"] is string successMessage)
            {
                <div class="auth-alert auth-alert-success" role="status"><span class="material-symbols-outlined" aria-hidden="true">check_circle</span><div><strong>Thành công</strong><p>@successMessage</p></div></div>
            }
            @if (TempData["Error"] is string errorMessage)
            {
                <div class="auth-alert auth-alert-error" role="alert"><span class="material-symbols-outlined" aria-hidden="true">error</span><div><strong>Không thể đăng nhập</strong><p>@errorMessage</p></div></div>
            }

            <form id="loginForm" asp-action="Login" asp-controller="Auth" method="post" novalidate>
                <input asp-for="ReturnUrl" type="hidden" />
                @if (ViewData.ModelState.TryGetValue(string.Empty, out var loginErrors) && loginErrors.Errors.Count > 0)
                {
                    <div class="auth-alert auth-alert-error auth-alert-single" role="alert"><span class="material-symbols-outlined" aria-hidden="true">error</span><span>@loginErrors.Errors[0].ErrorMessage</span></div>
                }

                <div class="field">
                    <label asp-for="Identifier">Email hoặc số điện thoại <i>*</i></label>
                    <div class="input-wrap"><span class="material-symbols-outlined" aria-hidden="true">person</span><input asp-for="Identifier" autocomplete="username" /></div>
                    <span asp-validation-for="Identifier" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Password">Mật khẩu <i>*</i></label>
                    <div class="input-wrap"><span class="material-symbols-outlined" aria-hidden="true">lock</span><input asp-for="Password" autocomplete="current-password" /><button class="toggle-password" type="button" aria-label="Hiện mật khẩu"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></button></div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="form-row between compact">
                    <label class="check"><input asp-for="RememberMe" /> <span>Ghi nhớ phiên đăng nhập</span></label>
                    <button class="muted-link auth-link-button" id="openForgotPassword" type="button">Quên mật khẩu?</button>
                </div>

                <button class="primary-button" type="submit">Đăng Nhập</button>

            </form>

            <section id="passwordResetFlow" class="password-reset-flow" hidden aria-live="polite">
                <div class="password-reset-steps" aria-label="Tiến trình đặt lại mật khẩu">
                    <span class="is-active" data-step-indicator="1">1</span><i></i><span data-step-indicator="2">2</span><i></i><span data-step-indicator="3">3</span>
                </div>
                <form id="sendResetOtpForm" data-reset-step="1">
                    @Html.AntiForgeryToken()
                    <h3>Quên mật khẩu</h3>
                    <p class="password-reset-description">Nhập email của tài khoản để nhận mã OTP gồm 6 chữ số.</p>
                    <div class="field">
                        <label for="resetEmail">Địa chỉ email <i>*</i></label>
                        <div class="input-wrap"><span class="material-symbols-outlined" aria-hidden="true">mail</span><input id="resetEmail" name="Email" type="email" autocomplete="email" required placeholder="example@email.com" /></div>
                    </div>
                    <button class="primary-button" id="sendResetOtpButton" type="submit">Gửi mã OTP</button>
                </form>

                <form id="verifyResetOtpForm" data-reset-step="2" hidden>
                    @Html.AntiForgeryToken()
                    <h3>Xác minh OTP</h3>
                    <p class="password-reset-description">Mã đã được gửi tới <strong id="resetEmailDisplay"></strong> và có hiệu lực trong 5 phút.</p>
                    <input id="verifyResetEmail" name="Email" type="hidden" />
                    <div class="field">
                        <label for="resetOtpCode">Mã OTP <i>*</i></label>
                        <div class="input-wrap otp-code-input"><span class="material-symbols-outlined" aria-hidden="true">pin</span><input id="resetOtpCode" name="OtpCode" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required placeholder="000000" /></div>
                    </div>
                    <button class="primary-button" type="submit">Xác minh mã</button>
                    <button class="password-reset-secondary" id="resendResetOtp" type="button" disabled>Gửi lại mã sau 60 giây</button>
                </form>

                <form id="completePasswordResetForm" data-reset-step="3" hidden>
                    @Html.AntiForgeryToken()
                    <input id="resetGrant" name="ResetToken" type="hidden" />
                    <h3>Tạo mật khẩu mới</h3>
                    <p class="password-reset-description">Mật khẩu phải có chữ hoa, chữ thường, số và ký tự đặc biệt.</p>
                    <div class="field"><label for="resetNewPassword">Mật khẩu mới <i>*</i></label><div class="input-wrap"><span class="material-symbols-outlined" aria-hidden="true">password</span><input id="resetNewPassword" name="NewPassword" type="password" autocomplete="new-password" minlength="8" required /><button class="toggle-password" type="button" aria-label="Hiện mật khẩu"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></button></div></div>
                    <div class="field"><label for="resetConfirmPassword">Xác nhận mật khẩu <i>*</i></label><div class="input-wrap"><span class="material-symbols-outlined" aria-hidden="true">verified_user</span><input id="resetConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" required /><button class="toggle-password" type="button" aria-label="Hiện mật khẩu"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></button></div></div>
                    <button class="primary-button" type="submit">Cập nhật mật khẩu</button>
                </form>

                <button class="password-reset-back" id="backToLogin" type="button">Quay lại đăng nhập</button>
            </section>
            <footer>Hotline hỗ trợ: <strong>0933 777 888</strong> <span>│</span> 360D Bến Vân Đồn, P.1, Q.4, TP.HCM</footer>
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/js/password-reset-otp.js" asp-append-version="true"></script>
    @if (Context.Request.Query["forgotPassword"] == "True" || Context.Request.Query["forgotPassword"] == "true")
    {
        <script>window.addEventListener('DOMContentLoaded', () => document.getElementById('openForgotPassword')?.click());</script>
    }
}
