@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    var loginErrorMessage = ViewData.ModelState.TryGetValue(string.Empty, out var loginErrors) && loginErrors.Errors.Count > 0
        ? loginErrors.Errors[0].ErrorMessage
        : null;
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,300..600,0..1,-50..200&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<main class="auth-shell login-page">
    <section class="auth-story" aria-label="Giới thiệu Riverside Palace">
        <partial name="_AuthBrand" />
        <div class="story-content">
            <span class="auth-story-kicker">CỔNG QUẢN LÝ NỘI BỘ</span>
            <h1>Vận hành tinh tế.<br /><em>Trải nghiệm nhất quán.</em></h1>
            <p>Không gian làm việc bảo mật dành cho đội ngũ vận hành Riverside Palace.</p>
            <ul>
                <li><b><i class="bi bi-shield-check" aria-hidden="true"></i></b><span>Bảo mật thông tin hợp đồng &amp; thanh toán</span></li>
                <li><b><i class="bi bi-grid-1x2" aria-hidden="true"></i></b><span>Quản lý công việc tập trung và nhất quán</span></li>
                <li><b><i class="bi bi-person-lock" aria-hidden="true"></i></b><span>Phân quyền truy cập theo vai trò công việc</span></li>
            </ul>
        </div>
        <small>© 2026 Riverside Palace · Hệ thống quản lý hội nghị và yến tiệc.</small>
    </section>

    <section class="auth-form-side">
        <div class="auth-card">
            <div class="crest"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i></div>
            <span class="auth-card-kicker">RIVERSIDE PALACE STAFF PORTAL</span>
            <h2>Đăng Nhập</h2>
            <p class="subtitle">Đăng nhập để truy cập khu vực quản trị và vận hành</p>

            <div id="authInitialMessages" hidden>
                @if (TempData["Success"] is string successMessage)
                {
                    <span data-auth-toast="success" data-auth-toast-title="Thành công">@successMessage</span>
                }
                @if (TempData["Error"] is string errorMessage)
                {
                    <span data-auth-toast="error" data-auth-toast-title="Không thể đăng nhập">@errorMessage</span>
                }
                @if (!string.IsNullOrWhiteSpace(loginErrorMessage))
                {
                    <span data-auth-toast="error" data-auth-toast-title="Không thể đăng nhập">@loginErrorMessage</span>
                }
            </div>

            <form id="loginForm" asp-action="Login" asp-controller="Auth" method="post" novalidate>
                <input asp-for="ReturnUrl" type="hidden" />

                <div class="field">
                    <label asp-for="Identifier">Email hoặc số điện thoại <i>*</i></label>
                    <div class="input-wrap"><i class="bi bi-person" aria-hidden="true"></i><input asp-for="Identifier" autocomplete="username" placeholder="VD: admin@riversideplace.vn hoặc 0901234567" /></div>
                    <span asp-validation-for="Identifier" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Password">Mật khẩu <i>*</i></label>
                    <div class="input-wrap"><i class="bi bi-lock" aria-hidden="true"></i><input asp-for="Password" autocomplete="current-password" /><button class="toggle-password" type="button" aria-label="Hiện mật khẩu"><i class="bi bi-eye" aria-hidden="true"></i></button></div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="form-row between compact">
                    <label class="check"><input asp-for="RememberMe" /> <span>Ghi nhớ phiên đăng nhập</span></label>
                    <button class="muted-link auth-link-button" id="openForgotPassword" type="button">Quên mật khẩu?</button>
                </div>

                <button class="primary-button" type="submit"><span>Đăng nhập</span><i class="bi bi-arrow-right" aria-hidden="true"></i></button>

            </form>

            <section id="passwordResetFlow" class="password-reset-flow" hidden aria-live="polite">
                <div class="password-reset-steps" aria-label="Tiến trình đặt lại mật khẩu">
                    <span class="is-active" data-step-indicator="1">1</span><i></i><span data-step-indicator="2">2</span><i></i><span data-step-indicator="3">3</span>
                </div>
                <form id="sendResetOtpForm" data-reset-step="1">
                    @Html.AntiForgeryToken()
                    <h3>Quên mật khẩu</h3>
                    <p class="password-reset-description">Nhập email của tài khoản để nhận mã OTP gồm 6 chữ số.</p>
                    <div class="field">
                        <label for="resetEmail">Địa chỉ email <i>*</i></label>
                        <div class="input-wrap"><i class="bi bi-envelope" aria-hidden="true"></i><input id="resetEmail" name="Email" type="email" autocomplete="email" required placeholder="example@email.com" /></div>
                    </div>
                    <button class="primary-button" id="sendResetOtpButton" type="submit">Gửi mã OTP</button>
                </form>

                <form id="verifyResetOtpForm" data-reset-step="2" hidden>
                    @Html.AntiForgeryToken()
                    <h3>Xác minh OTP</h3>
                    <p class="password-reset-description">Mã đã được gửi tới <strong id="resetEmailDisplay"></strong> và có hiệu lực trong 5 phút.</p>
                    <input id="verifyResetEmail" name="Email" type="hidden" />
                    <div class="field">
                        <label for="resetOtpCode">Mã OTP <i>*</i></label>
                        <div class="input-wrap otp-code-input"><i class="bi bi-key" aria-hidden="true"></i><input id="resetOtpCode" name="OtpCode" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required placeholder="000000" /></div>
                    </div>
                    <button class="primary-button" type="submit">Xác minh mã</button>
                    <button class="password-reset-secondary" id="resendResetOtp" type="button" disabled>Gửi lại mã sau 60 giây</button>
                </form>

                <form id="completePasswordResetForm" data-reset-step="3" hidden>
                    @Html.AntiForgeryToken()
                    <input id="resetGrant" name="ResetToken" type="hidden" />
                    <h3>Tạo mật khẩu mới</h3>
                    <p class="password-reset-description">Mật khẩu phải có chữ hoa, chữ thường, số và ký tự đặc biệt.</p>
                    <div class="field"><label for="resetNewPassword">Mật khẩu mới <i>*</i></label><div class="input-wrap"><i class="bi bi-lock" aria-hidden="true"></i><input id="resetNewPassword" name="NewPassword" type="password" autocomplete="new-password" minlength="8" required /><button class="toggle-password" type="button" aria-label="Hiện mật khẩu"><i class="bi bi-eye" aria-hidden="true"></i></button></div></div>
                    <div class="field"><label for="resetConfirmPassword">Xác nhận mật khẩu <i>*</i></label><div class="input-wrap"><i class="bi bi-shield-check" aria-hidden="true"></i><input id="resetConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" required /><button class="toggle-password" type="button" aria-label="Hiện mật khẩu"><i class="bi bi-eye" aria-hidden="true"></i></button></div></div>
                    <button class="primary-button" type="submit">Cập nhật mật khẩu</button>
                </form>

                <button class="password-reset-back" id="backToLogin" type="button">Quay lại đăng nhập</button>
            </section>
            <footer><i class="bi bi-headset" aria-hidden="true"></i><span>Hỗ trợ nội bộ <strong>0933 777 888</strong></span><i></i><span>360D Bến Vân Đồn, Q.4, TP.HCM</span></footer>
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/js/password-reset-otp.js" asp-append-version="true"></script>
    @if (Context.Request.Query["forgotPassword"] == "True" || Context.Request.Query["forgotPassword"] == "true")
    {
        <script>window.addEventListener('DOMContentLoaded', () => document.getElementById('openForgotPassword')?.click());</script>
    }
}
