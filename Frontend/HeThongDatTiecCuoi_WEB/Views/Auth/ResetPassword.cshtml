@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<main class="auth-shell login-page">
    <section class="auth-story" aria-label="Giới thiệu Riverside Palace">
        <div class="brand-pill"><span></span> RIVERSIDE PALACE CONVENTION &amp; WEDDING CENTER</div>
        <div class="story-content">
            <div class="monogram">R</div>
            <h1>Tạo Mật Khẩu<br /><em>Mới</em></h1>
            <p>Liên kết chỉ sử dụng được một lần và có thời hạn để bảo vệ tài khoản.</p>
        </div>
    </section>
    <section class="auth-form-side">
        <div class="auth-card">
            <div class="crest">★</div>
            <h2>Đặt Lại Mật Khẩu</h2>
            <p class="subtitle">Mật khẩu phải có chữ hoa, chữ thường, số và ký tự đặc biệt</p>
            <form asp-action="ResetPassword" asp-controller="Auth" method="post">
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert-error"></div>
                <div class="field">
                    <label asp-for="NewPassword">MẬT KHẨU MỚI <i>*</i></label>
                    <div class="input-wrap"><span>♙</span><input asp-for="NewPassword" autocomplete="new-password" /></div>
                    <span asp-validation-for="NewPassword" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="ConfirmPassword">XÁC NHẬN MẬT KHẨU <i>*</i></label>
                    <div class="input-wrap"><span>♙</span><input asp-for="ConfirmPassword" autocomplete="new-password" /></div>
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>
                <button class="primary-button" type="submit">Cập Nhật Mật Khẩu <span>→</span></button>
                <p class="switch-page"><a asp-action="Login">Quay lại đăng nhập</a></p>
            </form>
        </div>
    </section>
</main>
