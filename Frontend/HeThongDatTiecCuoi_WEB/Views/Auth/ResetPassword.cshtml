@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,300..600,0..1,-50..200&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<main class="auth-shell login-page">
    <section class="auth-story" aria-label="Giới thiệu Riverside Palace">
        <partial name="_AuthBrand" />
        <div class="story-content">
            <span class="auth-story-kicker">BẢO VỆ TÀI KHOẢN</span>
            <h1>Thiết lập mật khẩu.<br /><em>Vững vàng bảo mật.</em></h1>
            <p>Liên kết chỉ sử dụng được một lần và có thời hạn để bảo vệ tài khoản.</p>
        </div>
        <small>Riverside Palace · Không chia sẻ mật khẩu hoặc liên kết đặt lại.</small>
    </section>
    <section class="auth-form-side">
        <div class="auth-card">
            <div class="crest"><i class="bi bi-key" aria-hidden="true"></i></div>
            <span class="auth-card-kicker">THIẾT LẬP MẬT KHẨU</span>
            <h2>Đặt Lại Mật Khẩu</h2>
            <p class="subtitle">Mật khẩu phải có chữ hoa, chữ thường, số và ký tự đặc biệt</p>
            <form asp-action="ResetPassword" asp-controller="Auth" method="post">
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert-error" role="alert"></div>
                <div class="field">
                    <label asp-for="NewPassword">Mật khẩu mới <i>*</i></label>
                    <div class="input-wrap"><i class="bi bi-lock" aria-hidden="true"></i><input asp-for="NewPassword" autocomplete="new-password" placeholder="Nhập mật khẩu mới" /><button class="toggle-password" type="button" aria-label="Hiện mật khẩu"><i class="bi bi-eye" aria-hidden="true"></i></button></div>
                    <span asp-validation-for="NewPassword" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="ConfirmPassword">Xác nhận mật khẩu <i>*</i></label>
                    <div class="input-wrap"><i class="bi bi-shield-check" aria-hidden="true"></i><input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" /><button class="toggle-password" type="button" aria-label="Hiện mật khẩu"><i class="bi bi-eye" aria-hidden="true"></i></button></div>
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>
                <button class="primary-button" type="submit">Cập Nhật Mật Khẩu <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                <p class="switch-page"><a asp-action="Login"><i class="bi bi-arrow-left" aria-hidden="true"></i>Quay lại đăng nhập</a></p>
            </form>
        </div>
    </section>
</main>
