@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<main class="auth-shell login-page">
    <section class="auth-story" aria-label="Giới thiệu Riverside Palace">
        <div class="brand-pill"><span></span> RIVERSIDE PALACE CONVENTION &amp; WEDDING CENTER</div>
        <div class="story-content">
            <div class="monogram">R</div>
            <h1>Khôi Phục<br /><em>Tài Khoản</em></h1>
            <p>Chúng tôi sẽ gửi một liên kết bảo mật đến email đã đăng ký của bạn.</p>
        </div>
    </section>
    <section class="auth-form-side">
        <div class="auth-card">
            <div class="crest">★</div>
            <h2>Quên Mật Khẩu</h2>
            <p class="subtitle">Nhập email để nhận liên kết đặt lại mật khẩu</p>

            @if (TempData["Success"] is string success) { <div class="alert-success">@success</div> }
            @if (TempData["Error"] is string error) { <div class="alert-error">@error</div> }

            <form asp-action="ForgotPassword" asp-controller="Auth" method="post">
                <div asp-validation-summary="ModelOnly" class="alert-error"></div>
                <div class="field">
                    <label asp-for="Email">ĐỊA CHỈ EMAIL <i>*</i></label>
                    <div class="input-wrap"><span>✉</span><input asp-for="Email" autocomplete="email" placeholder="example@email.com" /></div>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <button class="primary-button" type="submit">Gửi Liên Kết <span>→</span></button>
                <p class="switch-page"><a asp-action="Login">Quay lại cổng nhân viên</a></p>
            </form>
        </div>
    </section>
</main>
