@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<main class="auth-shell login-page">
    <section class="auth-story" aria-label="Giới thiệu Riverside Palace">
        <partial name="_AuthBrand" />
        <div class="story-content">
            <span class="auth-story-kicker">KHÔI PHỤC QUYỀN TRUY CẬP</span>
            <h1>Lấy lại tài khoản.<br /><em>An toàn từng bước.</em></h1>
            <p>Hướng dẫn bảo mật chỉ được gửi đến địa chỉ email đã xác minh.</p>
        </div>
        <small>Riverside Palace · Hệ thống quản lý nội bộ bảo mật.</small>
    </section>
    <section class="auth-form-side">
        <div class="auth-card">
            <div class="crest"><i class="bi bi-envelope-check" aria-hidden="true"></i></div>
            <span class="auth-card-kicker">KHÔI PHỤC TÀI KHOẢN</span>
            <h2>Quên Mật Khẩu</h2>
            <p class="subtitle">Nhập email để nhận liên kết đặt lại mật khẩu</p>

            @if (TempData["Success"] is string success) { <div class="alert-success" role="status">@success</div> }
            @if (TempData["Error"] is string error) { <div class="alert-error" role="alert">@error</div> }

            <form asp-action="ForgotPassword" asp-controller="Auth" method="post">
                <div asp-validation-summary="ModelOnly" class="alert-error" role="alert"></div>
                <div class="field">
                    <label asp-for="Email">Địa chỉ email <i>*</i></label>
                    <div class="input-wrap"><i class="bi bi-envelope" aria-hidden="true"></i><input asp-for="Email" autocomplete="email" placeholder="example@email.com" /></div>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <button class="primary-button" type="submit"><span>Gửi liên kết bảo mật</span><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                <p class="switch-page"><a asp-action="Login"><i class="bi bi-arrow-left" aria-hidden="true"></i>Quay lại đăng nhập</a></p>
            </form>
        </div>
    </section>
</main>
