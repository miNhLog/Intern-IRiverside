@{
    ViewData["Title"] = "Quản Trị Gói Decor & Dịch Vụ";
    Layout = "_AdminLayout";
}

<!-- Font dùng chung được nạp bởi _AdminLayout. -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.tailwindcss.com"></script>
<!-- Thêm thư viện SheetJS để xuất Excel thực tế -->
<script src="https://cdn.sheetjs.com/xlsx-0.20.0/package/dist/xlsx.full.min.js"></script>

<script>
    tailwind.config = {
        theme: {
            extend: {
                colors: {
                    brand: {
                        gold: '#B89758',
                        goldLight: '#E8D8B6',
                        goldHover: '#8C6D32',
                        darkNavy: '#111822',
                        sidebar: '#141E28',
                        surface: '#FFFFFF',
                        canvas: '#F8F9FA',
                        border: '#E2E8F0',
                        textMain: '#1E293B',
                        textMuted: '#64748B'
                    }
                },
                fontFamily: {
                    serif: ['"Playfair Display"', 'Georgia', 'serif'],
                    sans: ['"Plus Jakarta Sans"', '-apple-system', 'BlinkMacSystemFont', 'sans-serif']
                }
            }
        }
    }
</script>

<style>
    .decor-page-wrapper {
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #1E293B;
        background-color: #F8F9FA;
    }

        .decor-page-wrapper .font-serif {
            font-family: 'Playfair Display', serif;
        }

    .custom-card-shadow {
        box-shadow: 0 4px 20px -2px rgba(30, 41, 59, 0.05), 0 2px 6px -1px rgba(30, 41, 59, 0.02);
    }

    .custom-row-hover:hover {
        background-color: #FAF8F5;
        border-color: rgba(184, 151, 88, 0.4);
    }

    .focus-ring:focus-visible {
        outline: 2px solid #B89758;
        outline-offset: 2px;
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: #F7F4EE;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #C5A880;
        border-radius: 4px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #B89758;
        }

    /* Ẩn scrollbar ngang cho tabs trên mobile */
    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }

    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<!-- CONTAINER CHÍNH -->
<div class="decor-page-wrapper min-h-screen flex flex-col w-full relative">

    <!-- ================= KHỐI ĐIỀU HƯỚNG CỐ ĐỊNH (HEADER + TABS DÍNH CHUNG) ================= -->
    <div class="sticky top-0 z-30 bg-white border-b border-slate-200 shadow-xs w-full">

        <!-- Top Title & Controls Header -->
        <header class="px-4 sm:px-6 lg:px-8 py-3 sm:py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-3 sm:gap-4 border-b border-slate-100">
            <div class="min-w-0">
                <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500 mb-1 flex-wrap">
                    <span>Quản trị Master Data</span>
                    <i class="fa-solid fa-chevron-right text-[9px] text-slate-400"></i>
                    <span id="breadcrumb-current-tab" class="text-[#B89758] font-semibold">Gói Decor Tiệc Cưới</span>
                </nav>
                <h2 id="header-page-title" class="font-serif text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
                    Quản Trị Danh Mục Gói Decor Tiệc Cưới
                </h2>
            </div>

            <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
                <!-- System Status Badge -->
                <div class="flex items-center bg-slate-50 rounded-lg px-2.5 sm:px-3 py-1.5 border border-slate-200 text-xs shadow-2xs">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 mr-2 animate-pulse flex-shrink-0"></span>
                    <span id="badge-system-status" class="text-slate-600 font-medium whitespace-nowrap">
                        <span class="hidden sm:inline">CSDL đồng bộ • Niên độ 2026</span>
                        <span class="sm:hidden">Đồng bộ 2026</span>
                    </span>
                </div>

                <!-- Notification Bell -->
                <div class="relative" id="notification-wrapper">
                    <button id="btn-notification" onclick="toggleNotificationDropdown()" class="p-2.5 text-slate-500 hover:text-slate-900 bg-slate-50 hover:bg-slate-100 rounded-lg border border-slate-200 relative focus-ring min-h-[42px] min-w-[42px] flex items-center justify-center transition-colors shadow-2xs" aria-label="Thông báo hệ thống">
                        <i class="fa-regular fa-bell text-sm"></i>
                        <span id="notif-badge" class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full"></span>
                    </button>

                    <!-- Dropdown: fixed positioning on mobile, absolute on desktop -->
                    <div id="notification-dropdown" class="hidden fixed sm:absolute top-20 sm:top-auto right-3 left-3 sm:right-0 sm:left-auto sm:mt-2 sm:w-96 sm:max-w-[384px] bg-white rounded-xl shadow-2xl border border-[#E5D5B8] overflow-hidden" style="z-index: 9999;">
                        <div class="bg-[#FAF8F5] px-4 py-3 border-b border-slate-200 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-bell text-[#B89758] text-xs"></i>
                                <span class="font-bold text-xs text-slate-800">Thông báo hệ thống</span>
                            </div>
                            <button onclick="markAllNotificationsRead()" class="text-[11px] text-[#8C6D32] hover:underline font-medium">Đã đọc tất cả</button>
                        </div>
                        <div class="divide-y divide-slate-100 max-h-80 overflow-y-auto custom-scrollbar text-xs">
                            <div class="p-3.5 hover:bg-[#FAF8F5] transition-colors flex gap-3 cursor-pointer">
                                <div class="w-8 h-8 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <i class="fa-solid fa-check text-xs"></i>
                                </div>
                                <div class="space-y-0.5 flex-1 min-w-0">
                                    <p class="font-semibold text-slate-800">Gói Decor DC-ROY-07 đã kích hoạt</p>
                                    <p class="text-slate-500 text-[11px] leading-relaxed">Gói "Hoàng Kim Dạ Yến" đã được phê duyệt và niêm yết công khai.</p>
                                    <span class="text-[10px] text-slate-400 block pt-1">5 phút trước</span>
                                </div>
                            </div>
                            <div class="p-3.5 hover:bg-[#FAF8F5] transition-colors flex gap-3 cursor-pointer">
                                <div class="w-8 h-8 rounded-full bg-amber-50 border border-amber-200 text-[#8C6D32] flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <i class="fa-solid fa-pen text-xs"></i>
                                </div>
                                <div class="space-y-0.5 flex-1 min-w-0">
                                    <p class="font-semibold text-slate-800">Cập nhật đơn giá Master Data</p>
                                    <p class="text-slate-500 text-[11px] leading-relaxed">Đơn giá niêm yết của hệ thống Âm thanh JBL đã được cập nhật.</p>
                                    <span class="text-[10px] text-slate-400 block pt-1">1 giờ trước</span>
                                </div>
                            </div>
                            <div class="p-3.5 hover:bg-[#FAF8F5] transition-colors flex gap-3 cursor-pointer">
                                <div class="w-8 h-8 rounded-full bg-blue-50 border border-blue-200 text-blue-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <i class="fa-solid fa-calendar-check text-xs"></i>
                                </div>
                                <div class="space-y-0.5 flex-1 min-w-0">
                                    <p class="font-semibold text-slate-800">Khóa cọc sảnh Seine</p>
                                    <p class="text-slate-500 text-[11px] leading-relaxed">Sảnh Seine (Ca tối, 25/12/2026) đã được cọc Đợt 1 thành công.</p>
                                    <span class="text-[10px] text-slate-400 block pt-1">Hôm nay 09:30</span>
                                </div>
                            </div>
                        </div>
                        <div class="p-2.5 bg-slate-50 border-t border-slate-100 text-center">
                            <button onclick="toggleNotificationDropdown()" class="text-[11px] font-semibold text-slate-600 hover:text-slate-900">Đóng thông báo</button>
                        </div>
                    </div>
                </div>

                <!-- Export Excel Button -->
                <button onclick="exportDataExcel()" class="flex items-center gap-2 px-3 sm:px-3.5 py-2 bg-slate-50 hover:bg-slate-100 text-slate-700 rounded-lg text-xs font-semibold transition-colors border border-slate-200 focus-ring min-h-[42px] shadow-2xs">
                    <i class="fa-solid fa-file-excel text-emerald-600 text-sm"></i>
                    <span class="hidden sm:inline">Xuất Excel</span>
                </button>
            </div>
        </header>

        <!-- Two-Tab Catalog Workspace Header - Scroll ngang trên mobile -->
        <div class="px-4 sm:px-6 lg:px-8 bg-white">
            <div class="flex gap-5 sm:gap-8 overflow-x-auto scrollbar-hide" role="tablist">
                <!-- Tab 1 Button -->
                <button id="tab-btn-decor" onclick="switchMainTab('decor')" class="py-3 sm:py-4 font-bold text-xs sm:text-sm border-b-2 border-[#B89758] text-slate-900 flex items-center gap-2 flex-shrink-0 whitespace-nowrap focus-ring transition-colors">
                    <i class="fa-solid fa-wand-magic-sparkles text-[#B89758]"></i>
                    <span>Gói Decor Tiệc Cưới</span>
                    <span id="badge-decor-active" class="bg-[#B89758]/15 text-[#8C6D32] text-[10px] sm:text-[11px] font-bold px-2 py-0.5 rounded-full ml-1 border border-[#B89758]/30">Đang chọn</span>
                </button>

                <!-- Tab 2 Button -->
                <button id="tab-btn-service" onclick="switchMainTab('service')" class="py-3 sm:py-4 font-medium text-xs sm:text-sm text-slate-500 hover:text-slate-800 flex items-center gap-2 flex-shrink-0 whitespace-nowrap transition-colors border-b-2 border-transparent focus-ring">
                    <i class="fa-solid fa-people-arrows text-slate-400"></i>
                    <span>Dịch Vụ Đi Kèm</span>
                    <span id="badge-service-count" class="text-[10px] sm:text-[11px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full border border-slate-200">6 dịch vụ</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ================= NỘI DUNG VÙNG LÀM VIỆC (WORKSPACE BODY) ================= -->
    <div class="p-4 sm:p-6 lg:p-8 space-y-4 sm:space-y-6 flex-1 w-full max-w-[1600px] mx-auto">

        <!-- Master Filter & Action Controls Bar -->
        <section class="bg-white rounded-xl p-3 sm:p-4 border border-slate-200 custom-card-shadow flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
            <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-2.5 flex-1 w-full">
                <!-- Search Input -->
                <div class="relative w-full sm:flex-1 sm:min-w-[240px] sm:max-w-sm">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text"
                           id="input-search-keyword"
                           oninput="applyFilters()"
                           placeholder="Tìm mã gói, tên chủ đề decor..."
                           class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-9 pr-3 py-2 text-xs text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:border-[#B89758] focus:ring-1 focus:ring-[#B89758] min-h-[42px] transition-all">
                </div>

                <!-- Category / Style Filter Dropdown -->
                <div class="flex items-center bg-slate-50 border border-slate-200 rounded-lg px-3 py-1 min-h-[42px] w-full sm:w-auto">
                    <i id="icon-filter-cat" class="fa-solid fa-palette text-slate-500 mr-2 text-xs flex-shrink-0"></i>
                    <label for="filter-category" id="label-filter-category" class="text-xs text-slate-500 mr-1.5 whitespace-nowrap">Phong cách:</label>
                    <select id="filter-category" onchange="applyFilters()" class="w-full bg-transparent text-xs font-semibold text-slate-800 focus:outline-none cursor-pointer pr-1 min-w-0">
                        <!-- Options generated dynamically -->
                    </select>
                </div>

                <!-- Status Filter Dropdown -->
                <div class="flex items-center bg-slate-50 border border-slate-200 rounded-lg px-3 py-1 min-h-[42px] w-full sm:w-auto">
                    <i class="fa-solid fa-toggle-on text-slate-500 mr-2 text-xs flex-shrink-0"></i>
                    <label for="filter-status" class="text-xs text-slate-500 mr-1.5 whitespace-nowrap">Trạng thái:</label>
                    <select id="filter-status" onchange="applyFilters()" class="w-full bg-transparent text-xs font-semibold text-slate-800 focus:outline-none cursor-pointer pr-1 min-w-0">
                        <option value="">Tất cả trạng thái</option>
                        <option value="Áp dụng">Áp dụng</option>
                        <option value="Ngừng áp dụng">Ngừng áp dụng</option>
                    </select>
                </div>

                <!-- Reset Filter Action -->
                <button onclick="resetFilters()" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold transition-colors border border-slate-200 flex items-center justify-center gap-1.5 focus-ring min-h-[42px] w-full sm:w-auto">
                    <i class="fa-solid fa-arrow-rotate-left text-[11px] text-slate-500"></i>
                    <span>Đặt lại</span>
                </button>
            </div>

            <!-- Primary Action CTA Button -->
            <button onclick="openCreateModal()" class="px-5 py-2.5 bg-gradient-to-r from-[#B89758] to-[#9E7E3F] hover:from-[#A8884A] hover:to-[#8E7035] text-white font-bold text-xs rounded-lg shadow-sm flex items-center justify-center gap-2 transition-all focus-ring min-h-[42px] w-full lg:w-auto lg:flex-shrink-0 cursor-pointer">
                <i class="fa-solid fa-plus text-xs"></i>
                <span id="btn-create-label">Thêm gói Decor</span>
            </button>
        </section>

        <!-- Status Summary Metrics Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 sm:gap-3 text-xs text-slate-500 px-1">
            <div class="flex items-center gap-2 flex-wrap">
                <span id="metric-title-label" class="font-medium text-slate-700">Danh mục Gói Decor đang quản lý:</span>
                <span id="metric-showing" class="px-2.5 py-0.5 rounded-full bg-slate-200/80 font-bold text-slate-800 text-[11px]">Hiển thị 6 gói</span>
            </div>
            <div class="flex items-center gap-3 text-[11px] flex-wrap">
                <span id="metric-active" class="flex items-center gap-1.5 text-emerald-700 font-medium">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span> 5 gói Đang áp dụng
                </span>
                <span id="metric-inactive" class="flex items-center gap-1.5 text-slate-500 font-medium">
                    <span class="w-2 h-2 rounded-full bg-slate-400"></span> 1 gói Ngừng áp dụng
                </span>
            </div>
        </div>

        <!-- VIEW CONTAINER 1: TAB 1 (GÓI DECOR - LƯỚI CARD) -->
        <div id="container-decor-tab" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
            <!-- Cards rendered dynamically by JS -->
        </div>

        <!-- VIEW CONTAINER 2: TAB 2 (DỊCH VỤ - BẢNG VẬN HÀNH) -->
        <div id="container-service-tab" class="bg-white rounded-xl border border-slate-200 custom-card-shadow overflow-hidden hidden">
            <div class="overflow-x-auto custom-scrollbar">
                <table class="w-full border-collapse text-left min-w-[800px]">
                    <thead>
                        <tr class="bg-[#FAF8F5] text-slate-700 border-b border-slate-200 text-xs font-semibold uppercase tracking-wider">
                            <th class="py-3.5 px-4 w-28 text-center">Mã DV</th>
                            <th class="py-3.5 px-4 w-40">Hình ảnh</th>
                            <th class="py-3.5 px-5">Tên Dịch Vụ &amp; Mô Tả Chi Tiết</th>
                            <th class="py-3.5 px-4 w-48">Phân Loại Dịch Vụ</th>
                            <th class="py-3.5 px-5 w-44 text-right">Đơn Giá Niêm Yết</th>
                            <th class="py-3.5 px-4 w-36 text-center">Trạng Thái</th>
                            <th class="py-3.5 px-4 w-44 text-center">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody id="service-table-tbody" class="divide-y divide-slate-100 text-xs">
                        <!-- Rows rendered dynamically by JS -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination / Summary Bar -->
        <div class="bg-white rounded-xl p-3 sm:p-4 border border-slate-200 custom-card-shadow flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs text-slate-600">
            <div class="flex flex-wrap items-center gap-2">
                <span id="pagination-summary">Hiển thị <strong>1 – 6</strong> trong tổng số <strong>6</strong> gói Decor</span>
                <span class="text-slate-300 hidden sm:inline">|</span>
                <span class="text-slate-500">Quy chuẩn: Master Data Spec MD-RP-2026</span>
            </div>
            <div class="flex items-center gap-2 justify-end">
                <button class="px-3 sm:px-3.5 py-1.5 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-600 font-medium focus-ring disabled:opacity-50" disabled>
                    <i class="fa-solid fa-chevron-left mr-1 text-[10px]"></i> <span class="hidden sm:inline">Trang</span> trước
                </button>
                <span class="px-3 py-1.5 rounded-lg bg-[#B89758]/15 text-[#8C6D32] font-bold border border-[#B89758]/30">1</span>
                <button class="px-3 sm:px-3.5 py-1.5 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-600 font-medium focus-ring disabled:opacity-50" disabled>
                    <span class="hidden sm:inline">Trang</span> sau <i class="fa-solid fa-chevron-right ml-1 text-[10px]"></i>
                </button>
            </div>
        </div>

        <!-- Master Data Guidelines & Technical Policy Banner -->
        <div class="p-3 sm:p-4 rounded-xl bg-amber-50/50 border border-[#B89758]/30 flex items-start gap-3 text-xs">
            <div class="w-6 h-6 rounded-full bg-[#B89758]/20 flex items-center justify-center text-[#967638] flex-shrink-0 mt-0.5">
                <i class="fa-solid fa-circle-info text-xs"></i>
            </div>
            <div class="space-y-1 min-w-0">
                <h5 class="font-bold text-[#1E242B]">Quy định cấu hình Danh mục Master Data Riverside Palace:</h5>
                <p class="text-slate-600 leading-relaxed">
                    Theo quy chuẩn vận hành, hệ thống không cho phép xóa vĩnh viễn dữ liệu gói decor và dịch vụ đã từng phát sinh giao dịch trên các hợp đồng tiệc cưới. Quản trị viên sử dụng thao tác <strong>Khóa (Tạm ngưng)</strong> để bảo toàn toàn vẹn dữ liệu kế toán và lịch sử kiểm toán hợp đồng.
                </p>
            </div>
        </div>

    </div>

    <!-- Admin Footer -->
    <footer class="mt-auto bg-white border-t border-slate-200 px-4 sm:px-6 lg:px-8 py-3.5 flex flex-col sm:flex-row sm:items-center sm:justify-between text-xs text-slate-500 gap-2">
        <div>
            © 2026 Riverside Palace Convention &amp; Wedding Center. Quản Trị Hệ Thống Master Data v4.2.
        </div>
        <div class="flex flex-wrap items-center gap-2 sm:gap-4">
            <span class="flex items-center gap-1 text-slate-600">
                <i class="fa-solid fa-shield-halved text-[#B89758]"></i> Phân quyền: Administrator Level 1
            </span>
            <span class="hidden sm:inline text-slate-300">•</span>
            <span>Hotline Kỹ thuật &amp; IT nội bộ: Ext 888</span>
        </div>
    </footer>
</div>

<!-- ========================================================================= -->
<!-- ================= MODAL CHÍNH: THÊM GÓI DECOR MỚI ======================== -->
<!-- ========================================================================= -->
<div id="decorModal" class="fixed inset-0 bg-black/60 backdrop-blur-xs flex items-center justify-center z-50 hidden p-3 sm:p-6 overflow-y-auto">
    <div class="bg-white border border-[#E5D5B8] rounded-2xl w-full max-w-4xl shadow-2xl flex flex-col max-h-[95vh] sm:max-h-[92vh] overflow-hidden my-auto">

        <!-- Modal Header -->
        <div class="px-4 sm:px-8 py-4 sm:py-5 border-b border-slate-200 bg-[#FAF8F5] flex items-center justify-between flex-shrink-0">
            <div class="flex items-center space-x-2.5 sm:space-x-3 min-w-0">
                <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-[#B89758]/15 border border-[#E5D5B8] flex items-center justify-center text-[#B89758] flex-shrink-0">
                    <i class="fa-solid fa-wand-magic-sparkles text-sm"></i>
                </div>
                <div class="min-w-0">
                    <div class="flex items-center space-x-2 sm:space-x-2.5 flex-wrap">
                        <h2 id="decor-modal-title" class="font-serif text-base sm:text-xl font-bold text-slate-900 truncate">Thêm gói Decor mới</h2>
                        <span class="hidden sm:inline-block px-2 py-0.5 rounded-full bg-[#B89758]/15 border border-[#B89758]/30 text-[10px] font-bold text-[#8C6D32] tracking-wider uppercase">MASTER DATA</span>
                    </div>
                    <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5 line-clamp-1">Cấu hình thông tin danh mục, định mức giá và hình ảnh nhận diện gói trang trí tiệc cưới.</p>
                </div>
            </div>
            <button onclick="closeDecorModal()" class="w-9 h-9 rounded-full flex items-center justify-center text-slate-400 hover:text-slate-800 hover:bg-slate-200 transition-colors focus-ring flex-shrink-0" type="button" aria-label="Đóng">
                <i class="fa-solid fa-xmark text-base"></i>
            </button>
        </div>

        <!-- Modal Body -->
        <form id="decorForm" onsubmit="handleDecorFormSubmit(event)" class="p-4 sm:p-6 lg:p-8 overflow-y-auto custom-scrollbar space-y-4 sm:space-y-6 bg-[#FDFBF7] text-xs">
            <input type="hidden" id="decor-form-id" value="0" />

            <!-- PHẦN 1: THÔNG TIN CƠ BẢN & ĐỊNH MỨC KINH DOANH -->
