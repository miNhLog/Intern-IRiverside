                            <button onclick="editDecorItem(${item.id})" class="min-h-[40px] px-1.5 sm:px-2 py-2 rounded-lg bg-slate-50 hover:bg-[#B89758]/10 text-slate-800 hover:text-[#8C6D32] text-[11px] sm:text-xs font-semibold border border-slate-200 hover:border-[#B89758]/50 transition-colors flex items-center justify-center gap-1 sm:gap-1.5 focus-ring" title="Chỉnh sửa">
                                <i class="fa-regular fa-pen-to-square text-[#B89758]"></i><span>Sửa</span>
                            </button>
                            <button onclick="toggleStatus(${item.id})" class="min-h-[40px] px-1.5 sm:px-2 py-2 rounded-lg ${isInactive ? 'bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border-emerald-200' : 'bg-slate-50 hover:bg-amber-50 text-slate-700 hover:text-amber-800 border-slate-200'} text-[11px] sm:text-xs font-semibold border transition-colors flex items-center justify-center gap-1 sm:gap-1.5 focus-ring" title="Thay đổi trạng thái">
                                <i class="fa-solid ${isInactive ? 'fa-rotate-left text-emerald-600' : 'fa-lock text-slate-400'}"></i>
                                <span class="hidden sm:inline">${isInactive ? 'Mở lại' : 'Khóa'}</span>
                                <span class="sm:hidden">${isInactive ? 'Mở' : 'Khóa'}</span>
                            </button>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // 8. RENDER TAB 2: SERVICE TABLE
        function renderServiceTable(list) {
            const tbody = document.getElementById('service-table-tbody');
            tbody.innerHTML = '';

            if (list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-10 text-slate-400 italic">Không tìm thấy dịch vụ nào phù hợp với bộ lọc.</td></tr>`;
                return;
            }

            list.forEach(item => {
                const isInactive = item.trangThai === 'Ngừng áp dụng';
                const tr = document.createElement('tr');
                tr.className = `custom-row-hover transition-colors ${isInactive ? 'bg-slate-50/40' : ''}`;

                const badgeStatus = !isInactive
                    ? `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Đang áp dụng</span>`
                    : `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 text-slate-600 border border-slate-300"><span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> Tạm ngưng</span>`;

                const lockBtn = !isInactive
                    ? `<button onclick="toggleStatus(${item.id})" class="h-[36px] px-2.5 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-800 text-xs font-semibold flex items-center gap-1 border border-amber-200 transition-colors" title="Khóa tạm ngưng"><i class="fa-solid fa-ban text-[11px]"></i><span>Khóa</span></button>`
                    : `<button onclick="toggleStatus(${item.id})" class="h-[36px] px-2.5 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-xs font-semibold flex items-center gap-1 border border-emerald-200 transition-colors" title="Kích hoạt lại"><i class="fa-solid fa-rotate-left text-[11px]"></i><span>Mở lại</span></button>`;

                const imageThumbnail = item.hinhAnh
                    ? `<div class="w-32 h-20 rounded-lg overflow-hidden border border-gray-200 relative bg-slate-900 group"><img src="${item.hinhAnh}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" /><span class="absolute bottom-1 right-1 bg-black/70 text-white text-[9px] px-1.5 py-0.5 rounded">16:10</span></div>`
                    : `<div class="w-32 h-20 rounded-lg border border-dashed border-slate-300 bg-[#F5F3EF] flex flex-col items-center justify-center text-slate-400 p-2 text-center"><i class="fa-regular fa-image text-lg mb-1"></i><span class="text-[9px] text-slate-500 font-medium">Chưa có ảnh</span><span class="text-[8px] text-slate-400">Đang cập nhật</span></div>`;

                tr.innerHTML = `
                    <td class="py-4 px-4 text-center">
                        <span class="font-mono text-[11px] font-bold px-2 py-1 rounded bg-slate-100 text-slate-800 border border-slate-200">${item.ma}</span>
                    </td>
                    <td class="py-4 px-4">${imageThumbnail}</td>
                    <td class="py-4 px-5 align-middle">
                        <div class="space-y-1">
                            <h4 class="font-serif font-bold text-sm text-slate-900">${item.ten}</h4>
                            <p class="text-slate-600 text-xs line-clamp-2 leading-relaxed">${item.moTa}</p>
                            <div class="text-[11px] text-slate-400 flex items-center gap-3 pt-0.5">
                                <span><i class="fa-solid fa-user-gear text-[10px] text-[#B89758] mr-1"></i>${item.spec1 || '2 kỹ thuật viên'}</span>
                                <span><i class="fa-regular fa-clock text-[10px] text-[#B89758] mr-1"></i>${item.spec2 || 'Setup trước ca 2h'}</span>
                            </div>
                        </div>
                    </td>
                    <td class="py-4 px-4">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-amber-50/80 text-amber-900 border border-[#B89758]/30 text-xs font-medium">
                            <i class="fa-solid fa-tag text-[10px] text-[#B89758]"></i> ${item.phanLoai}
                        </span>
                    </td>
                    <td class="py-4 px-5 text-right">
                        <div class="font-serif font-bold text-sm text-slate-900">${Number(item.gia).toLocaleString('vi-VN')} <span class="text-xs font-sans text-slate-500 font-normal">VNĐ</span></div>
                        <span class="text-[10px] text-slate-400 block mt-0.5">/suất tiệc</span>
                    </td>
                    <td class="py-4 px-4 text-center">${badgeStatus}</td>
                    <td class="py-4 px-4 text-center">
                        <div class="flex items-center justify-center gap-1.5">
                            <button onclick="viewDetail(${item.id})" class="h-[36px] px-2.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold flex items-center gap-1 border border-slate-200 transition-colors" title="Xem chi tiết">
                                <i class="fa-regular fa-eye text-slate-500"></i><span>Xem</span>
                            </button>
                            <button onclick="editDecorItem(${item.id})" class="h-[36px] px-2.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold flex items-center gap-1 border border-slate-200 transition-colors" title="Chỉnh sửa">
                                <i class="fa-regular fa-pen-to-square text-[#B89758]"></i><span>Sửa</span>
                            </button>
                            ${lockBtn}
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        // 9. KHÓA / MỞ TRẠNG THÁI RECORD
        function toggleStatus(id) {
            const list = currentTab === 'decor' ? decorData : serviceData;
            const target = list.find(x => x.id === id);
            if (target) {
                target.trangThai = target.trangThai === 'Áp dụng' ? 'Ngừng áp dụng' : 'Áp dụng';
                applyFilters();
            }
        }

        // 10. MODAL XEM CHI TIẾT
        function viewDetail(id) {
            const list = currentTab === 'decor' ? decorData : serviceData;
            const item = list.find(x => x.id === id);
            if (!item) return;

            document.getElementById('detail-title').innerText = currentTab === 'decor' ? `Chi Tiết Gói Decor: ${item.ma}` : `Chi Tiết Dịch Vụ: ${item.ma}`;
            document.getElementById('detail-content').innerHTML = `
                <div class="p-3 bg-slate-50 rounded-lg border border-slate-200 flex justify-between items-center gap-3 flex-wrap">
                    <div class="min-w-0">
                        <h4 class="font-bold text-sm text-slate-800">${item.ten}</h4>
                        <span class="text-[11px] text-[#B89758] font-semibold">${item.phanLoai}</span>
                    </div>
                    <div class="text-right font-serif font-bold text-base text-slate-900 whitespace-nowrap">
                        ${Number(item.gia).toLocaleString('vi-VN')} VNĐ
                    </div>
                </div>
                <div>
                    <span class="font-bold text-slate-700 block mb-1">Mô tả cấu hình:</span>
                    <p class="text-slate-600 leading-relaxed bg-white p-3 rounded-lg border border-slate-100">${item.moTa}</p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="p-2.5 bg-slate-50 rounded-lg border border-slate-200">
                        <span class="text-[10px] uppercase font-bold text-slate-400 block">${currentTab === 'decor' ? 'Hạng mục chính' : 'Nhân sự vận hành'}</span>
                        <span class="font-semibold text-slate-800">${item.spec1 || 'Tiêu chuẩn'}</span>
                    </div>
                    <div class="p-2.5 bg-slate-50 rounded-lg border border-slate-200">
                        <span class="text-[10px] uppercase font-bold text-slate-400 block">${currentTab === 'decor' ? 'Thời gian set-up' : 'Thời gian phục vụ'}</span>
                        <span class="font-semibold text-slate-800">${item.spec2 || 'Theo ca tiệc'}</span>
                    </div>
                </div>
                <div class="flex items-center justify-between text-[11px] text-slate-500 pt-2 flex-wrap gap-2">
                    <span>Tình trạng niêm yết: <strong class="${item.trangThai === 'Áp dụng' ? 'text-emerald-600' : 'text-slate-500'} font-bold">${item.trangThai}</strong></span>
                    <span>Mã quy chuẩn: <strong>MD-RP-2026</strong></span>
                </div>
            `;
            document.getElementById('detailModal').classList.remove('hidden');
        }

        function closeDetailModal() {
            document.getElementById('detailModal').classList.add('hidden');
        }

        // 11. MODAL THÊM MỚI / CHỈNH SỬA
        function openCreateModal() {
            document.getElementById('decorForm').reset();
            document.getElementById('decor-form-id').value = '0';
            document.getElementById('decor-modal-title').innerText = currentTab === 'decor' ? 'Thêm gói Decor mới' : 'Thêm Dịch Vụ Mới';

            if (currentTab === 'decor') {
                document.getElementById('decor-code').value = 'DC-' + Date.now();
                document.getElementById('decor-name').value = '';
                document.getElementById('decor-price').value = '';
                document.getElementById('decor-setup-time').value = '';
                document.getElementById('decor-desc').value = '';
            } else {
                document.getElementById('decor-code').value = 'DV-' + Date.now();
                document.getElementById('decor-name').value = '';
                document.getElementById('decor-price').value = '';
                document.getElementById('decor-setup-time').value = '';
                document.getElementById('decor-desc').value = '';
            }

            document.getElementById('radio-decor-active').checked = true;
            document.getElementById('decor-image-preview-card').classList.remove('hidden');
            document.getElementById('decorModal').classList.remove('hidden');
        }

        function editDecorItem(id) {
            const list = currentTab === 'decor' ? decorData : serviceData;
            const item = list.find(x => x.id === id);
            if (!item) return;

            document.getElementById('decor-form-id').value = item.id;
            document.getElementById('decor-modal-title').innerText = currentTab === 'decor' ? 'Chỉnh sửa gói Decor' : 'Chỉnh sửa Dịch vụ';
            document.getElementById('decor-code').value = item.ma;
            document.getElementById('decor-name').value = item.ten;
            document.getElementById('decor-style').value = item.phanLoai;
            document.getElementById('decor-price').value = item.gia;
            document.getElementById('decor-setup-time').value = item.spec2 || '4.0 giờ trước ca tiệc';
            document.getElementById('decor-desc').value = item.moTa;

            if (item.trangThai === 'Áp dụng') {
                document.getElementById('radio-decor-active').checked = true;
            } else {
                document.getElementById('radio-decor-draft').checked = true;
            }

            if (item.hinhAnh) {
                document.getElementById('decor-preview-img').src = item.hinhAnh;
                document.getElementById('decor-preview-filename').innerText = item.ma + '-cover-image.jpg';
                document.getElementById('decor-image-preview-card').classList.remove('hidden');
            }

            document.getElementById('decorModal').classList.remove('hidden');
        }

        function closeDecorModal() {
            document.getElementById('decorModal').classList.add('hidden');
        }

        // 12. UPLOAD & PREVIEW ẢNH
        function handleImageSelected(event) {
            const file = event.target.files[0];
            if (file) {
                if (file.size > 5 * 1024 * 1024) {
                    alert('Tệp quá lớn! Vui lòng chọn ảnh có dung lượng dưới 5 MB.');
                    return;
                }
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('decor-preview-img').src = e.target.result;
                    document.getElementById('decor-preview-filename').innerText = file.name;
                    document.getElementById('decor-image-preview-card').classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        }

        function removeImagePreview() {
            document.getElementById('decor-file-input').value = '';
            document.getElementById('decor-image-preview-card').classList.add('hidden');
        }

        // 13. SUBMIT FORM
        async function handleDecorFormSubmit(e) {
            e.preventDefault();
            const id = parseInt(document.getElementById('decor-form-id').value);
            const isCheckedActive = document.getElementById('radio-decor-active').checked;
            const isDecor = currentTab === 'decor';
            const payload = isDecor
                ? {
                    packageCode: document.getElementById('decor-code').value.trim(),
                    packageName: document.getElementById('decor-name').value.trim(),
                    style: document.getElementById('decor-style').value.trim(),
                    description: document.getElementById('decor-desc').value.trim(),
                    price: parseFloat(document.getElementById('decor-price').value),
                    statusCode: isCheckedActive ? 'ACTIVE' : 'INACTIVE'
                }
                : {
                    serviceCode: document.getElementById('decor-code').value.trim(),
                    serviceName: document.getElementById('decor-name').value.trim(),
                    serviceType: document.getElementById('decor-style').value.trim(),
                    description: document.getElementById('decor-desc').value.trim(),
                    price: parseFloat(document.getElementById('decor-price').value),
                    statusCode: isCheckedActive ? 'ACTIVE' : 'INACTIVE'
                };

            const endpoint = isDecor ? '/AdminDecorService/data/decor' : '/AdminDecorService/data/service';
            const response = await fetch(id === 0 ? endpoint : `${endpoint}/${id}`, {
                method: id === 0 ? 'POST' : 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const result = await response.json();
            if (!response.ok || !result.success) {
                alert(result.message || 'Không thể lưu danh mục.');
                return;
            }

            closeDecorModal();
            await loadCatalogData();
            switchMainTab(currentTab);
        }

        // 14. XUẤT EXCEL
        function exportDataExcel() {
            const list = currentTab === 'decor' ? decorData : serviceData;
            const fileName = currentTab === 'decor' ? 'Riverside_DanhMuc_GoiDecor.xlsx' : 'Riverside_DanhMuc_DichVu.xlsx';
            const sheetName = currentTab === 'decor' ? 'Goi_Decor' : 'Dich_Vu';

            const exportData = list.map((item, index) => ({
                'STT': index + 1,
                'Mã Quy Định': item.ma,
                'Tên Gói / Dịch Vụ': item.ten,
                'Phân Loại / Phong Cách': item.phanLoai,
                'Đơn Giá Niêm Yết (VNĐ)': item.gia,
                'Mô Tả Chi Tiết': item.moTa,
                'Hạng Mục Chính / Nhân Sự': item.spec1 || '',
                'Thời Gian Set-up / Phục Vụ': item.spec2 || '',
                'Trạng Thái': item.trangThai
            }));

            const ws = XLSX.utils.json_to_sheet(exportData);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, sheetName);

            const wscols = [
                {wch: 5}, {wch: 15}, {wch: 35}, {wch: 25},
                {wch: 20}, {wch: 60}, {wch: 30}, {wch: 25}, {wch: 15}
            ];
            ws['!cols'] = wscols;

            XLSX.writeFile(wb, fileName);
        }
    </script>
}
