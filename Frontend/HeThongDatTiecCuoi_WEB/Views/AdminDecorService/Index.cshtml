        // 4. ĐỔ OPTIONS PHÂN LOẠI / PHONG CÁCH VÀO DROPDOWN
        function populateCategoryFilter() {
            const select = document.getElementById('filter-category');
            select.innerHTML = '<option value="">' + (currentTab === 'decor' ? 'Tất cả phong cách' : 'Tất cả phân loại') + '</option>';
            const currentList = currentTab === 'decor' ? decorData : serviceData;
            const categories = [...new Set(currentList.map(item => item.phanLoai))];
            categories.forEach(cat => {
                const opt = document.createElement('option');
                opt.value = cat;
                opt.innerText = cat;
                select.appendChild(opt);
            });
        }

        // 5. LỌC & TÌM KIẾM DỮ LIỆU
        function applyFilters() {
            const keyword = document.getElementById('input-search-keyword').value.toLowerCase().trim();
            const category = document.getElementById('filter-category').value;
            const status = document.getElementById('filter-status').value;

            const sourceList = currentTab === 'decor' ? decorData : serviceData;
            const filtered = sourceList.filter(item => {
                const matchKw = !keyword || item.ma.toLowerCase().includes(keyword) || item.ten.toLowerCase().includes(keyword) || item.moTa.toLowerCase().includes(keyword);
                const matchCat = !category || item.phanLoai === category;
                const matchStatus = !status || item.trangThai === status;
                return matchKw && matchCat && matchStatus;
            });

            if (currentTab === 'decor') {
                renderDecorCards(filtered);
            } else {
                renderServiceTable(filtered);
            }
            updateMetrics(filtered, sourceList);
        }

        function resetFilters() {
            document.getElementById('input-search-keyword').value = '';
            document.getElementById('filter-category').value = '';
            document.getElementById('filter-status').value = '';
            applyFilters();
        }

        // 6. CẬP NHẬT CHỈ SỐ METRICS
        function updateMetrics(filteredList, totalList) {
            const activeCount = totalList.filter(x => x.trangThai === 'Áp dụng').length;
            const inactiveCount = totalList.filter(x => x.trangThai === 'Ngừng áp dụng').length;

            document.getElementById('metric-showing').innerText = `Hiển thị ${filteredList.length} ${currentTab === 'decor' ? 'gói' : 'dịch vụ'}`;
            document.getElementById('metric-active').innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500"></span> ${activeCount} Đang áp dụng`;
            document.getElementById('metric-inactive').innerHTML = `<span class="w-2 h-2 rounded-full bg-slate-400"></span> ${inactiveCount} Ngừng áp dụng`;
            document.getElementById('pagination-summary').innerHTML = `Hiển thị <strong>1 – ${filteredList.length}</strong> trong tổng số <strong>${totalList.length}</strong> ${currentTab === 'decor' ? 'gói Decor' : 'dịch vụ'}`;
            document.getElementById('badge-system-status').innerText = `Hệ thống sẵn sàng • ${activeCount}/${totalList.length} Áp dụng`;
        }

