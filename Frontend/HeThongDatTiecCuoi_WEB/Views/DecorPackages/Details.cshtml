@using System.Globalization
@model HeThongDatTiecCuoi_WEB.Models.DecorPackages.DecorPackageDetailViewModel
@using HeThongDatTiecCuoi_WEB.Models
@{
    var hasPackage =
        !Model.IsNotFound &&
        string.IsNullOrWhiteSpace(Model.ErrorMessage);

    ViewData["Title"] = hasPackage
        ? Model.PackageName
        : Model.IsNotFound
            ? "Không tìm thấy gói trang trí"
            : "Thông tin gói trang trí tạm thời không khả dụng";

    ViewData["PublicActivePage"] = "decor-packages";

    var vi = CultureInfo.GetCultureInfo("vi-VN");

    var placeholderImage =
        Url.Content("~/images/decor-packages/decor-placeholder.svg");

    var description =
        string.IsNullOrWhiteSpace(Model.Description)
            ? "Thông tin mô tả gói trang trí chưa được cung cấp."
            : Model.Description;
    var galleryImages = ProjectImages.GetGallery("DecorGalleryFolders", Model.PackageName).ToList();
    if (!string.IsNullOrWhiteSpace(Model.ImageUrl)) galleryImages.Insert(0, Model.ImageUrl);
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hall-detail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/decor-packages.css" asp-append-version="true" />
}

<div class="home-page decor-packages-page">

    <partial name="_PublicHeader" />

    <main id="main-content" tabindex="-1">

        @if (!hasPackage)
        {
            <section class="decor-detail-feedback">

                <div class="home-container">

                    <div class="decor-empty-state"
                         role="@(Model.IsNotFound ? null : "alert")">

                        <span class="material-symbols-outlined"
                              aria-hidden="true">
                            @(Model.IsNotFound ? "search_off" : "error")
                        </span>

                        <span class="decor-eyebrow">
                            RIVERSIDE PALACE
                        </span>

                        <h1>
                            @(Model.IsNotFound
                                                    ? "Không tìm thấy gói trang trí."
                                                    : "Không thể tải thông tin gói trang trí")
                                                                                          </h1>

                        <p>
                            @(Model.IsNotFound
                                                    ? "Gói trang trí bạn đang tìm không tồn tại hoặc hiện không được giới thiệu."
                                                    : Model.ErrorMessage)
                    </p>

                        <a asp-controller="DecorPackages"
                           asp-action="Index">

                            <span class="material-symbols-outlined"
                                  aria-hidden="true">
                                arrow_back
                            </span>

                            Quay lại danh sách gói trang trí
                        </a>
                    </div>
                </div>
            </section>
                }
        else
        {
            <section class="decor-detail-hero"
                     aria-labelledby="decor-detail-title">

                <div class="home-container decor-detail-hero-content">

                    <span class="decor-eyebrow">
                        GÓI TRANG TRÍ
                    </span>

                    <h1 id="decor-detail-title">
                        @Model.PackageName
                    </h1>
                </div>
            </section>

            <nav class="public-breadcrumb public-breadcrumb--inline"
                 aria-label="Đường dẫn trang">

                <div class="home-container">

                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-route-publicSite="true">

                        Trang chủ
                    </a>

                    <span class="public-breadcrumb-separator" aria-hidden="true">›</span>

                    <a asp-controller="DecorPackages"
                       asp-action="Index">
                        Gói trang trí
                    </a>

                    <span class="public-breadcrumb-separator" aria-hidden="true">›</span>

                    <span aria-current="page">
                        @Model.PackageName
                    </span>
                </div>
            </nav>

            <section class="decor-detail-main"
                     aria-label="Chi tiết gói trang trí @Model.PackageName">

                <div class="home-container">

                    <div class="decor-detail-overview">

                        <partial name="_ImageGallery" model="new ImageGalleryViewModel { Name = Model.PackageName, Images = galleryImages, Placeholder = placeholderImage }" />

                        <div class="decor-detail-summary">

                            <span class="decor-eyebrow">
                                PHONG CÁCH
                            </span>

                            <h2>@Model.PackageName</h2>

                            <p class="decor-detail-style">
                                @Model.Style
                            </p>

                            <div class="decor-detail-price">

                                <span class="material-symbols-outlined"
                                      aria-hidden="true">
                                    payments
                                </span>

                                <div>
                                    <small>
                                        Giá gói trang trí
                                    </small>

                                    <strong>
                                        @Model.Price.ToString("N0", vi) VNĐ
                                    </strong>
                                </div>
                            </div>

                            <p class="decor-detail-description">
                                @description
                            </p>

                            <a class="decor-back-link"
                               asp-controller="DecorPackages"
                               asp-action="Index">

                                <span class="material-symbols-outlined"
                                      aria-hidden="true">
                                    arrow_back
                                </span>

                                Quay lại danh sách gói trang trí
                            </a>
                        </div>
                    </div>
                </div>
            </section>
        }
    </main>

    <partial name="_PublicFooter" />

    <div class="home-toast"
         role="status"
         aria-live="polite"
         hidden></div>
</div>

@section Scripts {
    <script src="~/js/public-site.js"
            asp-append-version="true"></script>
    <script src="~/js/hall-gallery.js" asp-append-version="true"></script>
}
