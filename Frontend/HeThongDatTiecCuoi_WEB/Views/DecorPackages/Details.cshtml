@using System.Globalization
@model HeThongDatTiecCuoi_WEB.Models.DecorPackages.DecorPackageDetailViewModel
@{
    var hasPackage = !Model.IsNotFound && string.IsNullOrWhiteSpace(Model.ErrorMessage);
    ViewData["Title"] = hasPackage ? Model.PackageName : Model.IsNotFound ? "Không tìm thấy gói trang trí" : "Thông tin gói trang trí tạm thời không khả dụng";
    ViewData["PublicActivePage"] = "decor-packages";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var placeholderImage = Url.Content("~/images/decor-packages/decor-placeholder.svg");
    var image = string.IsNullOrWhiteSpace(Model.ImageUrl) ? placeholderImage : Model.ImageUrl;
    var description = string.IsNullOrWhiteSpace(Model.Description)
        ? "Thông tin mô tả gói trang trí chưa được cung cấp."
        : Model.Description;
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;family=Plus+Jakarta+Sans:wght@300..800&amp;family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/decor-packages.css" asp-append-version="true" />
}

<div class="home-page decor-packages-page">
    <partial name="_PublicHeader" />
    <main id="main-content" tabindex="-1">
        @if (!hasPackage)
        {
            <section class="decor-detail-feedback">
                <div class="home-container">
                    <div class="decor-empty-state" role="@(Model.IsNotFound ? null : "alert")">
                        <span class="material-symbols-outlined" aria-hidden="true">@(Model.IsNotFound ? "search_off" : "error")</span>
                        <span class="decor-eyebrow">RIVERSIDE PALACE</span>
                        <h1>@(Model.IsNotFound ? "Không tìm thấy gói trang trí." : "Không thể tải thông tin gói trang trí")</h1>
                        <p>@(Model.IsNotFound ? "Gói trang trí bạn đang tìm không tồn tại hoặc hiện không được giới thiệu." : Model.ErrorMessage)</p>
                        <a asp-controller="DecorPackages" asp-action="Index"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span> Quay lại danh sách gói trang trí</a>
                    </div>
                </div>
            </section>
        }
        else
        {
            <section class="decor-detail-hero" aria-labelledby="decor-detail-title">
                <div class="home-container decor-detail-hero-content">
                    <span class="decor-eyebrow">GÓI TRANG TRÍ</span>
                    <h1 id="decor-detail-title">@Model.PackageName</h1>
                </div>
            </section>

            <nav class="decor-breadcrumb" aria-label="Đường dẫn trang">
                <div class="home-container">
                    <a asp-controller="Home" asp-action="Index" asp-route-publicSite="true"><span class="material-symbols-outlined" aria-hidden="true">home</span> Trang chủ</a>
                    <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                    <a asp-controller="DecorPackages" asp-action="Index">Gói trang trí</a>
                    <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                    <span aria-current="page">@Model.PackageName</span>
                </div>
            </nav>

            <section class="decor-detail-main" aria-label="Chi tiết gói trang trí @Model.PackageName">
                <div class="home-container">
                    <div class="decor-detail-overview">
                        <figure class="decor-detail-photo">
                            <img src="@image" alt="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "Chưa có hình ảnh gói trang trí" : Model.PackageName)" data-fallback="@placeholderImage" />
                        </figure>
                        <div class="decor-detail-summary">
                            <span class="decor-eyebrow">PHONG CÁCH</span>
                            <h2>@Model.PackageName</h2>
                            <p class="decor-detail-style">@Model.Style</p>
                            <div class="decor-detail-price"><span class="material-symbols-outlined" aria-hidden="true">payments</span><div><small>Giá gói trang trí</small><strong>@Model.Price.ToString("N0", vi) VNĐ</strong></div></div>
                            <p class="decor-detail-description">@description</p>
                            <a class="decor-back-link" asp-controller="DecorPackages" asp-action="Index"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span> Quay lại danh sách gói trang trí</a>
                        </div>
                    </div>
                </div>
            </section>
        }
    </main>
    <partial name="_PublicFooter" />
    <div class="home-toast" role="status" aria-live="polite" hidden></div>
</div>

@section Scripts {
    <script src="~/js/public-site.js" asp-append-version="true"></script>
}
