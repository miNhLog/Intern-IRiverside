@using System.Globalization
@model HeThongDatTiecCuoi_WEB.Models.DecorPackages.DecorPackageListViewModel
@{
    ViewData["Title"] = "Gói trang trí";
    ViewData["PublicActivePage"] = "decor-packages";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var placeholderImage = Url.Content("~/images/decor-packages/decor-placeholder.svg");
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/split-catalog.css" asp-append-version="true" />
}

<div class="home-page split-catalog-page">
    <partial name="_PublicHeader" />
    <main id="main-content" tabindex="-1">
        <nav class="public-breadcrumb" aria-label="Đường dẫn trang">
            <div class="home-container"><a asp-controller="Home" asp-action="Index" asp-route-publicSite="true">Trang chủ</a><span class="public-breadcrumb-separator" aria-hidden="true">›</span><span aria-current="page">Gói trang trí</span></div>
        </nav>
        <section aria-labelledby="decor-list-title">
            <header class="sc-intro">
                <img class="sc-banner-photo" src="/site-banner/DECOR" alt="" aria-hidden="true" fetchpriority="high" />
                <span class="sc-kicker">WEDDING CONCEPTS &bull; RIVERSIDE PALACE</span>
                <h1 id="decor-list-title">Bộ Sưu Tập Gói <em>Trang Trí Độc Bản</em></h1>
            </header>
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="sc-empty home-container" role="alert"><h2>Không thể tải danh sách gói trang trí</h2><p>Vui lòng thử lại sau.</p><a class="sc-detail" asp-controller="DecorPackages" asp-action="Index">Thử lại</a></div>
            }
            else if (Model.Packages.Count == 0)
            {
                <div class="sc-empty home-container"><h2>Chưa có gói trang trí được giới thiệu</h2><p>Thông tin các gói trang trí sẽ được cập nhật tại đây.</p></div>
            }
            else
            {
                <div class="sc-list">
                    @foreach (var package in Model.Packages)
                    {
                        var image = string.IsNullOrWhiteSpace(package.ImageUrl) ? placeholderImage : package.ImageUrl;
                        <article class="sc-row" aria-labelledby="decor-name-@package.DecorationPackageId">
                            <div class="home-container sc-row-inner">
                                <div class="sc-copy">
                                    <span class="sc-star" aria-hidden="true">✳</span>
                                    <h2 id="decor-name-@package.DecorationPackageId">Gói <strong>@package.PackageName</strong></h2>
                                    <div class="sc-rule" aria-hidden="true"></div>
                                    <p>@(string.IsNullOrWhiteSpace(package.Description) ? "Thông tin mô tả gói trang trí chưa được cung cấp." : package.Description)</p>
                                    <div class="sc-meta"><span>@package.Style</span><span>@package.Price.ToString("N0", vi) VNĐ</span></div>
                                    <a class="sc-detail" asp-controller="DecorPackages" asp-action="Details" asp-route-decorationPackageId="@package.DecorationPackageId" aria-label="Xem chi tiết gói @package.PackageName">Chi tiết <span class="material-symbols-outlined" aria-hidden="true">north_east</span></a>
                                </div>
                                <a class="sc-image" asp-controller="DecorPackages" asp-action="Details" asp-route-decorationPackageId="@package.DecorationPackageId" aria-label="Xem hình ảnh và chi tiết gói @package.PackageName"><img src="@image" alt="Gói trang trí @package.PackageName" loading="lazy" data-fallback="@placeholderImage" /></a>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </main>
    <partial name="_PublicFooter" />
    <div class="home-toast" role="status" aria-live="polite" hidden></div>
</div>

@section Scripts {
    <script src="~/js/public-site.js" asp-append-version="true"></script>
}
