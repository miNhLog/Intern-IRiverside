@using System.Globalization
@model HeThongDatTiecCuoi_WEB.Models.DecorPackages.DecorPackageListViewModel
@{
    ViewData["Title"] = "Gói trang trí";
    ViewData["PublicActivePage"] = "decor-packages";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var placeholderImage = Url.Content("~/images/decor-packages/decor-placeholder.svg");
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;family=Plus+Jakarta+Sans:wght@300..800&amp;family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/decor-packages.css" asp-append-version="true" />
}

<div class="home-page decor-packages-page">
    <partial name="_PublicHeader" />
    <main id="main-content" tabindex="-1">
        <section class="decor-list-hero" aria-labelledby="decor-list-title">
            <div class="home-container decor-list-hero-content">
                <span class="decor-eyebrow">GÓI TRANG TRÍ</span>
                <h1 id="decor-list-title">Dấu ấn riêng cho<br />ngày vui trọn vẹn</h1>
                <p>Khám phá các gói trang trí đang được giới thiệu tại Riverside Palace.</p>
            </div>
        </section>

        <nav class="decor-breadcrumb" aria-label="Đường dẫn trang">
            <div class="home-container">
                <a asp-controller="Home" asp-action="Index" asp-route-publicSite="true"><span class="material-symbols-outlined" aria-hidden="true">home</span> Trang chủ</a>
                <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                <span aria-current="page">Gói trang trí</span>
            </div>
        </nav>

        <section class="decor-catalog" aria-label="Danh sách gói trang trí">
            <div class="home-container">
                <form class="decor-filter" method="get" asp-controller="DecorPackages" asp-action="Index">
                    <div class="decor-filter-field">
                        <label for="keyword">Tìm theo tên hoặc phong cách</label>
                        <div class="decor-input-with-icon">
                            <span class="material-symbols-outlined" aria-hidden="true">search</span>
                            <input id="keyword" name="keyword" value="@Model.Keyword" maxlength="200" placeholder="Nhập tên hoặc phong cách..." />
                        </div>
                    </div>
                    <div class="decor-filter-field">
                        <label for="sort">Sắp xếp theo</label>
                        <select id="sort" name="sort">
                            <option value="name-asc" selected="@(Model.Sort == "name-asc")">Tên A - Z</option>
                            <option value="price-asc" selected="@(Model.Sort == "price-asc")">Giá thấp → cao</option>
                            <option value="price-desc" selected="@(Model.Sort == "price-desc")">Giá cao → thấp</option>
                        </select>
                    </div>
                    <button class="decor-filter-button" type="submit"><span class="material-symbols-outlined" aria-hidden="true">search</span> Tìm gói trang trí</button>
                </form>

                @if (string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <p class="decor-results-count">Có <strong>@Model.TotalItems</strong> gói trang trí phù hợp</p>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="decor-empty-state" role="alert">
                        <span class="material-symbols-outlined" aria-hidden="true">error</span>
                        <h2>Không thể tải danh sách gói trang trí</h2>
                        <p>Vui lòng thử lại sau.</p>
                        <a asp-controller="DecorPackages" asp-action="Index">Thử lại</a>
                    </div>
                }
                else if (Model.Packages.Count == 0)
                {
                    <div class="decor-empty-state">
                        <span class="material-symbols-outlined" aria-hidden="true">search_off</span>
                        <h2>@(string.IsNullOrWhiteSpace(Model.Keyword) ? "Chưa có gói trang trí được giới thiệu" : "Không tìm thấy gói trang trí phù hợp")</h2>
                        <p>@(string.IsNullOrWhiteSpace(Model.Keyword) ? "Thông tin các gói trang trí sẽ được cập nhật tại đây." : "Thử thay đổi từ khóa tìm kiếm của bạn.")</p>
                        <a asp-controller="DecorPackages" asp-action="Index">Xóa bộ lọc</a>
                    </div>
                }
                else
                {
                    <div class="public-decor-grid">
                        @foreach (var package in Model.Packages)
                        {
                            var image = string.IsNullOrWhiteSpace(package.ImageUrl) ? placeholderImage : package.ImageUrl;
                            <article class="public-decor-card">
                                <a class="public-decor-image" asp-controller="DecorPackages" asp-action="Details" asp-route-decorationPackageId="@package.DecorationPackageId" aria-label="Xem chi tiết gói @package.PackageName">
                                    <img src="@image" alt="@(string.IsNullOrWhiteSpace(package.ImageUrl) ? "Chưa có hình ảnh gói trang trí" : package.PackageName)" loading="lazy" data-fallback="@placeholderImage" />
                                </a>
                                <div class="public-decor-content">
                                    <span class="public-decor-style">@package.Style</span>
                                    <h2>@package.PackageName</h2>
                                    <p class="public-decor-description">@(string.IsNullOrWhiteSpace(package.Description) ? "Thông tin mô tả gói trang trí chưa được cung cấp." : package.Description)</p>
                                    <p class="public-decor-price">@package.Price.ToString("N0", vi) VNĐ</p>
                                    <a class="public-decor-detail" asp-controller="DecorPackages" asp-action="Details" asp-route-decorationPackageId="@package.DecorationPackageId">Xem chi tiết <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
                                </div>
                            </article>
                        }
                    </div>
                }

                @if (Model.TotalPages > 1)
                {
                    <nav class="decor-pagination" aria-label="Phân trang danh sách gói trang trí">
                        @if (Model.Page > 1)
                        {
                            <a asp-controller="DecorPackages" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page - 1)" aria-label="Trang trước"><span class="material-symbols-outlined" aria-hidden="true">chevron_left</span></a>
                        }
                        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                        {
                            <a class="@(pageNumber == Model.Page ? "active" : null)" asp-controller="DecorPackages" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-sort="@Model.Sort" asp-route-page="@pageNumber" aria-current="@(pageNumber == Model.Page ? "page" : null)">@pageNumber</a>
                        }
                        @if (Model.Page < Model.TotalPages)
                        {
                            <a asp-controller="DecorPackages" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page + 1)" aria-label="Trang sau"><span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></a>
                        }
                    </nav>
                }
            </div>
        </section>
    </main>
    <partial name="_PublicFooter" />
    <div class="home-toast" role="status" aria-live="polite" hidden></div>
</div>

@section Scripts {
    <script src="~/js/public-site.js" asp-append-version="true"></script>
}
