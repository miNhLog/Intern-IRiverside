@model HeThongDatTiecCuoi_WEB.Models.AdminBooking.BookingListResponseViewModel
@{
    ViewData["Title"] = "Quản Lý Đặt Tiệc";
    Layout = "_AdminLayout";
    var isManager = User.IsInRole(HeThongDatTiecCuoi_WEB.Constants.RoleNames.Manager);
}

<!-- Font dùng chung được nạp bởi _AdminLayout. -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.tailwindcss.com"></script>
<!-- Thêm SheetJS để xuất Excel -->
<script src="https://cdn.sheetjs.com/xlsx-0.20.0/package/dist/xlsx.full.min.js"></script>

<script>
    tailwind.config = {
        theme: {
            extend: {
                colors: {
                    brand: {
                        gold: '#B89758',
                        goldLight: '#E8D8B6',
                        goldHover: '#8C6D32',
                        darkNavy: '#111822',
                        sidebar: '#141E28',
                        surface: '#FFFFFF',
                        canvas: '#F8F9FA',
                        border: '#E2E8F0'
                    }
                },
                fontFamily: {
                    serif: ['"Playfair Display"', 'Georgia', 'serif'],
                    sans: ['"Plus Jakarta Sans"', '-apple-system', 'BlinkMacSystemFont', 'sans-serif']
                }
            }
        }
    }
</script>

<style>
    .booking-page-wrapper {
        font-family: 'Inter', sans-serif;
        color: var(--rp-text);
    }

        .booking-page-wrapper .font-serif {
            font-family: 'Inter', sans-serif;
        }

    .card-shadow {
        box-shadow: 0 4px 20px -2px rgba(30, 41, 59, 0.05), 0 2px 6px -1px rgba(30, 41, 59, 0.02);
    }

    .focus-ring:focus-visible {
        outline: 2px solid #B89758;
        outline-offset: 2px;
    }

    .custom-scrollbar::-webkit-scrollbar {
        height: 8px;
        width: 8px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: #F1F5F9;
        border-radius: 4px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #CBD5E1;
        border-radius: 4px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #B89758;
        }

    /* Trạng thái tab */
    .status-tab-btn {
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .status-tab-btn:hover {
            transform: translateY(-1px);
        }

    /* Booking row hover */
    .booking-row {
        transition: all 0.15s ease;
    }

        .booking-row:hover {
            background-color: var(--rp-surface-hover);
            box-shadow: inset 3px 0 0 var(--rp-gold-600);
        }

    /* Avatar khách hàng */
    .customer-avatar {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: linear-gradient(135deg, #B89758 0%, #8C6D32 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 12px;
        flex-shrink: 0;
    }

    .booking-action-trigger {
        width: 72px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 11px;
        border: 1px solid var(--rp-border);
        border-radius: var(--metis-radius);
        color: var(--rp-text-secondary);
        background: var(--rp-surface);
        cursor: pointer;
        transition: border-color .18s ease, color .18s ease, background .18s ease;
    }

    .booking-action-trigger:hover,
    .booking-action-trigger[aria-expanded="true"] {
        border-color: var(--rp-gold-600);
        color: var(--rp-gold-700);
        background: var(--rp-surface-hover);
    }

    .booking-action-popover {
        position: fixed;
        inset: auto;
        width: 210px;
        margin: 0;
        padding: 6px;
        border: 1px solid var(--rp-border);
        border-radius: 12px;
        color: var(--rp-text);
        background: var(--rp-surface);
        box-shadow: var(--metis-shadow-float);
        z-index: 100000;
    }

    .booking-action-popover::backdrop {
        background: transparent;
    }

    .booking-action-item {
        width: 100%;
        min-height: 38px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 10px;
        border: 0;
        border-radius: 8px;
        color: var(--rp-text);
        background: transparent;
        font: inherit;
        font-size: 12px;
        font-weight: 650;
        text-align: left;
        text-decoration: none;
        cursor: pointer;
    }

    .booking-action-item:hover {
        background: var(--rp-surface-hover);
    }

    .booking-action-item i {
        width: 18px;
        color: var(--rp-gold-600);
        text-align: center;
    }

    .booking-action-item.danger {
        color: #dc3355;
    }

    .booking-action-item.danger i {
        color: inherit;
    }

    .booking-status {
        display: inline-flex;
        min-height: 26px;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 4px 9px !important;
        border: 0 !important;
        border-radius: var(--metis-radius-sm) !important;
        color: #fff !important;
        background: var(--metis-badge-secondary) !important;
        font-size: 10.5px !important;
        font-weight: 650 !important;
        line-height: 1.2;
        white-space: nowrap;
    }

    .booking-status--pending { background: var(--metis-badge-warning) !important; }
    .booking-status--confirmed { background: var(--metis-badge-primary) !important; }
    .booking-status--preparing { background: #d97706 !important; }
    .booking-status--completed { background: var(--metis-badge-success) !important; }
    .booking-status--cancelled { background: var(--metis-badge-danger) !important; }

    .booking-page-wrapper .status-tab-btn.active {
        color: #211806 !important;
        background: var(--rp-gold-500) !important;
        box-shadow: none !important;
    }

    .booking-page-wrapper .status-tab-btn:not(.active) {
        color: var(--rp-text-secondary) !important;
        background: transparent !important;
    }

    .booking-page-wrapper .status-tab-btn:not(.active):hover {
        color: var(--rp-text) !important;
        background: var(--rp-surface-hover) !important;
        transform: none;
    }

    .booking-page-wrapper .status-tab-btn:not(.active) > span:last-child {
        color: var(--rp-text) !important;
        background: var(--rp-surface-hover) !important;
    }

    .booking-page-wrapper .status-tab-btn.active > span:last-child {
        color: #211806 !important;
        background: rgba(255, 255, 255, .42) !important;
    }

    html[data-admin-theme="dark"] .manager-metis-app :is(.booking-page-wrapper, #bookingDetailModal, #createBookingModal) {
        color: var(--rp-text);
        font-family: 'Inter', sans-serif !important;
    }

    html[data-admin-theme="dark"] .manager-metis-app .booking-page-wrapper :is(
        .bg-white, .bg-slate-50, .bg-slate-100, [class*="bg-[#FAF8F5]"]
    ),
    html[data-admin-theme="dark"] .manager-metis-app :is(#bookingDetailModal, #createBookingModal) :is(
        .bg-white, [class*="from-slate-50"], [class*="from-[#FAF8F5]"], [class*="to-[#F5EFE3]"]
    ) {
        background: var(--rp-surface) !important;
        background-image: none !important;
    }

    html[data-admin-theme="dark"] .manager-metis-app .booking-page-wrapper :is(.bg-slate-50\/60, .bg-slate-50\/70),
    html[data-admin-theme="dark"] .manager-metis-app :is(#bookingDetailModal, #createBookingModal) :is(.bg-slate-50\/60, .bg-slate-50\/70) {
        background: var(--rp-surface-muted) !important;
    }

    html[data-admin-theme="dark"] .manager-metis-app :is(.booking-page-wrapper, #bookingDetailModal, #createBookingModal) :is(
        .text-slate-950, .text-slate-900, .text-slate-800, .text-slate-700
    ) { color: var(--rp-text) !important; }

    html[data-admin-theme="dark"] .manager-metis-app :is(.booking-page-wrapper, #bookingDetailModal, #createBookingModal) :is(
        .text-slate-600, .text-slate-500, .text-slate-400, .text-slate-300
    ) { color: var(--rp-text-secondary) !important; }

    html[data-admin-theme="dark"] .manager-metis-app :is(.booking-page-wrapper, #bookingDetailModal, #createBookingModal) :is(
        .border-slate-100, .border-slate-200, .border-slate-200\/70, .border-slate-300, [class*="border-[#E5D5B8]"]
    ) { border-color: var(--rp-border) !important; }

    html[data-admin-theme="dark"] .manager-metis-app :is(.booking-page-wrapper, #bookingDetailModal, #createBookingModal) :is(
        .divide-slate-100, .divide-slate-200
    ) > :not([hidden]) ~ :not([hidden]) {
        border-color: var(--rp-border) !important;
    }

    html[data-admin-theme="dark"] .manager-metis-app .booking-page-wrapper :is(input, select),
    html[data-admin-theme="dark"] .manager-metis-app #createBookingModal :is(input:not([type="checkbox"]), select, textarea) {
        border-color: var(--rp-border) !important;
        color: var(--rp-text) !important;
        background: var(--rp-surface-muted) !important;
        color-scheme: dark;
    }

    html[data-admin-theme="dark"] .manager-metis-app :is(.booking-page-wrapper, #createBookingModal) :is(input, textarea)::placeholder {
        color: var(--rp-text-muted) !important;
        opacity: 1;
    }

    html[data-admin-theme="dark"] .manager-metis-app :is(.booking-page-wrapper, #createBookingModal) select option {
        color: var(--rp-text) !important;
        background: var(--rp-surface) !important;
    }

    html[data-admin-theme="dark"] .manager-metis-app :is(.booking-page-wrapper, #createBookingModal) :is(input, select, textarea):focus {
        border-color: var(--rp-gold-500) !important;
        outline: 0 !important;
        box-shadow: 0 0 0 2px rgba(198, 161, 91, .18) !important;
    }

    html[data-admin-theme="dark"] .manager-metis-app #createBookingModal :is(input, select, textarea):disabled {
        color: var(--rp-text-muted) !important;
        background: var(--rp-surface-hover) !important;
        opacity: .72;
    }

    html[data-admin-theme="dark"] .manager-metis-app #createBookingModal input[type="checkbox"] {
        accent-color: var(--metis-badge-primary);
    }

    html[data-admin-theme="dark"] .manager-metis-app .booking-page-wrapper thead,
    html[data-admin-theme="dark"] .manager-metis-app #bookingDetailModal :is(thead, tfoot) {
        border-color: var(--rp-border) !important;
        color: var(--rp-text) !important;
        background: var(--metis-heading-bg) !important;
    }

    html[data-admin-theme="dark"] .manager-metis-app .booking-page-wrapper tbody,
    html[data-admin-theme="dark"] .manager-metis-app #bookingDetailModal tbody {
        border-color: var(--rp-border) !important;
        color: var(--rp-text) !important;
        background: var(--rp-surface) !important;
    }

    html[data-admin-theme="dark"] .manager-metis-app .booking-row:hover,
    html[data-admin-theme="dark"] .manager-metis-app #bookingDetailModal tbody tr:hover {
        background: var(--rp-surface-hover) !important;
    }

    html[data-admin-theme="dark"] .manager-metis-app :is(#bookingDetailModal, #createBookingModal) > div {
        border-color: var(--rp-border) !important;
        color: var(--rp-text);
        background: var(--rp-surface) !important;
        box-shadow: var(--metis-shadow-float) !important;
    }

    html[data-admin-theme="dark"] .manager-metis-app :is(#bookingDetailModal, #createBookingModal) :is(header, footer) {
        border-color: var(--rp-border) !important;
        background: var(--rp-surface) !important;
        background-image: none !important;
    }

    html[data-admin-theme="dark"] .manager-metis-app #bookingDetailModal #mdReviewQrImage {
        border-radius: var(--metis-radius-sm);
        background: #fff;
    }

    html[data-admin-theme="dark"] .manager-metis-app .booking-action-popover {
        border-color: var(--rp-border);
        color: var(--rp-text);
        background: var(--rp-surface);
    }

    html[data-admin-theme="dark"] .manager-metis-app .custom-scrollbar::-webkit-scrollbar-track {
        background: var(--rp-surface-muted);
    }

    html[data-admin-theme="dark"] .manager-metis-app .custom-scrollbar::-webkit-scrollbar-thumb {
        background: var(--rp-border-strong);
    }
</style>

<!-- CONTAINER CHÍNH: Căn chỉnh padding và căn giữa đồng bộ với các trang khác -->
<div class="booking-page-wrapper p-6 lg:p-8 space-y-6 w-full max-w-[1600px] mx-auto" data-can-manage-contracts="@isManager.ToString().ToLowerInvariant()">

    <!-- ================= 1. HEADER TRANG ================= -->
    <div class="manager-section-header flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <span class="backoffice-hero__eyebrow"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i> QUẢN LÝ ĐẶT TIỆC</span>
            <h2 class="font-serif text-2xl font-bold text-slate-900 tracking-tight">
                Quản lý đặt tiệc cưới
            </h2>
            <p>Theo dõi và quản lý toàn bộ đơn đặt tiệc cưới.</p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
            <button type="button" onclick="exportBookingsExcel()" class="excel-export-button flex items-center gap-2 px-3.5 py-2 bg-slate-50 hover:bg-slate-100 text-slate-700 rounded-lg text-xs font-semibold transition-colors border border-slate-200 focus-ring min-h-[40px] shadow-2xs cursor-pointer">
                <i class="fa-solid fa-file-excel text-emerald-600 text-sm"></i>
                <span>Xuất Excel</span>
            </button>

            <button type="button" onclick="openCreateBookingModal()" class="admin-create-button flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-[#B89758] to-[#9E7E3F] hover:from-[#A8884A] hover:to-[#8E7035] text-white rounded-lg text-xs font-bold transition-all shadow-sm min-h-[40px] cursor-pointer">
                <i class="fa-solid fa-plus text-xs"></i>
                <span>Tạo Đơn Đặt Tiệc Mới</span>
            </button>
        </div>
    </div>

    <!-- ================= 2. TABS TRẠNG THÁI NHANH (Segmented Control) ================= -->
    <div class="bg-white rounded-xl border border-slate-200 card-shadow p-1.5">
        <div class="flex items-center gap-1 overflow-x-auto custom-scrollbar">
            <button type="button" onclick="filterByStatus(event, 'ALL')" class="status-tab-btn active px-3.5 py-2 rounded-lg font-bold border-0 transition-all bg-[#1E293B] text-white shrink-0 text-xs flex items-center gap-1.5">
                <i class="fa-solid fa-list-ul text-[10px]"></i>
                <span>Tất cả</span>
                <span class="px-1.5 py-0.5 rounded text-[10px] bg-white/20 font-bold" id="countTotal">@Model.TotalCount</span>
            </button>
            <button type="button" onclick="filterByStatus(event, 'PENDING')" class="status-tab-btn px-3.5 py-2 rounded-lg font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700 shrink-0 text-xs flex items-center gap-1.5">
                <i class="fa-regular fa-clock text-[10px]"></i>
                <span>Chờ xác nhận</span>
                <span class="px-1.5 py-0.5 rounded text-[10px] bg-blue-100 text-blue-700 font-bold" id="countPending">@(Model.PendingCount > 0 ? Model.PendingCount : Model.PendingConfirmationCount)</span>
            </button>
            <button type="button" onclick="filterByStatus(event, 'CONFIRMED')" class="status-tab-btn px-3.5 py-2 rounded-lg font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 shrink-0 text-xs flex items-center gap-1.5">
                <i class="fa-solid fa-check-double text-[10px]"></i>
                <span>Đã xác nhận</span>
                <span class="px-1.5 py-0.5 rounded text-[10px] bg-indigo-100 text-indigo-700 font-bold" id="countConfirmed">@Model.ConfirmedCount</span>
            </button>
            <button type="button" onclick="filterByStatus(event, 'PREPARING')" class="status-tab-btn px-3.5 py-2 rounded-lg font-semibold text-slate-700 hover:bg-amber-50 hover:text-amber-700 shrink-0 text-xs flex items-center gap-1.5">
                <i class="fa-solid fa-list-check text-[10px]"></i>
                <span>Đang chuẩn bị</span>
                <span class="px-1.5 py-0.5 rounded text-[10px] bg-amber-100 text-amber-800 font-bold" id="countDeposited">@(Model.PreparingCount > 0 ? Model.PreparingCount : Model.DepositedCount)</span>
            </button>
            <button type="button" onclick="filterByStatus(event, 'COMPLETED')" class="status-tab-btn px-3.5 py-2 rounded-lg font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 shrink-0 text-xs flex items-center gap-1.5">
                <i class="fa-solid fa-circle-check text-[10px]"></i>
                <span>Hoàn tất</span>
                <span class="px-1.5 py-0.5 rounded text-[10px] bg-emerald-100 text-emerald-700 font-bold" id="countCompleted">@Model.CompletedCount</span>
            </button>
            <button type="button" onclick="filterByStatus(event, 'CANCELLED')" class="status-tab-btn px-3.5 py-2 rounded-lg font-semibold text-slate-700 hover:bg-rose-50 hover:text-rose-700 shrink-0 text-xs flex items-center gap-1.5">
                <i class="fa-solid fa-ban text-[10px]"></i>
                <span>Đã hủy</span>
                <span class="px-1.5 py-0.5 rounded text-[10px] bg-rose-100 text-rose-700 font-bold" id="countCancelled">@Model.CancelledCount</span>
            </button>
        </div>
    </div>

    <!-- ================= 3. BỘ LỌC TÌM KIẾM ================= -->
    <section class="bg-white rounded-xl p-4 border border-slate-200 card-shadow flex flex-col md:flex-row flex-wrap items-stretch md:items-center justify-between gap-3">
        <div class="flex-1 flex flex-wrap items-center gap-3">
            <!-- Tìm kiếm từ khóa -->
            <div class="relative min-w-[240px] flex-1 max-w-md">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" id="filterKeyword" placeholder="Tìm theo mã tiệc, tên khách, SĐT..." onkeydown="if(event.key==='Enter') executeFilter(1)" class="w-full pl-9 pr-3.5 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-[#B89758] focus:bg-white focus:ring-1 focus:ring-[#B89758] min-h-[42px] transition-all">
            </div>

            <!-- Lọc theo sảnh -->
            <div class="backoffice-filter-control flex items-center bg-slate-50 border border-slate-200 rounded-lg px-3 py-1 min-h-[42px] min-w-[200px]">
                <i class="fa-solid fa-building-columns text-slate-500 mr-2 text-xs"></i>
                <label for="filterHallId" class="text-xs text-slate-500 mr-1.5 whitespace-nowrap font-medium">Sảnh:</label>
                <select id="filterHallId" onchange="executeFilter(1)" class="w-full bg-transparent text-xs font-semibold text-slate-800 focus:outline-none cursor-pointer pr-1">
                    <option value="0">Tất cả đại sảnh</option>
                    <option value="1">Sảnh Amur</option>
                    <option value="2">Sảnh Elbe</option>
                    <option value="3">Sảnh Danube</option>
                    <option value="4">Sảnh Seine</option>
                    <option value="5">Sảnh Thames</option>
                    <option value="6">Sảnh Volga</option>
                    <option value="7">Sảnh Green Riverside</option>
                    <option value="8">Sảnh Nile</option>
                    <option value="9">Sảnh Grand Ballroom</option>
                </select>
            </div>

            <!-- Lọc theo khoảng ngày -->
            <div class="backoffice-filter-control flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 min-h-[42px] text-xs">
                <i class="fa-regular fa-calendar text-slate-500 text-xs"></i>
                <span class="text-slate-500 font-medium">Từ:</span>
                <input type="date"
                       id="filterFromDate"
                       class="bg-transparent text-xs text-slate-800 focus:outline-none cursor-pointer"
                       style="min-height:0 !important; border:0 !important; border-radius:0 !important; outline:0 !important; background:transparent !important; box-shadow:none !important; padding:0 !important;">
                <span class="text-slate-300">|</span>
                <span class="text-slate-500 font-medium">Đến:</span>
                <input type="date"
                       id="filterToDate"
                       class="bg-transparent text-xs text-slate-800 focus:outline-none cursor-pointer"
                       style="min-height:0 !important; border:0 !important; border-radius:0 !important; outline:0 !important; background:transparent !important; box-shadow:none !important; padding:0 !important;">
            </div>

            <button type="button" onclick="executeFilter(1)" class="px-4 py-2 bg-[#1E293B] hover:bg-[#0F172A] text-white rounded-lg text-xs font-bold transition-colors cursor-pointer min-h-[42px] flex items-center gap-1.5">
                <i class="fa-solid fa-filter text-[11px]"></i>
                <span>Lọc dữ liệu</span>
            </button>
            <button type="button" onclick="resetFilters()" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg text-xs font-semibold transition-colors cursor-pointer min-h-[42px]" title="Đặt lại bộ lọc">
                <i class="fa-solid fa-arrow-rotate-left"></i>
            </button>
        </div>
    </section>

    <!-- ================= 4. BẢNG DANH SÁCH ĐẶT TIỆC ================= -->
    <div class="bg-white rounded-xl border border-slate-200 card-shadow overflow-hidden">
        <div class="overflow-x-auto custom-scrollbar">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-[#FAF8F5] text-slate-700 border-b border-slate-200 font-semibold uppercase text-[10.5px] tracking-wider">
                        <th class="py-3.5 px-4">Mã Tiệc</th>
                        <th class="py-3.5 px-4">Khách Hàng</th>
                        <th class="py-3.5 px-4">Đại Sảnh &amp; Ca</th>
                        <th class="py-3.5 px-3 text-center">Ngày Tổ Chức</th>
                        <th class="py-3.5 px-3 text-center">Quy Mô</th>
                        <th class="py-3.5 px-4 text-right">Tổng Dự Kiến</th>
                        <th class="py-3.5 px-3 text-center">Trạng Thái</th>
                        <th class="py-3.5 px-4 text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="bookingsTbody" class="divide-y divide-slate-100">
                    @if (Model.Items != null && Model.Items.Count > 0)
                    {
                        foreach (var b in Model.Items)
                        {
                            var initial = !string.IsNullOrEmpty(b.CustomerName) ? b.CustomerName.Substring(0, 1).ToUpper() : "?";
                            <tr class="booking-row">
                                <td class="py-3.5 px-4 font-mono font-bold text-[#8C6D32]">@b.BookingCode</td>
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-2.5">
                                        <div class="customer-avatar">@initial</div>
                                        <div class="min-w-0">
                                            <p class="font-bold text-slate-900 truncate">@b.CustomerName</p>
                                            <p class="text-[11px] text-slate-500 flex items-center gap-1">
                                                <i class="fa-solid fa-phone text-[9px]"></i>
                                                @b.CustomerPhone
                                            </p>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    <p class="font-semibold text-slate-800 flex items-center gap-1.5">
                                        <i class="fa-solid fa-hotel text-[10px] text-[#B89758]"></i>
                                        @b.HallName
                                    </p>
                                    <span class="inline-block mt-0.5 px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-600">
                                        @if (b.Shift == "Ca tối")
                                        {
                                            <i class="fa-regular fa-moon text-indigo-500 mr-1"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-regular fa-sun text-amber-500 mr-1"></i>
                                        }
                                        @b.Shift
                                    </span>
                                </td>
                                <td class="py-3.5 px-3 text-center font-medium text-slate-700">
                                    <div class="flex flex-col items-center">
                                        <span class="font-bold">@b.EventDate.ToString("dd")</span>
                                        <span class="text-[10px] text-slate-500">Tháng @b.EventDate.ToString("MM/yyyy")</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-3 text-center">
                                    <span class="font-bold text-slate-800">@b.TableCount</span>
                                    <span class="text-[10px] text-slate-500 ml-0.5">bàn</span>
                                </td>
                                <td class="py-3.5 px-4 text-right font-serif font-bold text-slate-900">
                                    @((b.EstimatedTotal ?? 0m).ToString("N0")) <span class="text-[10px] font-sans text-slate-500 font-normal">đ</span>
                                </td>
                                <td class="py-3.5 px-3 text-center">
                                    @if (b.Status == "Hoàn tất")
                                    {
                                        <span class="booking-status booking-status--completed">
                                            Hoàn tất
                                        </span>
                                    }
                                    else if (b.StatusCode == "PREPARING")
                                    {
                                        <span class="booking-status booking-status--preparing">
                                            Đang chuẩn bị
                                        </span>
                                    }
                                    else if (b.Status == "Đã xác nhận")
                                    {
                                        <span class="booking-status booking-status--confirmed">
                                            Đã xác nhận
                                        </span>
                                    }
                                    else if (b.Status == "Đã hủy")
                                    {
                                        <span class="booking-status booking-status--cancelled">
                                            Đã hủy
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="booking-status booking-status--pending">
                                            Chờ xác nhận
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    <div class="inline-flex">
                                        <button type="button" class="booking-action-trigger" onclick="toggleBookingActions(event, 'bookingActions-@b.BookingId')" aria-controls="bookingActions-@b.BookingId" aria-expanded="false" aria-label="Mở thao tác cho booking @b.BookingCode" title="Thao tác">
                                            <i class="bi bi-three-dots"></i>
                                            <i class="bi bi-chevron-down text-[10px]" aria-hidden="true"></i>
                                        </button>
                                        <div id="bookingActions-@b.BookingId" class="booking-action-popover" popover="auto" role="menu">
                                            <button type="button" class="booking-action-item" onclick="closeBookingActions(); viewBookingDetail(@b.BookingId)" role="menuitem"><i class="fa-regular fa-eye"></i><span>Xem chi tiết</span></button>
                                        @if (isManager && b.HasContract)
                                        {
                                            <a href="/quan-ly/hop-dong-thanh-toan?contractId=@b.ContractId" class="booking-action-item" role="menuitem"><i class="fa-solid fa-file-contract"></i><span>Xem hợp đồng</span></a>
                                        }
                                        else if (isManager && b.StatusCode == "CONFIRMED")
                                        {
                                            <a href="/quan-ly/hop-dong-thanh-toan?bookingId=@b.BookingId&amp;openCreate=true" class="booking-action-item" role="menuitem"><i class="fa-solid fa-file-circle-plus"></i><span>Tạo hợp đồng</span></a>
                                        }
                                        @if (b.StatusCode == "PENDING")
                                        {
                                            <button type="button" class="booking-action-item" onclick="closeBookingActions(); quickUpdateStatus(@b.BookingId, 'CONFIRMED')" role="menuitem"><i class="fa-solid fa-check"></i><span>Xác nhận đơn tiệc</span></button>
                                        }
                                        @if (b.StatusCode != "CANCELLED" && b.StatusCode != "COMPLETED")
                                        {
                                            <button type="button" class="booking-action-item danger" onclick="closeBookingActions(); cancelBookingPrompt(@b.BookingId)" role="menuitem"><i class="fa-solid fa-ban"></i><span>Hủy đơn tiệc</span></button>
                                        }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="py-10 text-center text-slate-400 italic">
                                <i class="fa-regular fa-folder-open text-3xl mb-2 text-slate-300 block"></i>
                                Chưa có đơn đặt tiệc nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang -->
        <div class="p-4 bg-[#FAF8F5] border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
            <div>
                Hiển thị <span id="pageInfoStart" class="font-bold text-slate-800">1</span> – <span id="pageInfoEnd" class="font-bold text-slate-800">@(Model.Items?.Count ?? 0)</span> trên tổng số <strong id="pageInfoTotal" class="text-slate-800">@Model.TotalCount</strong> hợp đồng
            </div>
            <div class="flex items-center gap-1.5" id="paginationWrapper">
                <!-- Nút phân trang render qua JS -->
            </div>
        </div>
    </div>

</div>

<!-- ================= MODAL CHI TIẾT HỢP ĐỒNG & THANH TOÁN ================= -->
