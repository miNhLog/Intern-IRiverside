@section Scripts {
    <script>
        let currentFilter = {
            keyword: '',
            status: 'ALL',
            hallId: 0,
            fromDate: null,
            toDate: null,
            pageIndex: 1,
            pageSize: 10
        };

        let selectedBookingId = null;
        let currentBookings = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items ?? new List<HeThongDatTiecCuoi_WEB.Models.AdminBooking.BookingSummaryViewModel>()));

        document.addEventListener('DOMContentLoaded', () => {
            // Đặt mặc định ngày tạo tiệc mới là 30 ngày tới
            const defaultDate = new Date();
            defaultDate.setDate(defaultDate.getDate() + 30);
            document.getElementById('newEventDate').value = defaultDate.toISOString().split('T')[0];

            // Thoát stacking context cho các Modal
            const detailModal = document.getElementById('bookingDetailModal');
            const createModal = document.getElementById('createBookingModal');
            if (detailModal && detailModal.parentElement !== document.body) document.body.appendChild(detailModal);
            if (createModal && createModal.parentElement !== document.body) document.body.appendChild(createModal);

            // Render phân trang lần đầu
            renderPagination(@Model.TotalCount, 1, 10);
        });

        function showToast(title, msg, isSuccess = true) {
            const toast = document.getElementById('bookingToast');
            const icon = document.getElementById('toastIcon');
            document.getElementById('toastTitle').innerText = title;
            document.getElementById('toastMsg').innerText = msg;

            if (isSuccess) {
                icon.className = "w-7 h-7 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs";
                icon.innerHTML = '<i class="fa-solid fa-circle-check"></i>';
            } else {
                icon.className = "w-7 h-7 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center text-xs";
                icon.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>';
            }

            toast.classList.remove('translate-x-full');
            setTimeout(() => toast.classList.add('translate-x-full'), 3000);
        }

        // ================= 1. XỬ LÝ LỌC & PHÂN TRANG =================
        function filterByStatus(event, status) {
            currentFilter.status = status;

            // Reset tất cả nút
            document.querySelectorAll('.status-tab-btn').forEach(btn => {
                btn.classList.remove('active', 'bg-[#1E293B]', 'text-white');
                btn.classList.add('text-slate-700', 'hover:bg-slate-50');
            });

            // Active nút được chọn
            event.currentTarget.classList.add('active', 'bg-[#1E293B]', 'text-white');
            event.currentTarget.classList.remove('text-slate-700', 'hover:bg-slate-50');

            executeFilter(1);
        }

        function resetFilters() {
            document.getElementById('filterKeyword').value = '';
            document.getElementById('filterHallId').value = '0';
            document.getElementById('filterFromDate').value = '';
            document.getElementById('filterToDate').value = '';
            currentFilter = { keyword: '', status: 'ALL', hallId: 0, fromDate: null, toDate: null, pageIndex: 1, pageSize: 10 };
            executeFilter(1);
        }

        async function executeFilter(page = 1) {
            currentFilter.pageIndex = page;
            currentFilter.keyword = document.getElementById('filterKeyword').value.trim();
            currentFilter.hallId = parseInt(document.getElementById('filterHallId').value) || 0;
            currentFilter.fromDate = document.getElementById('filterFromDate').value || null;
            currentFilter.toDate = document.getElementById('filterToDate').value || null;

            const params = new URLSearchParams();
            params.append('pageIndex', currentFilter.pageIndex);
            params.append('pageSize', currentFilter.pageSize);
            if (currentFilter.keyword) params.append('keyword', currentFilter.keyword);
            if (currentFilter.status && currentFilter.status !== 'ALL') params.append('status', currentFilter.status);
            if (currentFilter.hallId > 0) params.append('hallId', currentFilter.hallId);
            if (currentFilter.fromDate) params.append('fromDate', currentFilter.fromDate);
            if (currentFilter.toDate) params.append('toDate', currentFilter.toDate);

            try {
                const res = await fetch(`/AdminBooking/GetBookingsData?${params.toString()}`);
                const result = await res.json();

                if (result.success && result.data) {
                    renderBookingsTable(result.data);
                } else {
                    showToast('Lỗi', result.message || 'Không thể tải danh sách đặt tiệc.', false);
                }
            } catch (e) {
                console.error(e);
                showToast('Lỗi kết nối', 'Không thể kết nối máy chủ.', false);
            }
        }

        function renderBookingsTable(data) {
            const tbody = document.getElementById('bookingsTbody');
            tbody.innerHTML = '';
            const items = data.items || data.Items || [];
            currentBookings = items;

            // Cập nhật số liệu tabs
            document.getElementById('countTotal').innerText = data.totalCount ?? data.TotalCount ?? 0;
            document.getElementById('countPending').innerText = data.pendingConfirmationCount ?? data.PendingConfirmationCount ?? 0;
            document.getElementById('countConfirmed').innerText = data.confirmedCount ?? data.ConfirmedCount ?? 0;
            document.getElementById('countDeposited').innerText = data.depositedCount ?? data.DepositedCount ?? 0;
            document.getElementById('countCompleted').innerText = data.completedCount ?? data.CompletedCount ?? 0;
            document.getElementById('countCancelled').innerText = data.cancelledCount ?? data.CancelledCount ?? 0;

            if (items.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="py-10 text-center text-slate-400 italic"><i class="fa-regular fa-folder-open text-3xl mb-2 text-slate-300 block"></i>Không tìm thấy đơn đặt tiệc nào.</td></tr>`;
                renderPagination(0, 1, 10);
                return;
            }

            items.forEach(b => {
                const id = b.bookingId || b.BookingId;
                const code = b.bookingCode || b.BookingCode;
                const custName = b.customerName || b.CustomerName || '';
                const phone = b.customerPhone || b.CustomerPhone || '';
                const hall = b.hallName || b.HallName;
                const shift = b.shift || b.Shift;
                const eventDate = new Date(b.eventDate || b.EventDate);
                const day = String(eventDate.getDate()).padStart(2, '0');
                const monthYear = String(eventDate.getMonth() + 1).padStart(2, '0') + '/' + eventDate.getFullYear();
                const tables = b.tableCount ?? b.TableCount ?? 0;
                const total = Number(b.estimatedTotal ?? b.EstimatedTotal ?? 0).toLocaleString('vi-VN');
                const status = b.status || b.Status;
                const initial = custName ? custName.substring(0, 1).toUpperCase() : '?';

                let badge = `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-blue-50 text-blue-700 border border-blue-200"><i class="fa-regular fa-clock text-[9px]"></i> Chờ xác nhận</span>`;
                if (status === 'Hoàn tất') badge = `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-300"><i class="fa-solid fa-circle-check text-[9px]"></i> Hoàn tất</span>`;
                else if (status === 'Đã cọc') badge = `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-amber-50 text-amber-800 border border-amber-300"><i class="fa-solid fa-hand-holding-dollar text-[9px]"></i> Đã cọc</span>`;
                else if (status === 'Đã xác nhận') badge = `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200"><i class="fa-solid fa-check-double text-[9px]"></i> Đã xác nhận</span>`;
                else if (status === 'Đã hủy') badge = `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-rose-50 text-rose-700 border border-rose-200"><i class="fa-solid fa-ban text-[9px]"></i> Đã hủy</span>`;

                let shiftIcon = shift === 'Ca tối'
                    ? '<i class="fa-regular fa-moon text-indigo-500 mr-1"></i>'
                    : '<i class="fa-regular fa-sun text-amber-500 mr-1"></i>';

                let actionBtns = `
                    <button type="button" onclick="viewBookingDetail(${id})" class="h-[32px] w-[32px] rounded-lg bg-slate-100 hover:bg-[#B89758]/15 text-[#8C6D32] hover:text-[#B89758] transition-colors flex items-center justify-center" title="Xem hợp đồng chi tiết">
                        <i class="fa-solid fa-file-contract text-sm"></i>
                    </button>
                `;
                if (status === 'Chờ xác nhận') {
                    actionBtns += `
                        <button type="button" onclick="quickUpdateStatus(${id}, 'Đã xác nhận')" class="h-[32px] w-[32px] rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-600 transition-colors flex items-center justify-center" title="Xác nhận đơn tiệc">
                            <i class="fa-solid fa-check text-sm"></i>
                        </button>
                    `;
                } else if (status === 'Đã xác nhận') {
                    actionBtns += `
                        <button type="button" onclick="quickDepositModal(${id}, ${b.estimatedTotal ?? b.EstimatedTotal ?? 0})" class="h-[32px] w-[32px] rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-600 transition-colors flex items-center justify-center" title="Xác nhận đặt cọc">
                            <i class="fa-solid fa-hand-holding-dollar text-sm"></i>
                        </button>
                    `;
                }
                if (status !== 'Đã hủy' && status !== 'Hoàn tất') {
                    actionBtns += `
                        <button type="button" onclick="cancelBookingPrompt(${id})" class="h-[32px] w-[32px] rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-500 transition-colors flex items-center justify-center" title="Hủy đơn tiệc">
                            <i class="fa-solid fa-ban text-sm"></i>
                        </button>
                    `;
                }

                tbody.innerHTML += `
                    <tr class="booking-row">
                        <td class="py-3.5 px-4 font-mono font-bold text-[#8C6D32]">${code}</td>
                        <td class="py-3.5 px-4">
                            <div class="flex items-center gap-2.5">
                                <div class="customer-avatar">${initial}</div>
                                <div class="min-w-0">
                                    <p class="font-bold text-slate-900 truncate">${custName}</p>
                                    <p class="text-[11px] text-slate-500 flex items-center gap-1">
                                        <i class="fa-solid fa-phone text-[9px]"></i>
                                        ${phone}
                                    </p>
                                </div>
                            </div>
                        </td>
                        <td class="py-3.5 px-4">
                            <p class="font-semibold text-slate-800 flex items-center gap-1.5">
                                <i class="fa-solid fa-hotel text-[10px] text-[#B89758]"></i>
                                ${hall}
                            </p>
                            <span class="inline-block mt-0.5 px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-600">
                                ${shiftIcon}${shift}
                            </span>
                        </td>
                        <td class="py-3.5 px-3 text-center font-medium text-slate-700">
                            <div class="flex flex-col items-center">
                                <span class="font-bold">${day}</span>
                                <span class="text-[10px] text-slate-500">Tháng ${monthYear}</span>
                            </div>
                        </td>
                        <td class="py-3.5 px-3 text-center">
                            <span class="font-bold text-slate-800">${tables}</span>
                            <span class="text-[10px] text-slate-500 ml-0.5">bàn</span>
                        </td>
                        <td class="py-3.5 px-4 text-right font-serif font-bold text-slate-900">
                            ${total} <span class="text-[10px] font-sans text-slate-500 font-normal">đ</span>
                        </td>
                        <td class="py-3.5 px-3 text-center">${badge}</td>
                        <td class="py-3.5 px-4 text-center"><div class="inline-flex items-center gap-1.5">${actionBtns}</div></td>
                    </tr>
                `;
            });

            // Render phân trang
            const totalCount = data.totalCount ?? data.TotalCount ?? 0;
            const pageSize = currentFilter.pageSize;
            renderPagination(totalCount, currentFilter.pageIndex, pageSize);

            // Update page info
            const start = (currentFilter.pageIndex - 1) * pageSize + 1;
            const end = Math.min(start + items.length - 1, totalCount);
            document.getElementById('pageInfoStart').innerText = items.length > 0 ? start : 0;
            document.getElementById('pageInfoEnd').innerText = end;
            document.getElementById('pageInfoTotal').innerText = totalCount;
        }

        function renderPagination(totalCount, currentPage, pageSize) {
            const wrapper = document.getElementById('paginationWrapper');
            wrapper.innerHTML = '';
            const totalPages = Math.ceil(totalCount / pageSize) || 1;

            // Nút Previous
            const prevBtn = document.createElement('button');
            prevBtn.type = 'button';
            prevBtn.className = `px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 font-medium ${currentPage === 1 ? 'opacity-40 cursor-not-allowed' : 'hover:bg-slate-100 cursor-pointer'}`;
            prevBtn.innerHTML = '<i class="fa-solid fa-chevron-left text-[10px]"></i>';
            if (currentPage > 1) prevBtn.onclick = () => executeFilter(currentPage - 1);
            wrapper.appendChild(prevBtn);

            // Số trang
            const maxVisible = 5;
            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, startPage + maxVisible - 1);
            if (endPage - startPage < maxVisible - 1) startPage = Math.max(1, endPage - maxVisible + 1);

            for (let i = startPage; i <= endPage; i++) {
                const btn = document.createElement('button');
                btn.type = 'button';
                if (i === currentPage) {
                    btn.className = 'px-3 py-1.5 rounded-lg bg-[#B89758] text-white font-bold border border-[#B89758] cursor-pointer';
                } else {
                    btn.className = 'px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 font-medium hover:bg-slate-100 cursor-pointer';
                }
                btn.innerText = i;
                btn.onclick = () => executeFilter(i);
                wrapper.appendChild(btn);
            }

            // Nút Next
            const nextBtn = document.createElement('button');
            nextBtn.type = 'button';
            nextBtn.className = `px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 font-medium ${currentPage === totalPages ? 'opacity-40 cursor-not-allowed' : 'hover:bg-slate-100 cursor-pointer'}`;
            nextBtn.innerHTML = '<i class="fa-solid fa-chevron-right text-[10px]"></i>';
            if (currentPage < totalPages) nextBtn.onclick = () => executeFilter(currentPage + 1);
            wrapper.appendChild(nextBtn);
        }

        // ================= 2. XỬ LÝ CHI TIẾT HỢP ĐỒNG & ĐẶT CỌC =================
        async function viewBookingDetail(id) {
            selectedBookingId = id;
            try {
                const res = await fetch(`/AdminBooking/GetDetail/${id}`);
                const result = await res.json();

                if (result.success && result.data) {
                    const b = result.data;
                    document.getElementById('mdBookingCode').innerText = b.bookingCode || b.BookingCode;
                    document.getElementById('mdCustomerName').innerText = b.customerName || b.CustomerName;
                    document.getElementById('mdCustomerPhone').innerText = b.customerPhone || b.CustomerPhone || 'Chưa có SĐT';
                    document.getElementById('mdHallAndShift').innerText = `${b.hallName || b.HallName} • ${b.shift || b.Shift}`;
                    document.getElementById('mdEventDate').innerText = new Date(b.eventDate || b.EventDate).toLocaleDateString('vi-VN');

                    const tables = b.tableCount ?? b.TableCount ?? 0;
                    const menuUnit = b.finalMenuPrice ?? b.FinalMenuPrice ?? 0;
                    const hallPrice = b.finalHallPrice ?? b.FinalHallPrice ?? 0;
                    const decorPrice = b.finalDecorationPrice ?? b.FinalDecorationPrice ?? 0;
                    const total = b.estimatedTotal ?? b.EstimatedTotal ?? 0;

                    document.getElementById('mdTableCount').innerText = `${tables} bàn`;
                    document.getElementById('mdMenuUnitPrice').innerText = `${Number(menuUnit).toLocaleString('vi-VN')} đ`;
                    document.getElementById('mdMenuSubtotal').innerText = `${Number(menuUnit * tables).toLocaleString('vi-VN')} đ`;
                    document.getElementById('mdHallPrice').innerText = `${Number(hallPrice).toLocaleString('vi-VN')} đ`;
                    document.getElementById('mdHallSubtotal').innerText = `${Number(hallPrice).toLocaleString('vi-VN')} đ`;
                    document.getElementById('mdDecorPrice').innerText = `${Number(decorPrice).toLocaleString('vi-VN')} đ`;
                    document.getElementById('mdDecorSubtotal').innerText = `${Number(decorPrice).toLocaleString('vi-VN')} đ`;
                    document.getElementById('mdTotalAmount').innerText = `${Number(total).toLocaleString('vi-VN')} VNĐ`;

                    document.getElementById('mdDeposit20').innerText = `${Number(total * 0.2).toLocaleString('vi-VN')} đ`;
                    document.getElementById('mdDeposit50').innerText = `${Number(total * 0.5).toLocaleString('vi-VN')} đ`;

                    const status = b.status || b.Status;
                    document.getElementById('mdStatusBadge').innerText = status;

                    const btnGroup = document.getElementById('mdActionBtnGroup');
                    btnGroup.innerHTML = '';
                    if (status === 'Chờ xác nhận') {
                        btnGroup.innerHTML = `<button type="button" onclick="quickUpdateStatus(${id}, 'Đã xác nhận')" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-bold shadow-sm transition-colors flex items-center gap-2"><i class="fa-solid fa-check text-xs"></i>Duyệt Hợp Đồng</button>`;
                    } else if (status === 'Đã xác nhận') {
                        btnGroup.innerHTML = `<button type="button" onclick="quickDepositModal(${id}, ${total})" class="px-4 py-2.5 bg-gradient-to-r from-[#B89758] to-[#9E7E3F] hover:from-[#A8884A] text-white rounded-lg font-bold shadow-sm transition-all flex items-center gap-2"><i class="fa-solid fa-hand-holding-dollar text-xs"></i>Thu Cọc 20%</button>`;
                    } else if (status === 'Đã cọc') {
                        btnGroup.innerHTML = `<button type="button" onclick="quickUpdateStatus(${id}, 'Hoàn tất')" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-bold shadow-sm transition-colors flex items-center gap-2"><i class="fa-solid fa-circle-check text-xs"></i>Quyết Toán</button>`;
                    }

                    const modal = document.getElementById('bookingDetailModal');
                    modal.classList.remove('hidden');
                    modal.classList.add('flex');
                }
            } catch (e) {
                console.error(e);
                showToast('Lỗi', 'Không thể lấy chi tiết hợp đồng.', false);
            }
        }

        function closeDetailModal() {
            const modal = document.getElementById('bookingDetailModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        // ================= 3. CẬP NHẬT TRẠNG THÁI / ĐẶT CỌC / HỦY =================
        async function quickUpdateStatus(id, newStatus) {
            if (!confirm(`Bạn có chắc muốn chuyển trạng thái đơn tiệc sang "${newStatus}"?`)) return;

            try {
                const res = await fetch(`/AdminBooking/UpdateStatus/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ newStatus: newStatus })
                });
                const result = await res.json();
                if (result.success) {
                    showToast('Thành công', result.message);
                    closeDetailModal();
                    executeFilter(currentFilter.pageIndex);
                } else {
                    showToast('Lỗi', result.message, false);
                }
            } catch (e) {
                showToast('Lỗi', 'Không thể cập nhật trạng thái.', false);
            }
        }

        function quickDepositModal(id, totalAmount) {
            const deposit20 = totalAmount * 0.2;
            if (confirm(`Xác nhận khách hàng đã nộp tiền cọc đợt 1 (20%): ${deposit20.toLocaleString('vi-VN')} đ?`)) {
                quickUpdateStatus(id, 'Đã cọc');
            }
        }

        function cancelBookingPrompt(id) {
            const reason = prompt("Nhập lý do hủy tiệc cưới (lịch sảnh sẽ tự động giải phóng):", "Khách hàng đổi kế hoạch");
            if (reason === null) return;

            fetch(`/AdminBooking/UpdateStatus/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ newStatus: 'Đã hủy', cancellationReason: reason })
            })
            .then(res => res.json())
            .then(result => {
                if (result.success) {
                    showToast('Đã hủy', 'Đã hủy tiệc và giải phóng lịch sảnh thành công.');
                    closeDetailModal();
                    executeFilter(currentFilter.pageIndex);
                } else {
                    showToast('Lỗi', result.message, false);
                }
            });
        }

        // ================= 4. TẠO MỚI ĐẶT TIỆC =================
        function openCreateBookingModal() {
            const modal = document.getElementById('createBookingModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeCreateBookingModal() {
            const modal = document.getElementById('createBookingModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        async function handleCreateBooking(e) {
            e.preventDefault();
            const payload = {
                customerId: parseInt(document.getElementById('newCustomerId').value),
                hallId: parseInt(document.getElementById('newHallId').value),
                eventDate: document.getElementById('newEventDate').value,
                shift: document.getElementById('newShift').value,
                tableCount: parseInt(document.getElementById('newTableCount').value),
                guestCount: parseInt(document.getElementById('newGuestCount').value),
                specialRequests: document.getElementById('newSpecialRequests').value
            };

            try {
                const res = await fetch('/AdminBooking/Create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();

                if (result.success) {
                    showToast('Thành công', result.message);
                    closeCreateBookingModal();
                    executeFilter(1);
                } else {
                    showToast('Thất bại', result.message, false);
                }
            } catch (err) {
                showToast('Lỗi', 'Không thể kết nối máy chủ.', false);
            }
        }

        // ================= 5. XUẤT EXCEL =================
        function exportBookingsExcel() {
            if (!currentBookings || currentBookings.length === 0) {
                showToast('Thông báo', 'Không có dữ liệu để xuất.', false);
                return;
            }

            try {
                const wb = XLSX.utils.book_new();

                const dataToExport = currentBookings.map((b, idx) => {
                    const eventDateRaw = b.eventDate || b.EventDate;
                    const dateFormatted = eventDateRaw ? new Date(eventDateRaw).toLocaleDateString('vi-VN') : '';
                    return {
                        'STT': idx + 1,
                        'Mã Tiệc': b.bookingCode || b.BookingCode,
                        'Tên Khách Hàng': b.customerName || b.CustomerName,
                        'Số Điện Thoại': b.customerPhone || b.CustomerPhone || '',
                        'Đại Sảnh': b.hallName || b.HallName,
                        'Ca Tổ Chức': b.shift || b.Shift,
                        'Ngày Tổ Chức': dateFormatted,
                        'Số Bàn': b.tableCount || b.TableCount || 0,
                        'Tổng Dự Kiến (VNĐ)': b.estimatedTotal || b.EstimatedTotal || 0,
                        'Trạng Thái': b.status || b.Status
                    };
                });

                const ws = XLSX.utils.json_to_sheet(dataToExport);
                const wscols = [
                    { wch: 5 }, { wch: 15 }, { wch: 25 }, { wch: 15 },
                    { wch: 20 }, { wch: 12 }, { wch: 15 }, { wch: 10 },
                    { wch: 20 }, { wch: 15 }
                ];
                ws['!cols'] = wscols;
                XLSX.utils.book_append_sheet(wb, ws, 'DanhSach_DatTiec');

                XLSX.writeFile(wb, `Riverside_DanhSach_DatTiec_${new Date().toISOString().slice(0,10)}.xlsx`);
                showToast('Thành công', `Đã xuất ${currentBookings.length} hợp đồng ra Excel!`);
            } catch (err) {
                console.error('Lỗi xuất Excel:', err);
                showToast('Lỗi', 'Không thể xuất file Excel: ' + err.message, false);
            }
        }
    </script>
}
