<!-- ================= MODAL TẠO MỚI ĐẶT TIỆC (CREATE BOOKING) ================= -->
<div id="createBookingModal" class="fixed inset-0 hidden items-center justify-center bg-slate-950/75 backdrop-blur-xs p-2 sm:p-4 transition-all duration-300" style="z-index: 99999; font-family: 'Inter', sans-serif;">
    <div class="bg-white w-full max-w-2xl rounded-2xl shadow-2xl flex flex-col border border-[#E5D5B8] overflow-hidden max-h-[92vh]">
        <header class="p-4 sm:p-5 border-b border-slate-200 bg-gradient-to-r from-[#FAF8F5] via-white to-[#FAF8F5] flex items-center justify-between shrink-0">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#B89758] to-[#8C6D32] flex items-center justify-center text-white shadow-md">
                    <i class="fa-solid fa-calendar-plus text-base"></i>
                </div>
                <div>
                    <h3 class="font-serif font-bold text-base sm:text-lg text-slate-900">
                        Tạo Mới Đơn Đặt Tiệc Cưới
                    </h3>
                    <p class="text-[11px] text-slate-500">Điền thông tin để khởi tạo hợp đồng đặt tiệc</p>
                </div>
            </div>
