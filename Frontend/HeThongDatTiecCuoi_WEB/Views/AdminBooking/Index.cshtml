@model HeThongDatTiecCuoi_WEB.Models.AdminBooking.BookingListResponseViewModel
@{
    ViewData["Title"] = "Quản Lý Đặt Tiệc & Hợp Đồng";
    Layout = "_AdminLayout";
}

<!-- Font dùng chung được nạp bởi _AdminLayout. -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.tailwindcss.com"></script>
<!-- Thêm SheetJS để xuất Excel -->
<script src="https://cdn.sheetjs.com/xlsx-0.20.0/package/dist/xlsx.full.min.js"></script>

<script>
    tailwind.config = {
        theme: {
            extend: {
                colors: {
                    brand: {
                        gold: '#B89758',
                        goldLight: '#E8D8B6',
                        goldHover: '#8C6D32',
                        darkNavy: '#111822',
                        sidebar: '#141E28',
                        surface: '#FFFFFF',
                        canvas: '#F8F9FA',
                        border: '#E2E8F0'
                    }
                },
                fontFamily: {
                    serif: ['"Playfair Display"', 'Georgia', 'serif'],
                    sans: ['"Plus Jakarta Sans"', '-apple-system', 'BlinkMacSystemFont', 'sans-serif']
                }
            }
        }
    }
</script>

<style>
    .booking-page-wrapper {
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #1E293B;
    }

        .booking-page-wrapper .font-serif {
            font-family: 'Playfair Display', serif;
        }

    .card-shadow {
        box-shadow: 0 4px 20px -2px rgba(30, 41, 59, 0.05), 0 2px 6px -1px rgba(30, 41, 59, 0.02);
    }

    .focus-ring:focus-visible {
        outline: 2px solid #B89758;
        outline-offset: 2px;
    }

    .custom-scrollbar::-webkit-scrollbar {
        height: 8px;
        width: 8px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: #F1F5F9;
        border-radius: 4px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #CBD5E1;
        border-radius: 4px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #B89758;
        }

    /* Trạng thái tab */
    .status-tab-btn {
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .status-tab-btn:hover {
            transform: translateY(-1px);
        }

    /* Booking row hover */
    .booking-row {
        transition: all 0.15s ease;
    }

        .booking-row:hover {
            background-color: #FAF8F5;
            box-shadow: inset 3px 0 0 #B89758;
        }

    /* Avatar khách hàng */
    .customer-avatar {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: linear-gradient(135deg, #B89758 0%, #8C6D32 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 12px;
        flex-shrink: 0;
    }
</style>

<!-- TOAST THÔNG BÁO TỰ ĐỘNG -->
<div id="bookingToast" class="fixed top-5 right-5 z-[999999] transform translate-x-full transition-transform duration-300 flex items-center gap-3 bg-white border border-[#E5D5B8] shadow-2xl px-4 py-3 rounded-xl">
    <div class="w-7 h-7 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs" id="toastIcon">
        <i class="fa-solid fa-circle-check"></i>
    </div>
    <div>
        <p class="text-xs font-bold text-slate-900" id="toastTitle">Thông báo</p>
        <p class="text-[11px] text-slate-500" id="toastMsg">Nội dung</p>
    </div>
</div>

<!-- CONTAINER CHÍNH: Căn chỉnh padding và căn giữa đồng bộ với các trang khác -->
<div class="booking-page-wrapper p-6 lg:p-8 space-y-6 w-full max-w-[1600px] mx-auto">

    <!-- ================= 1. HEADER TRANG ================= -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500 mb-1">
                <span>Quản trị hệ thống</span>
                <i class="fa-solid fa-chevron-right text-[9px] text-slate-400"></i>
                <span class="text-[#B89758] font-semibold">Hợp Đồng &amp; Đặt Tiệc</span>
            </nav>
            <h2 class="font-serif text-2xl font-bold text-slate-900 tracking-tight">
                Quản Lý Đặt Tiệc Cưới &amp; Hợp Đồng Đặt Cọc
            </h2>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
            <div class="flex items-center bg-slate-50 rounded-lg px-3 py-1.5 border border-slate-200 text-xs shadow-2xs">
                <span class="w-2 h-2 rounded-full bg-emerald-500 mr-2 animate-pulse"></span>
                <span class="text-slate-600 font-medium">CSDL thời gian thực • Niên độ 2026</span>
            </div>

            <button type="button" onclick="exportBookingsExcel()" class="flex items-center gap-2 px-3.5 py-2 bg-slate-50 hover:bg-slate-100 text-slate-700 rounded-lg text-xs font-semibold transition-colors border border-slate-200 focus-ring min-h-[40px] shadow-2xs cursor-pointer">
                <i class="fa-solid fa-file-excel text-emerald-600 text-sm"></i>
                <span>Xuất Excel</span>
            </button>

            <button type="button" onclick="openCreateBookingModal()" class="flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-[#B89758] to-[#9E7E3F] hover:from-[#A8884A] hover:to-[#8E7035] text-white rounded-lg text-xs font-bold transition-all shadow-sm min-h-[40px] cursor-pointer">
                <i class="fa-solid fa-plus text-xs"></i>
                <span>Tạo Đơn Đặt Tiệc Mới</span>
            </button>
        </div>
    </div>

    <!-- ================= 2. TABS TRẠNG THÁI NHANH (Segmented Control) ================= -->
    <div class="bg-white rounded-xl border border-slate-200 card-shadow p-1.5">
        <div class="flex items-center gap-1 overflow-x-auto custom-scrollbar">
            <button type="button" onclick="filterByStatus(event, 'ALL')" class="status-tab-btn active px-3.5 py-2 rounded-lg font-bold border-0 transition-all bg-[#1E293B] text-white shrink-0 text-xs flex items-center gap-1.5">
                <i class="fa-solid fa-list-ul text-[10px]"></i>
                <span>Tất cả</span>
                <span class="px-1.5 py-0.5 rounded text-[10px] bg-white/20 font-bold" id="countTotal">@Model.TotalCount</span>
            </button>
            <button type="button" onclick="filterByStatus(event, 'Chờ xác nhận')" class="status-tab-btn px-3.5 py-2 rounded-lg font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700 shrink-0 text-xs flex items-center gap-1.5">
                <i class="fa-regular fa-clock text-[10px]"></i>
                <span>Chờ xác nhận</span>
                <span class="px-1.5 py-0.5 rounded text-[10px] bg-blue-100 text-blue-700 font-bold" id="countPending">@Model.PendingConfirmationCount</span>
            </button>
            <button type="button" onclick="filterByStatus(event, 'Đã xác nhận')" class="status-tab-btn px-3.5 py-2 rounded-lg font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 shrink-0 text-xs flex items-center gap-1.5">
                <i class="fa-solid fa-check-double text-[10px]"></i>
                <span>Đã xác nhận</span>
                <span class="px-1.5 py-0.5 rounded text-[10px] bg-indigo-100 text-indigo-700 font-bold" id="countConfirmed">@Model.ConfirmedCount</span>
            </button>
            <button type="button" onclick="filterByStatus(event, 'Đã cọc')" class="status-tab-btn px-3.5 py-2 rounded-lg font-semibold text-slate-700 hover:bg-amber-50 hover:text-amber-700 shrink-0 text-xs flex items-center gap-1.5">
                <i class="fa-solid fa-hand-holding-dollar text-[10px]"></i>
                <span>Đã cọc</span>
                <span class="px-1.5 py-0.5 rounded text-[10px] bg-amber-100 text-amber-800 font-bold" id="countDeposited">@Model.DepositedCount</span>
            </button>
            <button type="button" onclick="filterByStatus(event, 'Hoàn tất')" class="status-tab-btn px-3.5 py-2 rounded-lg font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 shrink-0 text-xs flex items-center gap-1.5">
                <i class="fa-solid fa-circle-check text-[10px]"></i>
                <span>Hoàn tất</span>
                <span class="px-1.5 py-0.5 rounded text-[10px] bg-emerald-100 text-emerald-700 font-bold" id="countCompleted">@Model.CompletedCount</span>
            </button>
            <button type="button" onclick="filterByStatus(event, 'Đã hủy')" class="status-tab-btn px-3.5 py-2 rounded-lg font-semibold text-slate-700 hover:bg-rose-50 hover:text-rose-700 shrink-0 text-xs flex items-center gap-1.5">
                <i class="fa-solid fa-ban text-[10px]"></i>
                <span>Đã hủy</span>
                <span class="px-1.5 py-0.5 rounded text-[10px] bg-rose-100 text-rose-700 font-bold" id="countCancelled">@Model.CancelledCount</span>
            </button>
        </div>
    </div>

    <!-- ================= 3. BỘ LỌC TÌM KIẾM ================= -->
    <section class="bg-white rounded-xl p-4 border border-slate-200 card-shadow flex flex-col md:flex-row flex-wrap items-stretch md:items-center justify-between gap-3">
        <div class="flex-1 flex flex-wrap items-center gap-3">
            <!-- Tìm kiếm từ khóa -->
            <div class="relative min-w-[240px] flex-1 max-w-md">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" id="filterKeyword" placeholder="Tìm theo mã tiệc, tên khách, SĐT..." onkeydown="if(event.key==='Enter') executeFilter(1)" class="w-full pl-9 pr-3.5 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-[#B89758] focus:bg-white focus:ring-1 focus:ring-[#B89758] min-h-[42px] transition-all">
            </div>

            <!-- Lọc theo sảnh -->
            <div class="flex items-center bg-slate-50 border border-slate-200 rounded-lg px-3 py-1 min-h-[42px] min-w-[200px]">
                <i class="fa-solid fa-building-columns text-slate-500 mr-2 text-xs"></i>
                <label for="filterHallId" class="text-xs text-slate-500 mr-1.5 whitespace-nowrap font-medium">Sảnh:</label>
                <select id="filterHallId" onchange="executeFilter(1)" class="w-full bg-transparent text-xs font-semibold text-slate-800 focus:outline-none cursor-pointer pr-1">
                    <option value="0">Tất cả đại sảnh</option>
                    <option value="1">Sảnh Amur</option>
                    <option value="2">Sảnh Elbe</option>
                    <option value="3">Sảnh Danube</option>
                    <option value="4">Sảnh Seine</option>
                    <option value="5">Sảnh Thames</option>
                    <option value="6">Sảnh Volga</option>
                    <option value="7">Sảnh Green Riverside</option>
                    <option value="8">Sảnh Nile</option>
                    <option value="9">Sảnh Grand Ballroom</option>
                </select>
            </div>

            <!-- Lọc theo khoảng ngày -->
            <div class="flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 min-h-[42px] text-xs">
                <i class="fa-regular fa-calendar text-slate-500 text-xs"></i>
                <span class="text-slate-500 font-medium">Từ:</span>
                <input type="date" id="filterFromDate" class="bg-transparent text-xs text-slate-800 focus:outline-none cursor-pointer">
                <span class="text-slate-300">|</span>
                <span class="text-slate-500 font-medium">Đến:</span>
                <input type="date" id="filterToDate" class="bg-transparent text-xs text-slate-800 focus:outline-none cursor-pointer">
            </div>

            <button type="button" onclick="executeFilter(1)" class="px-4 py-2 bg-[#1E293B] hover:bg-[#0F172A] text-white rounded-lg text-xs font-bold transition-colors cursor-pointer min-h-[42px] flex items-center gap-1.5">
                <i class="fa-solid fa-filter text-[11px]"></i>
                <span>Lọc dữ liệu</span>
            </button>
            <button type="button" onclick="resetFilters()" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg text-xs font-semibold transition-colors cursor-pointer min-h-[42px]" title="Đặt lại bộ lọc">
                <i class="fa-solid fa-arrow-rotate-left"></i>
            </button>
        </div>
    </section>

    <!-- ================= 4. BẢNG DANH SÁCH ĐẶT TIỆC ================= -->
    <div class="bg-white rounded-xl border border-slate-200 card-shadow overflow-hidden">
        <div class="overflow-x-auto custom-scrollbar">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-[#FAF8F5] text-slate-700 border-b border-slate-200 font-semibold uppercase text-[10.5px] tracking-wider">
                        <th class="py-3.5 px-4">Mã Tiệc</th>
                        <th class="py-3.5 px-4">Khách Hàng</th>
                        <th class="py-3.5 px-4">Đại Sảnh &amp; Ca</th>
                        <th class="py-3.5 px-3 text-center">Ngày Tổ Chức</th>
                        <th class="py-3.5 px-3 text-center">Quy Mô</th>
                        <th class="py-3.5 px-4 text-right">Tổng Dự Kiến</th>
                        <th class="py-3.5 px-3 text-center">Trạng Thái</th>
                        <th class="py-3.5 px-4 text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="bookingsTbody" class="divide-y divide-slate-100">
                    @if (Model.Items != null && Model.Items.Count > 0)
                    {
                        foreach (var b in Model.Items)
                        {
                            var initial = !string.IsNullOrEmpty(b.CustomerName) ? b.CustomerName.Substring(0, 1).ToUpper() : "?";
                            <tr class="booking-row">
                                <td class="py-3.5 px-4 font-mono font-bold text-[#8C6D32]">@b.BookingCode</td>
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-2.5">
                                        <div class="customer-avatar">@initial</div>
                                        <div class="min-w-0">
                                            <p class="font-bold text-slate-900 truncate">@b.CustomerName</p>
                                            <p class="text-[11px] text-slate-500 flex items-center gap-1">
                                                <i class="fa-solid fa-phone text-[9px]"></i>
                                                @b.CustomerPhone
                                            </p>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    <p class="font-semibold text-slate-800 flex items-center gap-1.5">
                                        <i class="fa-solid fa-hotel text-[10px] text-[#B89758]"></i>
                                        @b.HallName
                                    </p>
                                    <span class="inline-block mt-0.5 px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-600">
                                        @if (b.Shift == "Ca tối")
                                        {
                                            <i class="fa-regular fa-moon text-indigo-500 mr-1"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-regular fa-sun text-amber-500 mr-1"></i>
                                        }
                                        @b.Shift
                                    </span>
                                </td>
                                <td class="py-3.5 px-3 text-center font-medium text-slate-700">
                                    <div class="flex flex-col items-center">
                                        <span class="font-bold">@b.EventDate.ToString("dd")</span>
                                        <span class="text-[10px] text-slate-500">Tháng @b.EventDate.ToString("MM/yyyy")</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-3 text-center">
                                    <span class="font-bold text-slate-800">@b.TableCount</span>
                                    <span class="text-[10px] text-slate-500 ml-0.5">bàn</span>
                                </td>
                                <td class="py-3.5 px-4 text-right font-serif font-bold text-slate-900">
                                    @b.EstimatedTotal.ToString("N0") <span class="text-[10px] font-sans text-slate-500 font-normal">đ</span>
                                </td>
                                <td class="py-3.5 px-3 text-center">
                                    @if (b.Status == "Hoàn tất")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-300">
                                            <i class="fa-solid fa-circle-check text-[9px]"></i> Hoàn tất
                                        </span>
                                    }
                                    else if (b.Status == "Đã cọc")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-amber-50 text-amber-800 border border-amber-300">
                                            <i class="fa-solid fa-hand-holding-dollar text-[9px]"></i> Đã cọc
                                        </span>
                                    }
                                    else if (b.Status == "Đã xác nhận")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                                            <i class="fa-solid fa-check-double text-[9px]"></i> Đã xác nhận
                                        </span>
                                    }
                                    else if (b.Status == "Đã hủy")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                            <i class="fa-solid fa-ban text-[9px]"></i> Đã hủy
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-blue-50 text-blue-700 border border-blue-200">
                                            <i class="fa-regular fa-clock text-[9px]"></i> Chờ xác nhận
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    <div class="inline-flex items-center gap-1.5">
                                        <button type="button" onclick="viewBookingDetail(@b.BookingId)" class="h-[32px] w-[32px] rounded-lg bg-slate-100 hover:bg-[#B89758]/15 text-[#8C6D32] hover:text-[#B89758] transition-colors flex items-center justify-center" title="Xem hợp đồng chi tiết">
                                            <i class="fa-solid fa-file-contract text-sm"></i>
                                        </button>
                                        @if (b.Status == "Chờ xác nhận")
                                        {
                                            <button type="button" onclick="quickUpdateStatus(@b.BookingId, 'Đã xác nhận')" class="h-[32px] w-[32px] rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-600 transition-colors flex items-center justify-center" title="Xác nhận đơn tiệc">
                                                <i class="fa-solid fa-check text-sm"></i>
                                            </button>
                                        }
                                        else if (b.Status == "Đã xác nhận")
                                        {
                                            <button type="button" onclick="quickDepositModal(@b.BookingId, @b.EstimatedTotal)" class="h-[32px] w-[32px] rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-600 transition-colors flex items-center justify-center" title="Xác nhận đặt cọc">
                                                <i class="fa-solid fa-hand-holding-dollar text-sm"></i>
                                            </button>
                                        }
                                        @if (b.Status != "Đã hủy" && b.Status != "Hoàn tất")
                                        {
                                            <button type="button" onclick="cancelBookingPrompt(@b.BookingId)" class="h-[32px] w-[32px] rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-500 transition-colors flex items-center justify-center" title="Hủy đơn tiệc">
                                                <i class="fa-solid fa-ban text-sm"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="py-10 text-center text-slate-400 italic">
                                <i class="fa-regular fa-folder-open text-3xl mb-2 text-slate-300 block"></i>
                                Chưa có đơn đặt tiệc nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang -->
        <div class="p-4 bg-[#FAF8F5] border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
            <div>
                Hiển thị <span id="pageInfoStart" class="font-bold text-slate-800">1</span> – <span id="pageInfoEnd" class="font-bold text-slate-800">@(Model.Items?.Count ?? 0)</span> trên tổng số <strong id="pageInfoTotal" class="text-slate-800">@Model.TotalCount</strong> hợp đồng
            </div>
            <div class="flex items-center gap-1.5" id="paginationWrapper">
                <!-- Nút phân trang render qua JS -->
            </div>
        </div>
    </div>

</div>

<!-- ================= MODAL CHI TIẾT HỢP ĐỒNG & THANH TOÁN ================= -->
<div id="bookingDetailModal" class="fixed inset-0 hidden items-center justify-center bg-slate-950/75 backdrop-blur-xs p-2 sm:p-4 md:p-6 transition-all duration-300" style="z-index: 99999; font-family: 'Plus Jakarta Sans', sans-serif;">
    <div class="bg-white w-full max-w-4xl max-h-[92vh] rounded-2xl shadow-2xl flex flex-col border border-[#E5D5B8] overflow-hidden">

        <!-- Header Modal -->
        <header class="p-4 sm:p-5 border-b border-slate-200 bg-gradient-to-r from-[#FAF8F5] via-white to-[#FAF8F5] flex items-center justify-between shrink-0">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#B89758] to-[#8C6D32] flex items-center justify-center text-white shadow-md">
                    <i class="fa-solid fa-file-invoice-dollar text-base"></i>
                </div>
                <div>
                    <h3 class="font-serif font-bold text-base sm:text-lg text-slate-900 flex items-center gap-2">
                        <span>Hồ Sơ Đặt Tiệc:</span>
                        <span id="mdBookingCode" class="font-mono text-[#8C6D32]">DT-XXXX</span>
                    </h3>
                    <p class="text-[11px] text-slate-500">Chi tiết dịch vụ, thực đơn &amp; tiến độ đặt cọc</p>
                </div>
            </div>
            <button type="button" onclick="closeDetailModal()" class="w-9 h-9 flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-200/70 rounded-lg transition-colors">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </header>

        <!-- Thân Modal -->
        <div class="flex-1 overflow-y-auto custom-scrollbar p-5 space-y-5">

            <!-- Thông tin khách hàng & Tiệc cưới -->
