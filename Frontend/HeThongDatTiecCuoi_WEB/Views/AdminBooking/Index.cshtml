                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </header>

        <form id="createBookingForm" onsubmit="handleCreateBooking(event)" class="flex-1 overflow-y-auto custom-scrollbar p-5 space-y-5 text-xs">

            <!-- Section 1: Thông tin khách hàng -->
            <div class="bg-slate-50/60 rounded-xl p-4 border border-slate-200/70">
                <h4 class="font-bold text-xs text-slate-700 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                    <i class="fa-solid fa-user text-[#B89758]"></i> Thông Tin Khách Hàng
                </h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Họ và tên <span class="text-rose-500">*</span></label>
                        <input type="text" id="newCustomerName" required maxlength="150" placeholder="Nguyễn Văn An" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg focus:outline-none focus:border-[#B89758] focus:ring-1 focus:ring-[#B89758]">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Số điện thoại <span class="text-rose-500">*</span></label>
                        <input type="tel" id="newPhoneNumber" required maxlength="20" placeholder="0901234567" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg focus:outline-none focus:border-[#B89758] focus:ring-1 focus:ring-[#B89758]">
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block font-semibold text-slate-700 mb-1">Email</label>
                        <input type="email" id="newEmail" maxlength="255" placeholder="khachhang@example.com" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg focus:outline-none focus:border-[#B89758] focus:ring-1 focus:ring-[#B89758]">
                    </div>
                </div>
            </div>

            <!-- Section 2: Thông tin tiệc -->
            <div class="bg-slate-50/60 rounded-xl p-4 border border-slate-200/70">
                <h4 class="font-bold text-xs text-slate-700 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                    <i class="fa-solid fa-calendar-check text-[#B89758]"></i> Thông Tin Tiệc Cưới
                </h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <div class="sm:col-span-2">
                        <label class="block font-semibold text-slate-700 mb-1">Đại Sảnh Tổ Chức <span class="text-rose-500">*</span></label>
                        <select id="newHallId" required class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg focus:outline-none focus:border-[#B89758] focus:ring-1 focus:ring-[#B89758] cursor-pointer">
                            <option value="">Chọn ngày để tải sảnh còn trống</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Ngày Tổ Chức Tiệc <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <input type="text" id="newEventDateFormatted" readonly aria-hidden="true" class="w-full px-3 py-2 pr-10 bg-white border border-slate-200 rounded-lg text-slate-800 pointer-events-none">
                            <i class="fa-regular fa-calendar absolute right-3 top-1/2 -translate-y-1/2 text-slate-700 pointer-events-none"></i>
                            <input type="date" id="newEventDate" lang="vi-VN" required aria-label="Ngày tổ chức tiệc" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
                        </div>
                        <small id="newEventDateDisplay" class="block mt-1 text-slate-500">Định dạng: ngày/tháng/năm</small>
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Ca Tổ Chức <span class="text-rose-500">*</span></label>
                        <select id="newShift" required class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg focus:outline-none focus:border-[#B89758] focus:ring-1 focus:ring-[#B89758] cursor-pointer">
                            <option value="Ca tối" selected>Ca tối (17:30 – 21:30)</option>
                            <option value="Ca trưa">Ca trưa (10:30 – 14:00)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Số Lượng Bàn Tiệc <span class="text-rose-500">*</span></label>
                        <input type="number" id="newTableCount" required min="1" max="300" value="25" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg focus:outline-none focus:border-[#B89758] focus:ring-1 focus:ring-[#B89758]">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Bàn dự phòng</label>
                        <input type="number" id="newSpareTableCount" required min="0" max="50" value="2" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg focus:outline-none focus:border-[#B89758] focus:ring-1 focus:ring-[#B89758]">
                    </div>
                </div>
            </div>

            <div class="bg-slate-50/60 rounded-xl p-4 border border-slate-200/70">
                <h4 class="font-bold text-xs text-slate-700 uppercase tracking-wider mb-3"><i class="fa-solid fa-utensils text-[#B89758]"></i> Thực đơn &amp; trang trí</h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <div><label class="block font-semibold text-slate-700 mb-1">Thực đơn</label><select id="newMenuId" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg"><option value="">Chưa chọn thực đơn</option></select></div>
                    <div><label class="block font-semibold text-slate-700 mb-1">Gói trang trí</label><select id="newDecorationPackageId" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg"><option value="">Chưa chọn trang trí</option></select></div>
                    <div class="sm:col-span-2"><label class="block font-semibold text-slate-700 mb-1">Phong cách mong muốn</label><input id="newDesiredStyle" maxlength="150" placeholder="Sang trọng, tối giản, rustic..." class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg"></div>
                </div>
            </div>

            <div class="bg-slate-50/60 rounded-xl p-4 border border-slate-200/70">
                <h4 class="font-bold text-xs text-slate-700 uppercase tracking-wider mb-3"><i class="fa-solid fa-bell-concierge text-[#B89758]"></i> Dịch vụ đi kèm</h4>
                <div id="newServices" class="grid grid-cols-1 sm:grid-cols-2 gap-2"><span class="text-slate-400">Đang tải dịch vụ...</span></div>
            </div>

            <!-- Section 3: Ghi chú -->
            <div class="bg-slate-50/60 rounded-xl p-4 border border-slate-200/70">
                <h4 class="font-bold text-xs text-slate-700 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                    <i class="fa-solid fa-pen-to-square text-[#B89758]"></i> Ghi Chú Đặc Biệt
                </h4>
                <textarea id="newSpecialRequests" rows="3" placeholder="Ghi chú hoa trang trí, thời gian đón khách, yêu cầu đặc biệt..." class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg focus:outline-none focus:border-[#B89758] focus:ring-1 focus:ring-[#B89758] resize-none"></textarea>
                <div class="mt-3 rounded-lg bg-white border border-[#E5D5B8] p-3 flex justify-between"><span class="font-semibold text-slate-600">Tổng dự toán</span><strong id="newEstimatedTotal" class="text-[#8C6D32]">0 ₫</strong></div>
            </div>

        </form>

        <footer class="p-4 bg-slate-50 border-t border-slate-200 flex items-center justify-end gap-2.5 shrink-0">
            <button type="button" onclick="closeCreateBookingModal()" class="px-4 py-2 bg-white hover:bg-slate-100 text-slate-700 rounded-lg font-semibold border border-slate-200 cursor-pointer transition-colors">
                Hủy bỏ
            </button>
            <button type="submit" id="createBookingSubmit" form="createBookingForm" class="min-h-[40px] px-4 bg-[#102B43] hover:bg-[#0B2034] text-white rounded-[9px] font-semibold shadow-[0_6px_16px_rgba(16,43,67,0.16)] cursor-pointer transition-all inline-flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed">
                <i class="fa-solid fa-floppy-disk text-xs"></i>
                Lưu đơn đặt tiệc
            </button>
        </footer>
    </div>
</div>

@section Scripts {
    <script>
        let currentFilter = {
            keyword: '',
            status: 'ALL',
            hallId: 0,
            fromDate: null,
            toDate: null,
            pageIndex: 1,
            pageSize: 10
        };

        let selectedBookingId = null;
        let selectedReviewUrl = '';
        let selectedReviewQrImage = '';
        let createBookingOptions = null;
        let currentBookings = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items ?? new List<HeThongDatTiecCuoi_WEB.Models.AdminBooking.BookingSummaryViewModel>()));
        const canManageContracts = document.querySelector('.booking-page-wrapper')?.dataset.canManageContracts === 'true';

        document.addEventListener('DOMContentLoaded', () => {
            setMinimumBookingDate();
            document.getElementById('newEventDate').addEventListener('change', loadCreateBookingOptions);
            document.getElementById('newShift').addEventListener('change', renderAvailableHalls);
            ['newHallId','newMenuId','newDecorationPackageId','newTableCount','newSpareTableCount'].forEach(id =>
                document.getElementById(id).addEventListener('change', updateCreateEstimate));

            // Thoát stacking context cho các Modal
            const detailModal = document.getElementById('bookingDetailModal');
            const createModal = document.getElementById('createBookingModal');
            if (detailModal && detailModal.parentElement !== document.body) document.body.appendChild(detailModal);
            if (createModal && createModal.parentElement !== document.body) document.body.appendChild(createModal);

            // Render phân trang lần đầu
            renderPagination(@Model.TotalCount, 1, 10);
        });

        document.addEventListener('toggle', event => {
            if (!event.target.classList?.contains('booking-action-popover')) return;
            const trigger = document.querySelector(`[aria-controls="${event.target.id}"]`);
            if (trigger) trigger.setAttribute('aria-expanded', event.newState === 'open' ? 'true' : 'false');
        }, true);

        window.addEventListener('resize', closeBookingActions);
        window.addEventListener('scroll', closeBookingActions, true);

        function closeBookingActions(exceptMenu = null) {
            document.querySelectorAll('.booking-action-popover:popover-open').forEach(menu => {
                if (menu !== exceptMenu) menu.hidePopover();
            });
        }

        function toggleBookingActions(event, menuId) {
            event.preventDefault();
            event.stopPropagation();

            const trigger = event.currentTarget;
            const menu = document.getElementById(menuId);
            if (!menu) return;

            const isOpen = menu.matches(':popover-open');
            closeBookingActions(menu);
            if (isOpen) {
                menu.hidePopover();
                return;
            }

            menu.showPopover();
            const triggerRect = trigger.getBoundingClientRect();
            const menuRect = menu.getBoundingClientRect();
            const edgeGap = 12;
            const left = Math.max(edgeGap, Math.min(window.innerWidth - menuRect.width - edgeGap, triggerRect.right - menuRect.width));
            const top = triggerRect.bottom + menuRect.height + 6 <= window.innerHeight - edgeGap
                ? triggerRect.bottom + 6
                : Math.max(edgeGap, triggerRect.top - menuRect.height - 6);

            menu.style.left = `${left}px`;
            menu.style.top = `${top}px`;
        }

        function showToast(title, msg, isSuccess = true) {
            if (isSuccess) window.RiversideToast?.success(msg, { title });
            else window.RiversideToast?.error(msg, { title });
        }

        function escapeHtml(value) {
            const element = document.createElement('div');
            element.textContent = value == null ? '' : String(value);
            return element.innerHTML;
        }

        function formatNumber(value) {
            const number = Number(value || 0);
            return Number.isFinite(number) ? new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 0 }).format(number) : '0';
        }

        function toInputDate(date) {
            return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
        }

        function minimumBookingDate() {
            const now = new Date();
            const lastDayNextMonth = new Date(now.getFullYear(), now.getMonth() + 2, 0).getDate();
            return new Date(now.getFullYear(), now.getMonth() + 1, Math.min(now.getDate(), lastDayNextMonth));
        }

        function displayVietnameseDate(value) {
            if (!value) return '';
            const [year, month, day] = value.split('-');
            return `${day}/${month}/${year}`;
        }

        function setMinimumBookingDate() {
            const input = document.getElementById('newEventDate');
            const minimum = toInputDate(minimumBookingDate());
            input.min = minimum;
            input.value = minimum;
            document.getElementById('newEventDateFormatted').value = displayVietnameseDate(minimum);
            document.getElementById('newEventDateDisplay').textContent = `Ngày đã chọn: ${displayVietnameseDate(minimum)} (tối thiểu trước 1 tháng)`;
        }

        // ================= 1. XỬ LÝ LỌC & PHÂN TRANG =================
        function filterByStatus(event, status) {
            currentFilter.status = status;

            // Reset tất cả nút
            document.querySelectorAll('.status-tab-btn').forEach(btn => {
                btn.classList.remove('active', 'bg-[#1E293B]', 'text-white');
                btn.classList.add('text-slate-700', 'hover:bg-slate-50');
            });

            // Active nút được chọn
            event.currentTarget.classList.add('active', 'bg-[#1E293B]', 'text-white');
            event.currentTarget.classList.remove('text-slate-700', 'hover:bg-slate-50');

            executeFilter(1);
        }

        function resetFilters() {
            document.getElementById('filterKeyword').value = '';
            document.getElementById('filterHallId').value = '0';
            document.getElementById('filterFromDate').value = '';
            document.getElementById('filterToDate').value = '';
            currentFilter = { keyword: '', status: 'ALL', hallId: 0, fromDate: null, toDate: null, pageIndex: 1, pageSize: 10 };
            executeFilter(1);
        }

        async function executeFilter(page = 1) {
            currentFilter.pageIndex = page;
            currentFilter.keyword = document.getElementById('filterKeyword').value.trim();
            currentFilter.hallId = parseInt(document.getElementById('filterHallId').value) || 0;
            currentFilter.fromDate = document.getElementById('filterFromDate').value || null;
            currentFilter.toDate = document.getElementById('filterToDate').value || null;

            const params = new URLSearchParams();
            params.append('pageIndex', currentFilter.pageIndex);
            params.append('pageSize', currentFilter.pageSize);
            if (currentFilter.keyword) params.append('keyword', currentFilter.keyword);
            if (currentFilter.status && currentFilter.status !== 'ALL') params.append('status', currentFilter.status);
            if (currentFilter.hallId > 0) params.append('hallId', currentFilter.hallId);
            if (currentFilter.fromDate) params.append('fromDate', currentFilter.fromDate);
            if (currentFilter.toDate) params.append('toDate', currentFilter.toDate);

            try {
                const res = await fetch(`/AdminBooking/GetBookingsData?${params.toString()}`);
                const result = await res.json();

                if (result.success && result.data) {
                    renderBookingsTable(result.data);
                } else {
                    showToast('Lỗi', result.message || 'Không thể tải danh sách đặt tiệc.', false);
                }
            } catch (e) {
                console.error(e);
                showToast('Lỗi kết nối', 'Không thể kết nối máy chủ.', false);
            }
        }

        function renderBookingsTable(data) {
            const tbody = document.getElementById('bookingsTbody');
            tbody.innerHTML = '';
            const items = data.items || data.Items || [];
            currentBookings = items;

            // Cập nhật số liệu tabs
            document.getElementById('countTotal').innerText = data.totalCount ?? data.TotalCount ?? 0;
            document.getElementById('countPending').innerText = data.pendingCount ?? data.pendingConfirmationCount ?? data.PendingCount ?? data.PendingConfirmationCount ?? 0;
            document.getElementById('countConfirmed').innerText = data.confirmedCount ?? data.ConfirmedCount ?? 0;
            document.getElementById('countDeposited').innerText = data.preparingCount ?? data.depositedCount ?? data.PreparingCount ?? data.DepositedCount ?? 0;
            document.getElementById('countCompleted').innerText = data.completedCount ?? data.CompletedCount ?? 0;
            document.getElementById('countCancelled').innerText = data.cancelledCount ?? data.CancelledCount ?? 0;

            if (items.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="py-10 text-center text-slate-400 italic"><i class="fa-regular fa-folder-open text-3xl mb-2 text-slate-300 block"></i>Không tìm thấy đơn đặt tiệc nào.</td></tr>`;
                renderPagination(0, 1, 10);
                return;
            }

            items.forEach(b => {
                const id = b.bookingId || b.BookingId;
                const code = b.bookingCode || b.BookingCode;
                const custName = b.customerName || b.CustomerName || '';
                const phone = b.customerPhone || b.CustomerPhone || '';
                const hall = b.hallName || b.HallName;
                const shift = b.shift || b.Shift;
                const eventDate = new Date(b.eventDate || b.EventDate);
                const day = String(eventDate.getDate()).padStart(2, '0');
                const monthYear = String(eventDate.getMonth() + 1).padStart(2, '0') + '/' + eventDate.getFullYear();
                const tables = b.tableCount ?? b.TableCount ?? 0;
                const total = Number(b.estimatedTotal ?? b.EstimatedTotal ?? 0).toLocaleString('vi-VN');
                const status = b.statusName || b.StatusName || b.status || b.Status || 'Chưa xác định';
                const statusCode = b.statusCode || b.StatusCode || '';
                const hasContract = b.hasContract ?? b.HasContract ?? false;
                const contractId = b.contractId ?? b.ContractId;
                const contractCode = b.contractCode || b.ContractCode || '';
                const initial = custName ? custName.substring(0, 1).toUpperCase() : '?';
                const safeCode = escapeHtml(code);
                const safeCustomerName = escapeHtml(custName);
                const safePhone = escapeHtml(phone);
                const safeHall = escapeHtml(hall);
                const safeShift = escapeHtml(shift);
                const safeInitial = escapeHtml(initial);
                const safeContractCode = escapeHtml(contractCode);

                let badge = `<span class="booking-status booking-status--pending">Chờ xác nhận</span>`;
                if (statusCode === 'COMPLETED') badge = `<span class="booking-status booking-status--completed">Hoàn tất</span>`;
                else if (statusCode === 'PREPARING') badge = `<span class="booking-status booking-status--preparing">Đang chuẩn bị</span>`;
                else if (statusCode === 'CONFIRMED') badge = `<span class="booking-status booking-status--confirmed">Đã xác nhận</span>`;
                else if (statusCode === 'CANCELLED') badge = `<span class="booking-status booking-status--cancelled">Đã hủy</span>`;

                let shiftIcon = shift === 'Ca tối'
                    ? '<i class="fa-regular fa-moon text-indigo-500 mr-1"></i>'
                    : '<i class="fa-regular fa-sun text-amber-500 mr-1"></i>';

                let actionBtns = `
                    <button type="button" class="booking-action-item" onclick="closeBookingActions(); viewBookingDetail(${id})" role="menuitem">
                        <i class="fa-regular fa-eye"></i><span>Xem chi tiết</span>
                    </button>
                `;
                if (canManageContracts && hasContract) {
                    actionBtns += `<a href="/quan-ly/hop-dong-thanh-toan?contractId=${Number(contractId)}" class="booking-action-item" role="menuitem"><i class="fa-solid fa-file-contract"></i><span>Xem hợp đồng</span></a>`;
                } else if (canManageContracts && statusCode === 'CONFIRMED') {
                    actionBtns += `<a href="/quan-ly/hop-dong-thanh-toan?bookingId=${id}&openCreate=true" class="booking-action-item" role="menuitem"><i class="fa-solid fa-file-circle-plus"></i><span>Tạo hợp đồng</span></a>`;
                }
                if (statusCode === 'PENDING') {
                    actionBtns += `
                        <button type="button" class="booking-action-item" onclick="closeBookingActions(); quickUpdateStatus(${id}, 'CONFIRMED')" role="menuitem"><i class="fa-solid fa-check"></i><span>Xác nhận đơn tiệc</span></button>
                    `;
                }
                if (statusCode !== 'CANCELLED' && statusCode !== 'COMPLETED') {
                    actionBtns += `
                        <button type="button" class="booking-action-item danger" onclick="closeBookingActions(); cancelBookingPrompt(${id})" role="menuitem"><i class="fa-solid fa-ban"></i><span>Hủy đơn tiệc</span></button>
                    `;
                }

                tbody.innerHTML += `
                    <tr class="booking-row">
                        <td class="py-3.5 px-4 font-mono font-bold text-[#8C6D32]">${safeCode}</td>
                        <td class="py-3.5 px-4">
                            <div class="flex items-center gap-2.5">
                                <div class="customer-avatar">${safeInitial}</div>
                                <div class="min-w-0">
                                    <p class="font-bold text-slate-900 truncate">${safeCustomerName}</p>
                                    <p class="text-[11px] text-slate-500 flex items-center gap-1">
                                        <i class="fa-solid fa-phone text-[9px]"></i>
                                        ${safePhone}
                                    </p>
                                </div>
                            </div>
                        </td>
                        <td class="py-3.5 px-4">
                            <p class="font-semibold text-slate-800 flex items-center gap-1.5">
                                <i class="fa-solid fa-hotel text-[10px] text-[#B89758]"></i>
                                ${safeHall}
                            </p>
                            <span class="inline-block mt-0.5 px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-600">
                                ${shiftIcon}${safeShift}
                            </span>
                        </td>
                        <td class="py-3.5 px-3 text-center font-medium text-slate-700">
                            <div class="flex flex-col items-center">
                                <span class="font-bold">${day}</span>
                                <span class="text-[10px] text-slate-500">Tháng ${monthYear}</span>
                            </div>
                        </td>
                        <td class="py-3.5 px-3 text-center">
                            <span class="font-bold text-slate-800">${tables}</span>
                            <span class="text-[10px] text-slate-500 ml-0.5">bàn</span>
                        </td>
                        <td class="py-3.5 px-4 text-right font-serif font-bold text-slate-900">
                            ${total} <span class="text-[10px] font-sans text-slate-500 font-normal">đ</span>
                        </td>
                        <td class="py-3.5 px-3 text-center">${badge}</td>
                        <td class="py-3.5 px-4 text-center">
                            <div class="inline-flex">
                                <button type="button" class="booking-action-trigger" onclick="toggleBookingActions(event, 'bookingActions-${id}')" aria-controls="bookingActions-${id}" aria-expanded="false" aria-label="Mở thao tác cho booking ${safeCode}" title="Thao tác"><i class="bi bi-three-dots"></i><i class="bi bi-chevron-down text-[10px]" aria-hidden="true"></i></button>
                                <div id="bookingActions-${id}" class="booking-action-popover" popover="auto" role="menu">${actionBtns}</div>
                            </div>
                        </td>
                    </tr>
                `;
            });

            // Render phân trang
            const totalCount = data.totalCount ?? data.TotalCount ?? 0;
            const pageSize = currentFilter.pageSize;
            renderPagination(totalCount, currentFilter.pageIndex, pageSize);

            // Update page info
            const start = (currentFilter.pageIndex - 1) * pageSize + 1;
            const end = Math.min(start + items.length - 1, totalCount);
            document.getElementById('pageInfoStart').innerText = items.length > 0 ? start : 0;
            document.getElementById('pageInfoEnd').innerText = end;
            document.getElementById('pageInfoTotal').innerText = totalCount;
        }

        function renderPagination(totalCount, currentPage, pageSize) {
            const wrapper = document.getElementById('paginationWrapper');
            wrapper.innerHTML = '';
            const totalPages = Math.ceil(totalCount / pageSize) || 1;

            // Nút Previous
            const prevBtn = document.createElement('button');
            prevBtn.type = 'button';
            prevBtn.className = `pagination-edge ${currentPage === 1 ? 'opacity-40 cursor-not-allowed' : 'cursor-pointer'}`;
            prevBtn.textContent = 'Trước';
            if (currentPage > 1) prevBtn.onclick = () => executeFilter(currentPage - 1);
            wrapper.appendChild(prevBtn);

            // Số trang
            const maxVisible = 5;
            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, startPage + maxVisible - 1);
            if (endPage - startPage < maxVisible - 1) startPage = Math.max(1, endPage - maxVisible + 1);

            for (let i = startPage; i <= endPage; i++) {
                const btn = document.createElement('button');
                btn.type = 'button';
                if (i === currentPage) {
                    btn.className = 'active cursor-pointer';
                } else {
                    btn.className = 'cursor-pointer';
                }
                btn.innerText = i;
                btn.onclick = () => executeFilter(i);
                wrapper.appendChild(btn);
            }

            // Nút Next
            const nextBtn = document.createElement('button');
            nextBtn.type = 'button';
            nextBtn.className = `pagination-edge ${currentPage === totalPages ? 'opacity-40 cursor-not-allowed' : 'cursor-pointer'}`;
            nextBtn.textContent = 'Sau';
            if (currentPage < totalPages) nextBtn.onclick = () => executeFilter(currentPage + 1);
            wrapper.appendChild(nextBtn);
        }

        // ================= 2. XỬ LÝ CHI TIẾT HỢP ĐỒNG & ĐẶT CỌC =================
        async function viewBookingDetail(id) {
            selectedBookingId = id;
            try {
                const res = await fetch(`/AdminBooking/GetDetail/${id}`, {
                    headers: { 'Accept': 'application/json' }
                });
                const contentType = res.headers.get('content-type') || '';

                if (!contentType.includes('application/json')) {
                    throw new Error(res.redirected
                        ? 'Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.'
                        : `Máy chủ trả về dữ liệu không hợp lệ (HTTP ${res.status}).`);
                }

                const result = await res.json();

                if (!res.ok || !result.success || !result.data) {
                    throw new Error(result.message || 'Không thể lấy thông tin chi tiết đơn tiệc.');
                }

                const b = result.data;
                    document.getElementById('mdBookingCode').innerText = b.bookingCode || b.BookingCode;
                    document.getElementById('mdCustomerName').innerText = b.customerName || b.CustomerName;
                    document.getElementById('mdCustomerPhone').innerText = b.customerPhone || b.CustomerPhone || 'Chưa có SĐT';
                    document.getElementById('mdHallAndShift').innerText = `${b.hallName || b.HallName} • ${b.shift || b.Shift}`;
                    document.getElementById('mdEventDate').innerText = new Date(b.eventDate || b.EventDate).toLocaleDateString('vi-VN');

                    const guestCount = b.guestCount ?? b.GuestCount ?? 0;
                    const tables = b.tableCount ?? b.TableCount ?? Math.ceil(Number(guestCount) / 10);
                    const menuUnit = b.finalMenuPrice ?? b.FinalMenuPrice ?? 0;
                    const hallPrice = b.finalHallPrice ?? b.FinalHallPrice ?? 0;
                    const decorPrice = b.finalDecorationPrice ?? b.FinalDecorationPrice ?? 0;
                    const total = b.estimatedTotal ?? b.EstimatedTotal ?? 0;

                    document.getElementById('mdTableCount').innerText = `${tables} bàn`;
                    document.getElementById('mdMenuUnitPrice').innerText = `${Number(menuUnit).toLocaleString('vi-VN')} đ`;
                    document.getElementById('mdMenuSubtotal').innerText = `${Number(menuUnit * tables).toLocaleString('vi-VN')} đ`;
                    document.getElementById('mdHallPrice').innerText = `${Number(hallPrice).toLocaleString('vi-VN')} đ`;
                    document.getElementById('mdHallSubtotal').innerText = `${Number(hallPrice).toLocaleString('vi-VN')} đ`;
                    document.getElementById('mdDecorPrice').innerText = `${Number(decorPrice).toLocaleString('vi-VN')} đ`;
                    document.getElementById('mdDecorSubtotal').innerText = `${Number(decorPrice).toLocaleString('vi-VN')} đ`;
                    document.getElementById('mdTotalAmount').innerText = `${Number(total).toLocaleString('vi-VN')} VNĐ`;

                    const status = b.statusName || b.StatusName || b.status || b.Status || 'Chưa xác định';
                    const statusCode = b.statusCode || b.StatusCode || '';
                    const hasContract = b.hasContract ?? b.HasContract ?? false;
                    const contractId = b.contractId ?? b.ContractId;
                    const contractCode = b.contractCode || b.ContractCode || '';
                    const detailStatusBadge = document.getElementById('mdStatusBadge');
                    detailStatusBadge.innerText = status;
                    const detailStatusClass = {
                        PENDING: 'booking-status--pending',
                        CONFIRMED: 'booking-status--confirmed',
                        PREPARING: 'booking-status--preparing',
                        COMPLETED: 'booking-status--completed',
                        CANCELLED: 'booking-status--cancelled'
                    }[statusCode] || '';
                    detailStatusBadge.className = `booking-status ${detailStatusClass}`.trim();
                    document.getElementById('mdMenuName').innerText = b.menuName || b.MenuName || 'Chưa chọn thực đơn';
                    document.getElementById('mdDecorName').innerText = b.decorationPackageName || b.DecorationPackageName || 'Chưa chọn gói trang trí';

                    const hasReviewQr = b.hasReviewQr ?? b.HasReviewQr ?? false;
                    const qrSection = document.getElementById('mdReviewQrSection');
                    qrSection.classList.toggle('hidden', !hasReviewQr);
                    selectedReviewUrl = '';
                    selectedReviewQrImage = '';
                    if (hasReviewQr) {
                        const token = b.reviewQrToken || b.ReviewQrToken;
                        selectedReviewUrl = `${window.location.origin}/danh-gia/khach-moi/${encodeURIComponent(token)}`;
                        selectedReviewQrImage = `/danh-gia/quan-ly/${id}/qr.png`;
                        document.getElementById('mdReviewQrImage').src = selectedReviewQrImage;
                        document.getElementById('mdReviewQrDownload').href = `${selectedReviewQrImage}?download=true`;
                        const state = b.reviewQrState || b.ReviewQrState || 'Pending';
                        const stateLabels = { Pending: 'Chờ kích hoạt', Active: 'Đang hoạt động', Expired: 'Hết hạn', Locked: 'Bị khóa' };
                        document.getElementById('mdReviewQrState').innerText = stateLabels[state] || state;
                        document.getElementById('mdReviewCount').innerText = b.reviewCount ?? b.ReviewCount ?? 0;
                        const opensAt = b.reviewOpensAt || b.ReviewOpensAt;
                        const expiresAt = b.reviewExpiresAt || b.ReviewExpiresAt;
                        document.getElementById('mdReviewOpensAt').innerText = opensAt ? new Date(opensAt).toLocaleString('vi-VN') : '---';
                        document.getElementById('mdReviewExpiresAt').innerText = expiresAt ? new Date(expiresAt).toLocaleString('vi-VN') : '---';
                    }

                    const btnGroup = document.getElementById('mdActionBtnGroup');
                    btnGroup.innerHTML = '';
                    if (canManageContracts && hasContract) {
                        const link = document.createElement('a');
                        link.href = `/quan-ly/hop-dong-thanh-toan?contractId=${contractId}`;
                        link.className = 'px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-bold shadow-sm transition-colors flex items-center gap-2';
                        link.textContent = 'Xem hợp đồng';
                        btnGroup.appendChild(link);
                    } else if (canManageContracts && statusCode === 'CONFIRMED') {
                        const link = document.createElement('a');
                        link.href = `/quan-ly/hop-dong-thanh-toan?bookingId=${id}&openCreate=true`;
                        link.className = 'px-4 py-2.5 bg-gradient-to-r from-[#B89758] to-[#9E7E3F] text-white rounded-lg font-bold shadow-sm transition-all flex items-center gap-2';
                        link.textContent = 'Tạo hợp đồng';
                        btnGroup.appendChild(link);
                    } else if (statusCode === 'PENDING') {
                        btnGroup.innerHTML = `<button type="button" onclick="quickUpdateStatus(${id}, 'CONFIRMED')" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-bold shadow-sm transition-colors flex items-center gap-2"><i class="fa-solid fa-check text-xs"></i>Xác nhận Booking</button>`;
                    }

                    const modal = document.getElementById('bookingDetailModal');
                    modal.classList.remove('hidden');
                    modal.classList.add('flex');
            } catch (e) {
                console.error(e);
                showToast(
                    'Lỗi',
                    e instanceof Error ? e.message : 'Không thể lấy thông tin chi tiết đơn tiệc.',
                    false
                );
            }
        }

        async function copyReviewLink() {
            if (!selectedReviewUrl) return;
            await navigator.clipboard.writeText(selectedReviewUrl);
            showToast('Đã sao chép', 'Đường dẫn đánh giá khách mời đã được sao chép.');
        }

        function printReviewQr() {
            if (!selectedReviewQrImage) return;
            const popup = window.open('', '_blank', 'width=520,height=680');
            if (!popup) return;
            const bookingCode = document.getElementById('mdBookingCode').innerText;
            const popupDocument = popup.document;
            popupDocument.title = `QR đánh giá ${bookingCode}`;
            popupDocument.body.replaceChildren();
            popupDocument.body.style.cssText = 'font-family:Arial;text-align:center;padding:40px';

            const heading = popupDocument.createElement('h2');
            heading.textContent = 'Đánh giá buổi tiệc';
            const code = popupDocument.createElement('p');
            code.textContent = bookingCode;
            const qrImage = popupDocument.createElement('img');
            qrImage.src = selectedReviewQrImage;
            qrImage.alt = `QR đánh giá ${bookingCode}`;
            qrImage.style.cssText = 'width:320px;height:320px';
            qrImage.addEventListener('load', () => {
                popup.print();
                popup.close();
            }, { once: true });

            popupDocument.body.append(heading, code, qrImage);
        }

        function closeDetailModal() {
            const modal = document.getElementById('bookingDetailModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        // ================= 3. CẬP NHẬT TRẠNG THÁI BOOKING / HỦY =================
        async function quickUpdateStatus(id, newStatus) {
            const friendlyStatus = { CONFIRMED: 'Đã xác nhận', CANCELLED: 'Đã hủy', COMPLETED: 'Hoàn tất', PREPARING: 'Đang chuẩn bị' }[newStatus] || newStatus;
            if (!confirm(`Bạn có chắc muốn chuyển trạng thái đơn tiệc sang "${friendlyStatus}"?`)) return;

            try {
                const res = await fetch(`/AdminBooking/UpdateStatus/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ statusCode: newStatus })
                });
                const result = await res.json();
                if (result.success) {
                    showToast('Thành công', result.message);
                    closeDetailModal();
                    executeFilter(currentFilter.pageIndex);
                } else {
                    showToast('Lỗi', result.message, false);
                }
            } catch (e) {
                showToast('Lỗi', 'Không thể cập nhật trạng thái.', false);
            }
        }

        function cancelBookingPrompt(id) {
            const reason = prompt("Nhập lý do hủy tiệc cưới (lịch sảnh sẽ tự động giải phóng):", "Khách hàng đổi kế hoạch");
            if (reason === null) return;

            fetch(`/AdminBooking/UpdateStatus/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ statusCode: 'CANCELLED', cancellationReason: reason })
            })
            .then(res => res.json())
            .then(result => {
                if (result.success) {
                    showToast('Đã hủy', 'Đã hủy tiệc và giải phóng lịch sảnh thành công.');
                    closeDetailModal();
                    executeFilter(currentFilter.pageIndex);
                } else {
                    showToast('Lỗi', result.message, false);
                }
            });
        }

        // ================= 4. TẠO MỚI ĐẶT TIỆC =================
        async function openCreateBookingModal() {
            document.getElementById('createBookingForm').reset();
            createBookingOptions = null;
            setMinimumBookingDate();
            document.getElementById('newEstimatedTotal').textContent = '0 ₫';
            const modal = document.getElementById('createBookingModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            await loadCreateBookingOptions();
        }

        async function loadCreateBookingOptions() {
            const date = document.getElementById('newEventDate').value;
            if (!date) return;
            const minimum = toInputDate(minimumBookingDate());
            if (date < minimum) {
                document.getElementById('newEventDate').value = minimum;
                document.getElementById('newEventDateFormatted').value = displayVietnameseDate(minimum);
                showToast('Ngày không hợp lệ', `Ngày tổ chức phải từ ${displayVietnameseDate(minimum)} trở đi.`, false);
                return loadCreateBookingOptions();
            }
            document.getElementById('newEventDateFormatted').value = displayVietnameseDate(date);
            document.getElementById('newEventDateDisplay').textContent = `Ngày đã chọn: ${displayVietnameseDate(date)} (dd/MM/yyyy)`;
            try {
                const response = await fetch(`/AdminBooking/GetCreateOptions?eventDate=${encodeURIComponent(date)}`);
                const result = await response.json();
                if (!result.success) throw new Error(result.message);
                createBookingOptions = result.data;
                const menu = document.getElementById('newMenuId');
                menu.innerHTML = '<option value="">Chưa chọn thực đơn</option>' + createBookingOptions.menus.map(x => `<option value="${x.menuId}" data-price="${x.pricePerTable}">${escapeHtml(x.menuName)} — ${formatNumber(x.pricePerTable)} ₫/bàn</option>`).join('');
                const decor = document.getElementById('newDecorationPackageId');
                decor.innerHTML = '<option value="">Chưa chọn trang trí</option>' + createBookingOptions.decorations.map(x => `<option value="${x.decorationPackageId}" data-price="${x.price}">${escapeHtml(x.packageName)} (${escapeHtml(x.style)}) — ${formatNumber(x.price)} ₫</option>`).join('');
                document.getElementById('newServices').innerHTML = createBookingOptions.services.length
                    ? createBookingOptions.services.map(x => `<label class="flex items-center gap-2 rounded-lg border bg-white p-2"><input type="checkbox" class="booking-service" value="${x.serviceId}" data-price="${x.price}"><span class="flex-1"><b>${escapeHtml(x.serviceName)}</b><small class="block text-slate-500">${formatNumber(x.price)} ₫</small></span><input type="number" class="service-quantity w-14 border rounded px-1 py-1" min="1" max="100" value="1" disabled></label>`).join('')
                    : '<span class="text-slate-400">Không có dịch vụ đang hoạt động.</span>';
                document.querySelectorAll('.booking-service').forEach(box => box.addEventListener('change', () => { box.closest('label').querySelector('.service-quantity').disabled = !box.checked; updateCreateEstimate(); }));
                document.querySelectorAll('.service-quantity').forEach(input => input.addEventListener('input', updateCreateEstimate));
                renderAvailableHalls(); updateCreateEstimate();
            } catch (error) { showToast('Lỗi', error.message || 'Không thể tải lựa chọn booking.', false); }
        }

        function renderAvailableHalls() {
            if (!createBookingOptions) return;
            const shift = document.getElementById('newShift').value;
            const dateStr = document.getElementById('newEventDate').value;
            let isWeekend = false;
            if (dateStr) {
                const parts = dateStr.split('-');
                if (parts.length === 3) {
                    const d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
                    isWeekend = d.getDay() === 0 || d.getDay() === 6;
                }
            }
            const isDinner = (shift || '').toLowerCase().includes('tối');

            const select = document.getElementById('newHallId');
            const current = select.value;
            const halls = createBookingOptions.halls.filter(x => shift === 'Ca trưa' ? x.isNoonAvailable : x.isEveningAvailable);
            select.innerHTML = '<option value="">Chọn sảnh còn trống</option>' + halls.map(x => {
                const base = Number(x.rentalPrice || 0);
                let eff = base;
                let policyTag = 'Ca trưa (giá gốc)';
                if (isWeekend) {
                    eff = Math.round(base * 1.25);
                    policyTag = 'Cuối tuần (+25%)';
                } else if (isDinner) {
                    eff = Math.round(base * 1.15);
                    policyTag = 'Ca tối (+15%)';
                }
                return `<option value="${x.hallId}" data-price="${eff}">${escapeHtml(x.hallName)} — ${x.minimumCapacity || 0}-${x.maximumCapacity} khách [${formatNumber(eff)} ₫ • ${policyTag}]</option>`;
            }).join('');
            if (halls.some(x => String(x.hallId) === current)) select.value = current;
            updateCreateEstimate();
        }

        function updateCreateEstimate() {
            const optionPrice = id => Number(document.getElementById(id).selectedOptions[0]?.dataset.price || 0);
            const tables = Number(document.getElementById('newTableCount').value || 0) + Number(document.getElementById('newSpareTableCount').value || 0);
            let total = optionPrice('newHallId') + optionPrice('newMenuId') * tables + optionPrice('newDecorationPackageId');
            document.querySelectorAll('.booking-service:checked').forEach(box => total += Number(box.dataset.price) * Number(box.closest('label').querySelector('.service-quantity').value || 1));
            document.getElementById('newEstimatedTotal').textContent = `${formatNumber(total)} ₫`;
        }

        function closeCreateBookingModal() {
            const modal = document.getElementById('createBookingModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        async function handleCreateBooking(e) {
            e.preventDefault();
            const submitButton = document.getElementById('createBookingSubmit');
            if (submitButton.disabled) return;
            const payload = {
                customerName: document.getElementById('newCustomerName').value.trim(),
                phoneNumber: document.getElementById('newPhoneNumber').value.trim(),
                email: document.getElementById('newEmail').value.trim() || null,
                hallId: parseInt(document.getElementById('newHallId').value),
                eventDate: document.getElementById('newEventDate').value,
                shift: document.getElementById('newShift').value,
                tableCount: parseInt(document.getElementById('newTableCount').value),
                spareTableCount: parseInt(document.getElementById('newSpareTableCount').value),
                menuId: parseInt(document.getElementById('newMenuId').value) || null,
                decorationPackageId: parseInt(document.getElementById('newDecorationPackageId').value) || null,
                desiredStyle: document.getElementById('newDesiredStyle').value.trim() || null,
                specialRequests: document.getElementById('newSpecialRequests').value,
                services: Array.from(document.querySelectorAll('.booking-service:checked')).map(box => ({ serviceId: Number(box.value), quantity: Number(box.closest('label').querySelector('.service-quantity').value || 1) }))
            };

            try {
                submitButton.disabled = true;
                submitButton.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang tạo...';
                const res = await fetch('/AdminBooking/Create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();

                if (result.success) {
                    showToast('Thành công', result.message);
                    closeCreateBookingModal();
                    document.getElementById('createBookingForm').reset();
                    executeFilter(1);
                } else {
                    showToast('Thất bại', result.message, false);
                }
            } catch (err) {
                showToast('Lỗi', 'Không thể kết nối máy chủ.', false);
            } finally {
                submitButton.disabled = false;
                submitButton.innerHTML = '<i class="fa-solid fa-floppy-disk text-xs"></i> Lưu đơn đặt tiệc';
            }
        }

        // ================= 5. XUẤT EXCEL =================
        function exportBookingsExcel() {
            if (!currentBookings || currentBookings.length === 0) {
                showToast('Thông báo', 'Không có dữ liệu để xuất.', false);
                return;
            }

            try {
                const wb = XLSX.utils.book_new();

                const dataToExport = currentBookings.map((b, idx) => {
                    const eventDateRaw = b.eventDate || b.EventDate;
                    const dateFormatted = eventDateRaw ? new Date(eventDateRaw).toLocaleDateString('vi-VN') : '';
                    return {
                        'STT': idx + 1,
                        'Mã Tiệc': b.bookingCode || b.BookingCode,
                        'Tên Khách Hàng': b.customerName || b.CustomerName,
                        'Số Điện Thoại': b.customerPhone || b.CustomerPhone || '',
                        'Đại Sảnh': b.hallName || b.HallName,
                        'Ca Tổ Chức': b.shift || b.Shift,
                        'Ngày Tổ Chức': dateFormatted,
                        'Số Bàn': b.tableCount || b.TableCount || 0,
                        'Tổng Dự Kiến (VNĐ)': b.estimatedTotal || b.EstimatedTotal || 0,
                        'Trạng Thái': b.status || b.Status
                    };
                });

                const ws = XLSX.utils.json_to_sheet(dataToExport);
                const wscols = [
                    { wch: 5 }, { wch: 15 }, { wch: 25 }, { wch: 15 },
                    { wch: 20 }, { wch: 12 }, { wch: 15 }, { wch: 10 },
                    { wch: 20 }, { wch: 15 }
                ];
                ws['!cols'] = wscols;
                XLSX.utils.book_append_sheet(wb, ws, 'DanhSach_DatTiec');

                XLSX.writeFile(wb, `Riverside_DanhSach_DatTiec_${new Date().toISOString().slice(0,10)}.xlsx`);
                showToast('Thành công', `Đã xuất ${currentBookings.length} hợp đồng ra Excel!`);
            } catch (err) {
                console.error('Lỗi xuất Excel:', err);
                showToast('Lỗi', 'Không thể xuất file Excel: ' + err.message, false);
            }
        }
    </script>
}
