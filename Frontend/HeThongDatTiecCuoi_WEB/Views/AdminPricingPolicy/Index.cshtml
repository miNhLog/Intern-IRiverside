@model List<HeThongDatTiecCuoi_WEB.Models.AdminHall.HallDto>
@{
    var schedulePolicyPage = ViewBag.ScheduleChangePolicy as HeThongDatTiecCuoi_WEB.Models.ScheduleChange.ScheduleChangePolicyPageViewModel ?? new();
    ViewData["Title"] = "Quản Trị Bảng Giá & Chính Sách";
    Layout = "_AdminLayout";
}

<!-- Font dùng chung được nạp bởi _AdminLayout. -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.sheetjs.com/xlsx-0.20.0/package/dist/xlsx.full.min.js"></script>

<script>
    tailwind.config = {
        theme: {
            extend: {
                colors: {
                    brand: {
                        gold: '#B89758', goldLight: '#E8D8B6', goldHover: '#8C6D32',
                        darkNavy: '#111822', sidebar: '#141E28', surface: '#FFFFFF',
                        canvas: '#F8F9FA', border: '#E2E8F0'
                    }
                },
                fontFamily: {
                    serif: ['"Playfair Display"', 'Georgia', 'serif'],
                    sans: ['"Plus Jakarta Sans"', '-apple-system', 'BlinkMacSystemFont', 'sans-serif']
                }
            }
        }
    }
</script>

<style>
    .policy-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #1E293B;
    }

        .policy-page .font-serif {
            font-family: 'Playfair Display', serif;
        }

    .card-shadow {
        box-shadow: 0 4px 20px -2px rgba(30, 41, 59, 0.05), 0 2px 6px -1px rgba(30, 41, 59, 0.02);
    }

    .focus-ring:focus-visible {
        outline: 2px solid #B89758;
        outline-offset: 2px;
    }

    .custom-scrollbar::-webkit-scrollbar {
        height: 8px;
        width: 8px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: #F1F5F9;
        border-radius: 4px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #CBD5E1;
        border-radius: 4px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #B89758;
        }

    /* Ẩn scrollbar cho tabs trên mobile nhưng vẫn cuộn ngang được */
    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }

    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .policy-row:hover {
        background-color: #FAF8F5;
        box-shadow: inset 3px 0 0 #B89758;
    }

    @@keyframes slideUp {
        from

    {
        opacity: 0;
        transform: translateY(20px) scale(0.97);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    }

    .modal-panel {
        animation: slideUp 0.25s ease-out;
    }
</style>

<!-- ==================== CONTAINER ==================== -->
<div class="policy-page p-4 sm:p-6 lg:p-8 space-y-4 sm:space-y-6 w-full max-w-[1600px] mx-auto">

    <!-- ============ 1. HEADER (RESPONSIVE) ============ -->
    <div class="manager-section-header flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="min-w-0">
            <span class="backoffice-hero__eyebrow"><i class="fa-solid fa-tags" aria-hidden="true"></i> GIÁ &amp; CHÍNH SÁCH</span>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
                Quản lý bảng giá &amp; chính sách hợp đồng
            </h2>
            <p>Quản lý bảng giá sảnh và các chính sách áp dụng cho hợp đồng.</p>
        </div>

        <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
            <button onclick="exportExcel()" class="excel-export-button flex items-center gap-2 px-3 py-2 sm:px-3.5 bg-slate-50 hover:bg-slate-100 text-slate-700 rounded-lg text-xs font-semibold transition-colors border border-slate-200 focus-ring min-h-[42px] shadow-2xs">
                <i class="fa-solid fa-file-excel text-emerald-600 text-sm"></i>
                <span class="hidden sm:inline">Xuất Excel</span>
            </button>

            <button id="btnCreate" onclick="openPolicyModal()" class="admin-create-button px-5 py-2.5 bg-gradient-to-r from-[#B89758] to-[#9E7E3F] hover:from-[#A8884A] hover:to-[#8E7035] text-white font-bold text-xs rounded-lg shadow-sm flex items-center justify-center gap-2 transition-all focus-ring min-h-[42px]">
                <i class="fa-solid fa-plus text-xs" aria-hidden="true"></i>
                <span id="btnCreateLabel">Thêm chính sách mới</span>
            </button>
        </div>
    </div>

    <!-- ============ 2. THANH TAB (RESPONSIVE - SCROLL NGANG TRÊN MOBILE) ============ -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm px-3 sm:px-6 overflow-hidden">
        <div class="flex gap-5 sm:gap-8 overflow-x-auto scrollbar-hide" role="tablist">
            <button id="tab-payment" onclick="switchTab('payment')" class="py-3 sm:py-4 font-bold text-xs sm:text-sm border-b-2 border-[#B89758] text-slate-900 flex items-center gap-2 flex-shrink-0 whitespace-nowrap focus-ring transition-colors">
                <i class="fa-solid fa-file-signature text-[#B89758]"></i>
                <span>Chính Sách Thanh Toán &amp; Đặt Cọc</span>
                <span class="bg-[#B89758]/15 text-[#8C6D32] text-[10px] sm:text-[11px] font-bold px-2 py-0.5 rounded-full ml-1 border border-[#B89758]/30">Đang chọn</span>
            </button>

            <button id="tab-pricing" onclick="switchTab('pricing')" class="py-3 sm:py-4 font-medium text-xs sm:text-sm text-slate-500 hover:text-slate-800 flex items-center gap-2 flex-shrink-0 whitespace-nowrap transition-colors border-b-2 border-transparent focus-ring">
                <i class="fa-solid fa-calculator text-slate-400"></i>
                <span>Bảng Giá Ca &amp; Trạng Thái Vận Hành Sảnh</span>
                <span class="text-[10px] sm:text-[11px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full border border-slate-200">@(Model?.Count ?? 9) sảnh</span>
            </button>
            <button id="tab-schedule" onclick="switchTab('schedule')" class="py-3 sm:py-4 font-medium text-xs sm:text-sm text-slate-500 hover:text-slate-800 flex items-center gap-2 flex-shrink-0 whitespace-nowrap transition-colors border-b-2 border-transparent focus-ring">
                <i class="fa-solid fa-calendar-days text-slate-400"></i><span>Chính sách đổi lịch</span>
                @if(schedulePolicyPage.Active is not null){<span class="text-[10px] bg-slate-100 px-2 py-0.5 rounded-full">v@schedulePolicyPage.Active.Version</span>}
            </button>
        </div>
    </div>

    <!-- ============ 3. FILTER BAR (RESPONSIVE) ============ -->
    <section class="bg-white rounded-xl p-3 sm:p-4 border border-slate-200 shadow-sm flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
        <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-2.5 flex-1 w-full min-w-0">
            <!-- Search -->
            <div class="relative w-full sm:flex-1 sm:min-w-[240px] sm:max-w-md">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" id="searchInput" oninput="applyFilters()" placeholder="Tìm mã quy định, tên điều khoản..." class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-9 pr-3 py-2 text-xs text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:border-[#B89758] focus:ring-1 focus:ring-[#B89758] min-h-[42px] transition-all">
            </div>

            <!-- Category select -->
            <div class="backoffice-filter-control flex items-center bg-slate-50 border border-slate-200 rounded-lg px-3 py-1 min-h-[42px] w-full sm:w-auto sm:min-w-[200px]">
                <i class="fa-solid fa-layer-group text-slate-500 mr-2 text-xs flex-shrink-0"></i>
                <label id="filterCatLabel" class="text-xs text-slate-500 mr-1.5 whitespace-nowrap font-medium">Phân nhóm:</label>
                <select id="filterCat" onchange="applyFilters()" class="w-full bg-transparent text-xs font-semibold text-slate-800 focus:outline-none cursor-pointer pr-1 min-w-0"></select>
            </div>

            <!-- Status select -->
            <div class="backoffice-filter-control flex items-center bg-slate-50 border border-slate-200 rounded-lg px-3 py-1 min-h-[42px] w-full sm:w-auto sm:min-w-[170px]">
                <i class="fa-solid fa-toggle-on text-slate-500 mr-2 text-xs flex-shrink-0"></i>
                <label class="text-xs text-slate-500 mr-1.5 whitespace-nowrap font-medium">Trạng thái:</label>
                <select id="filterStatus" onchange="applyFilters()" class="w-full bg-transparent text-xs font-semibold text-slate-800 focus:outline-none cursor-pointer pr-1 min-w-0">
                    <option value="">Tất cả</option>
                    <option value="Hiệu lực">Hiệu lực</option>
                    <option value="Tạm ngưng">Tạm ngưng</option>
                    <option value="Hoạt động">Hoạt động</option>
                    <option value="Bảo trì">Bảo trì</option>
                    <option value="Ngừng hoạt động">Ngừng HĐ</option>
                </select>
            </div>

            <!-- Reset -->
            <button onclick="resetFilters()" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold transition-colors border border-slate-200 flex items-center justify-center gap-1.5 focus-ring min-h-[42px] w-full sm:w-auto">
                <i class="fa-solid fa-arrow-rotate-left text-[11px] text-slate-500"></i>
                <span>Đặt lại</span>
            </button>
        </div>

    </section>

    <!-- ============ 5. POLICY LIST (TAB 1) ============ -->
    <div id="container-payment" class="grid grid-cols-1 lg:grid-cols-2 gap-3 sm:gap-4"></div>

    <!-- ============ 6. HALL LIST (TAB 2) ============ -->
    <div id="container-pricing" class="hidden grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3 sm:gap-4"></div>
    <section id="container-schedule" class="hidden space-y-4">
        @if(ViewBag.ScheduleChangePolicyError is string policyError){<div class="bg-rose-50 text-rose-800 border border-rose-200 rounded-xl p-4">@policyError</div>}
        @if(schedulePolicyPage.Active is { } policy){<div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm"><div class="flex justify-between flex-wrap gap-3"><div><p class="text-xs text-[#8C6D32] font-bold">@policy.PolicyCode · phiên bản @policy.Version</p><h3 class="font-serif text-xl font-bold">Chính sách thay đổi lịch đang hiệu lực</h3><div class="flex items-center gap-2 mt-1"><p class="text-xs text-slate-500">Hiệu lực từ @policy.EffectiveFrom.ToString("dd/MM/yyyy HH:mm")</p><span class="policy-status policy-status--active"><span class="policy-status__dot"></span>@policy.Status</span></div></div><button type="button" onclick="openSchedulePolicyModal()" class="admin-create-button px-4 py-2 bg-[#B89758] text-white rounded-lg text-xs font-bold">Tạo phiên bản mới</button></div><div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3 mt-5"><div class="bg-slate-50 p-3 rounded-lg"><small>Gửi online tối thiểu</small><b class="block">@policy.OnlineMinimumDays ngày</b></div><div class="bg-slate-50 p-3 rounded-lg"><small>Ngày mới tối thiểu</small><b class="block">@policy.NewDateMinimumDays ngày</b></div><div class="bg-slate-50 p-3 rounded-lg"><small>Thanh toán</small><b class="block">@policy.PaymentWindowMinutes phút</b></div><div class="bg-slate-50 p-3 rounded-lg"><small>Giữ chỗ tạm</small><b class="block">@policy.HoldWindowMinutes phút</b></div></div><div class="overflow-auto mt-5"><table class="w-full text-xs"><thead><tr class="text-left border-b"><th class="p-3">Khoảng ngày</th><th>Phụ phí</th><th>Khách gửi online</th></tr></thead><tbody>@foreach(var tier in policy.Tiers.OrderBy(x=>x.MinimumDays)){<tr class="border-b"><td class="p-3">@(tier.MaximumDays.HasValue?$"{tier.MinimumDays}–{tier.MaximumDays} ngày":$"Từ {tier.MinimumDays} ngày")</td><td>@tier.FeeAmount.ToString("N0") ₫</td><td>@(tier.CustomerOnlineAllowed?"Cho phép":"Không cho phép")</td></tr>}</tbody></table></div></div>}
        <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm"><h3 class="font-serif text-lg font-bold mb-3">Lịch sử phiên bản</h3><div class="overflow-auto"><table class="w-full text-xs"><thead><tr class="text-left border-b"><th class="p-3">Phiên bản</th><th>Hiệu lực từ</th><th>Hiệu lực đến</th><th>Trạng thái</th><th>Ghi chú</th></tr></thead><tbody>@foreach(var p in schedulePolicyPage.History.OrderByDescending(x=>x.Version)){<tr class="border-b"><td class="p-3"><b>v@p.Version</b></td><td>@p.EffectiveFrom.ToString("dd/MM/yyyy HH:mm")</td><td>@(p.EffectiveTo?.ToString("dd/MM/yyyy HH:mm")??"—")</td><td><span class="policy-status @(p.Status == "ACTIVE" || p.Status == "Hiệu lực" ? "policy-status--active" : "policy-status--inactive")"><span class="policy-status__dot"></span>@p.Status</span></td><td>@p.ChangeNote</td></tr>}</tbody></table></div></div>
    </section>

</div>

<!-- ==================== MODAL: DETAIL VIEW (RESPONSIVE) ==================== -->
<div id="detailModal" class="fixed inset-0 hidden items-center justify-center bg-slate-950/70 backdrop-blur-sm p-3 sm:p-4 z-[99999]">
    <div class="bg-white rounded-2xl w-full max-w-lg shadow-2xl overflow-hidden modal-panel max-h-[95vh] sm:max-h-[90vh] flex flex-col">
        <div class="bg-[#FAF8F5] px-4 sm:px-6 py-3 sm:py-4 border-b border-slate-200 flex items-center justify-between flex-shrink-0">
            <h3 class="font-serif font-bold text-base sm:text-lg text-slate-900 flex items-center gap-2 min-w-0">
                <i class="fa-solid fa-file-lines text-[#B89758] text-sm flex-shrink-0"></i>
                <span id="detailTitle" class="truncate">Chi Tiết</span>
            </h3>
            <button onclick="closeDetailModal()" class="w-8 h-8 rounded-full flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-200 transition-colors flex-shrink-0">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>
        </div>
        <div id="detailBody" class="p-4 sm:p-6 space-y-4 text-xs overflow-y-auto custom-scrollbar flex-1"></div>
        <div class="bg-slate-50 px-4 sm:px-6 py-3 border-t border-slate-200 text-right flex-shrink-0">
            <button onclick="closeDetailModal()" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-800 rounded-lg font-semibold text-xs transition-colors">Đóng</button>
        </div>
    </div>
</div>

<!-- ==================== MODAL: POLICY FORM (RESPONSIVE) ==================== -->
<div id="policyModal" class="fixed inset-0 hidden items-center justify-center bg-slate-950/70 backdrop-blur-sm p-3 sm:p-4 z-[99999] overflow-y-auto">
    <div class="bg-white rounded-2xl w-full max-w-2xl shadow-2xl overflow-hidden modal-panel my-auto max-h-[95vh] flex flex-col">
        <div class="bg-[#FAF8F5] px-4 sm:px-6 py-3 sm:py-4 border-b border-slate-200 flex items-center justify-between flex-shrink-0">
            <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                <div class="w-9 h-9 rounded-lg bg-[#B89758]/15 border border-[#B89758]/30 flex items-center justify-center text-[#8C6D32] flex-shrink-0">
                    <i class="fa-solid fa-pen-nib text-sm"></i>
                </div>
                <div class="min-w-0">
                    <h3 id="modalTitle" class="font-serif font-bold text-sm sm:text-base text-slate-900 truncate">Cập nhật chính sách</h3>
                    <p class="text-[11px] text-slate-500 truncate hidden sm:block">Quy định tỷ lệ và mốc thời gian áp dụng</p>
                </div>
            </div>
            <button onclick="closePolicyModal()" class="w-8 h-8 rounded-full flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-200 transition-colors flex-shrink-0">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>
        </div>

        <form id="policyForm" onsubmit="handleSubmit(event)" class="p-4 sm:p-6 space-y-4 text-xs bg-[#FDFBF7] overflow-y-auto custom-scrollbar flex-1">
            <input type="hidden" id="formId" value="0" />

            <div class="grid grid-cols-1 md:grid-cols-12 gap-3 sm:gap-4">
                <div class="md:col-span-4">
                    <label class="block font-semibold text-slate-700 mb-1">Mã Quy Định <span class="text-rose-500">*</span></label>
                    <input id="formCode" required readonly class="w-full bg-slate-100 border border-slate-200 text-slate-700 font-mono font-bold rounded-lg px-3 py-2 text-xs cursor-not-allowed" />
                </div>
                <div class="md:col-span-8">
                    <label class="block font-semibold text-slate-800 mb-1">Tên Quy Định <span class="text-rose-500">*</span></label>
                    <input id="formName" required placeholder="VD: Đặt cọc Đợt 1 giữ sảnh tiệc..." class="w-full bg-white border border-slate-200 focus:border-[#B89758] focus:ring-1 focus:ring-[#B89758] rounded-lg px-3 py-2 text-xs outline-none transition-all" />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-12 gap-3 sm:gap-4">
                <div class="md:col-span-4">
                    <label class="block font-semibold text-slate-800 mb-1">Phân Loại <span class="text-rose-500">*</span></label>
                    <input id="formType" required placeholder="VD: Đặt cọc & Giữ chỗ" class="w-full bg-white border border-slate-200 focus:border-[#B89758] focus:ring-1 focus:ring-[#B89758] rounded-lg px-3 py-2 text-xs outline-none transition-all" />
                </div>
                <div class="md:col-span-4">
                    <label class="block font-semibold text-slate-800 mb-1">Định Mức / Tỷ Lệ <span class="text-rose-500">*</span></label>
                    <input id="formValue" required placeholder="VD: 20% Tổng dự toán" class="w-full bg-white border border-slate-200 focus:border-[#B89758] focus:ring-1 focus:ring-[#B89758] rounded-lg px-3 py-2 text-xs font-bold text-[#8C6D32] outline-none transition-all" />
                </div>
                <div class="md:col-span-4">
                    <label class="block font-semibold text-slate-800 mb-1">Thời Hạn / Mốc</label>
                    <input id="formTime" placeholder="VD: Trong 48 giờ" class="w-full bg-white border border-slate-200 focus:border-[#B89758] focus:ring-1 focus:ring-[#B89758] rounded-lg px-3 py-2 text-xs outline-none transition-all" />
                </div>
            </div>

            <div>
                <label class="block font-semibold text-slate-800 mb-1">Nội Dung Diễn Giải</label>
                <textarea id="formDesc" rows="3" placeholder="Quy định xử lý quá hạn, trách nhiệm bồi thường..." class="w-full bg-white border border-slate-200 focus:border-[#B89758] focus:ring-1 focus:ring-[#B89758] rounded-lg p-3 text-xs leading-relaxed outline-none resize-none transition-all"></textarea>
            </div>

            <div>
                <label class="block font-semibold text-slate-800 mb-1">Trạng Thái Hiệu Lực</label>
                <select id="formStatus" class="w-full bg-white border border-slate-200 focus:border-[#B89758] focus:ring-1 focus:ring-[#B89758] rounded-lg px-3 py-2 text-xs outline-none cursor-pointer transition-all">
                    <option value="Hiệu lực">Hiệu lực</option>
                    <option value="Tạm ngưng">Tạm ngưng</option>
                </select>
            </div>

            <div class="pt-3 border-t border-slate-200 flex flex-col-reverse sm:flex-row justify-end gap-2.5">
                <button type="button" onclick="closePolicyModal()" class="h-10 px-5 rounded-lg border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 font-semibold text-xs w-full sm:w-auto">Hủy bỏ</button>
                <button type="submit" class="h-10 px-6 rounded-lg bg-gradient-to-r from-[#B89758] to-[#9E7E3F] hover:from-[#A8884A] text-white font-bold shadow-sm flex items-center justify-center gap-2 text-xs w-full sm:w-auto">
                    <i class="fa-solid fa-check text-xs"></i>
                    <span>LƯU CHÍNH SÁCH</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ==================== MODAL: QUICK PRICE (RESPONSIVE) ==================== -->
<div id="priceModal" class="fixed inset-0 hidden items-center justify-center bg-slate-950/70 backdrop-blur-sm p-3 sm:p-4 z-[99999]">
    <div class="bg-white rounded-2xl w-full max-w-sm shadow-2xl p-4 sm:p-6 space-y-4 modal-panel max-h-[95vh] overflow-y-auto custom-scrollbar">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 id="priceModalTitle" class="font-serif font-bold text-base text-slate-900 truncate pr-2">Cập nhật đơn giá</h3>
            <button onclick="closePriceModal()" class="text-slate-400 hover:text-slate-700 flex-shrink-0"><i class="fa-solid fa-xmark text-sm"></i></button>
        </div>
        <input type="hidden" id="priceHallId" value="0" />
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Đơn giá cơ sở mới (VNĐ) <span class="text-rose-500">*</span></label>
            <input type="number" id="priceInput" step="500000" min="1000000" class="w-full bg-[#FAF8F5] border border-slate-200 focus:border-[#B89758] focus:ring-1 focus:ring-[#B89758] rounded-lg px-3 py-2.5 text-sm font-bold text-[#8C6D32] outline-none" />
            <p class="text-[10px] text-slate-400 mt-1.5">* Ca tối (+15%) và cuối tuần (+25%) sẽ tự động tính lại.</p>
        </div>
        <div class="flex flex-col-reverse sm:flex-row justify-end gap-2 pt-2">
            <button onclick="closePriceModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold w-full sm:w-auto">Hủy</button>
            <button onclick="savePrice()" class="px-4 py-2 bg-gradient-to-r from-[#B89758] to-[#9E7E3F] text-white rounded-lg text-xs font-bold shadow-sm w-full sm:w-auto">Lưu đơn giá</button>
        </div>
    </div>
</div>

<!-- ==================== MODAL: CONFIRM (RESPONSIVE) ==================== -->
<div id="confirmModal" class="fixed inset-0 hidden items-center justify-center bg-slate-950/70 backdrop-blur-sm p-3 sm:p-4 z-[100000]">
    <div class="bg-white rounded-2xl w-full max-w-sm shadow-2xl overflow-hidden modal-panel">
        <div class="p-5 sm:p-6 text-center">
            <div id="confirmIconBox" class="w-14 h-14 mx-auto rounded-full flex items-center justify-center mb-4 bg-amber-50 border border-amber-200">
                <i id="confirmIcon" class="fa-solid fa-triangle-exclamation text-2xl text-amber-500"></i>
            </div>
            <h3 id="confirmTitle" class="font-serif font-bold text-base sm:text-lg text-slate-900 mb-2">Xác nhận hành động</h3>
            <p id="confirmMessage" class="text-xs text-slate-500 leading-relaxed">Bạn có chắc chắn muốn thực hiện hành động này?</p>
        </div>
        <div class="px-4 sm:px-6 pb-5 sm:pb-6 flex flex-col-reverse sm:flex-row justify-center gap-2.5">
            <button onclick="closeConfirm()" class="h-10 px-5 rounded-lg border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 font-semibold text-xs transition-colors w-full sm:w-auto">
                Hủy bỏ
            </button>
            <button id="confirmOkBtn" class="h-10 px-6 rounded-lg font-bold shadow-sm text-xs text-white transition-colors w-full sm:w-auto">
                Xác nhận
            </button>
        </div>
    </div>
</div>

<div id="schedulePolicyModal" class="fixed inset-0 hidden items-center justify-center bg-slate-950/70 p-4 z-[100001]">
 <div class="bg-white rounded-2xl w-full max-w-3xl p-5 max-h-[94vh] overflow-auto"><div class="flex justify-between"><h3 class="font-serif text-lg font-bold">Tạo phiên bản chính sách đổi lịch</h3><button type="button" onclick="closeSchedulePolicyModal()">✕</button></div>
 <form id="schedulePolicyForm" class="space-y-4 mt-4">@Html.AntiForgeryToken()<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3"><label class="text-xs font-bold">Online tối thiểu<input class="w-full border rounded p-2" type="number" name="onlineMinimumDays" min="1" max="30" value="@(schedulePolicyPage.Active?.OnlineMinimumDays??7)" required></label><label class="text-xs font-bold">Ngày mới tối thiểu<input class="w-full border rounded p-2" type="number" name="newDateMinimumDays" min="1" max="365" value="@(schedulePolicyPage.Active?.NewDateMinimumDays??14)" required></label><label class="text-xs font-bold">Thanh toán (phút)<input class="w-full border rounded p-2" type="number" name="paymentWindowMinutes" min="1" max="120" value="@(schedulePolicyPage.Active?.PaymentWindowMinutes??15)" required></label><label class="text-xs font-bold">Giữ chỗ (phút)<input class="w-full border rounded p-2" type="number" name="holdWindowMinutes" min="1" max="120" value="@(schedulePolicyPage.Active?.HoldWindowMinutes??20)" required></label></div><label class="text-xs font-bold block">Hiệu lực từ<input class="block w-full border rounded p-2" type="datetime-local" name="effectiveFrom" required></label><label class="text-xs font-bold block">Ghi chú thay đổi<textarea class="block w-full border rounded p-2" name="changeNote" maxlength="1000" required></textarea></label>
 <div class="overflow-auto"><table class="w-full text-xs" id="scheduleTierTable"><thead><tr><th>Từ ngày</th><th>Đến ngày</th><th>Phí VNĐ</th><th>Online</th></tr></thead><tbody>@{var policyTiers=schedulePolicyPage.Active?.Tiers.OrderBy(x=>x.MinimumDays).ToList()??new List<HeThongDatTiecCuoi_WEB.Models.ScheduleChange.ScheduleChangePolicyTierViewModel>{new(){MinimumDays=0,MaximumDays=6,FeeAmount=5000000,CustomerOnlineAllowed=false},new(){MinimumDays=7,MaximumDays=29,FeeAmount=5000000,CustomerOnlineAllowed=true},new(){MinimumDays=30,MaximumDays=44,FeeAmount=2000000,CustomerOnlineAllowed=true},new(){MinimumDays=45,FeeAmount=0,CustomerOnlineAllowed=true}};}@foreach(var tier in policyTiers){<tr><td><input class="border rounded p-2 w-24" type="number" data-field="minimumDays" min="0" value="@tier.MinimumDays" required></td><td><input class="border rounded p-2 w-28" type="number" data-field="maximumDays" min="0" value="@tier.MaximumDays"></td><td><input class="border rounded p-2 w-36" type="number" data-field="feeAmount" min="0" value="@tier.FeeAmount" required></td><td><input type="checkbox" data-field="customerOnlineAllowed" checked="@tier.CustomerOnlineAllowed"></td></tr>}</tbody></table></div><div id="schedulePolicyMessage" class="text-xs"></div><button type="submit" class="px-5 py-2 bg-[#B89758] text-white rounded-lg text-xs font-bold">Lưu phiên bản mới vào SQL Server</button></form></div></div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        let currentTab = 'payment';
        let confirmCallback = null;

        let paymentPolicies = [
            { id: 1, ma: 'POL-PAY-01', ten: 'Đặt cọc Đợt 1 - Giữ chỗ sảnh tiệc', phanLoai: 'Đặt cọc & Giữ chỗ', dinhMuc: '20% Tổng dự toán', thoiHan: 'Trong 48 giờ', moTa: 'Khách hàng hoàn tất 20% chi phí dự toán để xác lập hợp đồng chính thức. Quá 48 giờ kể từ khi tạo booking nếu chưa nhận cọc, hệ thống tự động hủy giữ chỗ và mở lại lịch sảnh khả dụng.', canCu: 'Quy chuẩn giữ chỗ 48h', trangThai: 'Hiệu lực' },
            { id: 2, ma: 'POL-PAY-02', ten: 'Thanh toán Đợt 2 - Chốt thực đơn & dịch vụ', phanLoai: 'Thanh toán đợt', dinhMuc: '50% Tổng giá trị', thoiHan: 'Trước tiệc 7 – 10 ngày', moTa: 'Khách hàng chốt chính thức số lượng bàn phát sinh, danh mục ẩm thực và hoàn tất thanh toán lũy kế đạt tối thiểu 70% giá trị hợp đồng.', canCu: 'Quy trình thanh toán 3 đợt', trangThai: 'Hiệu lực' },
            { id: 3, ma: 'POL-PAY-03', ten: 'Quyết toán Đợt 3 - Sau sự kiện', phanLoai: 'Quyết toán thanh lý', dinhMuc: '100% Số dư công nợ', thoiHan: 'Ngay khi tan tiệc', moTa: 'Đối soát các chi phí phát sinh thực tế (bàn dự phòng, thức uống gọi thêm, phụ phí dịch vụ) và thanh toán toàn bộ số tiền còn lại ngay sau tiệc.', canCu: 'Thanh lý & quyết toán', trangThai: 'Hiệu lực' },
            { id: 4, ma: 'POL-CNC-04', ten: 'Chính sách bồi hoàn & hủy tiệc cưới', phanLoai: 'Hủy hợp đồng', dinhMuc: 'Phạt 50% - 100% Cọc', thoiHan: 'Theo mốc ngày hủy', moTa: 'Hủy trước 60 ngày: phạt 50% tiền cọc Đợt 1; Hủy từ 30-59 ngày: phạt 100% cọc Đợt 1; Hủy dưới 30 ngày: bồi hoàn 50% toàn bộ giá trị hợp đồng.', canCu: 'Bồi thường hợp đồng kinh tế', trangThai: 'Hiệu lực' }
        ];

        const rawHalls = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model ?? new List<HeThongDatTiecCuoi_WEB.Models.AdminHall.HallDto>()));

        function normalizeStatus(s) {
            if (!s) return 'Hoạt động';
            const x = s.toString().trim().toLowerCase();
            if (x.includes('active') || x.includes('hoạt động')) return 'Hoạt động';
            if (x.includes('maintenance') || x.includes('bảo trì')) return 'Bảo trì';
            if (x.includes('inactive') || x.includes('ngừng')) return 'Ngừng hoạt động';
            return s;
        }

        let hallPricing = rawHalls.map(h => {
            const price = h.RentalPrice || 20000000;
            return {
                sanhTiecId: h.HallId,
                maSanh: h.HallCode,
                tenSanh: h.HallName,
                sucChuaToiThieu: h.MinimumCapacity || 100,
                sucChuaToiDa: h.MaximumCapacity || 500,
                giaGoc: price, giaCaTrua: price, giaCaToi: price * 1.15, giaCuoiTuan: price * 1.25,
                trangThai: normalizeStatus(h.Status)
            };
        });

        document.addEventListener('DOMContentLoaded', () => {
            switchTab('payment');

            document.getElementById('confirmOkBtn').addEventListener('click', () => {
                if (confirmCallback) confirmCallback();
                closeConfirm();
            });
        });

        function showToast(title, msg, ok = true) {
            if (ok) window.RiversideToast?.success(msg, { title });
            else window.RiversideToast?.error(msg, { title });
        }

        function switchTab(tab) {
            currentTab = tab;
            const tP = document.getElementById('tab-payment');
            const tR = document.getElementById('tab-pricing');
            const cP = document.getElementById('container-payment');
            const cR = document.getElementById('container-pricing');
            const bc = document.getElementById('btnCreate');
            const bcl = document.getElementById('btnCreateLabel');
            const tS = document.getElementById('tab-schedule');
            const cS = document.getElementById('container-schedule');

            if (tab === 'schedule') {
                cP.classList.add('hidden'); cR.classList.add('hidden'); cS.classList.remove('hidden'); bc.classList.add('hidden');
                [tP, tR].forEach(x => x.className = 'py-3 sm:py-4 font-medium text-xs sm:text-sm text-slate-500 hover:text-slate-800 flex items-center gap-2 flex-shrink-0 whitespace-nowrap transition-colors border-b-2 border-transparent focus-ring');
                tS.className = 'py-3 sm:py-4 font-bold text-xs sm:text-sm border-b-2 border-[#B89758] text-slate-900 flex items-center gap-2 flex-shrink-0 whitespace-nowrap focus-ring transition-colors';
                return;
            }
            cS.classList.add('hidden');
            tS.className = 'py-3 sm:py-4 font-medium text-xs sm:text-sm text-slate-500 hover:text-slate-800 flex items-center gap-2 flex-shrink-0 whitespace-nowrap transition-colors border-b-2 border-transparent focus-ring';

            if (tab === 'payment') {
                tP.className = 'py-3 sm:py-4 font-bold text-xs sm:text-sm border-b-2 border-[#B89758] text-slate-900 flex items-center gap-2 flex-shrink-0 whitespace-nowrap focus-ring transition-colors';
                tP.innerHTML = `<i class="fa-solid fa-file-signature text-[#B89758]"></i><span>Chính Sách Thanh Toán &amp; Đặt Cọc</span><span class="bg-[#B89758]/15 text-[#8C6D32] text-[10px] sm:text-[11px] font-bold px-2 py-0.5 rounded-full ml-1 border border-[#B89758]/30">Đang chọn</span>`;

                tR.className = 'py-3 sm:py-4 font-medium text-xs sm:text-sm text-slate-500 hover:text-slate-800 flex items-center gap-2 flex-shrink-0 whitespace-nowrap transition-colors border-b-2 border-transparent focus-ring';
                tR.innerHTML = `<i class="fa-solid fa-calculator text-slate-400"></i><span>Bảng Giá Ca &amp; Trạng Thái Vận Hành Sảnh</span><span class="text-[10px] sm:text-[11px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full border border-slate-200">${hallPricing.length} sảnh</span>`;

                cP.classList.remove('hidden'); cP.classList.add('grid');
                cR.classList.add('hidden'); cR.classList.remove('grid');
                bc.classList.remove('hidden');
                bcl.innerText = 'Thêm chính sách mới';
                document.getElementById('filterCatLabel').innerText = 'Phân nhóm:';
            } else {
                tR.className = 'py-3 sm:py-4 font-bold text-xs sm:text-sm border-b-2 border-[#B89758] text-slate-900 flex items-center gap-2 flex-shrink-0 whitespace-nowrap focus-ring transition-colors';
                tR.innerHTML = `<i class="fa-solid fa-calculator text-[#B89758]"></i><span>Bảng Giá Ca &amp; Trạng Thái Vận Hành Sảnh</span><span class="bg-[#B89758]/15 text-[#8C6D32] text-[10px] sm:text-[11px] font-bold px-2 py-0.5 rounded-full ml-1 border border-[#B89758]/30">Đang chọn</span>`;

                tP.className = 'py-3 sm:py-4 font-medium text-xs sm:text-sm text-slate-500 hover:text-slate-800 flex items-center gap-2 flex-shrink-0 whitespace-nowrap transition-colors border-b-2 border-transparent focus-ring';
                tP.innerHTML = `<i class="fa-solid fa-file-signature text-slate-400"></i><span>Chính Sách Thanh Toán &amp; Đặt Cọc</span><span class="text-[10px] sm:text-[11px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full border border-slate-200">${paymentPolicies.length} điều khoản</span>`;

                cR.classList.remove('hidden'); cR.classList.add('grid');
                cP.classList.add('hidden'); cP.classList.remove('grid');
                bc.classList.add('hidden');
                document.getElementById('filterCatLabel').innerText = 'Sức chứa:';
            }
            populateFilter();
            applyFilters();
        }

        function populateFilter() {
            const sel = document.getElementById('filterCat');
            sel.innerHTML = '<option value="">Tất cả</option>';
            if (currentTab === 'payment') {
                [...new Set(paymentPolicies.map(p => p.phanLoai))].forEach(c => {
                    const o = document.createElement('option'); o.value = c; o.innerText = c; sel.appendChild(o);
                });
            } else {
                [['small','Dưới 400 khách'],['medium','400 - 600 khách'],['large','Trên 600 khách']].forEach(([v, l]) => {
                    const o = document.createElement('option'); o.value = v; o.innerText = l; sel.appendChild(o);
                });
            }
        }

        function applyFilters() {
            const kw = document.getElementById('searchInput').value.toLowerCase().trim();
            const cat = document.getElementById('filterCat').value;
            const st = document.getElementById('filterStatus').value;

            if (currentTab === 'payment') {
                const list = paymentPolicies.filter(p => {
                    const mk = !kw || p.ma.toLowerCase().includes(kw) || p.ten.toLowerCase().includes(kw) || p.moTa.toLowerCase().includes(kw);
                    const mc = !cat || p.phanLoai === cat;
                    const ms = !st || p.trangThai === st;
                    return mk && mc && ms;
                });
                renderPolicyCards(list);
            } else {
                const list = hallPricing.filter(h => {
                    const mk = !kw || h.maSanh.toLowerCase().includes(kw) || h.tenSanh.toLowerCase().includes(kw);
                    let mc = true;
                    if (cat === 'small') mc = h.sucChuaToiDa < 400;
                    else if (cat === 'medium') mc = h.sucChuaToiDa >= 400 && h.sucChuaToiDa <= 600;
                    else if (cat === 'large') mc = h.sucChuaToiDa > 600;
                    const ms = !st || h.trangThai === st;
                    return mk && mc && ms;
                });
                renderHallCards(list);
            }
        }

        function resetFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('filterCat').value = '';
            document.getElementById('filterStatus').value = '';
            applyFilters();
        }

        function renderPolicyCards(list) {
            const c = document.getElementById('container-payment');
            c.innerHTML = '';
            if (list.length === 0) {
                c.innerHTML = `<div class="col-span-full bg-white rounded-xl p-8 sm:p-12 text-center text-slate-400 italic border border-slate-200"><i class="fa-regular fa-folder-open text-3xl mb-2 text-slate-300 block"></i>Không tìm thấy chính sách nào phù hợp.</div>`;
                return;
            }

            list.forEach(p => {
                const inactive = p.trangThai !== 'Hiệu lực';
                const card = document.createElement('div');
                card.className = `policy-card bg-white rounded-xl border ${inactive ? 'is-inactive' : ''} p-4 sm:p-5 shadow-sm transition-all`;

                card.innerHTML = `
                    <div class="flex items-start justify-between gap-3 mb-3 flex-wrap">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-1.5 flex-wrap">
                                <span class="font-mono text-[10px] font-bold px-2 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200">${p.ma}</span>
                                <span class="policy-reference text-[10px] px-2 py-0.5 rounded font-semibold">${p.canCu}</span>
                            </div>
                            <h4 class="font-serif font-bold text-sm sm:text-base text-slate-900 leading-tight">${p.ten}</h4>
                        </div>
                        ${inactive
                            ? `<span class="policy-status policy-status--inactive"><span class="policy-status__dot"></span>Tạm ngưng</span>`
                            : `<span class="policy-status policy-status--active"><span class="policy-status__dot"></span>Hiệu lực</span>`
                        }
                    </div>

                    <div class="grid grid-cols-2 gap-2.5 mb-3">
                        <div class="policy-info-box rounded-lg p-2.5 border min-w-0">
                            <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider mb-0.5">Định mức</span>
                            <span class="font-serif font-bold text-[#8C6D32] text-xs sm:text-sm block truncate">${p.dinhMuc}</span>
                        </div>
                        <div class="policy-info-box rounded-lg p-2.5 border min-w-0">
                            <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider mb-0.5">Thời hạn</span>
                            <span class="font-semibold text-slate-800 text-[11px] sm:text-xs block truncate">${p.thoiHan}</span>
                        </div>
                    </div>

                    <p class="text-xs text-slate-600 leading-relaxed line-clamp-2 mb-3.5">${p.moTa}</p>

                    <div class="flex items-center justify-end gap-1.5 pt-3 border-t border-slate-100 flex-wrap">
                        <button onclick="viewPolicyDetail(${p.id})" class="policy-action h-8 px-2.5 sm:px-3 rounded-lg text-[11px] sm:text-xs font-semibold flex items-center gap-1.5 transition-colors" title="Xem chi tiết">
                            <i class="fa-regular fa-eye text-xs"></i>
                            <span>Chi tiết</span>
                        </button>
                        <button onclick="editPolicy(${p.id})" class="policy-action policy-action--edit h-8 px-2.5 sm:px-3 rounded-lg text-[11px] sm:text-xs font-semibold flex items-center gap-1.5 transition-colors" title="Chỉnh sửa">
                            <i class="fa-regular fa-pen-to-square text-xs"></i>
                            <span>Sửa</span>
                        </button>
                        <button onclick="togglePolicyStatus(${p.id})" class="policy-action ${inactive ? 'policy-action--success' : 'policy-action--warning'} h-8 px-2.5 sm:px-3 rounded-lg text-[11px] sm:text-xs font-semibold flex items-center gap-1.5 transition-colors" title="${inactive ? 'Mở' : 'Khóa'}">
                            <i class="fa-solid ${inactive ? 'fa-rotate-left' : 'fa-ban'} text-xs"></i>
                            <span>${inactive ? 'Mở' : 'Khóa'}</span>
                        </button>
                    </div>
                `;
                c.appendChild(card);
            });
        }

        function renderHallCards(list) {
            const c = document.getElementById('container-pricing');
            c.innerHTML = '';
            if (list.length === 0) {
                c.innerHTML = `<div class="col-span-full bg-white rounded-xl p-8 sm:p-12 text-center text-slate-400 italic border border-slate-200"><i class="fa-regular fa-building text-3xl mb-2 text-slate-300 block"></i>Không tìm thấy đại sảnh nào phù hợp.</div>`;
                return;
            }

            list.forEach(h => {
                const inactive = h.trangThai === 'Ngừng hoạt động';
                const maintenance = h.trangThai === 'Bảo trì';

                let badgeCls = 'policy-status--active';
                if (maintenance) badgeCls = 'policy-status--warning';
                if (inactive) badgeCls = 'policy-status--danger';

                const card = document.createElement('div');
                card.className = `policy-card policy-hall-card bg-white rounded-xl border overflow-hidden shadow-sm transition-all ${inactive ? 'is-inactive' : ''}`;

                card.innerHTML = `
                    <div class="p-4 sm:p-5">
                        <div class="flex items-start justify-between gap-3 mb-4 flex-wrap">
                            <div class="flex-1 min-w-0">
                                <span class="font-mono text-[10px] font-bold px-2 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200">${h.maSanh}</span>
                                <h4 class="font-serif font-bold text-base sm:text-lg text-slate-900 leading-tight mt-1.5">${h.tenSanh}</h4>
                                <p class="text-[11px] text-slate-500 mt-1 flex items-center gap-1">
                                    <i class="fa-solid fa-users text-[10px]"></i>
                                    ${h.sucChuaToiThieu} - ${h.sucChuaToiDa} khách
                                </p>
                            </div>
                            <span class="policy-status ${badgeCls}">
                                <span class="policy-status__dot"></span>
                                ${h.trangThai}
                            </span>
                        </div>

                        <div class="policy-info-box rounded-lg p-3 sm:p-3.5 border mb-4">
                            <div class="flex items-baseline justify-between pb-2.5 border-b border-dashed border-slate-200 mb-2.5 gap-2">
                                <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider flex-shrink-0">Đơn giá cơ sở</span>
                                <span class="font-serif font-bold text-base sm:text-lg text-slate-900 ${inactive ? 'line-through text-slate-400' : ''} truncate">
                                    ${h.giaGoc.toLocaleString('vi-VN')}<span class="text-[10px] font-sans text-slate-500 ml-0.5">đ</span>
                                </span>
                            </div>

                            <div class="space-y-1.5">
                                <div class="flex items-center justify-between text-xs gap-2">
                                    <span class="flex items-center gap-1.5 text-slate-600 flex-shrink-0">
                                        <i class="fa-regular fa-sun text-amber-500 text-[10px]"></i>
                                        <span>Ca trưa</span>
                                    </span>
                                    <span class="font-semibold text-slate-800 truncate">${h.giaCaTrua.toLocaleString('vi-VN')} đ</span>
                                </div>
                                <div class="flex items-center justify-between text-xs gap-2">
                                    <span class="flex items-center gap-1.5 text-slate-600 flex-shrink-0">
                                        <i class="fa-regular fa-moon text-indigo-500 text-[10px]"></i>
                                        <span>Ca tối (+15%)</span>
                                    </span>
                                    <span class="font-semibold text-[#8C6D32] truncate">${h.giaCaToi.toLocaleString('vi-VN')} đ</span>
                                </div>
                                <div class="flex items-center justify-between text-xs gap-2">
                                    <span class="flex items-center gap-1.5 text-slate-600 flex-shrink-0">
                                        <i class="fa-solid fa-star text-amber-500 text-[10px]"></i>
                                        <span>Cuối tuần (+25%)</span>
                                    </span>
                                    <span class="font-semibold text-rose-700 truncate">${h.giaCuoiTuan.toLocaleString('vi-VN')} đ</span>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center justify-end gap-1.5 flex-wrap">
                            <button onclick="viewHallDetail(${h.sanhTiecId})" class="policy-action h-9 px-3 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-colors">
                                <i class="fa-regular fa-eye text-xs"></i>
                                <span>Chi tiết</span>
                            </button>
                            ${inactive
                                ? `<button disabled class="h-9 px-3 rounded-lg bg-slate-100 text-slate-400 text-xs font-semibold border border-slate-200 cursor-not-allowed flex items-center gap-1.5">
                                    <i class="fa-solid fa-lock text-xs"></i>
                                    <span>Khóa giá</span>
                                  </button>`
                                : `<button onclick="openPriceModal(${h.sanhTiecId}, '${h.tenSanh}', ${h.giaGoc})" class="policy-action policy-action--edit h-9 px-3 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1.5">
                                    <i class="fa-regular fa-pen-to-square text-xs"></i>
                                    <span>Đổi giá</span>
                                  </button>`
                            }
                        </div>
                    </div>
                `;
                c.appendChild(card);
            });
        }

        function viewPolicyDetail(id) {
            const p = paymentPolicies.find(x => x.id === id);
            if (!p) return;

            document.getElementById('detailTitle').innerText = `Chi tiết: ${p.ma}`;
            document.getElementById('detailBody').innerHTML = `
                <div class="policy-info-box p-3 sm:p-4 rounded-lg border">
                    <div class="flex items-start justify-between gap-3 mb-2 flex-wrap">
                        <div class="min-w-0">
                            <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Tên quy định</span>
                            <h4 class="font-serif font-bold text-sm sm:text-base text-slate-900 mt-0.5">${p.ten}</h4>
                        </div>
                        <span class="policy-reference text-[11px] px-2 py-0.5 rounded font-semibold whitespace-nowrap">${p.phanLoai}</span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="p-3 bg-slate-50 rounded-lg border border-slate-200">
                        <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider mb-1">Định mức / Tỷ lệ</span>
                        <span class="font-serif font-bold text-[#8C6D32] text-sm">${p.dinhMuc}</span>
                    </div>
                    <div class="p-3 bg-slate-50 rounded-lg border border-slate-200">
                        <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider mb-1">Thời hạn / Mốc</span>
                        <span class="font-semibold text-slate-800 text-xs">${p.thoiHan}</span>
                    </div>
                </div>

                <div>
                    <span class="font-bold text-slate-700 block mb-1.5 text-[11px] uppercase tracking-wider">Nội dung diễn giải</span>
                    <p class="text-slate-600 leading-relaxed bg-white p-3 rounded-lg border border-slate-200">${p.moTa}</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="p-3 bg-slate-50 rounded-lg border border-slate-200">
                        <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider mb-1">Căn cứ quy chế</span>
                        <span class="font-semibold text-slate-800 text-xs">${p.canCu}</span>
                    </div>
                    <div class="p-3 bg-slate-50 rounded-lg border border-slate-200">
                        <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider mb-1">Trạng thái</span>
                        <span class="policy-status ${p.trangThai === 'Hiệu lực' ? 'policy-status--active' : 'policy-status--inactive'}"><span class="policy-status__dot"></span>${p.trangThai}</span>
                    </div>
                </div>
            `;
            document.getElementById('detailModal').classList.remove('hidden');
            document.getElementById('detailModal').classList.add('flex');
        }

        function viewHallDetail(sanhId) {
            const h = hallPricing.find(x => x.sanhTiecId === sanhId);
            if (!h) return;

            let note = 'Đại sảnh đang vận hành ổn định. Đơn giá có hiệu lực áp dụng trực tiếp cho các hợp đồng mới.';
            let noteCls = 'text-emerald-700 bg-emerald-50 border-emerald-200';
            if (h.trangThai === 'Bảo trì') { note = 'Đại sảnh đang bảo dưỡng kỹ thuật. Đơn giá được bảo lưu nhưng tạm dừng nhận lịch tiệc mới.'; noteCls = 'text-amber-800 bg-amber-50 border-amber-200'; }
            if (h.trangThai === 'Ngừng hoạt động') { note = 'Đại sảnh đã ngừng tiếp nhận sự kiện. Biểu phí niêm yết không khả dụng để chào bán.'; noteCls = 'text-rose-700 bg-rose-50 border-rose-200'; }

            document.getElementById('detailTitle').innerText = `Chi tiết: ${h.tenSanh} (${h.maSanh})`;
            document.getElementById('detailBody').innerHTML = `
                <div class="policy-info-box p-3 sm:p-4 rounded-lg border flex items-start justify-between gap-3 flex-wrap">
                    <div class="min-w-0">
                        <h4 class="font-serif font-bold text-sm sm:text-base text-slate-900">Đại sảnh ${h.tenSanh}</h4>
                        <p class="text-[11px] text-slate-500 mt-1">Sức chứa: ${h.sucChuaToiThieu} - ${h.sucChuaToiDa} khách mời</p>
                    </div>
                    <div class="text-right">
                        <span class="text-[10px] uppercase text-slate-400 block">Đơn giá cơ sở</span>
                        <span class="font-serif font-bold text-sm sm:text-base text-slate-900">${h.giaGoc.toLocaleString('vi-VN')} VNĐ</span>
                    </div>
                </div>

                <div>
                    <span class="font-bold text-slate-700 block mb-2 text-[11px] uppercase tracking-wider">Biểu giá theo ca tổ chức</span>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-center">
                        <div class="p-3 rounded-lg border border-slate-200 bg-white">
                            <span class="text-[10px] uppercase text-slate-400 block mb-1">Ca trưa (100%)</span>
                            <span class="font-bold text-slate-800 text-xs">${h.giaCaTrua.toLocaleString('vi-VN')} đ</span>
                        </div>
                        <div class="p-3 rounded-lg border border-amber-200 bg-amber-50/50">
                            <span class="text-[10px] uppercase text-amber-700 block mb-1">Ca tối (+15%)</span>
                            <span class="font-bold text-[#8C6D32] text-xs">${h.giaCaToi.toLocaleString('vi-VN')} đ</span>
                        </div>
                        <div class="p-3 rounded-lg border border-rose-200 bg-rose-50/50">
                            <span class="text-[10px] uppercase text-rose-700 block mb-1">Cuối tuần (+25%)</span>
                            <span class="font-bold text-rose-700 text-xs">${h.giaCuoiTuan.toLocaleString('vi-VN')} đ</span>
                        </div>
                    </div>
                </div>

                <div class="p-3 rounded-lg border ${noteCls} text-[11px] leading-relaxed">
                    <p class="font-semibold mb-1">Quy định kinh doanh:</p>
                    <p>${note}</p>
                </div>
            `;
            document.getElementById('detailModal').classList.remove('hidden');
            document.getElementById('detailModal').classList.add('flex');
        }

        function closeDetailModal() {
            document.getElementById('detailModal').classList.add('hidden');
            document.getElementById('detailModal').classList.remove('flex');
        }

        function openPolicyModal() {
            document.getElementById('policyForm').reset();
            document.getElementById('formId').value = '0';
            document.getElementById('modalTitle').innerText = 'Thêm chính sách mới';
            document.getElementById('formCode').value = 'POL-PAY-0' + (paymentPolicies.length + 1);
            document.getElementById('formType').value = 'Đặt cọc & Giữ chỗ';
            document.getElementById('formValue').value = '20% Tổng dự toán';
            document.getElementById('formTime').value = 'Trong 48 giờ';
            document.getElementById('policyModal').classList.remove('hidden');
            document.getElementById('policyModal').classList.add('flex');
        }

        function editPolicy(id) {
            const p = paymentPolicies.find(x => x.id === id);
            if (!p) return;
            document.getElementById('formId').value = p.id;
            document.getElementById('modalTitle').innerText = 'Cập nhật chính sách';
            document.getElementById('formCode').value = p.ma;
            document.getElementById('formName').value = p.ten;
            document.getElementById('formType').value = p.phanLoai;
            document.getElementById('formValue').value = p.dinhMuc;
            document.getElementById('formTime').value = p.thoiHan;
            document.getElementById('formDesc').value = p.moTa;
            document.getElementById('formStatus').value = p.trangThai;
            document.getElementById('policyModal').classList.remove('hidden');
            document.getElementById('policyModal').classList.add('flex');
        }

        function closePolicyModal() {
            document.getElementById('policyModal').classList.add('hidden');
            document.getElementById('policyModal').classList.remove('flex');
        }

        function handleSubmit(e) {
            e.preventDefault();
            const id = parseInt(document.getElementById('formId').value);
            const rec = {
                id: id === 0 ? Date.now() : id,
                ma: document.getElementById('formCode').value.trim(),
                ten: document.getElementById('formName').value.trim(),
                phanLoai: document.getElementById('formType').value.trim(),
                dinhMuc: document.getElementById('formValue').value.trim(),
                thoiHan: document.getElementById('formTime').value.trim(),
                moTa: document.getElementById('formDesc').value.trim(),
                canCu: 'Quy chuẩn hợp đồng 2026',
                trangThai: document.getElementById('formStatus').value
            };
            if (id === 0) {
                paymentPolicies.unshift(rec);
                showToast('Thành công', 'Đã thêm chính sách mới!');
            } else {
                const i = paymentPolicies.findIndex(x => x.id === id);
                if (i > -1) paymentPolicies[i] = rec;
                showToast('Thành công', 'Đã cập nhật chính sách!');
            }
            closePolicyModal();
            populateFilter();
            applyFilters();
        }

        function togglePolicyStatus(id) {
            const p = paymentPolicies.find(x => x.id === id);
            if (!p) return;

            const willLock = p.trangThai === 'Hiệu lực';
            if (willLock) {
                openConfirm({
                    title: 'Xác nhận khóa chính sách',
                    message: `Bạn có chắc muốn tạm ngưng hiệu lực của "${p.ten}" (${p.ma})? Chính sách sẽ không được áp dụng cho các hợp đồng mới.`,
                    icon: 'fa-lock',
                    iconBg: 'bg-amber-50 border-amber-200',
                    iconColor: 'text-amber-600',
                    okText: 'Khóa chính sách',
                    okCls: 'bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700',
                    onConfirm: () => {
                        p.trangThai = 'Tạm ngưng';
                        applyFilters();
                        showToast('Thành công', `${p.ma} đã được tạm ngưng hiệu lực.`);
                    }
                });
            } else {
                openConfirm({
                    title: 'Xác nhận mở lại chính sách',
                    message: `Bạn có chắc muốn kích hoạt lại hiệu lực của "${p.ten}" (${p.ma})? Chính sách sẽ được áp dụng trở lại.`,
                    icon: 'fa-rotate-left',
                    iconBg: 'bg-emerald-50 border-emerald-200',
                    iconColor: 'text-emerald-600',
                    okText: 'Mở lại',
                    okCls: 'bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700',
                    onConfirm: () => {
                        p.trangThai = 'Hiệu lực';
                        applyFilters();
                        showToast('Thành công', `${p.ma} đã được kích hoạt trở lại.`);
                    }
                });
            }
        }

        function openPriceModal(id, name, price) {
            document.getElementById('priceHallId').value = id;
            document.getElementById('priceModalTitle').innerText = `Đổi giá sảnh ${name}`;
            document.getElementById('priceInput').value = price;
            document.getElementById('priceModal').classList.remove('hidden');
            document.getElementById('priceModal').classList.add('flex');
        }

        function closePriceModal() {
            document.getElementById('priceModal').classList.add('hidden');
            document.getElementById('priceModal').classList.remove('flex');
        }

        function savePrice() {
            const id = parseInt(document.getElementById('priceHallId').value);
            const v = parseFloat(document.getElementById('priceInput').value);
            if (!v || v < 1000000) {
                showToast('Lỗi', 'Đơn giá tối thiểu 1.000.000 VNĐ', false);
                return;
            }
            const h = hallPricing.find(x => x.sanhTiecId === id);
            if (h) {
                h.giaGoc = v;
                h.giaCaTrua = v;
                h.giaCaToi = v * 1.15;
                h.giaCuoiTuan = v * 1.25;
                closePriceModal();
                applyFilters();
                showToast('Thành công', `Đã cập nhật giá sảnh ${h.tenSanh} thành ${v.toLocaleString('vi-VN')} đ`);
            }
        }

        function openConfirm({ title, message, icon, iconBg, iconColor, okText, okCls, onConfirm }) {
            document.getElementById('confirmTitle').innerText = title;
            document.getElementById('confirmMessage').innerText = message;
            document.getElementById('confirmIcon').className = `fa-solid ${icon} text-2xl ${iconColor}`;
            document.getElementById('confirmIconBox').className = `w-14 h-14 mx-auto rounded-full flex items-center justify-center mb-4 border ${iconBg}`;

            const okBtn = document.getElementById('confirmOkBtn');
            okBtn.className = `h-10 px-6 rounded-lg font-bold shadow-sm text-xs text-white transition-colors w-full sm:w-auto ${okCls}`;
            okBtn.innerText = okText;

            confirmCallback = onConfirm;

            document.getElementById('confirmModal').classList.remove('hidden');
            document.getElementById('confirmModal').classList.add('flex');
        }

        function closeConfirm() {
            document.getElementById('confirmModal').classList.add('hidden');
            document.getElementById('confirmModal').classList.remove('flex');
            confirmCallback = null;
        }

        function openSchedulePolicyModal() {
            const modal = document.getElementById('schedulePolicyModal'); modal.classList.remove('hidden'); modal.classList.add('flex');
            const input = document.querySelector('#schedulePolicyForm [name="effectiveFrom"]');
            if (!input.value) { const d = new Date(Date.now() + 86400000); input.value = new Date(d - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16); }
        }
        function closeSchedulePolicyModal() { const modal = document.getElementById('schedulePolicyModal'); modal.classList.add('hidden'); modal.classList.remove('flex'); }
        document.getElementById('schedulePolicyForm')?.addEventListener('submit', async function (event) {
            event.preventDefault(); const message = document.getElementById('schedulePolicyMessage'); const button = this.querySelector('button[type="submit"]');
            const tiers = [...document.querySelectorAll('#scheduleTierTable tbody tr')].map(row => { const max = row.querySelector('[data-field="maximumDays"]').value; return { minimumDays: Number(row.querySelector('[data-field="minimumDays"]').value), maximumDays: max === '' ? null : Number(max), feeAmount: Number(row.querySelector('[data-field="feeAmount"]').value), customerOnlineAllowed: row.querySelector('[data-field="customerOnlineAllowed"]').checked }; }).sort((a,b)=>a.minimumDays-b.minimumDays);
            for (let i=0;i<tiers.length;i++) if (tiers[i].feeAmount<0 || (tiers[i].maximumDays!==null && tiers[i].maximumDays<tiers[i].minimumDays) || (i>0 && (tiers[i-1].maximumDays===null || tiers[i].minimumDays<=tiers[i-1].maximumDays))) { message.className='text-xs text-rose-600'; message.textContent='Khoảng ngày không hợp lệ hoặc bị chồng lấn.'; return; }
            const form = new FormData(this); const payload = { onlineMinimumDays:Number(form.get('onlineMinimumDays')), newDateMinimumDays:Number(form.get('newDateMinimumDays')), paymentWindowMinutes:Number(form.get('paymentWindowMinutes')), holdWindowMinutes:Number(form.get('holdWindowMinutes')), effectiveFrom:new Date(form.get('effectiveFrom')).toISOString(), changeNote:form.get('changeNote'), tiers };
            button.disabled=true; message.textContent='Đang lưu vào SQL Server...';
            try { const response=await fetch('@Url.Action("CreateScheduleChangePolicyVersion","AdminPricingPolicy")',{method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':form.get('__RequestVerificationToken')},body:JSON.stringify(payload)}); const result=await response.json(); if(!response.ok||!result.success)throw new Error(result.message||'Không thể lưu chính sách.'); showToast('Đã lưu','Phiên bản chính sách mới đã được tạo.'); location.reload(); } catch(error) { message.className='text-xs text-rose-600'; message.textContent=error.message; } finally { button.disabled=false; }
        });

        function exportExcel() {
            const wb = XLSX.utils.book_new();
            if (currentTab === 'payment') {
                const data = paymentPolicies.map((p, i) => ({
                    'STT': i + 1, 'Mã': p.ma, 'Tên': p.ten, 'Phân loại': p.phanLoai,
                    'Định mức': p.dinhMuc, 'Thời hạn': p.thoiHan, 'Căn cứ': p.canCu, 'Trạng thái': p.trangThai
                }));
                const ws = XLSX.utils.json_to_sheet(data);
                ws['!cols'] = [{wch:5},{wch:15},{wch:35},{wch:25},{wch:20},{wch:20},{wch:30},{wch:15}];
                XLSX.utils.book_append_sheet(wb, ws, 'ChinhSach');
            } else {
                const data = hallPricing.map((h, i) => ({
                    'STT': i + 1, 'Mã sảnh': h.maSanh, 'Tên sảnh': h.tenSanh,
                    'Sức chứa Min': h.sucChuaToiThieu, 'Sức chứa Max': h.sucChuaToiDa,
                    'Giá cơ sở': h.giaGoc, 'Ca trưa': h.giaCaTrua,
                    'Ca tối (+15%)': h.giaCaToi, 'Cuối tuần (+25%)': h.giaCuoiTuan, 'Trạng thái': h.trangThai
                }));
                const ws = XLSX.utils.json_to_sheet(data);
                ws['!cols'] = [{wch:5},{wch:15},{wch:25},{wch:15},{wch:15},{wch:20},{wch:20},{wch:20},{wch:20},{wch:15}];
                XLSX.utils.book_append_sheet(wb, ws, 'BangGia');
            }
            XLSX.writeFile(wb, `Riverside_${currentTab === 'payment' ? 'ChinhSach' : 'BangGia'}_2026.xlsx`);
            showToast('Thành công', 'Đã xuất file Excel thành công!');
        }
    </script>
}
