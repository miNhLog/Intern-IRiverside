@using System.Globalization
@model HeThongDatTiecCuoi_WEB.Models.Menus.MenuListViewModel
@{
    ViewData["Title"] = "Danh sách thực đơn";
    ViewData["PublicActivePage"] = "menus";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var placeholderImage = Url.Content("~/images/menus/menu-banquet.png");
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;family=Plus+Jakarta+Sans:wght@300..800&amp;family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/menu-list.css" asp-append-version="true" />
}

<div class="home-page menu-list-page">
    <partial name="_PublicHeader" />
    <main>
        <section class="menu-list-hero" aria-labelledby="menu-list-title">
            <div class="menu-list-hero-image" aria-hidden="true"></div>
            <div class="home-container menu-list-hero-content">
                <span class="menu-list-eyebrow">THỰC ĐƠN</span>
                <h1 id="menu-list-title">Tinh hoa ẩm thực<br />cho tiệc cưới trọn vẹn</h1>
                <p>Sự kết hợp tinh tế giữa hương vị truyền thống và phong cách ẩm thực hiện đại, mang đến trải nghiệm ẩm thực hoàn hảo cho ngày trọng đại của bạn.</p>
            </div>
        </section>

        <nav class="menu-breadcrumb" aria-label="Đường dẫn trang">
            <div class="home-container">
                <a asp-controller="Home" asp-action="Index"><span class="material-symbols-outlined" aria-hidden="true">home</span> Trang chủ</a>
                <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                <span aria-current="page">Thực đơn</span>
            </div>
        </nav>

        <section class="menu-catalog" aria-label="Danh sách thực đơn">
            <div class="home-container">
                <form class="menu-filter" method="get" asp-controller="Menus" asp-action="Index">
                    <div class="menu-filter-field menu-filter-keyword">
                        <label for="keyword">Tìm theo tên thực đơn</label>
                        <div class="menu-input-with-icon">
                            <span class="material-symbols-outlined" aria-hidden="true">search</span>
                            <input id="keyword" name="keyword" value="@Model.Keyword" placeholder="Nhập tên thực đơn..." />
                        </div>
                    </div>
                    <div class="menu-filter-field">
                        <label for="priceRange">Khoảng giá</label>
                        <select id="priceRange" name="priceRange">
                            <option value="" selected="@(string.IsNullOrEmpty(Model.PriceRange))">Tất cả</option>
                            <option value="under-10000000" selected="@(Model.PriceRange == "under-10000000")">Dưới 10 triệu</option>
                            <option value="10000000-15000000" selected="@(Model.PriceRange == "10000000-15000000")">10 - 15 triệu</option>
                            <option value="15000000-20000000" selected="@(Model.PriceRange == "15000000-20000000")">15 - 20 triệu</option>
                            <option value="over-20000000" selected="@(Model.PriceRange == "over-20000000")">Trên 20 triệu</option>
                        </select>
                    </div>
                    <input type="hidden" name="sort" value="@Model.Sort" />
                    <button class="menu-filter-button" type="submit">
                        <span class="material-symbols-outlined" aria-hidden="true">search</span>
                        Lọc thực đơn
                    </button>
                </form>

                <div class="menu-list-toolbar">
                    <p>Có <strong>@Model.TotalItems</strong> thực đơn phù hợp</p>
                    <form method="get" asp-controller="Menus" asp-action="Index" data-sort-form>
                        <input type="hidden" name="keyword" value="@Model.Keyword" />
                        <input type="hidden" name="priceRange" value="@Model.PriceRange" />
                        <label for="sort">Sắp xếp theo</label>
                        <select id="sort" name="sort">
                            <option value="name-asc" selected="@(Model.Sort == "name-asc")">Tên A - Z</option>
                            <option value="price-asc" selected="@(Model.Sort == "price-asc")">Giá thấp → cao</option>
                            <option value="price-desc" selected="@(Model.Sort == "price-desc")">Giá cao → thấp</option>
                            <option value="dish-count-desc" selected="@(Model.Sort == "dish-count-desc")">Nhiều món → ít món</option>
                        </select>
                    </form>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="menu-empty-state" role="alert">
                        <span class="material-symbols-outlined" aria-hidden="true">error</span>
                        <h2>Không thể tải danh sách thực đơn</h2>
                        <p>Không thể tải danh sách thực đơn. Vui lòng thử lại sau.</p>
                        <a asp-controller="Menus" asp-action="Index">Thử lại</a>
                    </div>
                }
                else if (Model.Menus.Count == 0)
                {
                    <div class="menu-empty-state">
                        <span class="material-symbols-outlined" aria-hidden="true">search_off</span>
                        <h2>Không tìm thấy thực đơn phù hợp</h2>
                        <p>Không tìm thấy thực đơn phù hợp với tiêu chí của bạn.</p>
                        <a asp-controller="Menus" asp-action="Index">Xóa bộ lọc</a>
                    </div>
                }
                else
                {
                    <div class="public-menu-grid">
                        @foreach (var menu in Model.Menus)
                        {
                            <article class="public-menu-card">
                                <a class="public-menu-image" href="/menus/@menu.MenuId" aria-label="Xem thực đơn @menu.MenuName">
                                    <img src="@placeholderImage" alt="@menu.MenuName" loading="lazy" data-fallback="@placeholderImage" />
                                </a>
                                <div class="public-menu-content">
                                    <h2>@menu.MenuName</h2>
                                    <p class="public-menu-description">@(string.IsNullOrWhiteSpace(menu.Description) ? "Khám phá thực đơn được Riverside Palace lựa chọn cho ngày trọng đại." : menu.Description)</p>
                                    <div class="public-menu-meta">
                                        <span><span class="material-symbols-outlined" aria-hidden="true">restaurant</span> @menu.DishCount món</span>
                                        <span class="public-menu-price"><strong>@menu.PricePerTable.ToString("N0", vi) VNĐ</strong><small>/ bàn</small></span>
                                    </div>
                                    <a class="public-menu-detail" href="/menus/@menu.MenuId">
                                        Xem thực đơn <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                                    </a>
                                </div>
                            </article>
                        }
                    </div>
                }

                @if (Model.TotalPages > 1)
                {
                    <nav class="menu-pagination" aria-label="Phân trang danh sách thực đơn">
                        <a class="@(Model.Page <= 1 ? "disabled" : null)" asp-controller="Menus" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-priceRange="@Model.PriceRange" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page - 1)" aria-label="Trang trước" aria-disabled="@(Model.Page <= 1)"><span class="material-symbols-outlined" aria-hidden="true">chevron_left</span></a>
                        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                        {
                            <a class="@(pageNumber == Model.Page ? "active" : null)" asp-controller="Menus" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-priceRange="@Model.PriceRange" asp-route-sort="@Model.Sort" asp-route-page="@pageNumber" aria-current="@(pageNumber == Model.Page ? "page" : null)">@pageNumber</a>
                        }
                        <a class="@(Model.Page >= Model.TotalPages ? "disabled" : null)" asp-controller="Menus" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-priceRange="@Model.PriceRange" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page + 1)" aria-label="Trang sau" aria-disabled="@(Model.Page >= Model.TotalPages)"><span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></a>
                    </nav>
                }
            </div>
        </section>
    </main>
    <partial name="_PublicFooter" />
    <div class="home-toast" role="status" aria-live="polite" hidden></div>
</div>

@section Scripts {
    <script src="~/js/hall-list.js" asp-append-version="true"></script>
}
