@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi tiết tiệc được phân công";
}

<header class="top-header">
    <div>
        <div class="breadcrumb">Quản trị hệ thống <span>›</span> Tiệc được phân công <span>›</span> <strong>Chi tiết tiệc</strong></div>
        <h2>Chi tiết tiệc</h2>
    </div>
</header>

<section class="content coordinator-detail-page">
    <div class="assignment-hero">
        <div>
            <span class="eyebrow">ĐIỀU PHỐI TIỆC</span>
            <h1>Thông tin tiệc được phân công</h1>
            <p>Chi tiết tiệc chỉ hiển thị khi xác nhận tiệc thuộc phạm vi của Điều phối viên hiện tại.</p>
        </div>
        <div class="coordinator-action-buttons">
            <button type="button" class="btn-add developing">Cập nhật tiến độ</button>
            <button type="button" class="btn-outline developing">Báo cáo sự cố</button>
        </div>
    </div>

    <div class="coordinator-detail-notice"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> Chưa thể tải tiệc mã #@ViewData["BookingId"] vì API chi tiết theo quyền Điều phối viên chưa được triển khai.</div>

    <div class="coordinator-detail-grid">
        <article class="coordinator-detail-section"><h3><i class="fa-solid fa-circle-info" aria-hidden="true"></i> Thông tin chung</h3><dl><dt>Khách hàng</dt><dd>Chưa có dữ liệu</dd><dt>Ngày / ca</dt><dd>Chưa có dữ liệu</dd><dt>Sảnh</dt><dd>Chưa có dữ liệu</dd><dt>Số khách / số bàn</dt><dd>Chưa có dữ liệu</dd></dl></article>
        <article class="coordinator-detail-section"><h3><i class="fa-solid fa-utensils" aria-hidden="true"></i> Ẩm thực</h3><dl><dt>Thực đơn</dt><dd>Chưa có dữ liệu</dd><dt>Món ăn</dt><dd>Chưa có dữ liệu</dd><dt>Ghi chú</dt><dd>Chưa có dữ liệu</dd></dl></article>
        <article class="coordinator-detail-section"><h3><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Decor &amp; Dịch vụ</h3><dl><dt>Gói trang trí</dt><dd>Chưa có dữ liệu</dd><dt>Dịch vụ đi kèm</dt><dd>Chưa có dữ liệu</dd></dl></article>
        <article class="coordinator-detail-section"><h3><i class="fa-solid fa-list-check" aria-hidden="true"></i> Tiến độ</h3><p>Danh sách công việc cần thực hiện sẽ hiển thị khi API tiến độ sẵn sàng.</p><button type="button" class="btn-outline developing">Đánh dấu hoàn tất</button></article>
        <article class="coordinator-detail-section"><h3><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Sự cố</h3><p>Sự cố đã phát sinh sẽ hiển thị khi API vận hành sẵn sàng.</p><button type="button" class="btn-outline developing">Đề xuất thay đổi lịch</button></article>
    </div>
</section>
