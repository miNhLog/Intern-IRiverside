@model HeThongDatTiecCuoi_WEB.Models.RoleChangeRequest.AdminRoleChangeRequestPageViewModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Yêu cầu thay đổi vai trò"; string RoleClass(string r)=>r=="Quản lý sảnh"?"role-hall-manager":"role-coordinator"; string StatusLabel(string s)=>s switch{"APPROVED"=>"Đã duyệt","REJECTED"=>"Từ chối",_=>"Chờ duyệt"}; }
@section Styles { <link rel="stylesheet" href="~/css/admin-account.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/manager-role-change.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-role-change.css" asp-append-version="true" /> }
<main class="role-change-page admin-role-page">
<nav class="role-change-breadcrumb">Quản trị hệ thống <i class="fa-solid fa-chevron-right"></i> Yêu cầu thay đổi vai trò</nav>
<header class="role-change-header"><h1>Yêu cầu thay đổi vai trò <small>@Model.Requests.Count(x=>x.Status=="PENDING") chờ duyệt</small></h1><p>Xem xét và xử lý các yêu cầu điều chỉnh vai trò nhân sự.</p></header>
@if(TempData["RoleAdminSuccess"] is string ok){<div class="role-alert success">@ok</div>} @if(TempData["RoleAdminError"] is string err){<div class="role-alert error">@err</div>} @if(Model.ErrorMessage is not null){<div class="role-alert error">@Model.ErrorMessage</div>}
<section class="role-change-card"><form method="get" class="admin-role-filters"><input name="keyword" value="@Model.Keyword" placeholder="Tìm theo tên hoặc mã nhân viên"/><select name="status"><option value="">Tất cả trạng thái</option><option value="PENDING" selected="@(Model.Status=="PENDING")">Chờ duyệt</option><option value="APPROVED" selected="@(Model.Status=="APPROVED")">Đã duyệt</option><option value="REJECTED" selected="@(Model.Status=="REJECTED")">Từ chối</option></select><button type="submit"><i class="fa-solid fa-magnifying-glass"></i> Lọc</button></form>
@if(Model.Requests.Count==0){<div class="history-empty"><i class="fa-solid fa-inbox"></i><h3>Không có yêu cầu phù hợp</h3><p>Các yêu cầu thay đổi vai trò sẽ xuất hiện tại đây.</p></div>}else{<div class="role-table-wrap"><table class="role-history-table admin-role-table"><thead><tr><th>Nhân viên</th><th>Chuyển đổi vai trò</th><th>Lý do đề xuất</th><th>Người gửi</th><th>Ngày gửi</th><th>Trạng thái</th><th>Người xử lý</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var item in Model.Requests){<tr><td><strong>@item.FullName</strong><small>@item.EmployeeCodeBefore@if(item.EmployeeCodeAfter is not null){<text> → @item.EmployeeCodeAfter</text>}</small></td><td><div class="role-inline"><span class="role-badge @RoleClass(item.CurrentRoleName)">@item.CurrentRoleName</span><i class="fa-solid fa-arrow-right"></i><span class="role-badge @RoleClass(item.RequestedRoleName)">@item.RequestedRoleName</span></div></td><td class="reason-cell">@(item.Reason??"—") @if(item.Status=="REJECTED"){<small class="reject-note">Lý do từ chối: @item.RejectionReason</small>}</td><td>@item.RequestedByName</td><td>@item.RequestedAt.ToString("dd/MM/yyyy HH:mm")</td><td><span class="status-badge status-@item.Status.ToLowerInvariant()">@StatusLabel(item.Status)</span></td><td>@(item.ReviewedByName??"—") @if(item.ReviewedAt.HasValue){<small>@item.ReviewedAt.Value.ToString("dd/MM/yyyy HH:mm")</small>}</td><td>@if(item.Status=="PENDING"){<div class="admin-role-actions"><button type="button" class="approve-open" disabled="@(!item.CanApprove)" title="@item.BlockingReason" data-id="@item.RoleChangeRequestId" data-name="@item.FullName" data-code="@item.EmployeeCodeBefore" data-current="@item.CurrentRoleName" data-requested="@item.RequestedRoleName">Duyệt</button><button type="button" class="reject-open" data-id="@item.RoleChangeRequestId" data-name="@item.FullName" data-current="@item.CurrentRoleName" data-requested="@item.RequestedRoleName">Từ chối</button></div>@if(!item.CanApprove){<small class="blocking-reason"><i class="fa-solid fa-triangle-exclamation"></i> @item.BlockingReason</small>}}else{<span>Đã xử lý</span>}</td></tr>}
</tbody></table></div>}</section></main>
<div class="account-modal-overlay role-action-modal" id="approveModal" aria-hidden="true"><div class="account-modal"><div class="account-modal-header"><h3>Xác nhận duyệt yêu cầu</h3><button type="button" data-close><i class="fa-solid fa-xmark"></i></button></div><p id="approveSummary"></p><div class="modal-notice">Khi duyệt, hệ thống sẽ cập nhật vai trò và cấp lại mã nhân viên theo vai trò mới. Nhân viên cần đăng xuất và đăng nhập lại để nhận quyền mới.</div><form id="approveForm" method="post">@Html.AntiForgeryToken()<div class="account-modal-actions"><button type="button" data-close>Hủy</button><button class="approve-confirm" type="submit">Xác nhận duyệt</button></div></form></div></div>
<div class="account-modal-overlay role-action-modal" id="rejectModal" aria-hidden="true"><div class="account-modal"><div class="account-modal-header"><h3>Từ chối yêu cầu</h3><button type="button" data-close><i class="fa-solid fa-xmark"></i></button></div><p id="rejectSummary"></p><form id="rejectForm" method="post">@Html.AntiForgeryToken()<div class="role-field"><label>Lý do từ chối</label><textarea name="RejectionReason" maxlength="500" required rows="4"></textarea></div><div class="account-modal-actions"><button type="button" data-close>Hủy</button><button class="reject-confirm" type="submit">Xác nhận từ chối</button></div></form></div></div>
@section Scripts { <script>(()=>{const open=m=>{m.classList.add('show');m.setAttribute('aria-hidden','false')},close=m=>{m.classList.remove('show');m.setAttribute('aria-hidden','true')};document.querySelectorAll('.role-action-modal').forEach(m=>m.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>close(m)));document.querySelectorAll('.approve-open').forEach(b=>b.onclick=()=>{document.getElementById('approveSummary').textContent=`${b.dataset.name} (${b.dataset.code}): ${b.dataset.current} → ${b.dataset.requested}`;document.getElementById('approveForm').action=`/quan-tri/yeu-cau-thay-doi-vai-tro/${b.dataset.id}/duyet`;open(document.getElementById('approveModal'))});document.querySelectorAll('.reject-open').forEach(b=>b.onclick=()=>{document.getElementById('rejectSummary').textContent=`${b.dataset.name}: ${b.dataset.current} → ${b.dataset.requested}`;document.getElementById('rejectForm').action=`/quan-tri/yeu-cau-thay-doi-vai-tro/${b.dataset.id}/tu-choi`;open(document.getElementById('rejectModal'))})})();</script> }
