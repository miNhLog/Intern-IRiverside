@model HeThongDatTiecCuoi_WEB.Models.Notification.NotificationPageViewModel
@{ Layout="_AdminLayout"; ViewData["Title"]="Thông báo"; }
@section Styles { <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" /> }
<main class="notifications-page"><nav>Thông báo</nav><header><div><h1>Thông báo</h1><p>Theo dõi các cập nhật và yêu cầu liên quan đến tài khoản của bạn.</p></div>@if(Model.UnreadCount>0){<button type="button" id="pageMarkAllRead">Đánh dấu tất cả đã đọc</button>}</header>
<div class="notification-filters"><a asp-action="Index" class="@(string.IsNullOrWhiteSpace(Model.ReadStatus)?"active":"")">Tất cả</a><a asp-action="Index" asp-route-readStatus="UNREAD" class="@(Model.ReadStatus=="UNREAD"?"active":"")">Chưa đọc</a><a asp-action="Index" asp-route-readStatus="READ" class="@(Model.ReadStatus=="READ"?"active":"")">Đã đọc</a></div>
@if(Model.ErrorMessage is not null){<div class="role-alert error">@Model.ErrorMessage</div>}
<section class="notification-page-list">
@if(Model.Items.Count==0){<div class="notification-page-empty"><i class="fa-regular fa-bell-slash"></i><h2>Chưa có thông báo</h2><p>Các cập nhật quan trọng sẽ xuất hiện tại đây.</p></div>}
else{@foreach(var item in Model.Items){<button type="button" class="notification-page-item @(!item.IsRead?"unread":"")" data-notification-id="@item.NotificationId" data-navigation-url="@item.NavigationUrl"><span class="notification-type-icon"><i class="fa-solid fa-bell"></i></span><span><strong>@item.Title</strong><span>@item.Message</span><small data-created-at="@item.CreatedAt.ToString("O")">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></span>@if(!item.IsRead){<i class="notification-unread-dot"></i>}</button>}}
</section>
@if(Model.TotalPages>1){<nav class="notification-pagination">@for(var p=1;p<=Model.TotalPages;p++){<a asp-action="Index" asp-route-page="@p" asp-route-readStatus="@Model.ReadStatus" class="@(p==Model.CurrentPage?"active":"")">@p</a>}</nav>}
</main>
