@model HeThongDatTiecCuoi_WEB.Models.Recommendation.RecommendationRequestViewModel
@{
    ViewData["Title"] = "Gợi ý gói tiệc cưới Top 3 tối ưu - Riverside Palace";
    ViewData["PublicActivePage"] = "recommendation";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;family=Plus+Jakarta+Sans:wght@300..800&amp;family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

    <style>
        .recom-main-wrapper {
            background-color: #FAF8F5;
            padding: 50px 20px 80px 20px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #1E293B;
        }

        .recom-box-limit {
            max-width: 1140px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 32px;
        }

        .recom-card {
            background: #FFFFFF;
            border-radius: 20px;
            border: 1px solid #E2E8F0;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.04);
        }

        .recom-gold-card {
            background: linear-gradient(135deg, #FFFFFF 0%, #FAF8F5 100%);
            border: 2px solid #B89758;
            box-shadow: 0 18px 30px -8px rgba(184, 151, 88, 0.22);
            position: relative;
        }

        .recom-form-control {
            width: 100%;
            padding: 12px 16px;
            background-color: #FAF8F5;
            border: 1px solid #E2E8F0;
            border-radius: 12px;
            color: #1E293B;
            font-size: 13px;
            box-sizing: border-box;
            outline: none;
            transition: all 0.2s;
        }

            .recom-form-control:focus {
                border-color: #B89758;
                background-color: #FFFFFF;
            }

        .recom-btn-gold {
            background-color: #B89758;
            color: #FFFFFF;
            font-weight: 700;
            border-radius: 12px;
            padding: 14px 28px;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .recom-btn-gold:hover {
                background-color: #8C6D32;
            }

        .recom-btn-dark {
            background-color: #1E293B;
            color: #FFFFFF;
            font-weight: 700;
            border-radius: 12px;
            padding: 12px 20px;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
        }

            .recom-btn-dark:hover {
                background-color: #0F172A;
            }

        .recom-slot-free {
            background-color: #ECFDF5;
            border: 1.5px solid #10B981;
            color: #065F46;
            cursor: pointer;
            padding: 10px;
            border-radius: 12px;
            text-align: center;
            transition: all 0.2s;
        }

            .recom-slot-free:hover {
                background-color: #10B981;
                color: #FFFFFF;
                transform: translateY(-2px);
            }

        .recom-slot-locked {
            background-color: #F1F5F9;
            border: 1.5px solid #CBD5E1;
            color: #94A3B8;
            cursor: not-allowed;
            padding: 10px;
            border-radius: 12px;
            text-align: center;
            opacity: 0.7;
        }

        .recom-custom-modal {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(4px);
            z-index: 99999;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

        .recom-grid-3 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 16px;
        }

        .recom-grid-4 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
        }
    </style>
}

<div class="home-page">
    <!-- ĐỒNG BỘ 100% HEADER NHƯ TRANG CHỦ -->
    <partial name="_PublicHeader" />

    <main class="recom-main-wrapper">
        <div class="recom-box-limit">

            <!-- Banner giới thiệu -->
            <div style="text-align: center; max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 12px;">
                <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 999px; font-size: 11px; font-weight: 700; background: rgba(184, 151, 88, 0.15); color: #8C6D32; border: 1px solid rgba(184, 151, 88, 0.3);">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> AI Wedding Recommendation Engine
                </span>
                <h1 style="font-family: 'Playfair Display', serif; font-size: 38px; font-weight: 700; color: #0F172A; margin: 0; line-height: 1.2;">
                    Thiết Kế Đám Cưới Trong Mơ
                </h1>
                <p style="font-size: 14px; color: #64748B; margin: 0; line-height: 1.6;">
                    Nhập kế hoạch dự toán ngân sách và ý tưởng của hai bạn. Thuật toán sẽ rà soát dữ liệu thực tế tại 9 đại sảnh, 24 set thực đơn và các concept decor để đề xuất <strong>Top 3 Gói Tiệc Tối Ưu Nhất</strong>.
                </p>
            </div>

            <!-- Form khảo sát 5 nhóm tiêu chí -->
            <form id="clientRecomForm" onsubmit="handleAnalyzeCombos(event)" class="recom-card" style="padding: 36px; display: flex; flex-direction: column; gap: 28px;">

                <!-- Phần 1: Cặp đôi (Tự động điền) -->
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                        <h3 style="font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin: 0; display: flex; align-items: center; gap: 8px;">
                            <span style="width: 24px; height: 24px; border-radius: 999px; background: #B89758; color: #FFF; display: flex; align-items: center; justify-content: center; font-size: 12px;">1</span>
                            <span>Thông Tin Cặp Đôi</span>
                        </h3>
                        <span style="font-size: 12px; color: #94A3B8; font-style: italic;">Có thể chỉnh sửa trực tiếp thông tin liên hệ</span>
                    </div>
                    <div class="recom-grid-3">
                        <div>
                            <label style="display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 6px;">Họ tên Cô dâu &amp; Chú rể *</label>
                            <input type="text" id="coupleName" required value="@Model.CoupleName" placeholder="VD: Trần Hoàng &amp; Mai Phương" class="recom-form-control">
                        </div>
                        <div>
                            <label style="display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 6px;">Số điện thoại liên hệ *</label>
                            <input type="tel" id="phoneNumber" required value="@Model.PhoneNumber" placeholder="09xxxxxxxx" class="recom-form-control">
                        </div>
                        <div>
                            <label style="display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 6px;">Email nhận bảng dự toán</label>
                            <input type="email" id="email" value="@Model.Email" placeholder="wedding@gmail.com" class="recom-form-control">
                        </div>
                    </div>
                </div>

                <hr style="border: none; border-top: 1px solid #F1F5F9; margin: 0;">

                <!-- Phần 2: Thời gian & Ràng buộc số bàn -->
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
                        <h3 style="font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin: 0; display: flex; align-items: center; gap: 8px;">
                            <span style="width: 24px; height: 24px; border-radius: 999px; background: #B89758; color: #FFF; display: flex; align-items: center; justify-content: center; font-size: 12px;">2</span>
                            <span>Thời Gian Tổ Chức &amp; Quy Mô Bàn Tiệc</span>
                        </h3>
                        <button type="button" onclick="openShowtimeModal()" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 10px; font-size: 12px; font-weight: 700; color: #8C6D32; background: rgba(184, 151, 88, 0.15); border: 1px solid rgba(184, 151, 88, 0.3); cursor: pointer;">
                            <i class="fa-solid fa-calendar-check"></i>
                            <span>Xem Lịch &amp; Ca Trống Thực Tế</span>
                        </button>
                    </div>

                    <div class="recom-grid-4">
                        <div>
                            <label style="display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 6px;">Ngày tổ chức dự kiến *</label>
                            <input type="date" id="eventDate" required onchange="handleDateChanged()" class="recom-form-control">
                        </div>
                        <div>
                            <label style="display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 6px;">Buổi tiệc mong muốn *</label>
                            <select id="shift" class="recom-form-control" style="cursor: pointer;">
                                <option value="Ca tối" selected>Buổi tối (17:30 – 21:30)</option>
                                <option value="Ca trưa">Buổi trưa (10:30 – 14:00)</option>
                            </select>
                        </div>
                        <div>
                            <label style="display: flex; justify-content: space-between; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 6px;">
                                <span>Bàn chính thức *</span>
                                <span style="color: #B89758; font-weight: 700;">10 – 120 bàn</span>
                            </label>
                            <input type="number" id="officialTableCount" required min="10" max="120" value="25" onchange="validateTableCounts()" class="recom-form-control" style="font-weight: 700;">
                        </div>
                        <div>
                            <label style="display: flex; justify-content: space-between; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 6px;">
                                <span>Bàn dự phòng</span>
                                <span style="color: #B89758; font-weight: 700;">1 – 10 bàn</span>
                            </label>
                            <input type="number" id="spareTableCount" required min="1" max="10" value="2" onchange="validateTableCounts()" class="recom-form-control">
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin-top: 16px;">
                        <div>
                            <label style="display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 6px;">Tổng ngân sách dự trù (VNĐ) *</label>
                            <input type="number" id="expectedBudget" required step="5000000" min="50000000" max="3000000000" value="250000000" class="recom-form-control" style="font-weight: 700;">
                        </div>
                        <div>
                            <label style="display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 6px;">Ưu tiên cân đối</label>
                            <select id="budgetPriority" class="recom-form-control" style="cursor: pointer;">
                                <option value="BALANCED" selected>Cân đối toàn diện (Ẩm thực ngon &amp; Không gian lộng lẫy)</option>
                                <option value="PRIORITIZE_FOOD">Ưu tiên Ẩm thực (Nâng cấp thực đơn hải sản cao cấp)</option>
                                <option value="PRIORITIZE_DECOR">Ưu tiên Không gian (Sảnh tiệc hoành tráng &amp; decor hoa tươi)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <hr style="border: none; border-top: 1px solid #F1F5F9; margin: 0;">

                <!-- Phần 3: Phong cách & Dịch vụ đi kèm -->
                <div>
                    <h3 style="font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 16px 0; display: flex; align-items: center; gap: 8px;">
                        <span style="width: 24px; height: 24px; border-radius: 999px; background: #B89758; color: #FFF; display: flex; align-items: center; justify-content: center; font-size: 12px;">3</span>
                        <span>Gu Thẩm Mỹ &amp; Dịch Vụ Cưới Trọn Gói</span>
                    </h3>
                    <div class="recom-grid-3">
                        <div>
                            <label style="display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 6px;">Không gian yêu thích</label>
                            <select id="preferredSpaceType" class="recom-form-control" style="cursor: pointer;">
                                <option value="">-- Tùy chọn linh hoạt --</option>
                                <option value="INDOOR_PILLARLESS">Đại sảnh vòm trần cao không cột (Grand Ballroom, Seine)</option>
                                <option value="OUTDOOR_RIVER">Sân vườn ven sông thoáng đãng (Green Riverside)</option>
                                <option value="COZY_INTIMATE">Ấm cúng, thanh lịch (Elbe, Danube, Amur)</option>
                            </select>
                        </div>
                        <div>
                            <label style="display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 6px;">Concept Decor Hot Trend (TikTok)</label>
                            <select id="desiredStyle" class="recom-form-control" style="cursor: pointer;">
                                <option value="Hiện đại / lãng mạn" selected>🌊 Midnight Celestial Blue (Đêm Huyền Bí Sắc Xanh)</option>
                                <option value="Hoàng gia">✨ Royal Versailles Gold (Hoàng Gia Versailles)</option>
                                <option value="Sân vườn / lãng mạn">🌿 Botanical Garden Muse (Vườn Cổ Tích Rustic)</option>
                                <option value="Cổ tích / lãng mạn">🌸 Fairy Princesscore (Công Chúa Ngọt Ngào)</option>
                                <option value="Nhẹ nhàng">🕊️ Pure Minimalism (Trắng Pha Lê Tinh Giản)</option>
                            </select>
                        </div>
                        <div>
                            <label style="display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 6px;">Phong vị ẩm thực chủ đạo</label>
                            <select id="foodPreference" class="recom-form-control" style="cursor: pointer;">
                                <option value="EUROPEAN_FUSION" selected>Á - Âu Đương đại (Bò Mỹ, Cá hồi, Mì vịt quay)</option>
                                <option value="SEAFOOD_PREMIUM">Đặc sản Hải sản Cao cấp (Cua, Tôm càng, Cá tầm)</option>
                                <option value="ASIAN_TRADITIONAL">Á Đông Tinh Hoa (Hương vị truyền thống)</option>
                            </select>
                        </div>
                    </div>

                    <div style="margin-top: 16px; padding-top: 12px; border-top: 1px solid #F1F5F9;">
                        <span style="display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 10px;">Dịch vụ trọn gói đề xuất:</span>
                        <div style="display: flex; flex-wrap: wrap; gap: 16px; font-size: 12px;">
                            <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; color: #334155;">
                                <input type="checkbox" name="services" value="DV001" checked>
                                <span>MC Nghi Lễ Cưới (+5.000.000 đ)</span>
                            </label>
                            <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; color: #334155;">
                                <input type="checkbox" name="services" value="DV002" checked>
                                <span>Âm thanh &amp; Ánh sáng sân khấu (+12.000.000 đ)</span>
                            </label>
                            <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; color: #334155;">
                                <input type="checkbox" name="services" value="DV004">
                                <span>Vũ đoàn khai mạc tiệc (+7.000.000 đ)</span>
                            </label>
                            <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; color: #334155;">
                                <input type="checkbox" name="services" value="DV005">
                                <span>Đội ngũ Lễ tân đón khách (+3.000.000 đ)</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div style="display: flex; justify-content: flex-end; padding-top: 10px; border-top: 1px solid #F1F5F9;">
                    <button type="submit" id="btnSubmitRecom" class="recom-btn-gold">
                        <i class="fa-solid fa-sparkles"></i>
                        <span>Tính Toán &amp; Trích Xuất Top 3 Combo</span>
                    </button>
                </div>
            </form>

            <!-- Trạng thái chờ -->
            <div id="loadingState" style="display: none; padding: 60px 0; text-align: center;">
                <div style="display: inline-block; width: 44px; height: 44px; border: 4px solid rgba(184, 151, 88, 0.2); border-top-color: #B89758; border-radius: 50%; animation: spin 1s linear infinite;"></div>
                <p style="font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700; color: #0F172A; margin-top: 16px;">Scoring Engine đang chấm điểm ma trận phương án...</p>
                <p style="font-size: 13px; color: #64748B;">Đang đối soát lịch trống tại 9 sảnh, so khớp 24 set thực đơn và điểm tín nhiệm 5 sao từ CSDL.</p>
            </div>

            <!-- Khu vực kết quả Top 3 Combo -->
            <div id="resultsSection" style="display: none; flex-direction: column; gap: 24px;">
                <div class="recom-card" style="padding: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div>
                        <h2 style="font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: #0F172A; margin: 0;">Gợi Ý Gói Tiệc Cưới Dành Riêng Cho Hai Bạn</h2>
                        <p style="font-size: 12px; color: #64748B; margin: 4px 0 0 0;" id="resNotice">Đã phân tích hàng trăm phương án để chọn ra 3 lựa chọn xuất sắc nhất.</p>
                    </div>
                    <button type="button" onclick="window.scrollTo({top: 150, behavior: 'smooth'})" style="padding: 8px 16px; border-radius: 10px; font-size: 12px; font-weight: 700; background: #F1F5F9; border: 1px solid #E2E8F0; color: #334155; cursor: pointer;">
                        <i class="fa-solid fa-sliders" style="margin-right: 4px;"></i> Đổi tiêu chí
                    </button>
                </div>

                <div id="combosCardsContainer" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;"></div>
            </div>

        </div>
    </main>

    <!-- ĐỒNG BỘ 100% FOOTER NHƯ TRANG CHỦ -->
    <partial name="_PublicFooter" />
</div>

<!-- Modal 1: Chi tiết hạng mục từ DB -->
<div id="itemDetailModal" class="recom-custom-modal">
    <div style="background: #FFFFFF; border-radius: 24px; max-width: 520px; width: 100%; padding: 24px; position: relative; max-height: 90vh; overflow-y: auto; box-sizing: border-box;">
        <button type="button" onclick="closeDetailModal()" style="position: absolute; top: 16px; right: 16px; width: 32px; height: 32px; border-radius: 50%; border: none; background: #F1F5F9; color: #64748B; cursor: pointer;">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div id="modalIconBox" style="width: 44px; height: 44px; border-radius: 12px; background: rgba(184, 151, 88, 0.15); color: #8C6D32; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                <i class="fa-solid fa-circle-info"></i>
            </div>
            <div>
                <span id="modalSubTitle" style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: #B89758; display: block;">Hạng Mục Tiệc Cưới</span>
                <h3 id="modalTitle" style="font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700; color: #0F172A; margin: 0;">Chi Tiết Hạng Mục</h3>
            </div>
        </div>
        <div style="background: #FAF8F5; padding: 12px 16px; border-radius: 12px; border: 1px solid #E2E8F0; display: flex; justify-content: space-between; align-items: center; font-size: 13px; margin-bottom: 16px;">
            <span style="color: #64748B;">Đơn giá niêm yết:</span>
            <span id="modalPriceVal" style="font-weight: 700; color: #0F172A; font-size: 15px;">-- đ</span>
        </div>
        <div style="font-size: 13px; color: #475569; display: flex; flex-direction: column; gap: 12px;">
            <div>
                <strong style="color: #0F172A; display: block; margin-bottom: 4px;">Mô tả từ cơ sở dữ liệu:</strong>
                <p id="modalDescription" style="margin: 0; background: #F8FAFC; padding: 12px; border-radius: 10px; border: 1px solid #E2E8F0; line-height: 1.5;">Nội dung chi tiết...</p>
            </div>
            <div id="modalDishesContainer" style="display: none;">
                <strong style="color: #0F172A; display: block; margin-bottom: 4px;">Chi tiết thực đơn:</strong>
                <div id="modalDishesText" style="background: #F8FAFC; padding: 12px; border-radius: 10px; border: 1px solid #E2E8F0; line-height: 1.5;"></div>
            </div>
            <div style="padding: 10px 14px; border-radius: 10px; background: #FEF3C7; color: #92400E; font-size: 12px; border: 1px solid #FDE68A;">
                <i class="fa-solid fa-circle-check" style="color: #10B981; margin-right: 4px;"></i>
                <span id="modalNote">Dữ liệu được đồng bộ trực tiếp từ cơ sở dữ liệu Riverside Palace.</span>
            </div>
        </div>
        <button type="button" onclick="closeDetailModal()" class="recom-btn-dark" style="width: 100%; margin-top: 20px; font-size: 13px;">
            Đã Hiểu &amp; Đóng Lại
        </button>
    </div>
</div>

<!-- Modal 2: Xem lịch & ca trống từ DB -->
<div id="showtimeModal" class="recom-custom-modal">
    <div style="background: #FFFFFF; border-radius: 24px; max-width: 820px; width: 100%; padding: 28px; position: relative; max-height: 90vh; overflow-y: auto; box-sizing: border-box;">
        <button type="button" onclick="closeShowtimeModal()" style="position: absolute; top: 20px; right: 20px; width: 32px; height: 32px; border-radius: 50%; border: none; background: #F1F5F9; color: #64748B; cursor: pointer;">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 20px;">
            <div>
