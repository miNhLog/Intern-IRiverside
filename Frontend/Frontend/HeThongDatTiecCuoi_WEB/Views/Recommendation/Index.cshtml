@section Scripts {
    <script>
        let currentPayload = null;
        let selectedComboToBook = null;

        document.addEventListener('DOMContentLoaded', () => {
            const d = new Date();
            d.setDate(d.getDate() + 60);
            const dateStr = d.toISOString().split('T')[0];
            document.getElementById('eventDate').value = dateStr;
            document.getElementById('modalDatePicker').value = dateStr;
        });

        function handleDateChanged() {
            const val = document.getElementById('eventDate').value;
            document.getElementById('modalDatePicker').value = val;
        }

        function validateTableCounts() {
            const offInput = document.getElementById('officialTableCount');
            const spareInput = document.getElementById('spareTableCount');

            let off = parseInt(offInput.value) || 10;
            let spare = parseInt(spareInput.value) || 1;

            if (off < 10) off = 10;
            if (off > 120) off = 120;
            offInput.value = off;

            const maxSpareAllowed = Math.min(10, Math.max(1, Math.round(off * 0.15)));
            if (spare < 1) spare = 1;
            if (spare > maxSpareAllowed) spare = maxSpareAllowed;
            spareInput.value = spare;
        }

        async function handleAnalyzeCombos(e) {
            e.preventDefault();
            validateTableCounts();

            const btn = document.getElementById('btnSubmitRecom');
            const loading = document.getElementById('loadingState');
            const results = document.getElementById('resultsSection');

            btn.disabled = true;
            btn.style.opacity = '0.6';
            loading.style.display = 'block';
            results.style.display = 'none';

            const selectedServices = [];
            document.querySelectorAll('input[name="services"]:checked').forEach(cb => selectedServices.push(cb.value));

            currentPayload = {
                coupleName: document.getElementById('coupleName').value.trim(),
                phoneNumber: document.getElementById('phoneNumber').value.trim(),
                email: document.getElementById('email').value.trim(),
                eventDate: document.getElementById('eventDate').value,
                shift: document.getElementById('shift').value,
                officialTableCount: parseInt(document.getElementById('officialTableCount').value),
                spareTableCount: parseInt(document.getElementById('spareTableCount').value) || 1,
                guestCount: (parseInt(document.getElementById('officialTableCount').value) + (parseInt(document.getElementById('spareTableCount').value) || 1)) * 10,
                expectedBudget: parseFloat(document.getElementById('expectedBudget').value),
                budgetPriority: document.getElementById('budgetPriority').value,
                preferredSpaceType: document.getElementById('preferredSpaceType').value || null,
                desiredStyle: document.getElementById('desiredStyle').value || null,
                foodPreference: document.getElementById('foodPreference').value || null,
                selectedServiceCodes: selectedServices
            };

            try {
                const res = await fetch('/Recommendation/AnalyzeTop3', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(currentPayload)
                });
                const result = await res.json();

                btn.disabled = false;
                btn.style.opacity = '1';
                loading.style.display = 'none';

                if (result.success && result.data) {
                    renderCombosResult(result.data, currentPayload);
                    results.style.display = 'flex';
                    results.scrollIntoView({ behavior: 'smooth', block: 'start' });
                } else {
                    alert(result.message || 'Không tìm thấy gói tiệc khả dụng trong ngày và ca này. Hãy nhấn "Xem Lịch & Ca Trống" để chọn thời điểm phù hợp.');
                }
            } catch (err) {
                btn.disabled = false;
                btn.style.opacity = '1';
                loading.style.display = 'none';
                alert('Lỗi kết nối khi phân tích gói tiệc.');
            }
        }

        function renderCombosResult(data, req) {
            document.getElementById('resNotice').innerText = data.algorithmNotice || data.AlgorithmNotice;
            const container = document.getElementById('combosCardsContainer');
            container.innerHTML = '';

            const combos = data.topCombos || data.TopCombos || [];
            const totalTables = req.officialTableCount + req.spareTableCount;

            combos.forEach(c => {
                const isBest = (c.comboType || c.ComboType) === 'BALANCED';
                const cardClass = isBest ? 'recom-gold-card' : 'recom-card';

                const matchScore = c.overallMatchScore ?? c.OverallMatchScore ?? 90;
                const title = c.comboTitle || c.ComboTitle;
                const badge = c.comboBadge || c.ComboBadge;
                const totalCost = Number(c.totalEstimatedCost ?? c.TotalEstimatedCost ?? 0).toLocaleString('vi-VN');
                const analysisText = c.budgetAnalysisText || c.BudgetAnalysisText || '';

                const hallName = c.hallName || c.HallName;
                const hallPrice = Number(c.hallRentalPrice ?? c.HallRentalPrice ?? 0).toLocaleString('vi-VN');
                const hallCap = c.hallCapacity ?? c.HallCapacity ?? 0;
                const hallDesc = (c.hallDescription || c.HallDescription || '').replace(/'/g, "\\'");

                const menuName = c.menuName || c.MenuName;
                const menuPriceNum = Number(c.menuPricePerTable ?? c.MenuPricePerTable ?? 0);
                const menuPriceStr = menuPriceNum.toLocaleString('vi-VN');
                const menuTotalCalc = (menuPriceNum * totalTables).toLocaleString('vi-VN');
                const menuDesc = (c.menuDescription || c.MenuDescription || '').replace(/'/g, "\\'");

                const decorName = c.decorationPackageName || c.DecorationPackageName;
                const decorPrice = Number(c.decorationPrice ?? c.DecorationPrice ?? 0).toLocaleString('vi-VN');
                const decorStyle = c.decorationStyle || c.DecorationStyle;
                const decorDesc = (c.decorationDescription || c.DecorationDescription || '').replace(/'/g, "\\'");

                const services = c.includedServices || c.IncludedServices || [];
                let servicesListHtml = '';
                services.forEach(s => {
                    servicesListHtml += `
                        <div onclick="showServiceDetail('${(s.serviceName || s.ServiceName).replace(/'/g, "\\'")}', '${Number(s.price || s.Price).toLocaleString('vi-VN')} đ', '${(s.note || s.Note || 'Dịch vụ trọn gói Riverside').replace(/'/g, "\\'")}')" style="padding: 10px; background: #F8FAFC; border-radius: 12px; border: 1px solid #E2E8F0; cursor: pointer; display: flex; justify-content: space-between; align-items: center; font-size: 11px;">
                            <span><i class="fa-solid fa-check" style="color: #10B981; margin-right: 6px;"></i>${s.serviceName || s.ServiceName}</span>
                            <span style="color: #64748B; font-weight: 600;">${Number(s.price || s.Price).toLocaleString('vi-VN')} đ <i class="fa-solid fa-chevron-right" style="font-size: 9px; margin-left: 4px;"></i></span>
                        </div>
                    `;
                });

                container.innerHTML += `
                    <div class="${cardClass}" style="padding: 24px; display: flex; flex-direction: column; justify-content: space-between;">
                        ${isBest ? `
                            <div style="position: absolute; top: -14px; left: 50%; transform: translateX(-50%); background: #B89758; color: #FFF; padding: 4px 16px; border-radius: 999px; font-size: 11px; font-weight: 700; text-transform: uppercase; box-shadow: 0 4px 10px rgba(184, 151, 88, 0.3);">
                                <i class="fa-solid fa-crown"></i> Lựa Chọn Đề Xuất Số 1
                            </div>
                        ` : ''}

                        <div style="display: flex; flex-direction: column; gap: 16px; ${isBest ? 'padding-top: 10px;' : ''}">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 3px 10px; border-radius: 999px; background: ${isBest ? '#B89758' : '#F1F5F9'}; color: ${isBest ? '#FFF' : '#475569'};">
                                        ${badge}
                                    </span>
                                    <h4 style="font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700; color: #0F172A; margin: 6px 0 0 0;">${title}</h4>
                                </div>
                                <div style="text-align: right;">
                                    <span style="font-size: 10px; color: #94A3B8; font-weight: 600; display: block;">Tương Thích</span>
                                    <span style="font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 900; color: #B89758;">${matchScore}%</span>
                                </div>
                            </div>

                            <!-- 4 Thang điểm Explainable AI -->
                            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; background: #F8FAFC; padding: 10px; border-radius: 14px; border: 1px solid #E2E8F0; text-align: center; font-size: 10px;">
                                <div><span style="color: #94A3B8; display: block;">Ngân sách</span><strong style="color: #1E293B;">${c.budgetMatchScore ?? c.BudgetMatchScore}%</strong></div>
                                <div><span style="color: #94A3B8; display: block;">Sức chứa</span><strong style="color: #1E293B;">${c.spaceFitScore ?? c.SpaceFitScore}%</strong></div>
                                <div><span style="color: #94A3B8; display: block;">Phong cách</span><strong style="color: #1E293B;">${c.styleThemeScore ?? c.StyleThemeScore}%</strong></div>
                                <div><span style="color: #94A3B8; display: block;">Hài lòng</span><strong style="color: #1E293B;">${c.ratingCredibilityScore ?? c.RatingCredibilityScore}%</strong></div>
                            </div>

                            <div style="display: flex; flex-direction: column; gap: 10px; font-size: 12px;">
                                <div onclick="showDetailModal('HALL', '${hallName}', '${hallPrice} đ', '${hallDesc}', ${hallCap})" style="padding: 12px; background: #FFFFFF; border-radius: 14px; border: 1px solid #E2E8F0; cursor: pointer;">
                                    <div style="display: flex; justify-content: space-between; font-weight: 700; color: #1E293B;">
                                        <span><i class="fa-solid fa-archway" style="color: #B89758; margin-right: 6px;"></i>${hallName}</span>
                                        <span>${hallPrice} đ</span>
                                    </div>
                                    <span style="font-size: 11px; color: #64748B; display: block; margin-top: 3px;">Sức chứa: ${hallCap} bàn • Nhấn để xem chi tiết <i class="fa-solid fa-circle-question" style="color: #94A3B8;"></i></span>
                                </div>

                                <div onclick="showDetailModal('MENU', '${menuName}', '${menuPriceStr} đ/bàn', '${menuDesc}', ${totalTables})" style="padding: 12px; background: #FFFFFF; border-radius: 14px; border: 1px solid #E2E8F0; cursor: pointer;">
                                    <div style="display: flex; justify-content: space-between; font-weight: 700; color: #1E293B;">
                                        <span><i class="fa-solid fa-utensils" style="color: #B89758; margin-right: 6px;"></i>${menuName}</span>
                                        <span>${menuPriceStr} đ/bàn</span>
                                    </div>
                                    <div style="margin-top: 4px; padding-top: 4px; border-top: 1px solid #F1F5F9; display: flex; justify-content: space-between; font-size: 11px; font-weight: 600;">
                                        <span style="color: #64748B;">${totalTables} bàn (${req.officialTableCount} chính + ${req.spareTableCount} sơ cua):</span>
                                        <span style="color: #B89758; font-weight: 700;">${menuTotalCalc} đ</span>
                                    </div>
                                </div>

                                <div onclick="showDetailModal('DECOR', '${decorName}', '${decorPrice} đ', '${decorDesc}', '${decorStyle}')" style="padding: 12px; background: #FFFFFF; border-radius: 14px; border: 1px solid #E2E8F0; cursor: pointer;">
                                    <div style="display: flex; justify-content: space-between; font-weight: 700; color: #1E293B;">
                                        <span><i class="fa-solid fa-wand-magic-sparkles" style="color: #B89758; margin-right: 6px;"></i>${decorName}</span>
                                        <span>${decorPrice} đ</span>
                                    </div>
                                    <span style="font-size: 11px; color: #64748B; display: block; margin-top: 3px;">Tone chủ đạo: ${decorStyle} • Nhấn xem chi tiết <i class="fa-solid fa-circle-question" style="color: #94A3B8;"></i></span>
                                </div>

                                ${servicesListHtml}
                            </div>
                        </div>

                        <div style="margin-top: 20px; padding-top: 16px; border-top: 1px solid #E2E8F0;">
                            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px;">
                                <span style="font-size: 12px; color: #64748B;">Dự toán trọn gói:</span>
                                <span style="font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700; color: #0F172A;">${totalCost} đ</span>
                            </div>
                            <p style="font-size: 11px; color: #10B981; font-weight: 700; margin: 0 0 14px 0;">${analysisText}</p>

                            <button type="button" onclick="openBookingConfirmModal(${c.hallId ?? c.HallId}, '${hallName}', ${c.menuId ?? c.MenuId}, ${c.decorationPackageId ?? c.DecorationPackageId}, '${totalCost}')" class="${isBest ? 'recom-btn-gold' : 'recom-btn-dark'}" style="width: 100%; font-size: 13px; display: flex; align-items: center; justify-content: center; gap: 8px;">
                                <span>Đăng Ký Giữ Chỗ Gói Này</span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                `;
            });
        }

        function showDetailModal(type, title, price, desc, extra) {
            const modal = document.getElementById('itemDetailModal');
            const iconBox = document.getElementById('modalIconBox');
            const dishesBox = document.getElementById('modalDishesContainer');

            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalPriceVal').innerText = price;
            document.getElementById('modalDescription').innerText = desc || 'Thông tin chi tiết dịch vụ tại Riverside Palace.';
            dishesBox.style.display = 'none';

            if (type === 'HALL') {
                document.getElementById('modalSubTitle').innerText = 'Không Gian Đại Sảnh';
                iconBox.innerHTML = '<i class="fa-solid fa-archway"></i>';
                document.getElementById('modalNote').innerText = `Sức chứa tối đa: ${extra} bàn. Giá thuê sảnh là chi phí cố định cho ca tổ chức.`;
            } else if (type === 'MENU') {
                document.getElementById('modalSubTitle').innerText = 'Ẩm Thực Tiệc Cưới';
                iconBox.innerHTML = '<i class="fa-solid fa-utensils"></i>';
                dishesBox.style.display = 'block';
                document.getElementById('modalDishesText').innerText = desc;
                document.getElementById('modalNote').innerText = `Đơn giá áp dụng cho mâm tròn 10 khách. Đã tính cho ${extra} bàn tiệc.`;
            } else if (type === 'DECOR') {
                document.getElementById('modalSubTitle').innerText = 'Concept Trang Trí';
                iconBox.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles"></i>';
                document.getElementById('modalNote').innerText = `Tone màu phong cách: ${extra}. Concept trang trí bao gồm cổng hoa, backdrop và bàn gallery.`;
            }

            modal.style.display = 'flex';
        }

        function showServiceDetail(name, price, note) {
            const modal = document.getElementById('itemDetailModal');
            document.getElementById('modalSubTitle').innerText = 'Dịch Vụ Tiệc Cưới';
            document.getElementById('modalIconBox').innerHTML = '<i class="fa-solid fa-bell-concierge"></i>';
            document.getElementById('modalTitle').innerText = name;
            document.getElementById('modalPriceVal').innerText = price;
            document.getElementById('modalDescription').innerText = note;
            document.getElementById('modalDishesContainer').style.display = 'none';
            document.getElementById('modalNote').innerText = 'Dịch vụ được phục vụ bởi đội ngũ chuyên nghiệp của Riverside Palace.';
            modal.style.display = 'flex';
        }

        function closeDetailModal() {
            document.getElementById('itemDetailModal').style.display = 'none';
        }

        async function openShowtimeModal() {
            const modal = document.getElementById('showtimeModal');
            const currentDate = document.getElementById('eventDate').value;
            document.getElementById('modalDatePicker').value = currentDate;
            modal.style.display = 'flex';
            await loadHallAvailability(currentDate);
        }

        async function loadHallAvailability(dateStr) {
            const container = document.getElementById('showtimeMatrixContainer');
            container.innerHTML = '<div style="padding: 24px; text-align: center; color: #94A3B8;"><i class="fa-solid fa-circle-notch fa-spin" style="margin-right: 8px;"></i>Đang kiểm tra bảng LichSanh trong CSDL...</div>';

            try {
                const res = await fetch(`/Recommendation/GetHallAvailability?date=${encodeURIComponent(dateStr)}`);
                if (!res.ok) {
                    container.innerHTML = `<div style="padding: 24px; text-align: center; color: #EF4444;">Lỗi máy chủ (${res.status}). Vui lòng kiểm tra lại.</div>`;
                    return;
                }
                const json = await res.json();
                if (json.success && json.data && json.data.halls) {
                    renderRealShowtimeMatrix(json.data.halls, dateStr);
                } else {
                    container.innerHTML = `<div style="padding: 24px; text-align: center; color: #EF4444;">${json.message || 'Không thể tải dữ liệu lịch sảnh.'}</div>`;
                }
            } catch (e) {
                container.innerHTML = `<div style="padding: 24px; text-align: center; color: #EF4444;">Lỗi kết nối máy chủ.</div>`;
            }
        }

        function renderRealShowtimeMatrix(halls, dateStr) {
            const container = document.getElementById('showtimeMatrixContainer');
            container.innerHTML = '';

            halls.forEach(h => {
                const noonBtn = h.isNoonAvailable
                    ? `<button type="button" onclick="selectShowtimeSlot('${dateStr}', 'Ca trưa')" class="recom-slot-free"><span style="display: block; font-weight: 700;">Ca Trưa (10:30 – 14:00)</span><span style="font-size: 10px;">🟢 Còn trống (Bấm để chọn)</span></button>`
                    : `<button type="button" disabled class="recom-slot-locked"><span style="display: block; font-weight: 700;">Ca Trưa (10:30 – 14:00)</span><span style="font-size: 10px;">🔴 Đã kín lịch</span></button>`;

                const eveBtn = h.isEveningAvailable
                    ? `<button type="button" onclick="selectShowtimeSlot('${dateStr}', 'Ca tối')" class="recom-slot-free"><span style="display: block; font-weight: 700;">Ca Tối (17:30 – 21:30)</span><span style="font-size: 10px;">🟢 Còn trống (Bấm để chọn)</span></button>`
                    : `<button type="button" disabled class="recom-slot-locked"><span style="display: block; font-weight: 700;">Ca Tối (17:30 – 21:30)</span><span style="font-size: 10px;">🔴 Đã kín lịch</span></button>`;

                container.innerHTML += `
                    <div style="background: #FAF8F5; padding: 14px; border-radius: 16px; border: 1px solid #E2E8F0;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                            <strong style="color: #0F172A; font-size: 14px; display: flex; align-items: center; gap: 6px;">
                                <i class="fa-solid fa-archway" style="color: #B89758;"></i> Sảnh ${h.hallName}
                            </strong>
                            <span style="font-size: 11px; color: #64748B;">Sức chứa: ${h.capacity} bàn • Giá: ${Number(h.rentalPrice).toLocaleString('vi-VN')} đ</span>
                        </div>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px;">
                            ${noonBtn}
                            ${eveBtn}
                        </div>
                    </div>
                `;
            });
        }

        function selectShowtimeSlot(dateStr, shift) {
            document.getElementById('eventDate').value = dateStr;
            document.getElementById('shift').value = shift;
            closeShowtimeModal();
            alert(`Đã chọn sảnh trống vào ngày: ${dateStr} (${shift})!\nHãy nhấn nút "Tính Toán & Trích Xuất Top 3 Combo" để cập nhật phương án.`);
        }

        function closeShowtimeModal() {
            document.getElementById('showtimeModal').style.display = 'none';
        }

        function openBookingConfirmModal(hallId, hallName, menuId, decorId, totalCostStr) {
            selectedComboToBook = {
                hallId: hallId,
                hallName: hallName,
                menuId: menuId,
                decorId: decorId,
                totalCostStr: totalCostStr
            };

            document.getElementById('bkCoupleName').innerText = currentPayload.coupleName;
            document.getElementById('bkPhone').innerText = currentPayload.phoneNumber;
            document.getElementById('bkHall').innerText = hallName;
            document.getElementById('bkDateShift').innerText = `${currentPayload.shift}, ${currentPayload.eventDate}`;
            document.getElementById('bkTables').innerText = `${currentPayload.officialTableCount + currentPayload.spareTableCount} bàn (${currentPayload.officialTableCount} chính + ${currentPayload.spareTableCount} sơ cua)`;
            document.getElementById('bkTotal').innerText = `${totalCostStr} đ`;

            document.getElementById('bookingConfirmModal').style.display = 'flex';
        }

        function closeBookingModal() {
            document.getElementById('bookingConfirmModal').style.display = 'none';
        }

               async function submitActualBooking() {
            const btn = document.getElementById('btnSubmitBooking');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang kiểm tra & lưu đơn tiệc...';

            const bookingPayload = {
                customerName: currentPayload.coupleName,
                phoneNumber: currentPayload.phoneNumber,
                email: currentPayload.email,
                eventDate: currentPayload.eventDate,
                shift: currentPayload.shift,
                hallId: selectedComboToBook.hallId,
                menuId: selectedComboToBook.menuId,
                decorationPackageId: selectedComboToBook.decorId,
                tableCount: currentPayload.officialTableCount + currentPayload.spareTableCount,
                expectedBudget: currentPayload.expectedBudget,
                desiredStyle: currentPayload.desiredStyle,
                specialRequests: `Đăng ký từ AI Recommendation: Ngân sách dự kiến ${currentPayload.expectedBudget.toLocaleString('vi-VN')} đ`
            };

            try {
                const res = await fetch('/Recommendation/RegisterBooking', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(bookingPayload)
                });
                const result = await res.json();

                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-check"></i> Gửi Thông Tin Đăng Ký Giữ Chỗ';
                closeBookingModal();

                if (result.success) {
                    // Điền thông tin vào Popup thành công
                    document.getElementById('succBookingCode').innerText = result.bookingCode || 'DT-ONLINE';
                    document.getElementById('succCouple').innerText = currentPayload.coupleName;
                    document.getElementById('succHall').innerText = selectedComboToBook.hallName;
                    document.getElementById('succDateTime').innerText = `${currentPayload.shift}, ${currentPayload.eventDate}`;
                    document.getElementById('succPhone').innerText = currentPayload.phoneNumber;

                    document.getElementById('bookingSuccessModal').style.display = 'flex';
                } else {
                    // Nếu khách hàng đã có đơn tiệc đang hoạt động
                    if (result.message && (result.message.includes("đã có đơn tiệc") || result.message.includes("giữ chỗ 01 phương án"))) {
                        document.getElementById('duplicateNoticeMsg').innerText = result.message;
                        document.getElementById('duplicateBookingModal').style.display = 'flex';
                    } else {
                        alert(result.message || 'Chưa thể lưu đơn đặt tiệc lúc này.');
                    }
                }
            } catch (e) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-check"></i> Gửi Thông Tin Đăng Ký Giữ Chỗ';
                closeBookingModal();
                alert('Lỗi kết nối khi gửi thông tin giữ chỗ.');
            }
        }

        function closeDuplicateModal() {
            document.getElementById('duplicateBookingModal').style.display = 'none';
        }
    </script>
}